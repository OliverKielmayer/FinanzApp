<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Derselbe Beispielauszug, den die Oberflaeche zum Ausprobieren anbietet. Eine zweite,
         nur fuer den Test gebaute Fassung wuerde irgendwann abweichen. -->
    <Content Include="..\..\docs\beispiele\*.xml" Link="Beispiele\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FinanzApp.Api\FinanzApp.Api.csproj" />
    <!-- Nur für FinanzAppApi: der HTTP-Zugriff des Clients wird gegen einen Attrappen-Handler
         geprüft. Die Razor-Komponenten selbst laufen hier nicht. -->
    <ProjectReference Include="..\..\src\FinanzApp.Client\FinanzApp.Client.csproj" />
    <!-- Nur für den Ordnerdienst: geprüft wird, wann eine Datei als fertig geschrieben gilt und
         wohin sie danach wandert. Beides ist reine Dateiarbeit und läuft auf jedem System. -->
    <ProjectReference Include="..\..\src\FinanzApp.Ordnerdienst\FinanzApp.Ordnerdienst.csproj" />
  </ItemGroup>

</Project>