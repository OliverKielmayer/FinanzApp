<?xml version="1.0" encoding="UTF-8"?>
<!--
  Beispielauszug zum Ausprobieren des Imports: auf der Seite „Kontoauszug einlesen“
  in das Feld ziehen. Die IBAN gehört zum Demo-Konto „Sparkasse Giro“, damit die
  Kontozuordnung greift.

  Die Sätze sind absichtlich verschieden gebaut — Abbuchung und Gutschrift, Referenz
  von der Bank und keine, ein Sammler mit zwei Einzelposten, ein nur vorgemerkter
  Umsatz und einer ohne lesbaren Betrag.
-->
<Document xmlns="urn:iso:std:iso:20022:tech:xsd:camt.052.001.08">
  <BkToCstmrAcctRpt>
    <GrpHdr>
      <MsgId>SPK-2026-08-26-0001</MsgId>
      <CreDtTm>2026-08-26T06:15:00+02:00</CreDtTm>
    </GrpHdr>
    <Rpt>
      <Id>DE44672500200034889102-2026-08</Id>
      <CreDtTm>2026-08-26T06:15:00+02:00</CreDtTm>
      <Acct>
        <Id>
          <IBAN>DE44672500200034889102</IBAN>
        </Id>
        <Ccy>EUR</Ccy>
        <Svcr>
          <FinInstnId>
            <BICFI>SOLADES1HDB</BICFI>
            <Nm>Sparkasse Heidelberg</Nm>
          </FinInstnId>
        </Svcr>
      </Acct>

      <Bal>
        <Tp><CdOrPrtry><Cd>OPBD</Cd></CdOrPrtry></Tp>
        <Amt Ccy="EUR">4820.55</Amt>
        <CdtDbtInd>CRDT</CdtDbtInd>
        <Dt><Dt>2026-08-24</Dt></Dt>
      </Bal>
      <Bal>
        <Tp><CdOrPrtry><Cd>CLBD</Cd></CdOrPrtry></Tp>
        <Amt Ccy="EUR">6091.28</Amt>
        <CdtDbtInd>CRDT</CdtDbtInd>
        <Dt><Dt>2026-08-26</Dt></Dt>
      </Bal>

      <!-- Abbuchung mit Bankreferenz: der Empfänger steht im Gläubiger. -->
      <Ntry>
        <NtryRef>2026082400001</NtryRef>
        <Amt Ccy="EUR">68.42</Amt>
        <CdtDbtInd>DBIT</CdtDbtInd>
        <Sts><Cd>BOOK</Cd></Sts>
        <BookgDt><Dt>2026-08-24</Dt></BookgDt>
        <ValDt><Dt>2026-08-24</Dt></ValDt>
        <AcctSvcrRef>SPK2026082400001</AcctSvcrRef>
        <NtryDtls>
          <TxDtls>
            <Refs><EndToEndId>NOTPROVIDED</EndToEndId></Refs>
            <RltdPties>
              <Cdtr><Nm>REWE Markt Heidelberg</Nm></Cdtr>
            </RltdPties>
            <RmtInf><Ustrd>Kartenzahlung 24.08.2026</Ustrd></RmtInf>
          </TxDtls>
        </NtryDtls>
      </Ntry>

      <!-- Gutschrift: hier ist der Zahler die Gegenseite, nicht der Gläubiger. -->
      <Ntry>
        <Amt Ccy="EUR">2480.00</Amt>
        <CdtDbtInd>CRDT</CdtDbtInd>
        <Sts><Cd>BOOK</Cd></Sts>
        <BookgDt><Dt>2026-08-25</Dt></BookgDt>
        <AcctSvcrRef>SPK2026082500007</AcctSvcrRef>
        <NtryDtls>
          <TxDtls>
            <Refs><EndToEndId>LOHN-2026-08</EndToEndId></Refs>
            <RltdPties>
              <Dbtr><Nm>Kielmayer Systemtechnik GmbH</Nm></Dbtr>
              <Cdtr><Nm>Oliver Kielmayer</Nm></Cdtr>
            </RltdPties>
            <RmtInf><Ustrd>Gehalt August 2026</Ustrd></RmtInf>
          </TxDtls>
        </NtryDtls>
      </Ntry>

      <!-- Sammler mit zwei Einzelposten: wird in zwei Sätze aufgeteilt. -->
      <Ntry>
        <Amt Ccy="EUR">142.85</Amt>
        <CdtDbtInd>DBIT</CdtDbtInd>
        <Sts><Cd>BOOK</Cd></Sts>
        <BookgDt><Dt>2026-08-25</Dt></BookgDt>
        <AcctSvcrRef>SPK2026082500011</AcctSvcrRef>
        <NtryDtls>
          <Btch><NbOfTxs>2</NbOfTxs></Btch>
          <TxDtls>
            <Refs><TxId>SEPA-LS-88120</TxId></Refs>
            <Amt Ccy="EUR">98.90</Amt>
            <CdtDbtInd>DBIT</CdtDbtInd>
            <RltdPties>
              <Cdtr><Nm>Stadtwerke Heidelberg</Nm></Cdtr>
            </RltdPties>
            <RmtInf><Ustrd>Abschlag Strom 08/2026</Ustrd></RmtInf>
          </TxDtls>
          <TxDtls>
            <Refs><TxId>SEPA-LS-88121</TxId></Refs>
            <Amt Ccy="EUR">43.95</Amt>
            <CdtDbtInd>DBIT</CdtDbtInd>
            <RltdPties>
              <Cdtr><Nm>Telekom Deutschland</Nm></Cdtr>
            </RltdPties>
            <RmtInf><Ustrd>Mobilfunk 08/2026</Ustrd></RmtInf>
          </TxDtls>
        </NtryDtls>
      </Ntry>

      <!-- Ohne jede Referenz: die Wiedererkennung braucht dann einen Fingerabdruck. -->
      <Ntry>
        <Amt Ccy="EUR">17.99</Amt>
        <CdtDbtInd>DBIT</CdtDbtInd>
        <Sts><Cd>BOOK</Cd></Sts>
        <BookgDt><DtTm>2026-08-26T04:02:11+02:00</DtTm></BookgDt>
        <NtryDtls>
          <TxDtls>
            <RmtInf><Ustrd>Netflix Abo</Ustrd></RmtInf>
          </TxDtls>
        </NtryDtls>
      </Ntry>

      <!-- Nur vorgemerkt: keine Buchung, wird mit Grund ausgewiesen. -->
      <Ntry>
        <Amt Ccy="EUR">54.10</Amt>
        <CdtDbtInd>DBIT</CdtDbtInd>
        <Sts><Cd>PDNG</Cd></Sts>
        <BookgDt><Dt>2026-08-26</Dt></BookgDt>
        <AcctSvcrRef>SPK2026082600002</AcctSvcrRef>
        <NtryDtls>
          <TxDtls>
            <RltdPties>
              <Cdtr><Nm>Baumarkt Hornbach</Nm></Cdtr>
            </RltdPties>
          </TxDtls>
        </NtryDtls>
      </Ntry>

      <!-- Betrag unlesbar: der Satz bleibt sichtbar und lässt sich nicht zuschalten. -->
      <Ntry>
        <Amt Ccy="EUR">unleserlich</Amt>
        <CdtDbtInd>DBIT</CdtDbtInd>
        <Sts><Cd>BOOK</Cd></Sts>
        <BookgDt><Dt>2026-08-26</Dt></BookgDt>
        <AcctSvcrRef>SPK2026082600009</AcctSvcrRef>
        <NtryDtls>
          <TxDtls>
            <RltdPties>
              <Cdtr><Nm>Apotheke am Markt</Nm></Cdtr>
            </RltdPties>
          </TxDtls>
        </NtryDtls>
      </Ntry>
    </Rpt>
  </BkToCstmrAcctRpt>
</Document>
