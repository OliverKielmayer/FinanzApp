<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\FinanzApp.Shared\FinanzApp.Shared.csproj" />
    <ProjectReference Include="..\FinanzApp.Client\FinanzApp.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Das Testprojekt darf hineinsehen.

      Nur fuer einen Schritt: das Lesen dessen, was die FinTS-Bibliothek in ihren
      Ablageordner geschrieben hat. Er laesst sich nicht ueber die Oberflaeche pruefen -
      davor steht ein Dialog mit einer echten Bank und einer echten PIN. Geprueft wird
      deshalb der Ordner: ein Beispielauszug darin, daneben die Zwischenspeicher der
      Bibliothek, und die Frage, was davon als Auszug gilt.
    -->
    <InternalsVisibleTo Include="FinanzApp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="libfintx.FinTS" Version="1.4.0" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>89e9cd4c-2eb7-4962-ba20-4c1e37bb5288</UserSecretsId>
  </PropertyGroup>

  <!--
    Das Erkennungsprogramm kommt mit.

    Es ist ein eigenes Programm mit eigenem Zielrahmen (siehe FinanzApp.Texterkennung.csproj)
    und wird deshalb nicht wie eine Bibliothek verwiesen. Trotzdem soll es da sein: Wer die
    Anwendung startet, soll eingescannte Belege gelesen bekommen, ohne vorher einen Pfad
    einzutragen, den nur er kennen kann — diese Dateien liegen in einem oeffentlichen
    Repository, und ein Pfad darin waere auf jedem anderen Rechner falsch.

    Also wird es gebaut und neben die API gelegt; die sucht es dort selbst
    (OcrOptions.BundledCommand). Nur unter Windows: Der Zielrahmen verlangt das Windows-SDK,
    und auf einem Linux-Rechner soll der Bau der API weiterhin durchlaufen. Dort bleibt die
    Erkennung aus, und das sagt die Ablage dann auch an.

    Gilt fuer Build, nicht fuer Publish - veroeffentlicht wuerde die Erkennung fehlen.
  -->
  <Target Name="TexterkennungMitnehmen" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">

    <!--
      Erst wiederherstellen, dann bauen.

      Das Programm haengt bewusst nicht als Verweis am Projekt - und was nicht verwiesen ist,
      holt "dotnet restore" auch nicht. In einem frischen Auscheckout fehlte deshalb
      project.assets.json, und der Bau der API brach mit NETSDK1004 ab: schlimmer als das
      Problem, das dieser Schritt loest. Hier faellt es nicht auf, wo das Programm schon
      einmal gebaut wurde - nur beim ersten Mal, bei jemand anderem.
    -->
    <MSBuild Projects="..\FinanzApp.Texterkennung\FinanzApp.Texterkennung.csproj"
             Targets="Restore"
             Properties="Configuration=$(Configuration)" />

    <MSBuild Projects="..\FinanzApp.Texterkennung\FinanzApp.Texterkennung.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="Erkennungsprogramm" />
    </MSBuild>

    <ItemGroup>
      <Erkennungsdateien Include="%(Erkennungsprogramm.RootDir)%(Erkennungsprogramm.Directory)**\*" />
    </ItemGroup>

    <Copy SourceFiles="@(Erkennungsdateien)"
          DestinationFolder="$(OutDir)texterkennung\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
