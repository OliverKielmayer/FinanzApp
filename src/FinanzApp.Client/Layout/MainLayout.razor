@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject NavigationHistory History
@inject AppState State
@inject FinanzAppAuthStateProvider Auth
@inject FinanzAppApi Api

@*
    Das Auth-Gate: ohne Sitzung bleiben Kopfzeile, Tab-Bar und Seitennavigation weg. Der Rumpf
    enthält dann die Weiterleitung auf die Anmeldung und zeigt selbst nichts.
*@
<AuthorizeView>
    <Authorized>
        <div class="app">
            <SideNav Current="@screen" CanWrite="@CanWrite"
                     UserName="@Auth.User?.Name" HouseholdName="@Auth.User?.HouseholdName"
                     SignedInAt="@Auth.User?.SignedInAt"
                     Counts="@counts" MemberCount="@memberCount"
                     CategoryCount="@categoryCount" RuleCount="@ruleCount"
                     OnCapture="OpenCapture" />

            <div class="app-body">
                <header class="app-header">
                    @if (screen.IsDetail)
                    {
                        <button type="button" class="header-action" @onclick="History.GoBack">Zurück</button>
                    }

                    <div class="app-header-titles">
                        <span class="kicker">@screen.Kicker</span>
                        <h1 class="app-title">@screen.Title</h1>
                    </div>

                    <button type="button" class="header-action"
                            @onclick="State.ToggleAmounts">@State.ToggleLabel</button>
                </header>

                <main class="app-main">
                    <div class="app-content">
                        @Body
                    </div>
                </main>

                <TabBar Current="@screen" CanWrite="@CanWrite" OnCapture="OpenCapture" />
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        @Body
    </NotAuthorized>
</AuthorizeView>

@if (captureOpen)
{
    <CaptureSheet OnClose="CloseCapture" />
}

<Toast />

@code {
    private Screen screen = ScreenCatalog.All[0];
    private bool captureOpen;

    /// <summary>Kennzahlen der Seitennavigation. Dieselbe Quelle wie die Bereichsliste auf „Mehr“.</summary>
    private AreaCountsDto? counts;
    private int? memberCount;
    private int? categoryCount;
    private int? ruleCount;

    private bool CanWrite => Auth.User?.CanWrite ?? false;

    /// <summary>Der Anmeldezustand — er steht erst fest, wenn <c>/api/auth/me</c> geantwortet hat.</summary>
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    /// <summary>
    /// Die Kennzahlen kommen nach, sobald feststeht, wer angemeldet ist.
    /// </summary>
    /// <remarks>
    /// <para>Früher stand hier eine Prüfung auf <c>Auth.User</c> im ersten Rendern. Beim Kaltstart
    /// ist der Anmeldezustand da aber noch nicht bekannt — er kommt aus <c>/api/auth/me</c> und
    /// trifft später ein. Die Prüfung schlug also fehl, ein zweiter Versuch war nicht
    /// vorgesehen, und die Navigation blieb die ganze Sitzung lang ohne Zahlen. Nach einer
    /// Anmeldung im selben Lauf erschienen sie, nach einem Neuladen nie: derselbe Bildschirm
    /// zeigte je nach Weg dorthin verschiedene Dinge.</para>
    /// <para>Jetzt wird der Zustand abgewartet. Scheitert der Aufruf, bleibt die Navigation
    /// ohne Zahlen stehen — sie ist deshalb nicht weniger benutzbar, und ein Fehlerbanner über
    /// der ganzen Anwendung wäre die schlechtere Antwort.</para>
    /// </remarks>
    protected override async Task OnInitializedAsync()
    {
        UpdateScreen();
        Navigation.LocationChanged += OnLocationChanged;
        State.Changed += OnStateChanged;

        var state = await AuthState;
        if (state.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        try
        {
            var overview = await Api.GetMoreOverviewAsync();
            counts = overview.Areas;
            memberCount = overview.HouseholdMemberCount;
            categoryCount = overview.CategoryCount;
            ruleCount = overview.RuleCount;
        }
        catch (Exception)
        {
            // bewusst still: siehe oben
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateScreen();
        StateHasChanged();
    }

    private void OnStateChanged() => StateHasChanged();

    private void OpenCapture() => captureOpen = true;

    private void CloseCapture() => captureOpen = false;

    private void UpdateScreen() => screen = ScreenCatalog.Resolve(Navigation.ToBaseRelativePath(Navigation.Uri));

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        State.Changed -= OnStateChanged;
    }
}
