@page "/vorgaenge"
@attribute [Authorize]
@inherits AppPage

<PageTitle>Vorgänge — FinanzApp</PageTitle>

<div class="filter-chips">
    @foreach (var option in Filters)
    {
        <button type="button" class="chip @(filter == option.State ? "active" : null)"
                @onclick="() => SwitchFilter(option.State)">
            @option.Label @CountFor(option.State)
        </button>
    }
</div>

<AsyncView Loading="Loading" Error="@Error" Stale="HasLoadedOnce" Retry="ReloadAsync">
    @if (data is { } list)
    {
        @if (list.Items.Count == 0)
        {
            <div class="empty-area">
                <span class="empty-area-text">@EmptyText</span>
                <AuthorizeView Roles="Owner,Member">
                    <button type="button" class="btn btn-secondary"
                            @onclick="@(() => Toasts.Show("Aufgabe anlegen folgt"))">Aufgabe anlegen</button>
                </AuthorizeView>
            </div>
        }

        @foreach (var item in list.Items)
        {
            <div class="work-row @(item.IsOverdue ? "overdue" : null)">
                @* Betrag innerhalb der Fläche, die weiterführt: Wer auf die Zahl tippt, meint
                   die Zeile. *@
                <button type="button" class="tap work-open" @onclick="() => Open(item)">
                    <span class="stack">
                        <span class="work-title">@item.Title</span>
                        <span class="work-due">@Describe(item)</span>
                    </span>

                    @if (item.Amount is { } amount)
                    {
                        <span class="work-amount num">@State.Euro0(amount)</span>
                    }
                </button>

                @*
                    Abhaken gibt es nur, wo kein Objekt den Stand trägt. Eine offene Rechnung
                    wird an der Rechnung bezahlt; hier abgehakt bliebe sie offen, und der
                    einzige Hinweis darauf wäre weg.
                *@
                @if (item.CanComplete)
                {
                    <AuthorizeView Roles="Owner,Member" Context="abhaken">
                        <button type="button" class="btn btn-ghost" disabled="@busy"
                                title="Abhaken — der Vorgang kommt nicht wieder"
                                @onclick="() => CompleteAsync(item)">Erledigt</button>
                    </AuthorizeView>
                }
            </div>

            @*
                Was der Abgleich gefunden, aber nicht entschieden hat. Eindeutig Belegtes ist
                längst zugeordnet und der Vorgang zu; hier steht, wo es mehr als eine Buchung
                gibt oder keine Nummer vom Papier zur Zahlung führt. Beides sieht ein Mensch in
                einem Blick und die Anwendung nie.
            *@
            @foreach (var fund in item.PaymentSuggestions)
            {
                <div class="work-match">
                    <span class="work-match-text">
                        <span class="work-match-line">
                            Bezahlt? @GermanFormat.Date(fund.BookedOn) ·
                            @State.Euro(fund.Amount)@(fund.Payee is { Length: > 0 } wer ? " · " + wer : null)
                        </span>

                        <span class="work-match-why">
                            @(fund.Evidence is { } beweis
                                ? $"Nummer {beweis} steht auch im Beleg"
                                : "nur Betrag und Zeitraum passen")@(fund.Purpose is { Length: > 0 } zweck
                                    ? " · " + zweck
                                    : null)
                        </span>
                    </span>

                    <AuthorizeView Roles="Owner,Member" Context="zuordnen">
                        <button type="button" class="btn btn-secondary" disabled="@busy"
                                title="Buchung zuordnen und den Vorgang schliessen"
                                @onclick="() => AssignAsync(item, fund)">Zuordnen</button>
                    </AuthorizeView>
                </div>
            }
        }

        <div class="spacer"></div>
    }
</AsyncView>

@code {
    private static readonly (TaskState? State, string Label)[] Filters =
    [
        (TaskState.Open, "Offen"),
        (TaskState.Waiting, "Wartet"),
        (TaskState.Done, "Erledigt"),
    ];

    private TaskListDto? data;
    private TaskState? filter = TaskState.Open;
    private bool busy;

    protected override async Task LoadAsync() => data = await Api.GetTasksAsync(filter);

    private async Task SwitchFilter(TaskState? next)
    {
        if (next == filter)
        {
            return;
        }

        filter = next;
        await ReloadAsync();
    }

    private int CountFor(TaskState? state) => (data, state) switch
    {
        (null, _) => 0,
        ({ } list, TaskState.Open) => list.OpenCount,
        ({ } list, TaskState.Waiting) => list.WaitingCount,
        ({ } list, TaskState.Done) => list.DoneCount,
        _ => 0,
    };

    private string EmptyText => filter switch
    {
        TaskState.Open => "Nichts offen. Fristen, Rechnungen und Erstattungen tauchen hier von selbst auf.",
        TaskState.Waiting => "Nichts, worauf gewartet wird.",
        _ => "Noch nichts erledigt.",
    };

    /// <summary>
    /// Die Zeile erklärt, woher der Eintrag kommt — automatisch erzeugte Aufgaben wären sonst
    /// nicht nachvollziehbar.
    /// </summary>
    private static string Describe(TaskItemDto item)
    {
        var parts = new List<string>();

        if (item.Detail is { Length: > 0 } detail)
        {
            parts.Add(detail);
        }

        if (item.IsOverdue)
        {
            parts.Add($"überfällig seit {item.DaysOverdue} T");
        }
        else if (item.DueOn is { } due)
        {
            var days = -item.DaysOverdue;
            parts.Add(days == 0 ? "heute fällig" : $"fällig in {days} Tagen · {GermanFormat.Date(due)}");
        }

        return string.Join(" · ", parts);
    }

    /// <summary>
    /// Hakt einen Vorgang ab.
    /// </summary>
    /// <remarks>
    /// Danach wird neu geladen, statt die Zeile wegzunehmen: Die Zahlen an den Filtern gehören
    /// zur Liste, und eine Liste mit einer Zeile weniger und derselben Zahl daneben wäre
    /// falsch.
    /// </remarks>
    private Task CompleteAsync(TaskItemDto item) => RunAsync(async () =>
    {
        busy = true;
        try
        {
            await Api.SetTaskStateAsync(item.Id, TaskState.Done);
            Toasts.Show("Erledigt", ToastKind.Saved);
            await ReloadAsync();
        }
        finally
        {
            busy = false;
        }
    });

    /// <summary>
    /// Nimmt einen Vorschlag an: Buchung zuordnen, Vorgang schliessen.
    /// </summary>
    /// <remarks>
    /// Derselbe Ausgang wie beim Abhaken, nur mit einem Grund daran. Im Vorgang steht danach,
    /// woran es festgemacht wurde — ein geschlossener Vorgang ohne Begründung wäre schlimmer
    /// als ein offener, denn beim offenen sieht man wenigstens, dass etwas fehlt.
    /// </remarks>
    private Task AssignAsync(TaskItemDto item, TaskPaymentDto fund) => RunAsync(async () =>
    {
        busy = true;
        try
        {
            await Api.AssignTaskPaymentAsync(item.Id, fund.TransactionId);
            Toasts.Show("Zugeordnet und erledigt", ToastKind.Saved);
            await ReloadAsync();
        }
        finally
        {
            busy = false;
        }
    });

    private void Open(TaskItemDto item)
    {
        var route = (item.SourceType, item.SourceId) switch
        {
            (LinkTargetType.MedicalBill, { } id) => $"/gesundheit/{id}",
            (LinkTargetType.Invoice, { } id) => $"/rechnungen/{id}",
            (LinkTargetType.Policy, { } id) => $"/police/{id}",
            (LinkTargetType.Contract, { } id) => $"/vertraege/{id}",

            // Zum Beleg und nicht gleich in den Prüfschritt: dort steht, worum es geht, und
            // der Knopf „Werte übernehmen“ steht daneben. Wer eine Zahl in sein Vermögen
            // nimmt, soll vorher sehen, aus welchem Papier sie kommt.
            (LinkTargetType.Document, { } id) => $"/dokumente/{id}",

            _ => null,
        };

        if (route is null)
        {
            Toasts.Show("Zu dieser Aufgabe gibt es keinen eigenen Screen.");
            return;
        }

        Navigation.NavigateTo(route);
    }
}
