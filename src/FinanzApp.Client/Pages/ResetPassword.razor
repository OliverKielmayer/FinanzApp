@page "/passwort-vergessen"
@page "/passwort-zuruecksetzen"
@layout AuthLayout
@inject FinanzAppApi Api
@inject ToastService Toasts
@inject NavigationManager Navigation

<PageTitle>Passwort zurücksetzen — FinanzApp</PageTitle>

@if (Token is null)
{
    @* Schritt 1 — Link anfordern. So im Handoff entworfen. *@
    <EditForm Model="this" OnValidSubmit="RequestLinkAsync">
        <div class="auth-form">
            <span class="auth-explain">
                Wir senden einen Link zum Zurücksetzen an die hinterlegte Adresse.
                Der Link gilt 30 Minuten.
            </span>
            <div class="field">
                <label for="reset-mail">E-Mail</label>
                <InputText id="reset-mail" class="input" type="email" autocomplete="username"
                           placeholder="name@haushalt.de" @bind-Value="email" />
            </div>
        </div>

        <div class="auth-actions">
            <button type="submit" class="btn btn-primary" disabled="@busy">Link senden</button>
            <button type="button" class="btn btn-secondary"
                    @onclick="@(() => Navigation.NavigateTo(AuthScreens.Login))">Zurück</button>
        </div>
    </EditForm>
}
else
{
    @*
        Schritt 2 — neues Passwort setzen. Diesen Screen enthält der Handoff noch nicht; ohne ihn
        führte der Link aus der Mail aber ins Leere. Aufbau und Bausteine sind von der
        Registrierung übernommen.
    *@
    <EditForm Model="this" OnValidSubmit="RedeemAsync">
        <div class="auth-form">
            <span class="auth-explain">Wähle ein neues Passwort für dein Konto.</span>
            <div class="field">
                <label for="reset-pass">Neues Passwort</label>
                <input id="reset-pass" class="input" type="password" autocomplete="new-password"
                       placeholder="@($"mindestens {PasswordPolicy.MinimumLength} Zeichen")"
                       value="@password" @oninput="OnPasswordInput" />
            </div>

            <div class="strength">
                <div class="strength-bars" role="img" aria-label="@($"Passwortstärke: {strengthText}")">
                    @for (var level = 1; level <= 4; level++)
                    {
                        <div class="strength-bar @BarClass(level)"></div>
                    }
                </div>
                <span class="strength-text">@strengthText</span>
            </div>
        </div>

        <div class="auth-actions">
            <button type="submit" class="btn btn-primary" disabled="@busy">Passwort speichern</button>
            <button type="button" class="btn btn-secondary"
                    @onclick="@(() => Navigation.NavigateTo(AuthScreens.Login))">Abbrechen</button>
        </div>
    </EditForm>
}

@code {
    /// <summary>Kommt aus dem Link der Mail. Ohne Token zeigt die Seite das Anforderungsformular.</summary>
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private string email = string.Empty;
    private string password = string.Empty;
    private bool busy;

    private PasswordStrength strength = PasswordStrength.None;
    private string strengthText = PasswordPolicy.Describe(PasswordStrength.None);

    private void OnPasswordInput(ChangeEventArgs e)
    {
        password = e.Value?.ToString() ?? string.Empty;
        strength = PasswordPolicy.Evaluate(password);
        strengthText = PasswordPolicy.Describe(strength);
    }

    private string? BarClass(int level)
    {
        if (level > (int)strength)
        {
            return null;
        }

        return strength >= PasswordPolicy.Required ? "filled enough" : "filled";
    }

    private async Task RequestLinkAsync()
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            Toasts.Show("E-Mail fehlt");
            return;
        }

        busy = true;
        try
        {
            await Api.RequestPasswordResetAsync(email.Trim());

            // Immer dieselbe Bestätigung — ob es die Adresse gibt, geht niemanden etwas an,
            // der sie gerade eingetippt hat.
            Toasts.Show("Link gesendet an " + email.Trim());
            Navigation.NavigateTo(AuthScreens.Login);
        }
        catch (ApiException ex)
        {
            Toasts.Show(ex.Message);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RedeemAsync()
    {
        if (!PasswordPolicy.IsAcceptable(password))
        {
            Toasts.Show($"Passwort zu schwach — mindestens {PasswordPolicy.MinimumLength} Zeichen und Stufe „Gut“");
            return;
        }

        busy = true;
        try
        {
            await Api.RedeemPasswordResetAsync(Token!, password);
            Toasts.Show("Passwort gespeichert");
            Navigation.NavigateTo(AuthScreens.Login);
        }
        catch (ApiException ex)
        {
            Toasts.Show(ex.Message);
        }
        finally
        {
            busy = false;
            password = string.Empty;
        }
    }
}
