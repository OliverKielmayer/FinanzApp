@page "/konten"
@attribute [Authorize]
@inherits AppPage
@inject ImportDraft Draft

<PageTitle>Konten &amp; Buchungen — FinanzApp</PageTitle>

<AsyncView Loading="Loading" Error="@Error" Stale="HasLoadedOnce" Retry="ReloadAsync">
    @*
        Vier Spalten am Schreibtisch, untereinander auf dem Telefon: Konten, das gewählte Konto,
        seine Buchungen, die gewählte Buchung. Das ist die Ordnung, in der man danach greift —
        erst das Konto, dann der Monat, dann die eine Zeile, die man sucht.

        Die Spalten sind eine Sache der Breite und nicht des Zustands: dieselbe Markierung trägt
        beide Fassungen, und was auf dem Telefon untereinander steht, steht am Schreibtisch
        nebeneinander. Ein zweiter Satz Seiten für den großen Schirm hieße, jede Änderung zweimal
        zu machen und eine davon zu vergessen.
    *@
    <div class="ledger">

        @* ── Konten ───────────────────────────────────────────────────────────────────── *@
        <aside class="ledger-accounts">
            <div class="ledger-head">
                <span class="ledger-title">Konten</span>
                <span class="ledger-sum num">@State.Euro(AccountTotal)</span>
            </div>

            @*
                Die Karte wählt das Konto aus, statt ins Bearbeiten zu führen. Ein Tipp, der die
                Liste daneben umstellt, ist das, was man hier erwartet; bearbeitet wird in der
                Spalte, die das Konto ohnehin aufschlägt.
            *@
            <button type="button" class="acct-card @(accountFilter is null ? "picked" : null)"
                    @onclick="() => SetAccount(null)">
                <span class="acct-mark acct-mark-all" aria-hidden="true">Σ</span>
                <span class="stack">
                    <span class="acct-name">Alle Konten</span>
                    <span class="acct-sub">@accounts.Count @(accounts.Count == 1 ? "Konto" : "Konten")</span>
                </span>
                <span class="acct-balance num">@State.Euro(AccountTotal)</span>
            </button>

            @foreach (var account in accounts)
            {
                <button type="button" class="acct-card @(accountFilter == account.Id ? "picked" : null)"
                        @onclick="() => SetAccount(account.Id)">
                    <span class="acct-mark" aria-hidden="true">@Initial(account)</span>
                    <span class="stack">
                        <span class="acct-name">@account.Name</span>
                        <span class="acct-sub">@AccountSubtitle(account)</span>
                        <span class="meta">@AsOfLabel(account.BalanceAsOf)</span>
                    </span>
                    <span class="acct-balance num">@State.Euro(account.Balance)</span>
                </button>
            }

            <AuthorizeView Roles="Owner,Member" Context="neu">
                <AddRow Route="/neu/account" Label="Konto anlegen" />
            </AuthorizeView>
        </aside>

        @* ── Das gewählte Konto ───────────────────────────────────────────────────────── *@
        <aside class="ledger-account">
            @if (PickedAccount is { } konto)
            {
                <div class="acct-sheet">
                    <span class="acct-mark acct-mark-large" aria-hidden="true">@Initial(konto)</span>
                    <span class="acct-sheet-name">@konto.Name</span>

                    @* Nur was am Konto steht. Eine Kontoart führt das Modell nicht, und sie aus
                       der IBAN zu raten hieße, jedes Konto mit IBAN ein Girokonto zu nennen. *@
                    @if (KindLabel(konto) is { Length: > 0 } art)
                    {
                        <span class="acct-sheet-kind">@art</span>
                    }

                    @if (konto.Iban is { Length: > 0 } iban)
                    {
                        <div class="acct-sheet-field">
                            <span class="label-muted">IBAN</span>
                            <span class="num">@iban</span>
                        </div>
                    }

                    <span class="acct-sheet-balance num">@State.Euro(konto.Balance)</span>
                    <span class="meta">Stand @AsOfLabel(konto.BalanceAsOf)</span>

                    @*
                        Direkt unter der Zahl, weil es die Zahl betrifft. Ein Kontrollpunkt
                        zählt nur, was nach seinem Stichtag gebucht wurde — kommt eine ältere
                        Buchung erst später herein, fällt sie still heraus. Genau so ist hier
                        einmal ein Stand um einen vierstelligen Betrag danebengelegen, und
                        gemerkt hat es der Inhaber, nicht die Anwendung.

                        Gezählt, nicht gerechnet: Die Anwendung addiert nichts dazu. Ob die
                        Buchungen in der Zahl der Bank stecken, weiß nur die Bank.
                    *@
                    @if (konto.Uncounted is { } luecke)
                    {
                        <div class="state-error" role="status">
                            <span class="state-error-title">
                                @(luecke.Count == 1
                                    ? "Eine Buchung zählt nicht mit"
                                    : $"{luecke.Count} Buchungen zählen nicht mit")
                            </span>
                            <span class="state-error-text">
                                @($"Sie kamen nach dem Kontrollpunkt vom "
                                  + $"{GermanFormat.Date(luecke.CheckpointAsOf)} herein, tragen "
                                  + $"aber ältere Buchungstage — zusammen ")@Signed(luecke.Amount)@(
                                  ". In dem festgestellten Stand steckten sie nicht, und die "
                                  + "Rechnung lässt sie trotzdem heraus. Nehmen Sie den "
                                  + "Kontrollpunkt zurück oder setzen Sie ihn neu.")
                            </span>
                        </div>
                    }

                    @if (SharingLabel(konto) is { Length: > 0 } freigabe)
                    {
                        <span class="tag tag-outline">@freigabe</span>
                    }

                    @*
                        Was dieses Konto hergibt — nicht, was eine Bank könnte. „Konto
                        aktualisieren“ stünde hier ohne Bankzugang und täte nichts.
                    *@
                    <AuthorizeView Roles="Owner,Member" Context="aktionen">
                        <div class="acct-sheet-actions">
                            @if (konto.IsMine || konto.OwnerUserId is null)
                            {
                                <button type="button" class="btn btn-secondary"
                                        @onclick="@(() => Navigation.NavigateTo($"/bearbeiten/account/{konto.Id}"))">
                                    Konto bearbeiten
                                </button>
                            }

                            <button type="button" class="btn btn-secondary"
                                    @onclick="@(() => Navigation.NavigateTo("/import"))">
                                Buchungen einlesen
                            </button>

                            @*
                                An jedem Konto. Der Abgleich braucht keine Bank: Er trägt ein,
                                was auf dem Kontoauszug steht, und genau dafür ist er da —
                                Konten ohne Zugang sind sonst für immer schief.
                            *@
                            <button type="button" class="btn btn-secondary"
                                    @onclick="() => OpenReconcile(konto)">
                                Stand abgleichen
                            </button>

                            @*
                                Nur wo ein Zugang steht. Ein Schalter, der bei jedem Konto
                                anbietet, bei der Bank nachzufragen, verspricht etwas, das die
                                meisten Konten nicht halten können.

                                Ein Schalter, nicht zwei: Der Auszug bringt Umsätze und
                                Schlusssaldo in einem, und nur er sagt dazu, auf welchen Tag
                                sich der Saldo bezieht. Die frühere reine Saldenabfrage
                                lieferte eine Zahl ohne Datum — als Tagesstand abgelegt, fiel
                                alles heraus, was die Bank danach noch buchte.
                            *@
                            @if (konto.HasBankAccess)
                            {
                                <button type="button" class="btn btn-secondary"
                                        @onclick="() => OpenBankCheck(konto.Id)"
                                        disabled="@(bankBusy)">
                                    Bei der Bank abholen
                                </button>
                            }
                        </div>
                    </AuthorizeView>

                    @*
                        Der Abgleich von Hand. Zwei Felder, und das Datum ist das wichtigere:
                        Ein Kontostand ohne Stichtag ist keine Auskunft.
                    *@
                    @if (reconcileAccountId == konto.Id)
                    {
                        <section class="acct-bank">
                            <span class="label-muted">Stand abgleichen</span>

                            <span class="meta">
                                @("Tragen Sie ein, was laut Auszug oder Online-Banking an diesem "
                                  + "Tag auf dem Konto war. Die Anwendung rechnet ab da vorwärts; "
                                  + "Buchungen bis zu diesem Tag stecken schon in der Zahl.")
                            </span>

                            @*
                                Genau hier ist schon einmal eine Differenz entstanden: Ein
                                Stand, der vormittags abgelesen und auf denselben Tag datiert
                                wird, gilt der Rechnung als Stand des <em>ganzen</em> Tages.
                                Was die Bank nachmittags noch bucht, fällt damit still heraus
                                — und bleibt draußen, weil der nächste Abgleich gegen dieselbe
                                Zahl vergleicht. Der Hinweis steht nur beim heutigen Datum: An
                                jedem anderen Tag ist der Auszug längst geschlossen.
                            *@
                            @if (reconcileAsOf >= DateOnly.FromDateTime(DateTime.Today))
                            {
                                <span class="meta accent">
                                    @("Ein heute abgelesener Stand ist ein Zwischenstand: Was "
                                      + "die Bank im Lauf des Tages noch bucht, steckt weder "
                                      + "in ihm noch wird es dazugerechnet. Belastbarer ist "
                                      + "der Schlusssaldo eines vergangenen Tages — oder der "
                                      + "Auszug selbst, der ihn mitbringt.")
                                </span>
                            }

                            <div class="field">
                                <label for="abgleich-stichtag">Stichtag</label>
                                <input id="abgleich-stichtag" type="date" class="input"
                                       @bind="reconcileAsOf" />
                            </div>

                            <div class="field">
                                <label for="abgleich-stand">Stand an diesem Tag (€)</label>
                                <input id="abgleich-stand" type="number" step="0.01" class="input"
                                       @bind="reconcileBalance" />
                            </div>

                            <div class="field">
                                <label for="abgleich-vermerk">Vermerk (freiwillig)</label>
                                <input id="abgleich-vermerk" type="text" class="input"
                                       maxlength="300" placeholder="z. B. Auszug Nr. 11"
                                       @bind="reconcileNote" />
                            </div>

                            @if (reconcileError is { } abgleichfehler)
                            {
                                <div class="state-error" role="alert">
                                    <span class="state-error-text">@abgleichfehler</span>
                                </div>
                            }

                            <div class="acct-sheet-actions">
                                <button type="button" class="btn btn-primary"
                                        @onclick="() => SaveReconcile(konto.Id)"
                                        disabled="@reconcileBusy">
                                    @(reconcileBusy ? "Wird eingetragen …" : "Eintragen")
                                </button>

                                <button type="button" class="btn btn-secondary"
                                        @onclick="CloseReconcile">Abbrechen</button>
                            </div>

                            @*
                                Was bisher abgeglichen wurde. Die Differenz steht dabei: Sie ist
                                der eigentliche Befund — so viel fehlte bis zu dem Tag an
                                Buchungen oder stand zu viel da.
                            *@
                            @if (reconcilePoints.Count > 0)
                            {
                                <div class="acct-bank-rows">
                                    @foreach (var punkt in reconcilePoints.Take(5))
                                    {
                                        <div class="acct-bank-row">
                                            <span class="label-muted">
                                                @AsOfLabel(punkt.AsOf) · @SourceLabel(punkt.Source)
                                            </span>
                                            <span class="num">@State.Euro(punkt.Balance)</span>
                                            <span class="num">@Signed(punkt.Difference)</span>
                                            <button type="button" class="btn btn-ghost"
                                                    @onclick="() => DropReconcile(konto.Id, punkt.Id)"
                                                    disabled="@reconcileBusy">
                                                Zurücknehmen
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </section>
                    }

                    @*
                        Der Abruf: PIN eingeben, fragen, weiter in die Vorschau. An derselben
                        Stelle, an der das Konto steht — nicht auf einer eigenen Seite.
                    *@
                    @if (bankAccountId == konto.Id)
                    {
                        <section class="acct-bank">
                            @if (bankProblems.Count > 0)
                            {
                                @*
                                    Was fehlt, steht einzeln da. „Der Zugang ist unvollständig“
                                    sagt niemandem, wo er suchen soll.
                                *@
                                <span class="label-muted">Der Abruf geht noch nicht</span>
                                <ul class="acct-bank-problems">
                                    @foreach (var problem in bankProblems)
                                    {
                                        <li>@problem</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                @*
                                    Was schiefging, steht in der Tafel und nicht in einer
                                    Meldung, die nach zweieinhalb Sekunden verschwindet. Es ist
                                    der einzige Satz, der sagt, warum der Abruf nicht ging —
                                    und er wird gebraucht, während die PIN neu getippt wird.
                                *@
                                @if (bankError is { } fehler)
                                {
                                    <div class="state-error" role="alert">
                                        <span class="state-error-title">
                                            Der Abruf ist nicht durchgegangen
                                        </span>
                                        <span class="state-error-text">@fehler</span>
                                    </div>
                                }

                                @*
                                    Die PIN wird bei jedem Abruf neu gefragt und nirgends
                                    behalten. Der Preis dafür ist bekannt und gewollt: kein
                                    Abruf im Hintergrund.
                                *@
                                <label class="label-muted" for="bank-pin">
                                    PIN für @konto.Name
                                </label>
                                <input id="bank-pin" type="password" class="input"
                                       autocomplete="off" inputmode="numeric"
                                       placeholder="Bank-PIN"
                                       @bind="bankPin" @bind:event="oninput"
                                       @onkeydown="BankPinKey" disabled="@bankBusy" />
                                <span class="meta">
                                    Die PIN wird nicht gespeichert und bei jedem Abruf neu
                                    gefragt. Der Abruf ändert nichts am Konto — er endet in
                                    der Vorschau.
                                </span>

                                @*
                                    Die zweite Hälfte der Wahrheit: Verlangt die Bank eine
                                    Freigabe, schickt sie die Anfrage in ihre eigene App — und
                                    der Abruf steht so lange still. Wer das nicht weiß, hält
                                    die wartende Seite für hängengeblieben und bricht ab.
                                *@
                                <span class="meta">
                                    Verlangt Ihre Bank eine Freigabe, erscheint sie in
                                    <em>ihrer</em> App. Der Abruf wartet bis zu drei Minuten
                                    darauf. Eine TAN wird hier nie eingetippt.
                                </span>

                                @* Eine Frage an die Bank, und sie beantwortet beides: Der
                                   Auszug bringt die Umsätze und seinen Schlusssaldo mit, samt
                                   dem Tag, auf den der sich bezieht. Er endet in derselben
                                   Vorschau wie eine hochgeladene Datei, nicht in gebuchten
                                   Zeilen — deshalb steht hier nicht „Übernehmen“. *@
                                <div class="acct-sheet-actions">
                                    <button type="button" class="btn btn-primary"
                                            @onclick="RunStatementFetch"
                                            disabled="@(bankBusy || string.IsNullOrWhiteSpace(bankPin))">
                                        @(bankBusy
                                            ? "Bank wird gefragt …" : "Abholen")
                                    </button>
                                    <button type="button" class="btn btn-secondary"
                                            @onclick="CloseBankCheck" disabled="@bankBusy">
                                        Abbrechen
                                    </button>
                                </div>
                            }
                        </section>
                    }
                </div>
            }
            else
            {
                <div class="acct-sheet">
                    <span class="acct-mark acct-mark-large acct-mark-all" aria-hidden="true">Σ</span>
                    <span class="acct-sheet-name">Alle Konten</span>
                    <span class="acct-sheet-kind">
                        @accounts.Count @(accounts.Count == 1 ? "Konto" : "Konten") zusammen
                    </span>
                    <span class="acct-sheet-balance num">@State.Euro(AccountTotal)</span>
                    <span class="meta">
                        Ein Konto wählen, um seinen Stand je Tag zu sehen — über mehrere Konten
                        hinweg gibt es keinen.
                    </span>
                </div>
            }

            @*
                Die Summen rechnen gegen den sichtbaren Ausschnitt, nicht gegen den Gesamtbestand.
            *@
            <section class="tx-totals">
                <div class="tx-total">
                    <span class="label-muted">Einnahmen</span>
                    <span class="tx-total-value num income">@State.Euro(list.Totals.Income)</span>
                </div>
                <div class="tx-total">
                    <span class="label-muted">Ausgaben</span>
                    <span class="tx-total-value num">@State.Euro(list.Totals.Expense)</span>
                </div>
                <div class="tx-total">
                    <span class="label-muted">Saldo</span>
                    <span class="tx-total-value num">@Signed(list.Totals.Balance)</span>
                </div>
            </section>

            @if (list.Totals.TransferCount > 0)
            {
                <div class="tx-totals-note">
                    @list.Totals.TransferCount @(list.Totals.TransferCount == 1 ? "Umbuchung zählt" : "Umbuchungen zählen")
                    weder als Einnahme noch als Ausgabe.
                </div>
            }

            @*
                Gemeinschaftskonten — Handoff „Gemeinsame Immobilie“, 3.3. Beim Konto, weil der
                Block das Konto erklärt und nicht ersetzt: Soll gegen Eingang je Person, daneben
                der Jahresstand. Er mahnt nicht, er sagt, was steht.
            *@
            @foreach (var gemeinschaft in JointShown)
            {
                <div class="list-head">
                    <span class="label-strong">@gemeinschaft.Name · Gemeinschaft</span>
                    <span class="tag tag-outline">Gemeinschaftskonto</span>
                </div>

                <div class="joint-head">
                    <span class="stack">
                        <span class="meta">@Kopfzeile(gemeinschaft)</span>

                        @* Zweite Zeile, zweite Größe: der Abfluss ist nicht der Eingang und nicht die
                           Objektkosten — jede Zahl sagt, was sie ist. Wo nichts abgeht, fehlt sie:
                           drei Nullen sind keine Auskunft. *@
                        @if (Abflusszeile(gemeinschaft) is { Length: > 0 } abfluss)
                        {
                            <span class="meta">@abfluss</span>
                        }
                    </span>

                    @* Der Saldo kommt aus der Kontoliste, nicht aus einer zweiten Rechnung. *@
                    @if (Saldo(gemeinschaft.AccountId) is { } saldo)
                    {
                        <span class="balance-value num">@State.Euro(saldo)</span>
                    }
                </div>

                @foreach (var person in gemeinschaft.Contributors)
                {
                    <div class="row joint-row">
                        <span class="joint-name">@person.Name</span>

                        @* Kein Vorwurf, wo nichts vereinbart ist: „unter Soll“ ohne Soll hätte keine
                           Grundlage. Deshalb entscheidet der Stand über die Farbe, nicht der Betrag. *@
                        <span class="joint-state @(person.MonthlyTarget is not null && !person.Fulfilled ? "behind" : null)">
                            @Stand(person)
                        </span>

                        <span class="balance-value num joint-amount">@State.Euro(person.PaidThisMonth)</span>
                    </div>
                }

                <div class="tx-totals-note">
                    Einlagen zählen in die Beteiligungsrechnung — nicht in Einnahmen, Sparquote oder
                    Liquidität. Die App vergleicht Soll und Eingang; sie mahnt nicht.
                    @Jahreszeile(gemeinschaft)
                </div>
            }
        </aside>

        @* ── Buchungen ────────────────────────────────────────────────────────────────── *@
        <section class="ledger-list">
            <div class="ledger-head">
                <span class="ledger-title">Buchungen</span>
                <span class="list-count num">@list.FilteredCount von @list.TotalCount</span>
            </div>

            <div class="searchbar">
                <input class="input" type="search" placeholder="Buchungen durchsuchen" aria-label="Buchungen durchsuchen"
                       value="@search" @oninput="OnSearchInput" />
                @if (HasFilter)
                {
                    <button type="button" class="btn btn-secondary" @onclick="ResetFilter">Zurücksetzen</button>
                }
            </div>

            @* Filterchips: auf dem Telefon eine scrollende Reihe, ab Tablet umbrechend. Das Konto
               steht nicht mehr darunter — es wird in der ersten Spalte gewählt. *@
            <div class="filter-row">
                <button type="button" class="chip @(kindFilter is null && !onlyOpen ? "active" : null)"
                        @onclick="() => SetKind(null)">Alle Arten</button>
                <button type="button" class="chip @(kindFilter == TransactionKind.Income ? "active" : null)"
                        @onclick="() => SetKind(TransactionKind.Income)">Einnahmen</button>
                <button type="button" class="chip @(kindFilter == TransactionKind.Expense ? "active" : null)"
                        @onclick="() => SetKind(TransactionKind.Expense)">Ausgaben</button>
                <button type="button" class="chip @(kindFilter == TransactionKind.Transfer ? "active" : null)"
                        @onclick="() => SetKind(TransactionKind.Transfer)">Umbuchungen</button>
                <button type="button" class="chip @(onlyOpen ? "active" : null)"
                        @onclick="ToggleOnlyOpen">Ohne Kategorie</button>
            </div>

            @*
                Dreißig Kategorien sind drei Zeilen Knöpfe über jeder Liste — am eigenen Bestand
                gezählt. Eingeklappt sagt der Kopf, wonach gefiltert wird: ein zugeklappter Filter,
                der seinen Zustand verschweigt, nimmt der Liste Zeilen weg, ohne dass irgendwo
                stünde, warum.
            *@
            <div class="filter-fold">
                <button type="button" class="filter-fold-head" @onclick="ToggleCategories"
                        aria-expanded="@(categoriesOpen ? "true" : "false")">
                    <span class="filter-fold-label">Kategorie</span>
                    <span class="filter-fold-state @(categoryFilter is not null ? "set" : null)">
                        @CategoryFilterLabel
                    </span>
                    <span class="filter-fold-mark" aria-hidden="true">@(categoriesOpen ? "▴" : "▾")</span>
                </button>

                @if (categoriesOpen)
                {
                    <div class="filter-row">
                        <button type="button" class="chip @(categoryFilter is null ? "active" : null)"
                                @onclick="() => SetCategory(null)">Alle Kategorien</button>

                        @* Die Richtung steht nur an den doppelten Namen — sonst wäre sie
                           dreißigmal dieselbe Auskunft und ginge dort unter, wo sie zählt. *@
                        @foreach (var category in categories)
                        {
                            <button type="button" class="chip @(categoryFilter == category.Id ? "active" : null)"
                                    @onclick="() => SetCategory(category.Id)">
                                @CategoryChips.Label(category, categories)
                            </button>
                        }
                    </div>
                }
            </div>

            @if (list.FilteredUncategorizedCount > 0)
            {
                <AuthorizeView Roles="Owner,Member" Context="triage">
                    <div class="triage-wrap">
                        <button type="button" class="triage" @onclick="StartTriage">
                            <span class="stack">
                                <span class="triage-title">
                                    @list.FilteredUncategorizedCount
                                    @(list.FilteredUncategorizedCount == 1 ? "Buchung" : "Buchungen") ohne Kategorie
                                </span>
                                <span class="triage-sub">Jetzt zuordnen</span>
                            </span>
                            <span class="triage-arrow" aria-hidden="true">→</span>
                        </button>
                    </div>
                </AuthorizeView>
            }

            @if (selected.Count > 0)
            {
                <AuthorizeView Roles="Owner,Member" Context="auswahl">
                    <div class="tx-selection">
                        <span class="tx-selection-count">
                            @selected.Count @(selected.Count == 1 ? "Buchung" : "Buchungen") ausgewählt
                        </span>
                        <button type="button" class="btn btn-primary" @onclick="OpenBatchSheet">Kategorie zuweisen</button>

                        @if (confirmingBatchDelete)
                        {
                            <button type="button" class="btn btn-primary delete-confirm" @onclick="DeleteBatchAsync">
                                @selected.Count @(selected.Count == 1 ? "Buchung wird" : "Buchungen werden")
                                gelöscht — erneut tippen
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-secondary"
                                    @onclick="@(() => confirmingBatchDelete = true)">Löschen</button>
                        }

                        <button type="button" class="btn btn-secondary" @onclick="ClearSelection">Auswahl aufheben</button>
                    </div>
                </AuthorizeView>
            }

            @if (list.Items.Count == 0)
            {
                @* Nie eine leere Fläche: Ursache benennen, Ausweg anbieten. *@
                <div class="empty-area">
                    <span class="empty-area-title">Keine Buchung im gewählten Ausschnitt</span>
                    <span class="empty-area-text">@EmptyReason</span>
                    <div class="empty-area-actions">
                        <button type="button" class="btn btn-secondary" @onclick="ResetFilter">Filter zurücksetzen</button>
                    </div>
                </div>
            }
            else
            {
                <div class="tx-days">
                    @foreach (var tag in Days)
                    {
                        @*
                            Der Tageskopf trägt zwei Zahlen und sie sagen Verschiedenes: was an
                            diesem Tag zu- und abging, und wo das Konto danach stand. Der Stand
                            steht nur da, wenn er sich belegen lässt — ein Konto, kein weiterer
                            Filter. Sonst wäre es der Stand eines Kontos, das es nicht gibt.
                        *@
                        <div class="tx-day-head">
                            <span class="tx-day-date num">@GermanFormat.Date(tag.Date)</span>
                            <span class="tx-day-sum num">(@Signed(tag.Sum))</span>
                            @if (tag.Balance is { } stand)
                            {
                                <span class="tx-day-balance num">@State.Euro(stand)</span>
                            }
                        </div>

                        @foreach (var transaction in tag.Items)
                        {
                            <div class="tx-line @(selected.Contains(transaction.Id) ? "picked" : null) @(sheetTransaction?.Id == transaction.Id ? "shown" : null)">
                                <AuthorizeView Roles="Owner,Member" Context="zeile">
                                    <label class="tx-check">
                                        <input type="checkbox" checked="@selected.Contains(transaction.Id)"
                                               @onchange="e => Toggle(transaction.Id, e)"
                                               aria-label="@($"{transaction.Payee} wählen")" />
                                    </label>
                                </AuthorizeView>

                                <button type="button" class="tap tx-row" @onclick="() => OpenSheet(transaction)">
                                    <span class="tx-cell tx-cell-category">
                                        <span class="tag @TagClass(transaction)">@TagLabel(transaction)</span>
                                    </span>
                                    <span class="tx-main">
                                        <span class="tx-payee">@transaction.Payee</span>

                                        @*
                                            Der Verwendungszweck unter dem Empfänger, auf eine Zeile
                                            beschnitten: bei einer Kartenzahlung steht der Laden dort
                                            und sonst nirgends. Ganz steht er in den Details.
                                        *@
                                        @if (Subline(transaction) is { Length: > 0 } unterzeile)
                                        {
                                            <span class="tx-purpose">@unterzeile</span>
                                        }

                                        <span class="tx-tags">
                                            <span class="tag @TagClass(transaction)">@TagLabel(transaction)</span>
                                            <span class="tx-account">@transaction.AccountShortName</span>
                                        </span>
                                    </span>
                                    <span class="tx-cell tx-cell-account">@transaction.AccountShortName</span>
                                    <span class="tx-amount num @(transaction.Amount > 0 ? "income" : null)">
                                        @State.Euro(transaction.Amount, withPlusSign: true)
                                    </span>
                                </button>
                            </div>
                        }
                    }
                </div>
            }

            <div class="spacer"></div>
        </section>

        @* ── Die gewählte Buchung ─────────────────────────────────────────────────────── *@
        <TransactionDetail Transaction="sheetTransaction"
                           Categories="categories"
                           Contributors="ContributorsOf(sheetTransaction)"
                           OnPickCategory="AssignShown"
                           OnPickTransfer="TransferShown"
                           OnPickDeposit="DepositShownAsync"
                           OnDelete="DeleteSingleAsync"
                           OnClose="CloseSheet" />
    </div>
</AsyncView>

@if (batchOpen)
{
    <CategorySheet BatchCount="selected.Count"
                   BatchAmount="SelectedAmount"
                   Categories="categories"
                   OnPickCategory="AssignBatch"
                   OnPickTransfer="MarkBatchTransfer"
                   OnConfirm="@(_ => CloseBatch())"
                   OnClose="CloseBatch" />
}
else if (sheetTransaction is { } sheet)
{
    @*
        Dasselbe Ziel wie die Detailspalte, auf schmalem Schirm. Beide gleichzeitig wären zwei
        Fenster auf dieselbe Buchung; welches gilt, entscheidet die Breite und nicht der Code.
    *@
    <div class="sheet-narrow">
    <CategorySheet Transaction="sheet"
                   Categories="SheetCategories(sheet)"
                   @bind-RememberRule="rememberRule"
                   OnPickCategory="PickCategory"
                   OnPickTransfer="PickTransfer"
                   OnConfirm="ConfirmSheet"
                   OnClose="CloseSheet"
                   OnDelete="DeleteSingleAsync"
                   OnSplit="@(() => Toasts.Show("Split-Buchung folgt"))" />
    </div>
}

@code {
    private static readonly TransactionTotalsDto NoTotals = new()
    {
        Income = 0m, Expense = 0m, Balance = 0m, TransferCount = 0,
    };

    private static readonly TransactionPageDto Empty = new()
    {
        Items = [], FilteredCount = 0, TotalCount = 0,
        UncategorizedCount = 0, FilteredUncategorizedCount = 0, Totals = NoTotals,
    };

    private TransactionPageDto list = Empty;
    private IReadOnlyList<AccountDto> accounts = [];
    private IReadOnlyList<CategoryDto> categories = [];
    private TransactionDto? sheetTransaction;

    /// <summary>Ob die nächste Zuordnung eine Regel hinterlässt. Je Buchung zurückgesetzt.</summary>
    private bool rememberRule = true;

    private readonly HashSet<int> selected = [];
    private bool batchOpen;
    private bool confirmingBatchDelete;

    /// <summary>Ob die Kategorienzeile aufgeklappt ist.</summary>
    private bool categoriesOpen;

    // ── Der Bankabruf ─────────────────────────────────────────────────────────────────────
    //
    // Keines dieser Felder überlebt den Seitenwechsel. Die PIN steht hier, solange sie
    // getippt wird, und wird danach gelöscht — nicht weil das sicher wäre, sondern weil sie
    // nirgends länger stehen soll als nötig. Gespeichert wird sie an keiner Stelle.

    /// <summary>Welches Konto gerade abgefragt wird. <c>null</c> heisst: keines.</summary>
    private int? bankAccountId;

    private string bankPin = string.Empty;
    private bool bankBusy;
    private IReadOnlyList<string> bankProblems = [];
    private string? bankError;

    // ── Abgleich ──────────────────────────────────────────────────────────────────────────

    /// <summary>Welches Konto gerade abgeglichen wird. <c>null</c> heisst: keines.</summary>
    private int? reconcileAccountId;

    private DateOnly reconcileAsOf = DateOnly.FromDateTime(DateTime.Today);
    /// <summary>
    /// Der Stand, den der Benutzer vom Auszug abliest.
    /// </summary>
    /// <remarks>
    /// <b>Leer, nicht vorbelegt.</b> Hier stand einmal der gerechnete Stand des Kontos — und
    /// damit war der Abgleich keiner mehr: Die bequemste Handlung war, die Zahl zu bestätigen,
    /// die die Anwendung ohnehin glaubt. Am 12.11.2026 genau so passiert; der Punkt meldete
    /// „Stand bestätigt“, während die Bank etwas anderes sagte. Eine Prüfung, die nur sich
    /// selbst bestätigen kann, prüft nichts.
    /// </remarks>
    private decimal? reconcileBalance;
    private string reconcileNote = string.Empty;
    private bool reconcileBusy;
    private string? reconcileError;
    private IReadOnlyList<BalanceCheckpointDto> reconcilePoints = [];

    /// <summary>
    /// Öffnet den Abgleich und legt den gerechneten Stand als Vorschlag hinein.
    /// </summary>
    /// <remarks>
    /// Vorbelegt mit dem, was die Anwendung rechnet, und nicht mit null: Stimmen beide Zahlen
    /// ohnehin, soll das Eintragen ein Druck auf eine Schaltfläche sein. Weicht es ab, ist die
    /// Zahl im Feld genau die, die überschrieben gehört.
    /// </remarks>
    private async Task OpenReconcile(AccountDto konto)
    {
        reconcileAccountId = konto.Id;
        reconcileAsOf = DateOnly.FromDateTime(DateTime.Today);
        reconcileBalance = null;
        reconcileNote = string.Empty;
        reconcileError = null;
        reconcilePoints = [];

        try
        {
            reconcilePoints = await Api.GetBalanceCheckpointsAsync(konto.Id);
        }
        catch (ApiException ex)
        {
            reconcileError = ex.Message;
        }
    }

    private void CloseReconcile()
    {
        reconcileAccountId = null;
        reconcileNote = string.Empty;
        reconcileError = null;
        reconcilePoints = [];
    }

    /// <summary>Trägt den eingetippten Stand ein.</summary>
    private Task SaveReconcile(int accountId)
    {
        // Ohne Zahl kein Punkt. Eine leere Eingabe als Null zu buchen wäre die schlimmste
        // Auslegung: Sie setzte das Konto auf null und sähe dabei aus wie ein Abgleich.
        if (reconcileBalance is not { } stand)
        {
            reconcileError = "Bitte den Stand eintragen, der laut Auszug an diesem Tag auf "
                             + "dem Konto war.";
            return Task.CompletedTask;
        }

        return WriteReconcileAsync(accountId, new BalanceCheckpointRequest
        {
            AsOf = reconcileAsOf,
            Balance = stand,
            Source = BalanceCheckpointSource.Manual,
            Note = reconcileNote,
        });
    }

    /// <summary>
    /// Übernimmt die Zahl aus der Saldenabfrage.
    /// </summary>
    /// <remarks>
    /// Der Stichtag ist heute und nicht der Buchungstag der Bank: Den nennt sie zwar, aber die
    /// verwendete Bibliothek reicht ihn nicht durch. Ein anderes Datum hier wäre erfunden.
    /// </remarks>
    private async Task WriteReconcileAsync(int accountId, BalanceCheckpointRequest anfrage)
    {
        reconcileBusy = true;
        reconcileError = null;

        try
        {
            var punkt = await Api.AddBalanceCheckpointAsync(accountId, anfrage);

            Toasts.Show(punkt.WasAligned
                ? "Stand bestätigt — beide Zahlen stimmten schon überein."
                : $"Stand eingetragen. Unterschied: {Signed(punkt.Difference)}.");

            CloseReconcile();
            CloseBankCheck();

            // Neu laden, nicht nachrechnen: Der Saldo entsteht auf dem Server, und eine zweite
            // Rechnung hier wäre die zweite Wahrheit, die es gerade zu vermeiden gilt.
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            reconcileError = ex.Message;
        }
        finally
        {
            reconcileBusy = false;
        }
    }

    /// <summary>Nimmt einen Kontrollpunkt zurück.</summary>
    private async Task DropReconcile(int accountId, int checkpointId)
    {
        reconcileBusy = true;
        reconcileError = null;

        try
        {
            await Api.DeleteBalanceCheckpointAsync(accountId, checkpointId);
            reconcilePoints = await Api.GetBalanceCheckpointsAsync(accountId);

            Toasts.Show("Kontrollpunkt zurückgenommen.");
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            reconcileError = ex.Message;
        }
        finally
        {
            reconcileBusy = false;
        }
    }

    /// <summary>Woher ein Kontrollpunkt stammt, in einem Wort.</summary>
    private static string SourceLabel(BalanceCheckpointSource herkunft) => herkunft switch
    {
        BalanceCheckpointSource.BankFetch => "Abfrage",
        BalanceCheckpointSource.Statement => "Auszug",
        _ => "von Hand",
    };

    /// <summary>
    /// Öffnet den Abruf und fragt zuerst, ob er überhaupt geht.
    /// </summary>
    /// <remarks>
    /// Vor der PIN, nicht danach. Wer die FinTS-Adresse noch gar nicht eingetragen hat, soll
    /// nicht erst seine PIN tippen, um dann zu erfahren, dass es daran nicht lag.
    /// </remarks>
    private async Task OpenBankCheck(int accountId)
    {
        bankAccountId = accountId;
        bankPin = string.Empty;
        bankProblems = [];
        bankError = null;
        bankBusy = true;

        try
        {
            bankProblems = await Api.GetBankAccessProblemsAsync(accountId);
        }
        catch (ApiException ex)
        {
            Toasts.Show(ex.Message, ToastKind.Problem);
            bankAccountId = null;
        }
        finally
        {
            bankBusy = false;
        }
    }

    /// <summary>Schliesst den Abruf und löscht die PIN aus dem Speicher der Seite.</summary>
    private void CloseBankCheck()
    {
        bankAccountId = null;
        bankPin = string.Empty;
        bankProblems = [];
        bankError = null;
    }

    /// <summary>Die Eingabetaste fragt ab — wie in jedem anderen Anmeldefeld auch.</summary>
    private async Task BankPinKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !bankBusy && !string.IsNullOrWhiteSpace(bankPin))
        {
            await RunStatementFetch();
        }
    }

    /// <summary>
    /// Holt die Umsätze und übergibt sie der Importvorschau.
    /// </summary>
    /// <remarks>
    /// <para>Der Abruf bucht nichts. Er endet in derselben Vorschau wie eine hochgeladene
    /// Datei: Was die Anwendung schon kennt, steht dort abgewählt und mit Begründung, das Neue
    /// angehakt. Gebucht wird auf der Importseite, mit einem Klick auf Übernehmen.</para>
    /// <para>Daher der Seitenwechsel, statt hier eine zweite Liste aufzubauen: Eine Vorschau
    /// kann dreihundert Sätze lang sein und braucht Kategorien, Empfängergruppen und die Wahl
    /// je Zeile. Das ist die Importseite — und sie nimmt einen begonnenen Entwurf von selbst
    /// auf. Der Abruf legt ihn nur hin.</para>
    /// <para><b>Der Stand kommt mit.</b> Der Auszug der Bank nennt seinen Schlusssaldo und
    /// den Tag dazu; das Kästchen auf der Importseite steht deshalb nach einem Abruf von
    /// vornherein an. Bei einer hochgeladenen Datei bleibt es aus — dort weiß niemand, ob
    /// der Auszug der neueste ist.</para>
    /// </remarks>
    private async Task RunStatementFetch()
    {
        if (bankAccountId is not { } id || string.IsNullOrWhiteSpace(bankPin))
        {
            return;
        }

        bankBusy = true;
        bankError = null;

        try
        {
            var vorschau = await Api.FetchBankStatementAsync(id, bankPin);

            // Ein leerer Auszug ist kein Fehler, aber auch kein Grund zum Seitenwechsel: Die
            // Importseite zeigte eine leere Liste, und warum sie leer ist, stünde nirgends.
            if (vorschau.RecordCount == 0)
            {
                Toasts.Show("Die Bank hat für den Zeitraum keine Umsätze gemeldet.");
                return;
            }

            Draft.Start(vorschau);

            // Das Konto ist hier bekannt und kein Vorschlag: Genau dieses wurde gefragt.
            Draft.AccountId = id;

            // Nach Draft.Start, nicht davor: Start räumt den Entwurf auf und setzt das
            // Kästchen dabei zurück.
            Draft.AdoptBalance = true;

            // Eine Teilaussage, keine Zerlegung. „Davon neu“ ist die Zahl, nach der gefragt
            // wird; mögliche Duplikate und unlesbare Sätze stehen auf der Importseite, wo auch
            // das Kriterium dazu steht.
            Toasts.Show($"{vorschau.RecordCount} "
                        + $"{(vorschau.RecordCount == 1 ? "Umsatz" : "Umsätze")} geholt, "
                        + $"davon {vorschau.NewCount} neu.");

            Navigation.NavigateTo("/import");
        }
        catch (ApiException ex)
        {
            bankError = ex.Message;
        }
        finally
        {
            bankPin = string.Empty;
            bankBusy = false;
        }
    }

    private string search = string.Empty;
    private int? accountFilter;
    private int? categoryFilter;
    private TransactionKind? kindFilter;
    private bool onlyOpen;
    private CancellationTokenSource? searchDebounce;

    /// <summary>
    /// Vorgewählte Kategorie aus der Adresse — <c>/konten?category=5</c>.
    /// </summary>
    /// <remarks>
    /// Damit führt „In Buchungen zeigen“ aus einer Auswertung wirklich zu den Buchungen
    /// dieser Kategorie und nicht nur auf die Liste. Ein Sprungziel, das den Filter nicht
    /// mitbringt, ist ein Link, der so tut, als würde er etwas auswählen.
    /// </remarks>
    [SupplyParameterFromQuery(Name = "category")]
    public int? CategoryFromQuery { get; set; }

    /// <summary>
    /// Nur Buchungen ohne Kategorie — <c>/konten?offen=true</c>.
    /// </summary>
    /// <remarks>
    /// Bewusst als Zeichenkette und nicht als <c>bool?</c>. Blazor wirft beim Umwandeln, und
    /// zwar nicht als Feldfehler, sondern als unbehandelte Ausnahme beim Rendern: die ganze
    /// Seite steht dann auf „Es ist ein Fehler aufgetreten“. Ein Abfrageparameter kommt aus
    /// einer Adresszeile — aus einem Lesezeichen, einer Verknüpfung, einem Tippfehler — und
    /// darf die Seite unter keinen Umständen umbringen. Was nicht „an“ heißt, heißt aus.
    /// </remarks>
    [SupplyParameterFromQuery(Name = "offen")]
    public string? OpenFromQuery { get; set; }

    private bool HasFilter => !string.IsNullOrWhiteSpace(search)
                              || accountFilter is not null || categoryFilter is not null
                              || kindFilter is not null || onlyOpen;

    /// <summary>
    /// Ein Filter <em>außer</em> dem Konto.
    /// </summary>
    /// <remarks>
    /// Die Unterscheidung trägt den Tagesstand: das Konto zu wählen lässt seine Buchungen
    /// vollständig stehen, jeder andere Filter nimmt welche heraus. Zurückgerechnet werden darf
    /// nur über eine vollständige Liste.
    /// </remarks>
    private bool HasOtherFilter => !string.IsNullOrWhiteSpace(search)
                                   || categoryFilter is not null
                                   || kindFilter is not null || onlyOpen;

    /// <summary>Das gewählte Konto — <c>null</c> bei „Alle Konten“.</summary>
    private AccountDto? PickedAccount
        => accountFilter is { } id ? accounts.FirstOrDefault(a => a.Id == id) : null;

    private decimal AccountTotal => accounts.Sum(a => a.Balance);

    /// <summary>
    /// Die Buchungen tagweise, mit Tagessumme und — wo sie trägt — dem Stand des Kontos.
    /// </summary>
    private IReadOnlyList<BookingDay> Days
        => BookingDays.Group(list.Items, BookingDays.StartBalance(PickedAccount, HasOtherFilter, skip: 0));

    /// <summary>Die Gemeinschaftsblöcke zum gewählten Konto, sonst alle.</summary>
    private IEnumerable<JointAccountDto> JointShown
        => accountFilter is { } id ? joint.Where(j => j.AccountId == id) : joint;

    private bool AllSelected => list.Items.Count > 0 && list.Items.All(t => selected.Contains(t.Id));

    private decimal SelectedAmount => list.Items.Where(t => selected.Contains(t.Id)).Sum(t => t.Amount);

    private IReadOnlyList<JointAccountDto> joint = [];

    /// <summary>
    /// Soll und Eingang des Monats in einer Zeile.
    /// </summary>
    /// <remarks>
    /// Beide Größen nebeneinander, jede benannt: „Soll“ ist vereinbart, „Eingang“ ist gebucht.
    /// Ohne vereinbartes Soll bleibt der Eingang allein — verglichen wird nur, was verglichen
    /// werden kann.
    /// </remarks>
    private string Kopfzeile(JointAccountDto konto)
    {
        var eingang = "Eingang " + State.Euro0(konto.PaidTotal);

        return konto.HasTargets
            ? $"Soll {State.Euro0(konto.TargetTotal)}/Monat · {eingang}"
            : $"{eingang} · kein Soll vereinbart";
    }

    /// <summary>
    /// Der Abfluss des Monats und sein objektbezogener Teil.
    /// </summary>
    /// <remarks>
    /// Getrennt vom Eingang, weil es eine andere Größe ist: das Konto zahlt mehr aus, als die
    /// Beteiligten einzahlen, wenn es einen Bestand hat. Und getrennt von den Objektkosten — eine
    /// Rücklage zählt dort mit und verlässt das Konto nicht.
    /// </remarks>
    private string Abflusszeile(JointAccountDto konto)
    {
        if (konto.Outflow == 0m)
        {
            return string.Empty;
        }

        var abfluss = "Abfluss " + State.Euro0(konto.Outflow);

        if (!konto.HasPropertyRelatedCategories)
        {
            return abfluss + " · keine Kategorie ist als objektbezogen gekennzeichnet";
        }

        return $"{abfluss} · davon objektbezogen {State.Euro0(konto.OutflowPropertyRelated)}"
               + $", übrige gemeinsame {State.Euro0(konto.OutflowOther)}";
    }

    /// <summary>
    /// Wie diese Person im Monat steht — und wann sie gezahlt hat.
    /// </summary>
    /// <remarks>
    /// Die Abweichung steht im Klartext, weil eine Zahl allein nicht sagt, ob sie gut ist. Der
    /// Termin steht daneben: „erfüllt“ ohne Datum sagt nicht, ob es rechtzeitig war.
    /// </remarks>
    private string Stand(JointContributorDto person)
    {
        var termin = person.LastPaidOn is { } tag
            ? " · " + GermanFormat.DateShort(tag) + "."
            : string.Empty;

        if (person.MonthlyTarget is not { } soll)
        {
            return person.LastPaidOn is null
                ? "kein Soll vereinbart"
                : "eingezahlt" + termin;
        }

        var abweichung = person.Difference ?? 0m;

        var stand = abweichung == 0m
            ? "Soll erfüllt"
            : abweichung > 0m
                ? State.Euro0(abweichung) + " über Soll"
                : State.Euro0(-abweichung) + " unter Soll";

        // Ohne Eingang gibt es keinen Termin, aber den vereinbarten Tag — das ist die Auskunft,
        // die dann weiterhilft.
        if (person.LastPaidOn is null)
        {
            return person.DueDay is { } fällig
                ? stand + " · vereinbart zum " + fällig + "."
                : stand;
        }

        return stand + termin;
    }

    /// <summary>Der Jahresstand als Satz — ein einzelner Monat sagt wenig.</summary>
    /// <remarks>
    /// Wer im Mai zweimal gezahlt hat, steht im Juni scheinbar im Rückstand. Der Jahresstand
    /// steht deshalb daneben und nicht anstelle des Monats.
    /// </remarks>
    private string Jahreszeile(JointAccountDto konto)
        => $"In diesem Jahr {State.Euro0(konto.PaidThisYear)} eingezahlt.";

    /// <summary>
    /// Der Kontostand aus der Kontoliste.
    /// </summary>
    /// <remarks>
    /// Nicht neu gerechnet: dieselbe Größe zweimal zu rechnen ist der Fehler, den dieser Handoff
    /// über fünf Runden gejagt hat. <c>null</c>, wenn das Konto nicht in der Liste steht.
    /// </remarks>
    private decimal? Saldo(int accountId)
        => accounts.FirstOrDefault(a => a.Id == accountId)?.Balance;

    protected override async Task LoadAsync()
    {
        // Die Adresse setzt den Filter, bevor die Liste zum ersten Mal geholt wird — sonst
        // erschiene kurz die ungefilterte und spränge danach um.
        categoryFilter = CategoryFromQuery;
        onlyOpen = OpenFromQuery is "true" or "1" or "";

        // Wer über „In Buchungen zeigen“ hereinkommt, trägt den Filter schon mit. Zugeklappt
        // stünde er als Wort da, aber ohne die Nachbarn, zwischen denen er gewählt wurde.
        categoriesOpen = CategoryFromQuery is not null;

        accounts = await Api.GetAccountsAsync();
        categories = await Api.GetCategoriesAsync();
        joint = await Api.GetJointAccountsAsync();
        await ReloadListAsync();
    }

    private async Task ReloadListAsync(CancellationToken ct = default)
    {
        list = await Api.GetTransactionsAsync(search, accountFilter, categoryFilter, kindFilter, onlyOpen, ct);

        // Eine Auswahl, die der Filter nicht mehr zeigt, ist keine Auswahl mehr — sonst beträfe
        // die Stapelvergabe Zeilen, die niemand vor sich hat.
        selected.IntersectWith(list.Items.Select(t => t.Id));
    }

    private string EmptyReason
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(search))
            {
                return $"Die Suche nach „{search}“ trifft nichts im übrigen Ausschnitt.";
            }

            if (onlyOpen)
            {
                return "Im gewählten Ausschnitt ist alles kategorisiert.";
            }

            return HasFilter
                ? "Der gewählte Filter lässt nichts übrig."
                : "Es ist noch keine Buchung erfasst.";
        }
    }

    /// <summary>Der Saldo trägt sein Vorzeichen — die Null aber nicht.</summary>
    private static string Signed(decimal value)
        => value == 0m ? GermanFormat.Euro(0m) : GermanFormat.Euro(value, withPlusSign: true);

    /// <summary>
    /// Die Suche läuft auf dem Server. Ein kurzer Aufschub bündelt die Tastenanschläge zu
    /// einer Anfrage, statt bei jedem Zeichen eine zu stellen.
    /// </summary>
    private async Task OnSearchInput(ChangeEventArgs e)
    {
        search = e.Value?.ToString() ?? string.Empty;

        searchDebounce?.Cancel();
        searchDebounce?.Dispose();
        searchDebounce = new CancellationTokenSource();
        var token = searchDebounce.Token;

        try
        {
            await Task.Delay(250, token);
            await ReloadListAsync(token);
            StateHasChanged();
        }
        catch (OperationCanceledException)
        {
            // Ein neuer Tastenanschlag hat diese Anfrage überholt.
        }
        catch (ApiException ex)
        {
            Toasts.Show(ex.Message, ToastKind.Problem);
        }
    }

    private void ToggleCategories() => categoriesOpen = !categoriesOpen;

    /// <summary>
    /// Was der zugeklappte Kopf über den Kategorienfilter sagt.
    /// </summary>
    /// <remarks>
    /// „Alle“ heißt: diese Zeile nimmt der Liste nichts weg. Steht hier ein Name, fehlen Zeilen,
    /// und dann gehört der Name dorthin, auch wenn die Knöpfe zugeklappt sind. Eine Kategorie,
    /// die es nicht mehr gibt — aus einem alten Lesezeichen — wird benannt und nicht verschwiegen.
    /// </remarks>
    private string CategoryFilterLabel
        => categoryFilter switch
        {
            null => "Alle",
            { } id when categories.FirstOrDefault(c => c.Id == id) is { } gewaehlt
                => CategoryChips.Label(gewaehlt, categories),
            _ => "Unbekannte Kategorie",
        };

    private Task SetAccount(int? id) => Filter(() => accountFilter = id);

    private Task SetCategory(int? id) => Filter(() => categoryFilter = id);

    private Task SetKind(TransactionKind? kind) => Filter(() =>
    {
        kindFilter = kind;
        onlyOpen = false;
    });

    private Task ToggleOnlyOpen() => Filter(() =>
    {
        onlyOpen = !onlyOpen;
        kindFilter = null;
    });

    private Task ResetFilter() => Filter(() =>
    {
        search = string.Empty;
        accountFilter = null;
        categoryFilter = null;
        kindFilter = null;
        onlyOpen = false;
    });

    private Task Filter(Action change) => RunAsync(async () =>
    {
        searchDebounce?.Cancel();
        change();
        await ReloadListAsync();
    });

    // ── Auswahl und Stapelvergabe ──────────────────────────────────────────────────────────

    private void Toggle(int id, ChangeEventArgs e)
    {
        if (e.Value is true)
        {
            selected.Add(id);
        }
        else
        {
            selected.Remove(id);
        }
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        selected.Clear();
        if (e.Value is true)
        {
            foreach (var transaction in list.Items)
            {
                selected.Add(transaction.Id);
            }
        }
    }

    private void ClearSelection()
    {
        selected.Clear();
        confirmingBatchDelete = false;
    }

    private Task DeleteBatchAsync() => RunAsync(async () =>
    {
        var count = await Api.DeleteTransactionsAsync([.. selected]);

        Toasts.Show(count == 1 ? "1 Buchung gelöscht" : $"{count} Buchungen gelöscht", ToastKind.Saved);
        ClearSelection();
        await ReloadListAsync();
    });

    private Task DeleteSingleAsync() => RunAsync(async () =>
    {
        var transaction = sheetTransaction;
        if (transaction is null)
        {
            return;
        }

        await Api.DeleteTransactionAsync(transaction.Id);
        CloseSheet();
        Toasts.Show("Buchung gelöscht", ToastKind.Saved);
        await ReloadListAsync();
    });

    /// <summary>
    /// „Kategorie zuweisen“ öffnet das Panel und schreibt nicht direkt — die Wahl gehört dorthin,
    /// wo auch steht, was die Vergabe nicht anfassen wird.
    /// </summary>
    private void OpenBatchSheet() => batchOpen = true;

    private void CloseBatch()
    {
        batchOpen = false;
        selected.Clear();
    }

    private Task AssignBatch(CategoryDto category) => RunAsync(async () =>
    {
        var result = await Api.AssignCategoryBatchAsync(new BatchAssignRequest
        {
            TransactionIds = [.. selected],
            CategoryId = category.Id,
        });

        Toasts.Show(result.Message, ToastKind.Saved);
        await ReloadListAsync();
        CloseBatch();
    });

    private Task MarkBatchTransfer() => RunAsync(async () =>
    {
        var result = await Api.AssignCategoryBatchAsync(new BatchAssignRequest
        {
            TransactionIds = [.. selected],
            MarkAsTransfer = true,
        });

        Toasts.Show(result.Message, ToastKind.Saved);
        await ReloadListAsync();
        CloseBatch();
    });

    // ── Einzelbuchung ──────────────────────────────────────────────────────────────────────

    /// <summary>
    /// Öffnet das Sheet auf einer Buchung.
    /// </summary>
    /// <remarks>
    /// Der Regelschalter geht dabei auf die Vorgabe zurück. Ließe man ihn stehen, hörte das
    /// Merken nach dem ersten Abwählen für alle folgenden Buchungen stillschweigend auf — und
    /// beim Weiterschalten fällt das niemandem auf, weil man den Schalter gar nicht mehr ansieht.
    /// </remarks>
    private void OpenSheet(TransactionDto transaction)
    {
        sheetTransaction = transaction;
        rememberRule = true;
    }

    private void CloseSheet() => sheetTransaction = null;

    private void StartTriage()
    {
        var erste = list.Items.FirstOrDefault(t => t.IsUncategorized) ?? list.Items.FirstOrDefault();

        if (erste is not null)
        {
            OpenSheet(erste);
        }
    }

    /// <summary>
    /// Nach dem Zuordnen weiter zur nächsten Buchung der Liste.
    /// </summary>
    /// <remarks>
    /// <para>Der nächsten <em>dieser</em> Liste — nicht der nächsten unzugeordneten irgendwo.
    /// Was das Sheet als Nächstes zeigt, steht damit sichtbar dahinter, und der Filter „nur
    /// offene“ macht aus dem Durchgang genau den Aufräumlauf, für den er gedacht ist.</para>
    /// <para>Die zugeordnete Buchung bleibt an ihrem Platz in der Liste, statt zu verschwinden:
    /// dadurch ist „die nächste“ eindeutig, auch wenn der Filter sie eigentlich nicht mehr
    /// zeigen dürfte. Ausgeräumt wird beim nächsten Laden.</para>
    /// </remarks>
    private void Advance()
    {
        var stelle = sheetTransaction is null ? -1 : IndexOf(sheetTransaction.Id);

        if (stelle >= 0 && stelle + 1 < list.Items.Count)
        {
            OpenSheet(list.Items[stelle + 1]);
            return;
        }

        CloseSheet();

        // Nur melden, wenn es wirklich die letzte war. Steht die Buchung gar nicht mehr in der
        // Liste, wäre „das war die letzte“ eine Auskunft über etwas anderes.
        if (stelle >= 0)
        {
            Toasts.Show("Das war die letzte Buchung der Liste");
        }
    }

    private int IndexOf(int transactionId)
    {
        for (var i = 0; i < list.Items.Count; i++)
        {
            if (list.Items[i].Id == transactionId)
            {
                return i;
            }
        }

        return -1;
    }

    /// <summary>Kategorien passend zum Vorzeichen der Buchung.</summary>
    private IReadOnlyList<CategoryDto> SheetCategories(TransactionDto transaction)
    {
        var direction = transaction.Amount > 0 ? CategoryDirection.Income : CategoryDirection.Expense;
        return [.. categories.Where(c => c.Direction == direction)];
    }

    /// <summary>
    /// Ein Tipp auf einen Chip ordnet zu, merkt bei Bedarf die Regel und schaltet weiter.
    /// </summary>
    /// <remarks>
    /// Die Regel entsteht hier und nicht mehr erst mit „Fertig“: seit das Sheet weiterschaltet,
    /// kommt niemand mehr an „Fertig“ vorbei, und ein Schalter, der nichts bewirkt, wäre
    /// schlimmer als keiner.
    /// </remarks>
    private Task PickCategory(CategoryDto category) => AssignAsync(category, advance: true);

    /// <summary>
    /// Zuordnen aus der Detailspalte — ohne Weiterschalten.
    /// </summary>
    /// <remarks>
    /// Im Sheet ist das Weiterschalten der Sinn der Sache: man räumt einen Stapel ab. In der
    /// Spalte hat man <em>diese</em> Buchung aufgeschlagen; spränge sie nach der Zuordnung zur
    /// nächsten, wäre die, die man gerade angesehen hat, weg.
    /// </remarks>
    private Task AssignShown(CategoryDto category) => AssignAsync(category, advance: false);

    private Task AssignAsync(CategoryDto category, bool advance) => RunAsync(async () =>
    {
        var empfaenger = sheetTransaction!.Payee;

        // Eine Regel entsteht nur aus dem Sheet: dort steht der Schalter dafür und der Nutzer
        // hat ihn vor sich. Die Spalte ordnet die eine Buchung zu und sonst nichts.
        var regel = advance && rememberRule;

        var updated = await Api.AssignCategoryAsync(
            sheetTransaction.Id,
            new AssignCategoryRequest { CategoryId = category.Id, CreateRule = regel });

        Apply(updated);

        Toasts.Show(regel
            ? $"{category.Name} zugeordnet · Regel für „{Categorization.RulePatternFor(empfaenger)}“ gemerkt"
            : category.Name + " zugeordnet", ToastKind.Saved);

        if (advance)
        {
            Advance();
        }
    });

    /// <summary>
    /// Wer auf das Konto dieser Buchung einzahlt — leer, wenn es kein Gemeinschaftskonto ist.
    /// </summary>
    private IReadOnlyList<JointContributorDto> ContributorsOf(TransactionDto? buchung)
        => buchung is null
            ? []
            : joint.FirstOrDefault(j => j.AccountId == buchung.AccountId)?.Contributors ?? [];

    /// <summary>
    /// Macht aus der gezeigten Buchung eine Einlage.
    /// </summary>
    /// <remarks>
    /// Das Objekt bestimmt der Server, solange die Person an genau einem beteiligt ist. Es hier
    /// zu raten hieße, eine Zurechnung zu erfinden, die der Ausgleichsstand dann trägt.
    /// </remarks>
    private Task DepositShownAsync(int userId) => RunAsync(async () =>
    {
        var updated = await Api.AssignCategoryAsync(
            sheetTransaction!.Id,
            new AssignCategoryRequest { MarkAsDeposit = true, DepositUserId = userId });

        Apply(updated);
        await ReloadAsync();
        Toasts.Show("Als Einlage markiert", ToastKind.Saved);
    });

    /// <summary>Eine Umbuchung ist keine Kategorie — hier entsteht darum auch keine Regel.</summary>
    private Task PickTransfer() => TransferAsync(advance: true);

    private Task TransferShown() => TransferAsync(advance: false);

    private Task TransferAsync(bool advance) => RunAsync(async () =>
    {
        var updated = await Api.AssignCategoryAsync(
            sheetTransaction!.Id, new AssignCategoryRequest { MarkAsTransfer = true });

        Apply(updated);
        Toasts.Show("Als Umbuchung markiert", ToastKind.Saved);

        if (advance)
        {
            Advance();
        }
    });

    /// <summary>
    /// „Fertig“ — schließt das Sheet.
    /// </summary>
    /// <remarks>
    /// Die Regel legt es nur noch für den Fall an, dass gar nicht zugeordnet wurde: eine
    /// Buchung, die schon eine Kategorie trägt, und der Wunsch, sie künftig automatisch zu
    /// setzen. Beim Zuordnen selbst ist die Regel längst entstanden; ein zweiter Aufruf
    /// überschriebe sie nur mit demselben Wert.
    /// </remarks>
    private async Task ConfirmSheet(bool rememberRule)
    {
        var transaction = sheetTransaction;
        if (rememberRule && transaction?.CategoryId is { } categoryId)
        {
            await RunAsync(async () =>
            {
                var updated = await Api.AssignCategoryAsync(
                    transaction.Id, new AssignCategoryRequest { CategoryId = categoryId, CreateRule = true });

                Apply(updated);
                Toasts.Show(
                    "Regel für „" + Categorization.RulePatternFor(transaction.Payee) + "“ gemerkt",
                    ToastKind.Saved);
            });
        }

        CloseSheet();
    }

    /// <summary>Übernimmt die geänderte Buchung in Liste und Sheet, ohne alles neu zu laden.</summary>
    private void Apply(TransactionDto updated)
    {
        // Die Zähler werden fortgeschrieben statt neu gezählt — der eine gilt für den Bestand,
        // der andere für den Ausschnitt, und beide verschieben sich um dasselbe.
        var before = list.Items.FirstOrDefault(t => t.Id == updated.Id)?.IsUncategorized ?? false;
        var delta = (updated.IsUncategorized ? 1 : 0) - (before ? 1 : 0);

        list = list with
        {
            Items = [.. list.Items.Select(t => t.Id == updated.Id ? updated : t)],
            UncategorizedCount = Math.Max(0, list.UncategorizedCount + delta),
            FilteredUncategorizedCount = Math.Max(0, list.FilteredUncategorizedCount + delta),
        };

        sheetTransaction = updated;
    }

    private static string AccountSubtitle(AccountDto account)
    {
        var parts = new List<string>();

        if (account.Iban is { Length: > 0 } iban)
        {
            parts.Add(iban);
        }
        else
        {
            if (account.InterestRatePercent is { } rate)
            {
                parts.Add(GermanFormat.Percent(rate, 2));
            }

            if (account.InterestYearToDate is { } interest)
            {
                parts.Add("Zinsen " + GermanFormat.Euro(interest) + " YTD");
            }
        }

        if (SharingLabel(account) is { Length: > 0 } freigabe)
        {
            parts.Add(freigabe);
        }

        return string.Join(" · ", parts);
    }

    /// <summary>
    /// Der Freigabe-Tag — <b>perspektivisch</b>, nie der Rohwert.
    /// </summary>
    /// <remarks>
    /// Dasselbe Konto heißt für den Eigentümer „geteilt mit Sabine“ und für Sabine „geteilt von
    /// Oliver“. „Named“ hinzuschreiben wäre für beide gleich nichtssagend, und „Nur ich“ an einem
    /// fremden Konto wäre schlicht falsch — wer es liest, ist ja nicht gemeint.
    ///
    /// Ein Konto ohne Eigentümer trägt keinen Tag: es gehört niemandem und steht allen offen.
    /// </remarks>
    private static string? SharingLabel(AccountDto account)
    {
        if (account.OwnerUserId is null)
        {
            return null;
        }

        if (!account.IsMine)
        {
            return account.OwnerName is { Length: > 0 } owner ? $"geteilt von {owner}" : "geteilt";
        }

        return account.Sharing switch
        {
            AccountSharing.Private => "privat",
            AccountSharing.Named when account.SharedWith.Count == 0 => "privat",
            AccountSharing.Named
                => "geteilt mit " + string.Join(" + ", account.SharedWith.Select(s => s.Name)),

            // Die vierte Stufe heißt nach dem, was sie ausmacht: nicht der Zugriff, sondern das
            // Einzahlungssoll.
            AccountSharing.Shared => "Gemeinschaftskonto",
            _ => "Haushalt",
        };
    }

    /// <summary>„heute“, „gestern“ oder das Datum — die Aktualität des Saldos.</summary>
    private static string AsOfLabel(DateOnly asOf)
    {
        var today = DateOnly.FromDateTime(DateTime.Now);
        return asOf == today ? "heute"
            : asOf == today.AddDays(-1) ? "gestern"
            : GermanFormat.DateShort(asOf) + ".";
    }

    /// <summary>Das Zeichen auf der Kontokarte: der erste Buchstabe der Kurzform.</summary>
    /// <remarks>
    /// Kein Bankenlogo. Die Anwendung kennt keine Institute, nur Konten, und ein geratenes Logo
    /// wäre eine Behauptung über die Bank. Der Buchstabe unterscheidet die Karten, und mehr soll
    /// er nicht.
    /// </remarks>
    private static string Initial(AccountDto account)
        => account.ShortName is { Length: > 0 } kurz
            ? kurz[..1].ToUpperInvariant()
            : account.Name is { Length: > 0 } name ? name[..1].ToUpperInvariant() : "?";

    /// <summary>
    /// Was über das Konto bekannt ist, ohne die IBAN — die steht darunter.
    /// </summary>
    /// <remarks>
    /// Eine Kontoart führt das Modell nicht. Sie aus der IBAN abzuleiten hieße, jedes Konto mit
    /// IBAN „Girokonto“ zu nennen — auch das Darlehenskonto. Was dasteht, steht an den Daten.
    /// </remarks>
    private static string KindLabel(AccountDto account)
    {
        var teile = new List<string>();

        if (account.InterestRatePercent is { } zins)
        {
            teile.Add(GermanFormat.Percent(zins, 2) + " Zinsen");
        }

        if (account.InterestYearToDate is { } gutschrift)
        {
            teile.Add("Zinsen " + GermanFormat.Euro(gutschrift) + " im laufenden Jahr");
        }

        if (!account.IsMine && account.OwnerName is { Length: > 0 } eigentuemer)
        {
            teile.Add("Konto von " + eigentuemer);
        }

        return string.Join(" · ", teile);
    }

    /// <summary>
    /// Die Zeile unter dem Empfänger: der Verwendungszweck, sonst die Notiz.
    /// </summary>
    /// <remarks>
    /// Bei einer Kartenzahlung steht der Laden im Verwendungszweck und sonst nirgends — der
    /// Empfänger heißt dann „PayPal“ oder der Name des Zahlungsdienstleisters. Ohne Auszug ist
    /// die Notiz das, was ein Mensch dazugeschrieben hat; beschnitten wird die Zeile im
    /// Stylesheet, nicht hier.
    /// </remarks>
    private static string Subline(TransactionDto transaction)
        => transaction.Details?.Purpose is { Length: > 0 } zweck
            ? zweck
            : transaction.Note ?? string.Empty;

    private static string TagClass(TransactionDto transaction) => transaction switch
    {
        { Kind: TransactionKind.Transfer } => "tag-outline",
        { CategoryId: not null } => "tag-neutral",
        _ => "tag-accent",
    };

    private static string TagLabel(TransactionDto transaction) => transaction switch
    {
        { Kind: TransactionKind.Transfer } => "Umbuchung",
        { CategoryName: { Length: > 0 } name } => name,
        _ => "Nicht zugeordnet",
    };

    public override void Dispose()
    {
        searchDebounce?.Cancel();
        searchDebounce?.Dispose();
        base.Dispose();
    }
}
