@page "/konten"
@attribute [Authorize]
@inherits AppPage

<PageTitle>Konten &amp; Buchungen — FinanzApp</PageTitle>

<AsyncView Loading="Loading" Error="@Error" Retry="ReloadAsync">
    @* Ein Konto hat keinen eigenen Detailscreen — die Zeile führt deshalb direkt ins
       Bearbeiten, statt einen Link zu tragen. *@
    <AuthorizeView Roles="Owner,Member">
        <Authorized>
            @foreach (var account in accounts)
            {
                <button type="button" class="tap row"
                        @onclick="@(() => Navigation.NavigateTo($"/bearbeiten/account/{account.Id}"))">
                    <span class="stack">
                        <span class="account-name">@account.Name</span>
                        <span class="account-sub">@AccountSubtitle(account)</span>
                    </span>
                    <span class="stack-end">
                        <span class="account-balance num">@State.Euro(account.Balance)</span>
                        <span class="meta">@AsOfLabel(account.BalanceAsOf)</span>
                    </span>
                </button>
            }
        </Authorized>
        <NotAuthorized>
            @foreach (var account in accounts)
            {
                <div class="row">
                    <div class="stack">
                        <span class="account-name">@account.Name</span>
                        <span class="account-sub">@AccountSubtitle(account)</span>
                    </div>
                    <div class="stack-end">
                        <span class="account-balance num">@State.Euro(account.Balance)</span>
                        <span class="meta">@AsOfLabel(account.BalanceAsOf)</span>
                    </div>
                </div>
            }
        </NotAuthorized>
    </AuthorizeView>

    <AddRow Route="/neu/account" Label="Konto anlegen" />

    <div class="list-head">
        <span class="label-strong">Buchungen</span>
        <span class="list-count num">@list.FilteredCount von @list.TotalCount</span>
    </div>

    <div class="searchbar">
        <input class="input" type="search" placeholder="Buchungen durchsuchen" aria-label="Buchungen durchsuchen"
               value="@search" @oninput="OnSearchInput" />
        @if (HasFilter)
        {
            <button type="button" class="btn btn-secondary" @onclick="ResetFilter">Zurücksetzen</button>
        }
    </div>

    @* Filterchips: auf dem Telefon eine scrollende Reihe, ab Tablet umbrechend. *@
    <div class="filter-row">
        <button type="button" class="chip @(accountFilter is null ? "active" : null)"
                @onclick="() => SetAccount(null)">Alle Konten</button>
        @foreach (var account in accounts)
        {
            <button type="button" class="chip @(accountFilter == account.Id ? "active" : null)"
                    @onclick="() => SetAccount(account.Id)">@account.ShortName</button>
        }

        <span class="filter-sep" aria-hidden="true"></span>

        <button type="button" class="chip @(kindFilter is null && !onlyOpen ? "active" : null)"
                @onclick="() => SetKind(null)">Alle Arten</button>
        <button type="button" class="chip @(kindFilter == TransactionKind.Income ? "active" : null)"
                @onclick="() => SetKind(TransactionKind.Income)">Einnahmen</button>
        <button type="button" class="chip @(kindFilter == TransactionKind.Expense ? "active" : null)"
                @onclick="() => SetKind(TransactionKind.Expense)">Ausgaben</button>
        <button type="button" class="chip @(kindFilter == TransactionKind.Transfer ? "active" : null)"
                @onclick="() => SetKind(TransactionKind.Transfer)">Umbuchungen</button>
        <button type="button" class="chip @(onlyOpen ? "active" : null)"
                @onclick="ToggleOnlyOpen">Ohne Kategorie</button>

        <span class="filter-sep" aria-hidden="true"></span>

        <button type="button" class="chip @(categoryFilter is null ? "active" : null)"
                @onclick="() => SetCategory(null)">Alle Kategorien</button>
        @foreach (var category in categories)
        {
            <button type="button" class="chip @(categoryFilter == category.Id ? "active" : null)"
                    @onclick="() => SetCategory(category.Id)">@category.Name</button>
        }
    </div>

    @* Die Summen rechnen gegen den sichtbaren Ausschnitt, nicht gegen den Gesamtbestand. *@
    <section class="tx-totals">
        <div class="tx-total">
            <span class="label-muted">Einnahmen</span>
            <span class="tx-total-value num income">@State.Euro(list.Totals.Income)</span>
        </div>
        <div class="tx-total">
            <span class="label-muted">Ausgaben</span>
            <span class="tx-total-value num">@State.Euro(list.Totals.Expense)</span>
        </div>
        <div class="tx-total">
            <span class="label-muted">Saldo</span>
            <span class="tx-total-value num">@Signed(list.Totals.Balance)</span>
        </div>
    </section>

    @if (list.Totals.TransferCount > 0)
    {
        <div class="tx-totals-note">
            @list.Totals.TransferCount @(list.Totals.TransferCount == 1 ? "Umbuchung zählt" : "Umbuchungen zählen")
            weder als Einnahme noch als Ausgabe.
        </div>
    }

    @if (list.FilteredUncategorizedCount > 0)
    {
        <AuthorizeView Roles="Owner,Member">
            <div class="triage-wrap">
                <button type="button" class="triage" @onclick="StartTriage">
                    <span class="stack">
                        <span class="triage-title">
                            @list.FilteredUncategorizedCount
                            @(list.FilteredUncategorizedCount == 1 ? "Buchung" : "Buchungen") ohne Kategorie
                        </span>
                        <span class="triage-sub">Jetzt zuordnen</span>
                    </span>
                    <span class="triage-arrow" aria-hidden="true">→</span>
                </button>
            </div>
        </AuthorizeView>
    }

    @if (selected.Count > 0)
    {
        <AuthorizeView Roles="Owner,Member">
            <div class="tx-selection">
                <span class="tx-selection-count">
                    @selected.Count @(selected.Count == 1 ? "Buchung" : "Buchungen") ausgewählt
                </span>
                <button type="button" class="btn btn-primary" @onclick="OpenBatchSheet">Kategorie zuweisen</button>

                @if (confirmingBatchDelete)
                {
                    <button type="button" class="btn btn-primary delete-confirm" @onclick="DeleteBatchAsync">
                        @selected.Count @(selected.Count == 1 ? "Buchung wird" : "Buchungen werden")
                        gelöscht — erneut tippen
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-secondary"
                            @onclick="@(() => confirmingBatchDelete = true)">Löschen</button>
                }

                <button type="button" class="btn btn-secondary" @onclick="ClearSelection">Auswahl aufheben</button>
            </div>
        </AuthorizeView>
    }

    @if (list.Items.Count == 0)
    {
        @* Nie eine leere Fläche: Ursache benennen, Ausweg anbieten. *@
        <div class="empty-area">
            <span class="empty-area-title">Keine Buchung im gewählten Ausschnitt</span>
            <span class="empty-area-text">@EmptyReason</span>
            <div class="empty-area-actions">
                <button type="button" class="btn btn-secondary" @onclick="ResetFilter">Filter zurücksetzen</button>
                <AuthorizeView Roles="Owner,Member">
                    <button type="button" class="btn btn-primary"
                            @onclick="@(() => Navigation.NavigateTo("/erfassen"))">Buchung erfassen</button>
                </AuthorizeView>
            </div>
        </div>
    }
    else
    {
        <div class="tx-table">
            @* Die Kopfzeile trägt nur die Tabelle ab Tablet; auf dem Telefon ist sie ausgeblendet. *@
            <div class="tx-head">
                <AuthorizeView Roles="Owner,Member">
                    <label class="tx-check">
                        <input type="checkbox" checked="@AllSelected" @onchange="ToggleAll"
                               aria-label="Alle sichtbaren Buchungen wählen" />
                    </label>
                </AuthorizeView>
                <span>Datum</span>
                <span>Empfänger</span>
                <span>Kategorie</span>
                <span>Konto</span>
                <span class="tx-head-amount">Betrag</span>
            </div>

            @foreach (var transaction in list.Items)
            {
                <div class="tx-line @(selected.Contains(transaction.Id) ? "picked" : null)">
                    <AuthorizeView Roles="Owner,Member">
                        <label class="tx-check">
                            <input type="checkbox" checked="@selected.Contains(transaction.Id)"
                                   @onchange="e => Toggle(transaction.Id, e)"
                                   aria-label="@($"{transaction.Payee} wählen")" />
                        </label>
                    </AuthorizeView>

                    <button type="button" class="tap tx-row" @onclick="() => OpenSheet(transaction)">
                        <span class="tx-date num">@GermanFormat.DateShort(transaction.BookingDate)</span>
                        <span class="tx-main">
                            <span class="tx-payee">@transaction.Payee</span>
                            <span class="tx-tags">
                                <span class="tag @TagClass(transaction)">@TagLabel(transaction)</span>
                                <span class="tx-account">@transaction.AccountShortName</span>
                            </span>
                        </span>
                        <span class="tx-cell tx-cell-category">
                            <span class="tag @TagClass(transaction)">@TagLabel(transaction)</span>
                        </span>
                        <span class="tx-cell tx-cell-account">@transaction.AccountShortName</span>
                        <span class="tx-amount num @(transaction.Amount > 0 ? "income" : null)">
                            @State.Euro(transaction.Amount, withPlusSign: true)
                        </span>
                    </button>
                </div>
            }
        </div>
    }

    <div class="spacer"></div>
</AsyncView>

@if (batchOpen)
{
    <CategorySheet BatchCount="selected.Count"
                   BatchAmount="SelectedAmount"
                   Categories="categories"
                   OnPickCategory="AssignBatch"
                   OnPickTransfer="MarkBatchTransfer"
                   OnConfirm="@(_ => CloseBatch())"
                   OnClose="CloseBatch" />
}
else if (sheetTransaction is { } sheet)
{
    <CategorySheet Transaction="sheet"
                   Categories="SheetCategories(sheet)"
                   OnPickCategory="PickCategory"
                   OnPickTransfer="PickTransfer"
                   OnConfirm="ConfirmSheet"
                   OnClose="CloseSheet"
                   OnDelete="DeleteSingleAsync"
                   OnSplit="@(() => Toasts.Show("Split-Buchung folgt"))" />
}

@code {
    private static readonly TransactionTotalsDto NoTotals = new()
    {
        Income = 0m, Expense = 0m, Balance = 0m, TransferCount = 0,
    };

    private static readonly TransactionPageDto Empty = new()
    {
        Items = [], FilteredCount = 0, TotalCount = 0,
        UncategorizedCount = 0, FilteredUncategorizedCount = 0, Totals = NoTotals,
    };

    private TransactionPageDto list = Empty;
    private IReadOnlyList<AccountDto> accounts = [];
    private IReadOnlyList<CategoryDto> categories = [];
    private TransactionDto? sheetTransaction;

    private readonly HashSet<int> selected = [];
    private bool batchOpen;
    private bool confirmingBatchDelete;

    private string search = string.Empty;
    private int? accountFilter;
    private int? categoryFilter;
    private TransactionKind? kindFilter;
    private bool onlyOpen;
    private CancellationTokenSource? searchDebounce;

    private bool HasFilter => !string.IsNullOrWhiteSpace(search)
                              || accountFilter is not null || categoryFilter is not null
                              || kindFilter is not null || onlyOpen;

    private bool AllSelected => list.Items.Count > 0 && list.Items.All(t => selected.Contains(t.Id));

    private decimal SelectedAmount => list.Items.Where(t => selected.Contains(t.Id)).Sum(t => t.Amount);

    protected override async Task LoadAsync()
    {
        accounts = await Api.GetAccountsAsync();
        categories = await Api.GetCategoriesAsync();
        await ReloadListAsync();
    }

    private async Task ReloadListAsync(CancellationToken ct = default)
    {
        list = await Api.GetTransactionsAsync(search, accountFilter, categoryFilter, kindFilter, onlyOpen, ct);

        // Eine Auswahl, die der Filter nicht mehr zeigt, ist keine Auswahl mehr — sonst beträfe
        // die Stapelvergabe Zeilen, die niemand vor sich hat.
        selected.IntersectWith(list.Items.Select(t => t.Id));
    }

    private string EmptyReason
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(search))
            {
                return $"Die Suche nach „{search}“ trifft nichts im übrigen Ausschnitt.";
            }

            if (onlyOpen)
            {
                return "Im gewählten Ausschnitt ist alles kategorisiert.";
            }

            return HasFilter
                ? "Der gewählte Filter lässt nichts übrig."
                : "Es ist noch keine Buchung erfasst.";
        }
    }

    /// <summary>Der Saldo trägt sein Vorzeichen — die Null aber nicht.</summary>
    private static string Signed(decimal value)
        => value == 0m ? GermanFormat.Euro(0m) : GermanFormat.Euro(value, withPlusSign: true);

    /// <summary>
    /// Die Suche läuft auf dem Server. Ein kurzer Aufschub bündelt die Tastenanschläge zu
    /// einer Anfrage, statt bei jedem Zeichen eine zu stellen.
    /// </summary>
    private async Task OnSearchInput(ChangeEventArgs e)
    {
        search = e.Value?.ToString() ?? string.Empty;

        searchDebounce?.Cancel();
        searchDebounce?.Dispose();
        searchDebounce = new CancellationTokenSource();
        var token = searchDebounce.Token;

        try
        {
            await Task.Delay(250, token);
            await ReloadListAsync(token);
            StateHasChanged();
        }
        catch (OperationCanceledException)
        {
            // Ein neuer Tastenanschlag hat diese Anfrage überholt.
        }
        catch (ApiException ex)
        {
            Toasts.Show(ex.Message);
        }
    }

    private Task SetAccount(int? id) => Filter(() => accountFilter = id);

    private Task SetCategory(int? id) => Filter(() => categoryFilter = id);

    private Task SetKind(TransactionKind? kind) => Filter(() =>
    {
        kindFilter = kind;
        onlyOpen = false;
    });

    private Task ToggleOnlyOpen() => Filter(() =>
    {
        onlyOpen = !onlyOpen;
        kindFilter = null;
    });

    private Task ResetFilter() => Filter(() =>
    {
        search = string.Empty;
        accountFilter = null;
        categoryFilter = null;
        kindFilter = null;
        onlyOpen = false;
    });

    private Task Filter(Action change) => RunAsync(async () =>
    {
        searchDebounce?.Cancel();
        change();
        await ReloadListAsync();
    });

    // ── Auswahl und Stapelvergabe ──────────────────────────────────────────────────────────

    private void Toggle(int id, ChangeEventArgs e)
    {
        if (e.Value is true)
        {
            selected.Add(id);
        }
        else
        {
            selected.Remove(id);
        }
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        selected.Clear();
        if (e.Value is true)
        {
            foreach (var transaction in list.Items)
            {
                selected.Add(transaction.Id);
            }
        }
    }

    private void ClearSelection()
    {
        selected.Clear();
        confirmingBatchDelete = false;
    }

    private Task DeleteBatchAsync() => RunAsync(async () =>
    {
        var count = await Api.DeleteTransactionsAsync([.. selected]);

        Toasts.Show(count == 1 ? "1 Buchung gelöscht" : $"{count} Buchungen gelöscht");
        ClearSelection();
        await ReloadListAsync();
    });

    private Task DeleteSingleAsync() => RunAsync(async () =>
    {
        var transaction = sheetTransaction;
        if (transaction is null)
        {
            return;
        }

        await Api.DeleteTransactionAsync(transaction.Id);
        CloseSheet();
        Toasts.Show("Buchung gelöscht");
        await ReloadListAsync();
    });

    /// <summary>
    /// „Kategorie zuweisen“ öffnet das Panel und schreibt nicht direkt — die Wahl gehört dorthin,
    /// wo auch steht, was die Vergabe nicht anfassen wird.
    /// </summary>
    private void OpenBatchSheet() => batchOpen = true;

    private void CloseBatch()
    {
        batchOpen = false;
        selected.Clear();
    }

    private Task AssignBatch(CategoryDto category) => RunAsync(async () =>
    {
        var result = await Api.AssignCategoryBatchAsync(new BatchAssignRequest
        {
            TransactionIds = [.. selected],
            CategoryId = category.Id,
        });

        Toasts.Show(result.Message);
        await ReloadListAsync();
        CloseBatch();
    });

    private Task MarkBatchTransfer() => RunAsync(async () =>
    {
        var result = await Api.AssignCategoryBatchAsync(new BatchAssignRequest
        {
            TransactionIds = [.. selected],
            MarkAsTransfer = true,
        });

        Toasts.Show(result.Message);
        await ReloadListAsync();
        CloseBatch();
    });

    // ── Einzelbuchung ──────────────────────────────────────────────────────────────────────

    private void OpenSheet(TransactionDto transaction) => sheetTransaction = transaction;

    private void CloseSheet() => sheetTransaction = null;

    private void StartTriage()
        => sheetTransaction = list.Items.FirstOrDefault(t => t.IsUncategorized)
                              ?? list.Items.FirstOrDefault();

    /// <summary>Kategorien passend zum Vorzeichen der Buchung.</summary>
    private IReadOnlyList<CategoryDto> SheetCategories(TransactionDto transaction)
    {
        var direction = transaction.Amount > 0 ? CategoryDirection.Income : CategoryDirection.Expense;
        return [.. categories.Where(c => c.Direction == direction)];
    }

    private Task PickCategory(CategoryDto category) => RunAsync(async () =>
    {
        var updated = await Api.AssignCategoryAsync(
            sheetTransaction!.Id, new AssignCategoryRequest { CategoryId = category.Id });

        Apply(updated);
        Toasts.Show(category.Name + " zugeordnet");
    });

    private Task PickTransfer() => RunAsync(async () =>
    {
        var updated = await Api.AssignCategoryAsync(
            sheetTransaction!.Id, new AssignCategoryRequest { MarkAsTransfer = true });

        Apply(updated);
        Toasts.Show("Als Umbuchung markiert");
    });

    /// <summary>„Fertig“ — legt bei Bedarf noch die Regel an und schließt das Sheet.</summary>
    private async Task ConfirmSheet(bool rememberRule)
    {
        var transaction = sheetTransaction;
        if (rememberRule && transaction?.CategoryId is { } categoryId)
        {
            await RunAsync(async () =>
            {
                var updated = await Api.AssignCategoryAsync(
                    transaction.Id, new AssignCategoryRequest { CategoryId = categoryId, CreateRule = true });

                Apply(updated);
                Toasts.Show("Regel für „" + Categorization.RulePatternFor(transaction.Payee) + "“ gemerkt");
            });
        }

        CloseSheet();
    }

    /// <summary>Übernimmt die geänderte Buchung in Liste und Sheet, ohne alles neu zu laden.</summary>
    private void Apply(TransactionDto updated)
    {
        // Die Zähler werden fortgeschrieben statt neu gezählt — der eine gilt für den Bestand,
        // der andere für den Ausschnitt, und beide verschieben sich um dasselbe.
        var before = list.Items.FirstOrDefault(t => t.Id == updated.Id)?.IsUncategorized ?? false;
        var delta = (updated.IsUncategorized ? 1 : 0) - (before ? 1 : 0);

        list = list with
        {
            Items = [.. list.Items.Select(t => t.Id == updated.Id ? updated : t)],
            UncategorizedCount = Math.Max(0, list.UncategorizedCount + delta),
            FilteredUncategorizedCount = Math.Max(0, list.FilteredUncategorizedCount + delta),
        };

        sheetTransaction = updated;
    }

    private static string AccountSubtitle(AccountDto account)
    {
        if (account.Iban is { Length: > 0 } iban)
        {
            return iban;
        }

        var parts = new List<string>();
        if (account.InterestRatePercent is { } rate)
        {
            parts.Add(GermanFormat.Percent(rate, 2));
        }

        if (account.InterestYearToDate is { } interest)
        {
            parts.Add("Zinsen " + GermanFormat.Euro(interest) + " YTD");
        }

        return string.Join(" · ", parts);
    }

    /// <summary>„heute“, „gestern“ oder das Datum — die Aktualität des Saldos.</summary>
    private static string AsOfLabel(DateOnly asOf)
    {
        var today = DateOnly.FromDateTime(DateTime.Now);
        return asOf == today ? "heute"
            : asOf == today.AddDays(-1) ? "gestern"
            : GermanFormat.DateShort(asOf) + ".";
    }

    private static string TagClass(TransactionDto transaction) => transaction switch
    {
        { Kind: TransactionKind.Transfer } => "tag-outline",
        { CategoryId: not null } => "tag-neutral",
        _ => "tag-accent",
    };

    private static string TagLabel(TransactionDto transaction) => transaction switch
    {
        { Kind: TransactionKind.Transfer } => "Umbuchung",
        { CategoryName: { Length: > 0 } name } => name,
        _ => "Nicht zugeordnet",
    };

    public override void Dispose()
    {
        searchDebounce?.Cancel();
        searchDebounce?.Dispose();
        base.Dispose();
    }
}
