@page "/dokumente"
@page "/dokumente/{Id:int}"
@attribute [Authorize]
@inherits AppPage

<PageTitle>Dokumente — FinanzApp</PageTitle>

@*
    Master und Detail auf einer Seite. Auf dem Telefon zeigt die CSS je nach Route nur eine
    der beiden Spalten, ab Tablet beide nebeneinander — so bleibt es eine Navigation und nicht
    zwei, die sich widersprechen können.
*@
<div class="doc-split @(Id is null ? "list-only" : "detail-open")">
<div class="doc-master">
<div class="searchbar">
    <input class="input" type="search" placeholder="Dokumente und Objekte durchsuchen"
           aria-label="Dokumente und Objekte durchsuchen" value="@search" @oninput="OnSearchInput" />
    <button type="button" class="btn btn-secondary" @onclick="ClearSearch">Reset</button>
</div>

<div class="filter-chips">
    @foreach (var option in Areas)
    {
        <button type="button" class="chip @(area == option.Area ? "active" : null)"
                @onclick="() => SwitchArea(option.Area)">@option.Label</button>
    }
</div>

<AsyncView Loading="Loading" Error="@Error" Stale="HasLoadedOnce" Retry="ReloadAsync">
    @if (objects.Count > 0)
    {
        @* Die Suche trifft auch Objekte — wer „hausrat“ tippt, meint meist den Vertrag. *@
        <div class="list-head">
            <span class="label-strong">Objekte</span>
            <span class="list-count num">@objects.Count</span>
        </div>

        @foreach (var hit in objects)
        {
            <button type="button" class="tap doc-row" @onclick="() => OpenObject(hit)">
                <span class="stack">
                    <span class="doc-name">@hit.Label</span>
                    <span class="doc-meta">@hit.TargetLabel · @hit.Subtitle</span>
                </span>
            </button>
        }
    }

    @if (documents.Count > 0 && objects.Count > 0)
    {
        <div class="list-head">
            <span class="label-strong">Dokumente</span>
            <span class="list-count num">@documents.Count</span>
        </div>
    }

    @if (documents.Count == 0)
    {
        <div class="empty-area">
            <span class="empty-area-text">@EmptyText</span>
            <AuthorizeView Roles="Owner,Member">
                <button type="button" class="btn btn-secondary"
                        @onclick="@(() => Navigation.NavigateTo("/scannen"))">Beleg einlesen</button>
            </AuthorizeView>
        </div>
    }

    @foreach (var document in documents)
    {
        <button type="button"
                class="tap doc-row @(document.FileExists ? null : "missing") @(Id == document.Id ? "open" : null)"
                @onclick="@(() => Navigation.NavigateTo($"/dokumente/{document.Id}"))">
            <span class="stack">
                <span class="doc-name">@document.FileName</span>
                <span class="doc-meta">@Describe(document)</span>
            </span>
        </button>
    }

    @if (total > 0)
    {
        <div class="doc-foot">
            @* Klammern um den Ausdruck: ohne sie liest Razor „Dokumente@MissingSuffix“ als
               E-Mail-Adresse und gibt sie wörtlich aus. *@
            <span class="num">@total @(total == 1 ? "Dokument" : "Dokumente")@(MissingSuffix)</span>
            <span>sortiert nach Dokumentdatum</span>
        </div>
    }

    @*
        Alles, was vor der Textsuche abgelegt wurde, trägt noch keinen Text. Der Nachlauf liest
        die Dateien erneut — bei Fotos durch die Texterkennung, und die braucht Sekunden je
        Stück. Deshalb in Schüben und mit einer Zahl, die sagt, wie viel noch aussteht.
    *@
    @if (withoutText > 0)
    {
        <AuthorizeView Roles="Owner,Member" Context="volltext">
            <div class="doc-foot">
                <span>@withoutText @(withoutText == 1 ? "Dokument ist" : "Dokumente sind") noch nicht durchsuchbar</span>
                <button type="button" class="btn btn-secondary" disabled="@reading"
                        @onclick="BackfillAsync">
                    @(reading ? "liest …" : "Text nachholen")
                </button>
            </div>
        </AuthorizeView>
    }
</AsyncView>
</div>

<div class="doc-detail">
    @if (Id is { } open)
    {
        <DocumentPane Id="open" OnDeleted="AfterDeleteAsync" />
    }
    else
    {
        @* Ab Tablet steht die Spalte immer da — leer wäre sie eine unerklärte Fläche. *@
        <div class="empty-area">
            <span class="empty-area-text">Ein Dokument wählen, um es hier zu sehen.</span>
        </div>
    }
</div>
</div>

@code {
    /// <summary>Das geöffnete Dokument. <c>null</c> heißt: nur die Liste.</summary>
    [Parameter] public int? Id { get; set; }

    /// <summary>
    /// Die Liste bleibt stehen, wenn nur ein anderes Dokument geöffnet wird.
    /// </summary>
    /// <remarks>
    /// Die Adresse wählt hier die zweite Spalte, sie gehört nicht zu den Daten der ersten. Sie
    /// bei jedem Klick neu zu holen wäre ein Abruf ohne Ergebnis — die Vorschau lädt selbst.
    /// </remarks>
    protected override bool ReloadOnNavigation => false;

    /// <summary>
    /// Nach dem Löschen rückt die Vorschau auf den nächsten Eintrag — oder in den Leerzustand.
    /// Eine Vorschau, die auf ein gelöschtes Dokument zeigt, wäre schlimmer als eine leere.
    /// </summary>
    private async Task AfterDeleteAsync(int deletedId)
    {
        var position = documents.ToList().FindIndex(d => d.Id == deletedId);
        await ReloadAsync();

        var next = documents.Count == 0
            ? null
            : documents[Math.Min(Math.Max(position, 0), documents.Count - 1)];

        Navigation.NavigateTo(next is null ? "/dokumente" : $"/dokumente/{next.Id}");
    }

    private static readonly (DocumentArea? Area, string Label)[] Areas =
    [
        (null, "Alle"),
        (DocumentArea.Insurance, "Versicherung"),
        (DocumentArea.Health, "Gesundheit"),
        (DocumentArea.Housing, "Wohnen"),
        (DocumentArea.Work, "Arbeit"),
        (DocumentArea.Finance, "Finanzen"),
        (DocumentArea.Vehicle, "Fahrzeuge"),
        (DocumentArea.Personal, "Persönlich"),
    ];

    private IReadOnlyList<DocumentListItemDto> documents = [];
    private IReadOnlyList<ObjectHitDto> objects = [];
    private int total;
    private int missing;
    private int withoutText;
    private bool reading;

    private DocumentArea? area;
    private string search = string.Empty;
    private CancellationTokenSource? debounce;

    protected override async Task LoadAsync()
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            var page = await Api.GetDocumentsAsync(area);
            documents = page.Items;
            objects = [];
            total = page.TotalCount;
            missing = page.MissingFileCount;
            withoutText = page.WithoutTextCount;
            return;
        }

        var result = await Api.SearchDocumentsAsync(search);
        documents = area is { } value ? [.. result.Documents.Where(d => d.Area == value)] : result.Documents;
        objects = result.Objects;
        total = documents.Count;
        missing = documents.Count(d => !d.FileExists);
    }

    /// <summary>
    /// Holt den gelesenen Text für Dokumente nach, die noch keinen haben.
    /// </summary>
    /// <remarks>
    /// In Schüben von fünfzig. Ein Aufruf über hundertdreißig Belege, von denen einige durch die
    /// Texterkennung müssen, dauert Minuten — und eine Anfrage, die Minuten braucht, bricht
    /// unterwegs ab. Wer mehr will, drückt noch einmal; die Zahl daneben sagt, wie viel bleibt.
    /// </remarks>
    private Task BackfillAsync() => RunAsync(async () =>
    {
        reading = true;
        try
        {
            var ergebnis = await Api.BackfillDocumentTextAsync(50);
            Toasts.Show(ergebnis.Gelesen == 0
                ? "Kein Text zu holen"
                : $"{ergebnis.Gelesen} {(ergebnis.Gelesen == 1 ? "Dokument" : "Dokumente")} gelesen");

            await ReloadAsync();
        }
        finally
        {
            reading = false;
        }
    });

    private async Task SwitchArea(DocumentArea? next)
    {
        if (next == area)
        {
            return;
        }

        area = next;
        await ReloadAsync();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        search = e.Value?.ToString() ?? string.Empty;

        debounce?.Cancel();
        debounce?.Dispose();
        debounce = new CancellationTokenSource();

        try
        {
            await Task.Delay(250, debounce.Token);
            await LoadAsync();
            StateHasChanged();
        }
        catch (OperationCanceledException)
        {
            // Ein neuer Tastenanschlag hat diese Anfrage überholt.
        }
        catch (ApiException ex)
        {
            Toasts.Show(ex.Message);
        }
    }

    private async Task ClearSearch()
    {
        search = string.Empty;
        debounce?.Cancel();
        await ReloadAsync();
    }

    private string EmptyText => string.IsNullOrWhiteSpace(search)
        ? "In diesem Bereich liegt noch kein Dokument."
        : "Kein Dokument passt zur Suche.";

    private string MissingSuffix => missing == 0
        ? string.Empty
        : missing == 1 ? " · 1 ohne Datei" : $" · {missing} ohne Datei";

    private static string Describe(DocumentListItemDto document)
    {
        if (!document.FileExists)
        {
            return "Datei nicht gefunden";
        }

        var parts = new List<string>();

        // Zuerst, weil es die Frage beantwortet, die vor allen anderen kommt: Sieht das noch
        // jemand? Hinten zwischen Typ und Datum ginge es unter.
        if (document.Sharing == DocumentSharing.Private)
        {
            parts.Add("nur ich");
        }

        if (document.TypeName is { Length: > 0 } type)
        {
            parts.Add(type);
        }

        if (document.LinkedLabel is { Length: > 0 } linked)
        {
            parts.Add(linked);
        }

        if (document.DocumentDate is { } date)
        {
            parts.Add(GermanFormat.Date(date));
        }

        // Schlagworte zum Schluss: Sie sind das Einzige, was der Nutzer selbst vergibt, und
        // sie sollen die gepflegten Angaben nicht verdrängen.
        parts.AddRange(document.Tags);

        return string.Join(" · ", parts);
    }

    private void OpenObject(ObjectHitDto hit)
    {
        var route = hit.TargetType switch
        {
            LinkTargetType.Policy => $"/police/{hit.TargetId}",
            LinkTargetType.Contract => $"/vertraege/{hit.TargetId}",
            LinkTargetType.Property => $"/wohnen/{hit.TargetId}",
            LinkTargetType.MedicalBill => $"/gesundheit/{hit.TargetId}",
            LinkTargetType.Transaction => "/konten",
            _ => null,
        };

        if (route is null)
        {
            Toasts.Show("Zu diesem Treffer gibt es keinen eigenen Screen.");
            return;
        }

        Navigation.NavigateTo(route);
    }

    public override void Dispose()
    {
        debounce?.Cancel();
        debounce?.Dispose();
        base.Dispose();
    }
}
