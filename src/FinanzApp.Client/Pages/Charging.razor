@page "/ladestrom"
@attribute [Authorize]
@inherits AppPage
@inject FinanzAppAuthStateProvider Auth

@*
    Ladestrom — der Dienstwagen an der privaten Wallbox.

    Die Seite hat keine eigene Rechnung. Verbrauch, Satz und Betrag kommen so, wie der Dienst
    sie geliefert hat; sie hier noch einmal auszurechnen hieße, zwei Rechnungen für dieselbe
    Aussage zu führen — und der Tag, an dem sie auseinanderlaufen, fällt niemandem auf.

    Erfasst wird **ein** Stand je Ablesung. Was dazwischen geladen wurde, ist die Differenz zur
    vorigen und steht nirgends geschrieben. Deshalb lässt sich eine verlesene Ablesung löschen,
    ohne dass irgendetwas nachgerechnet werden müsste.
*@

<PageTitle>Ladestrom — FinanzApp</PageTitle>

<AsyncView Loading="Loading" Error="@Error" Stale="HasLoadedOnce" Retry="ReloadAsync">
    @if (data is { } strom)
    {
        <section class="hero">
            <span class="label-muted">
                Ladestrom@(strom.Employer is { Length: > 0 } wer ? " · " + wer : null)
            </span>
            <span class="hero-value num">@Kwh(strom.TotalKwh)</span>
            <span class="loan-sub">@HeadSub(strom)</span>
        </section>

        <section class="kpi">
            <div class="kpi-cell">
                <span class="label-muted">Erstattung gesamt</span>
                <span class="kpi-value num">@State.Euro(strom.TotalAmount)</span>
            </div>
            <div class="kpi-cell">
                <span class="label-muted">Letzter Stand</span>
                <span class="kpi-value num">@(Letzter(strom) is { } stand ? Kwh(stand) : "—")</span>
            </div>
            <div class="kpi-cell">
                <span class="label-muted">Offen</span>
                <span class="kpi-value num @(strom.OpenAmount > 0m ? "accent" : null)">
                    @State.Euro(strom.OpenAmount)
                </span>
            </div>
            <div class="kpi-cell">
                <span class="label-muted">Satz</span>
                <span class="kpi-value accent num">
                    @(strom.Rates.Count > 0 ? Satz(strom.Rates[0].EuroPerKwh) : "—")
                </span>
            </div>
        </section>

        @*
            Eine Summe, der etwas fehlt, muss es sagen. Sonst steht da eine Zahl, die aussieht
            wie das Ganze — und jemand gibt sie dem Arbeitgeber.
        *@
        @if (strom.PeriodsWithoutRate > 0)
        {
            <div class="tx-totals-note">
                @strom.PeriodsWithoutRate
                @(strom.PeriodsWithoutRate == 1 ? "Zeitraum hat" : "Zeiträume haben")
                keinen vereinbarten Satz — @(strom.PeriodsWithoutRate == 1 ? "er fehlt" : "sie fehlen")
                in der Erstattung oben. Trag den Satz unten ein, dann rechnet sie vollständig.
            </div>
        }

        @* ── Ablesungen ──────────────────────────────────────────────────────────────────── *@

        <div class="list-head">
            <span class="label-strong">Ablesungen</span>
        </div>

        @if (strom.Readings.Count == 0)
        {
            <div class="import-nothing">
                <span class="label-strong">Noch nichts abgelesen</span>
                <span class="create-help">
                    Die erste Ablesung ist der Anfang der Reihe. Einen Verbrauch hat sie noch
                    nicht — dafür braucht es eine zweite.
                </span>
            </div>
        }

        @foreach (var zeile in strom.Readings)
        {
            var id = zeile.Id;
            var offen = expanded == id;

            <button type="button" class="tap import-row plain @(offen ? "picked" : null)"
                    @onclick="() => Toggle(id)">
                <span class="stack">
                    <span class="import-row-payee">@GermanFormat.Date(zeile.ReadOn)</span>
                    <span class="meta">@Zeitraum(zeile)</span>
                    @if (zeile.RateChangedInPeriod)
                    {
                        <span class="meta accent">
                            Im Zeitraum hat ein neuer Satz begonnen — gerechnet wird mit dem vom
                            Ablesetag.
                        </span>
                    }
                </span>
                <span class="stack-end">
                    <span class="holding-value num">@Kwh(zeile.MeterKwh)</span>
                    <span class="meta">Zählerstand</span>
                </span>
            </button>

            @if (offen)
            {
                <div class="blueprint report-payees">
                    <i class="corner tl" aria-hidden="true"></i>
                    <i class="corner tr" aria-hidden="true"></i>
                    <i class="corner bl" aria-hidden="true"></i>
                    <i class="corner br" aria-hidden="true"></i>

                    <div class="detail-block">
                        <span class="detail-label">Zählerstand</span>
                        <span class="detail-value num">@Kwh(zeile.MeterKwh)</span>
                    </div>

                    @*
                        Gerechnet, nicht erfasst — und darum steht die Rechnung dabei. Ohne sie
                        sähe der Verbrauch aus wie eine abgelesene Zahl.
                    *@
                    <div class="detail-block">
                        <span class="detail-label">
                            @(zeile.Since is { } seit
                                ? $"Geladen seit dem {GermanFormat.Date(seit)}"
                                : "Geladen")
                        </span>
                        <span class="detail-value num @(zeile.Kwh is null ? "missing" : null)">
                            @(zeile.Kwh is { } menge ? Kwh(menge) : "erste Ablesung der Reihe")
                        </span>
                    </div>

                    <div class="detail-block">
                        <span class="detail-label">Satz</span>
                        <span class="detail-value num @(zeile.EuroPerKwh is null ? "missing" : null)">
                            @(zeile.EuroPerKwh is { } satz ? Satz(satz) : "nicht vereinbart")
                        </span>
                    </div>

                    <div class="detail-block">
                        <span class="detail-label">Erstattung</span>
                        <span class="detail-value num @(zeile.Amount is null ? "missing" : null)">
                            @(zeile.Amount is { } betrag ? State.Euro(betrag) : "—")
                        </span>
                    </div>

                    @if (zeile.VehicleName is { Length: > 0 } fahrzeug)
                    {
                        <div class="detail-block">
                            <span class="detail-label">Fahrzeug</span>
                            <span class="detail-value">@fahrzeug</span>
                        </div>
                    }

                    <div class="detail-block">
                        <span class="detail-label">Nachweis</span>
                        <span class="detail-value @(zeile.DocumentId is null ? "missing" : null)">
                            @(zeile.DocumentName ?? "kein Foto hinterlegt")
                        </span>
                    </div>

                    @if (zeile.Note is { Length: > 0 } notiz)
                    {
                        <div class="detail-block">
                            <span class="detail-label">Notiz</span>
                            <span class="detail-value">@notiz</span>
                        </div>
                    }

                    <AuthorizeView Roles="Owner,Member" Context="row">
                        <div class="actions">
                            @if (zeile.DocumentId is { } beleg)
                            {
                                <a class="btn btn-secondary" href="@($"/dokumente/{beleg}")">Foto öffnen</a>
                            }

                            @*
                                Löschen ohne Rückfrage wäre hier zu schnell: Die Ablesung trägt
                                zwei Zeiträume, den vor und den nach ihr. Dass die zusammen-
                                wachsen, ist richtig — aber es soll niemanden überraschen.
                            *@
                            @if (deleting == id)
                            {
                                <button type="button" class="btn btn-danger" disabled="@busy"
                                        @onclick="() => DeleteAsync(id)">Wirklich löschen</button>
                                <button type="button" class="btn btn-secondary" disabled="@busy"
                                        @onclick="KeepReading">Behalten</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-secondary" disabled="@busy"
                                        @onclick="() => deleting = id">Ablesung löschen</button>
                            }
                        </div>

                        @if (deleting == id)
                        {
                            <span class="create-help">
                                Der Zeitraum davor und der danach wachsen zusammen. Der Verbrauch
                                über das Ganze bleibt derselbe — er stand nie irgendwo
                                geschrieben.
                            </span>
                        }
                    </AuthorizeView>
                </div>
            }
        }

        @* ── Ablesung erfassen ───────────────────────────────────────────────────────────── *@

        <AuthorizeView Roles="Owner,Member" Context="capture">
            @if (capturing)
            {
                <div class="blueprint report-payees">
                    <i class="corner tl" aria-hidden="true"></i>
                    <i class="corner tr" aria-hidden="true"></i>
                    <i class="corner bl" aria-hidden="true"></i>
                    <i class="corner br" aria-hidden="true"></i>

                    <div class="field">
                        <label for="ls-tag">Abgelesen am</label>
                        <input id="ls-tag" class="input" type="date" value="@fresh.ReadOn"
                               @oninput="e => fresh.ReadOn = e.Value?.ToString() ?? string.Empty" />
                    </div>

                    <div class="field">
                        <label for="ls-stand">Zählerstand in kWh</label>
                        <input id="ls-stand" class="input" inputmode="decimal" value="@fresh.Meter"
                               placeholder="wie auf dem Display"
                               @oninput="e => fresh.Meter = e.Value?.ToString() ?? string.Empty" />
                        <span class="create-help">
                            Der Stand, nicht der Verbrauch. Was seit der letzten Ablesung geladen
                            wurde, rechnet die App.
                        </span>
                    </div>

                    @if (vehicles is { Count: > 0 })
                    {
                        <div class="field">
                            <label for="ls-fahrzeug">Fahrzeug</label>
                            <select id="ls-fahrzeug" class="input" value="@fresh.Vehicle"
                                    @onchange="e => fresh.Vehicle = e.Value?.ToString() ?? string.Empty">
                                <option value="">— ohne —</option>
                                @foreach (var wagen in vehicles)
                                {
                                    <option value="@wagen.Id">@wagen.Name · @wagen.Plate</option>
                                }
                            </select>
                        </div>
                    }

                    @*
                        Der Nachweis gegenüber dem Arbeitgeber. Zur Auswahl stehen die zuletzt
                        abgelegten Belege: Das Foto kommt über den Scaneingang oder das Postfach
                        herein und steht dann oben in dieser Liste.
                    *@
                    @if (documents is { Count: > 0 })
                    {
                        <div class="field">
                            <label for="ls-beleg">Foto vom Zählerstand</label>
                            <select id="ls-beleg" class="input" value="@fresh.Document"
                                    @onchange="e => fresh.Document = e.Value?.ToString() ?? string.Empty">
                                <option value="">— später —</option>
                                @foreach (var beleg in documents)
                                {
                                    <option value="@beleg.Id">@BelegLabel(beleg)</option>
                                }
                            </select>
                        </div>
                    }

                    <div class="field">
                        <label for="ls-notiz">Notiz</label>
                        <input id="ls-notiz" class="input" value="@fresh.Note"
                               placeholder="optional"
                               @oninput="e => fresh.Note = e.Value?.ToString() ?? string.Empty" />
                    </div>

                    @{ var vorschau = Vorschau(strom); }
                    <span class="create-help @(vorschau?.Warnt == true ? "accent" : null)">
                        @(vorschau?.Text ?? "Die erste Ablesung einer Reihe hat noch keinen Verbrauch.")
                    </span>

                    @if (problem is { Length: > 0 })
                    {
                        <span class="create-problem">@problem</span>
                    }

                    <div class="actions">
                        <button type="button" class="btn btn-primary" disabled="@busy"
                                @onclick="SaveReadingAsync">Ablesung erfassen</button>
                        <button type="button" class="btn btn-secondary" disabled="@busy"
                                @onclick="CancelCapture">Abbrechen</button>
                    </div>
                </div>
            }
            else
            {
                <div class="actions">
                    <button type="button" class="btn btn-primary" @onclick="StartCapture">
                        Ablesung erfassen
                    </button>
                </div>
            }
        </AuthorizeView>

        @* ── Sätze ───────────────────────────────────────────────────────────────────────── *@

        @* ── Abrechnungen ──────────────────────────────────────────────────── *@

        <div class="list-head">
            <span class="label-strong">Abrechnungen</span>
        </div>

        @if (strom.Statements.Count == 0)
        {
            <div class="import-nothing">
                <span class="label-strong">Noch nichts abgerechnet</span>
                <span class="create-help">
                    Eine Abrechnung schreibt fest, was sie gerechnet hat — der Arbeitgeber bekommt
                    ein Blatt mit einer Summe, und ein später vereinbarter Satz ändert sie nicht
                    mehr.
                </span>
            </div>
        }

        @foreach (var blatt in strom.Statements)
        {
            var nummer = blatt.Id;
            var auf = statement == nummer;

            <button type="button" class="tap import-row plain @(auf ? "picked" : null)"
                    @onclick="() => ToggleStatement(nummer)">
                <span class="stack">
                    <span class="import-row-payee">
                        @GermanFormat.Date(blatt.FromOn) bis @GermanFormat.Date(blatt.ToOn)
                    </span>
                    <span class="meta">@Kwh(blatt.Kwh) @Satzzeile(blatt)</span>
                    <span class="meta @(blatt.OpenAmount > 0m ? "accent" : null)">
                        @Stand(blatt)
                    </span>
                </span>
                <span class="stack-end">
                    <span class="holding-value num">@State.Euro(blatt.Amount)</span>
                    <span class="meta">@blatt.StatusLabel</span>
                </span>
            </button>

            @if (auf)
            {
                <div class="blueprint report-payees">
                    <i class="corner tl" aria-hidden="true"></i>
                    <i class="corner tr" aria-hidden="true"></i>
                    <i class="corner bl" aria-hidden="true"></i>
                    <i class="corner br" aria-hidden="true"></i>

                    @*
                        Die Rechnung offen hingeschrieben. Sie steht hier und auf dem Blatt, und
                        beide lesen dieselben festgeschriebenen Zahlen vor — nachrechnen lässt
                        sich das ohne die Anwendung.
                    *@
                    <div class="detail-block">
                        <span class="detail-label">Zählerstände</span>
                        <span class="detail-value num">
                            @Kwh(blatt.FromMeterKwh) → @Kwh(blatt.ToMeterKwh)
                        </span>
                    </div>
                    <div class="detail-block">
                        <span class="detail-label">Geladen</span>
                        <span class="detail-value num">@Kwh(blatt.Kwh)</span>
                    </div>
                    <div class="detail-block">
                        <span class="detail-label">Satz</span>
                        <span class="detail-value num">
                            @(blatt.EuroPerKwh is { } satz
                                ? Satz(satz)
                                : "mehrere im Zeitraum")
                        </span>
                    </div>
                    <div class="detail-block">
                        <span class="detail-label">Zu erstatten</span>
                        <span class="detail-value num">@State.Euro(blatt.Amount)</span>
                    </div>

                    @if (blatt.VehicleName is { Length: > 0 } wagen)
                    {
                        <div class="detail-block">
                            <span class="detail-label">Fahrzeug</span>
                            <span class="detail-value">
                                @wagen@(blatt.VehiclePlate is { Length: > 0 } kz ? $" · {kz}" : null)
                            </span>
                        </div>
                    }

                    <div class="detail-block">
                        <span class="detail-label">Zahlung</span>
                        <span class="detail-value @(blatt.TransactionId is null ? "missing" : null)">
                            @(blatt.TransactionLabel ?? "keine Buchung zugeordnet")
                        </span>
                    </div>

                    <AuthorizeView Roles="Owner,Member" Context="blattzeile">
                        <div class="actions">
                            <button type="button" class="btn btn-secondary" disabled="@busy"
                                    @onclick="() => ShowSheet(blatt)">Blatt ansehen</button>

                            @if (blatt.Status == ChargingStatementStatus.Recorded)
                            {
                                <button type="button" class="btn btn-primary" disabled="@busy"
                                        @onclick="() => AdvanceAsync(nummer, ChargingStatementStatus.Submitted)">
                                    eingereicht
                                </button>
                            }

                            @if (blatt.Status == ChargingStatementStatus.Submitted)
                            {
                                <button type="button" class="btn btn-primary" disabled="@busy"
                                        @onclick="() => LoadCandidatesAsync(nummer)">Zahlung zuordnen</button>
                                <button type="button" class="btn btn-secondary" disabled="@busy"
                                        @onclick="() => AdvanceAsync(nummer, ChargingStatementStatus.Paid)">
                                    ohne Buchung erstattet
                                </button>
                            }

                            @if (blatt.Status == ChargingStatementStatus.Paid)
                            {
                                <button type="button" class="btn btn-secondary" disabled="@busy"
                                        @onclick="() => DetachAsync(nummer)">Zuordnung lösen</button>
                            }

                            @*
                                Zurücknehmen nur bei der jüngsten. Der Knopf steht gar nicht erst
                                da, wenn es nicht geht — ein Knopf, der mit einer Erklärung
                                antwortet, warum er nicht geht, ist ein Versprechen, das er nicht
                                hält.
                            *@
                            @if (blatt.CanDelete)
                            {
                                @if (deletingStatement == nummer)
                                {
                                    <button type="button" class="btn btn-danger" disabled="@busy"
                                            @onclick="() => DeleteStatementAsync(nummer)">
                                        Wirklich zurücknehmen
                                    </button>
                                    <button type="button" class="btn btn-secondary" disabled="@busy"
                                            @onclick="KeepStatement">Behalten</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-secondary" disabled="@busy"
                                            @onclick="() => deletingStatement = nummer">
                                        Abrechnung zurücknehmen
                                    </button>
                                }
                            }
                        </div>

                        @if (deletingStatement == nummer)
                        {
                            <span class="create-help">
                                Der Zeitraum wird wieder offen und kann neu abgerechnet werden.
                                Liegt das Blatt schon beim Arbeitgeber, muss das zweite es
                                ersetzen.
                            </span>
                        }

                        @* Die Vorschläge stehen unter der Zeile, zu der sie gehören. *@
                        @if (candidatesFor == nummer && candidates is { } treffer)
                        {
                            @if (treffer.Count == 0)
                            {
                                <span class="create-help">
                                    Keine Buchung gefunden, die passen könnte. Eine Erstattung über
                                    die Gehaltsabrechnung erscheint gar nicht als eigener Eingang —
                                    dann hilft „ohne Buchung erstattet“.
                                </span>
                            }

                            @foreach (var vorschlag in treffer)
                            {
                                <button type="button"
                                        class="tap import-row plain @(vorschlag.IsBestMatch ? "picked" : null)"
                                        disabled="@busy"
                                        @onclick="() => LinkAsync(nummer, vorschlag.TransactionId)">
                                    <span class="stack">
                                        <span class="import-row-payee">@vorschlag.Payee</span>
                                        <span class="meta">
                                            @GermanFormat.Date(vorschlag.BookingDate) · @vorschlag.AccountName
                                        </span>
                                        <span class="meta accent">@vorschlag.Reason</span>
                                    </span>
                                    <span class="stack-end">
                                        <span class="holding-value num">@State.Euro(vorschlag.Amount)</span>
                                        <span class="meta">zuordnen</span>
                                    </span>
                                </button>
                            }
                        }
                    </AuthorizeView>
                </div>
            }
        }

        <AuthorizeView Roles="Owner,Member" Context="neueabrechnung">
            <div class="tx-totals-note">@Naechste(strom)</div>

            @if (strom.Next.Possible)
            {
                <div class="actions">
                    <button type="button" class="btn btn-primary" disabled="@busy"
                            @onclick="CreateStatementAsync">Abrechnung erstellen</button>
                </div>
            }
        </AuthorizeView>

        <div class="list-head">
            <span class="label-strong">Erstattungssätze</span>
        </div>

        @if (strom.Rates.Count == 0)
        {
            <div class="import-nothing">
                <span class="label-strong">Kein Satz vereinbart</span>
                <span class="create-help">
                    Ohne Satz bleibt der Betrag offen. Geraten wird keiner — ein unterstellter
                    Satz sähe aus wie ein vereinbarter.
                </span>
            </div>
        }

        @foreach (var satz in strom.Rates)
        {
            var satznummer = satz.Id;

            <div class="import-row plain">
                <span class="stack">
                    <span class="import-row-payee">@Satz(satz.EuroPerKwh)</span>
                    <span class="meta">@Geltung(satz)</span>
                    @if (satz.Note is { Length: > 0 } hinweis)
                    {
                        <span class="meta">@hinweis</span>
                    }
                </span>
                <AuthorizeView Roles="Owner,Member" Context="satzzeile">
                    <span class="stack-end">
                        @*
                            Was der Satz einmal gerechnet hat, steht in den Abrechnungen und
                            bleibt dort — die haben ihre Zahlen festgeschrieben. Offene
                            Zeiträume rechnen danach ohne ihn und sagen es.
                        *@
                        @if (deletingRate == satznummer)
                        {
                            <button type="button" class="btn btn-danger" disabled="@busy"
                                    @onclick="() => DeleteRateAsync(satznummer)">Wirklich</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-secondary" disabled="@busy"
                                    @onclick="() => deletingRate = satznummer">entfernen</button>
                        }
                    </span>
                </AuthorizeView>
            </div>
        }

        <AuthorizeView Roles="Owner,Member" Context="satzbereich">
            @if (rating)
            {
                <div class="blueprint report-payees">
                    <i class="corner tl" aria-hidden="true"></i>
                    <i class="corner tr" aria-hidden="true"></i>
                    <i class="corner bl" aria-hidden="true"></i>
                    <i class="corner br" aria-hidden="true"></i>

                    <div class="field">
                        <label for="ls-ab">Gültig ab</label>
                        <input id="ls-ab" class="input" type="date" value="@rate.ValidFrom"
                               @oninput="e => rate.ValidFrom = e.Value?.ToString() ?? string.Empty" />
                        <span class="create-help">
                            Der Satz gilt bis zum Tag vor dem nächsten. Ein Bis-Datum gibt es
                            nicht — zwei Felder, die dasselbe sagen, laufen auseinander.
                        </span>
                    </div>

                    <div class="field">
                        <label for="ls-satz">Euro je kWh</label>
                        <input id="ls-satz" class="input" inputmode="decimal" value="@rate.Euro"
                               placeholder="z. B. 0,2635"
                               @oninput="e => rate.Euro = e.Value?.ToString() ?? string.Empty" />
                    </div>

                    <div class="field">
                        <label for="ls-satz-notiz">Notiz</label>
                        <input id="ls-satz-notiz" class="input" value="@rate.Note"
                               placeholder="woher der Satz stammt"
                               @oninput="e => rate.Note = e.Value?.ToString() ?? string.Empty" />
                    </div>

                    @if (rateProblem is { Length: > 0 })
                    {
                        <span class="create-problem">@rateProblem</span>
                    }

                    <div class="actions">
                        <button type="button" class="btn btn-primary" disabled="@busy"
                                @onclick="SaveRateAsync">Satz eintragen</button>
                        <button type="button" class="btn btn-secondary" disabled="@busy"
                                @onclick="CancelRate">Abbrechen</button>
                    </div>
                </div>
            }
            else
            {
                <div class="actions">
                    <button type="button" class="btn btn-secondary" @onclick="StartRate">
                        Satz eintragen
                    </button>
                </div>
            }
        </AuthorizeView>
    }
</AsyncView>

@if (sheet is { Count: > 0 })
{
    <ChargingSheet Rows="sheet" Year="sheetYear" Employer="@data?.Employer"
                   HouseholdName="@Auth.User?.HouseholdName" UserName="@Auth.User?.Name"
                   OnClose="() => sheet = null" />
}

@code {
    /// <summary>Die Eingaben der Ablesemaske, roh wie getippt.</summary>
    private sealed class ReadingDraft
    {
        public string ReadOn { get; set; } = string.Empty;
        public string Meter { get; set; } = string.Empty;
        public string Vehicle { get; set; } = string.Empty;
        public string Document { get; set; } = string.Empty;
        public string Note { get; set; } = string.Empty;
    }

    private sealed class RateDraft
    {
        public string ValidFrom { get; set; } = string.Empty;
        public string Euro { get; set; } = string.Empty;
        public string Note { get; set; } = string.Empty;
    }

    private ChargingOverviewDto? data;
    private IReadOnlyList<VehicleListItemDto>? vehicles;
    private IReadOnlyList<DocumentListItemDto>? documents;

    private int? expanded;
    private int? deleting;

    private int? statement;
    private int? deletingStatement;
    private int? deletingRate;

