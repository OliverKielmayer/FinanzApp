    protected override async Task LoadAsync()
    {
        data = await Api.GetChargingAsync();

        // Fahrzeuge und Belege sind Beiwerk: Fehlen sie, bleibt das jeweilige Feld weg und die
        // Ablesung lässt sich trotzdem erfassen. Ein Abruf, der die Seite scheitern lässt, weil
        // ein Auswahlfeld leer bliebe, wäre die falsche Abhängigkeit.
        vehicles ??= await Versuche(() => Api.GetVehiclesAsync());
        // Nur die letzten fünfundzwanzig: Das Foto vom Zähler ist eben hereingekommen und
        // steht damit oben. Ein Auswahlfeld mit der ganzen Ablage wäre eine Liste, durch die
        // niemand scrollt — und das Feld ist ohnehin freiwillig.
        documents ??= (await Versuche(() => Api.GetDocumentsAsync()))?.Items.Take(25).ToList();
    }

    private static async Task<T?> Versuche<T>(Func<Task<T>> abruf) where T : class
    {
        try
        {
            return await abruf();
        }
        catch (ApiException)
        {
            return null;
        }
    }

    // ── Kopf und Zeilen ────────────────────────────────────────────────────────────────────

    /// <summary>„3 Ablesungen · seit 30.09.2026“ — oder was davon dasteht.</summary>
    private static string HeadSub(ChargingOverviewDto strom)
    {
        if (strom.Readings.Count == 0)
        {
            return "geladen · noch keine Ablesung";
        }

        var erste = strom.Readings[^1].ReadOn;

        return $"geladen · {strom.Readings.Count} "
               + (strom.Readings.Count == 1 ? "Ablesung" : "Ablesungen")
               + $" · seit {GermanFormat.Date(erste)}";
    }

    /// <summary>Der jüngste Zählerstand — die Liste führt ihn zuerst.</summary>
    private static decimal? Letzter(ChargingOverviewDto strom)
        => strom.Readings.Count > 0 ? strom.Readings[0].MeterKwh : null;

    /// <summary>Was zwischen dieser Ablesung und der vorigen liegt.</summary>
    private string Zeitraum(ChargingReadingDto zeile)
    {
        if (zeile.Kwh is not { } menge)
        {
            return "Anfang der Reihe";
        }

        var teile = new List<string> { Kwh(menge) + " geladen" };

        if (zeile.Since is { } seit)
        {
            teile.Add($"seit {GermanFormat.Date(seit)}");
        }

        teile.Add(zeile.Amount is { } betrag ? State.Euro(betrag) : "ohne Satz");

        return string.Join(" · ", teile);
    }

    /// <summary>„ab 01.01.2026“ bzw. „01.01.2026 bis 31.12.2026“.</summary>
    private static string Geltung(ChargingRateDto satz)
        => satz.ValidUntil is { } bis
            ? $"{GermanFormat.Date(satz.ValidFrom)} bis {GermanFormat.Date(bis)}"
            : $"ab {GermanFormat.Date(satz.ValidFrom)}";

    private static string BelegLabel(DocumentListItemDto beleg)
        => beleg.DocumentDate is { } tag
            ? $"{beleg.Title} · {GermanFormat.Date(tag)}"
            : beleg.Title;

    /// <summary>
    /// Was der eingetippte Stand ergäbe.
    /// </summary>
    /// <remarks>
    /// Der Hinweis rechnet mit, bevor gespeichert wird — ein Zahlendreher fällt hier auf und
    /// nicht erst in der Abrechnung an den Arbeitgeber. Gerechnet wird gegen den <em>letzten</em>
    /// Stand; wer eine Ablesung mitten in die Reihe nachträgt, sieht den Hinweis nicht, aber der
    /// Dienst prüft sie trotzdem nach beiden Seiten.
    /// </remarks>
    private (string Text, bool Warnt)? Vorschau(ChargingOverviewDto strom)
    {
        if (Parse(fresh.Meter) is not { } stand
            || !DateOnly.TryParse(fresh.ReadOn, out var tag))
        {
            return null;
        }

        var davor = strom.Readings.Where(r => r.ReadOn < tag).MaxBy(r => r.ReadOn);
        var danach = strom.Readings.Where(r => r.ReadOn > tag).MinBy(r => r.ReadOn);

        if (davor is { } vorher && stand < vorher.MeterKwh)
        {
            return ($"Das liegt unter dem Stand vom {GermanFormat.Date(vorher.ReadOn)} "
                    + $"({Kwh(vorher.MeterKwh)}). Ein Zähler zählt aufwärts.", true);
        }

        if (danach is { } nachher && stand > nachher.MeterKwh)
        {
            return ($"Das liegt über dem Stand vom {GermanFormat.Date(nachher.ReadOn)} "
                    + $"({Kwh(nachher.MeterKwh)}), der später abgelesen wurde.", true);
        }

        return davor is { } basis
            ? ($"Das wären {Kwh(stand - basis.MeterKwh)} seit dem "
               + $"{GermanFormat.Date(basis.ReadOn)}.", false)
            : null;
    }

    private void Toggle(int id)
    {
        expanded = expanded == id ? null : id;
        deleting = null;
    }

    private void ToggleStatement(int id)
    {
        statement = statement == id ? null : id;
        deletingStatement = null;
        candidatesFor = null;
        candidates = null;
    }

    private void KeepStatement() => deletingStatement = null;

    /// <summary>„0,2000 €/kWh“ — oder der Hinweis, dass im Zeitraum mehrere galten.</summary>
    private static string Satzzeile(ChargingStatementDto blatt)
        => blatt.EuroPerKwh is { } satz
            ? "× " + Satz(satz)
            : "· mehrere Sätze im Zeitraum";

    /// <summary>Wo die Abrechnung steht, in einem Satz.</summary>
    private string Stand(ChargingStatementDto blatt)
    {
        if (blatt.Status == ChargingStatementStatus.Paid)
        {
            return blatt.PaidAt is { } tag
                ? $"erstattet am {GermanFormat.Date(DateOnly.FromDateTime(tag))}"
                : "erstattet";
        }

        if (blatt.Status == ChargingStatementStatus.Submitted)
        {
            var seit = blatt.SubmittedAt is { } tag
                ? $" seit {GermanFormat.Date(DateOnly.FromDateTime(tag))}"
                : null;

            return $"offen{seit}";
        }

        return "noch nicht eingereicht";
    }

    /// <summary>
    /// Was die nächste Abrechnung umfassen würde — oder warum keine möglich ist.
    /// </summary>
    /// <remarks>
    /// Der Satz steht über der Schaltfläche und nicht hinter ihr. Wer erst nach dem Drücken
    /// erfährt, dass nichts abzurechnen ist, hat einen Knopf gedrückt, der nichts tut.
    /// </remarks>
    private string Naechste(ChargingOverviewDto strom)
    {
        var naechste = strom.Next;

        if (!naechste.Possible)
        {
            return naechste.Obstacle ?? "Zurzeit lässt sich nichts abrechnen.";
        }

        return $"Nächste Abrechnung: {GermanFormat.Date(naechste.FromOn!.Value)} bis "
               + $"{GermanFormat.Date(naechste.ToOn!.Value)} · {Kwh(naechste.Kwh!.Value)} · "
               + State.Euro(naechste.Amount!.Value);
    }

    /// <summary>
    /// Öffnet das Blatt — mit allen Abrechnungen des Jahres bis zu dieser.
    /// </summary>
    /// <remarks>
    /// So wie die Vorlage es zeigt: eine Jahrestabelle, die mit jedem Monat länger wird. Das
    /// Blatt zu einer früheren Abrechnung zeigt den Stand von damals und nicht den von heute —
    /// sonst wäre es nicht mehr das Blatt, das eingereicht wurde.
    /// </remarks>
    private void ShowSheet(ChargingStatementDto blatt)
    {
        sheetYear = blatt.ToOn.Year;

        sheet =
        [
            .. (data?.Statements ?? [])
                .Where(a => a.ToOn.Year == sheetYear && a.ToOn <= blatt.ToOn)
                .OrderBy(a => a.ToOn),
        ];
    }

