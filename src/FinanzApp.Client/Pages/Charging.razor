    // ── Erfassen ───────────────────────────────────────────────────────────────────────────

    private void CancelCapture()
    {
        capturing = false;
        problem = null;
    }

    private void CancelRate()
    {
        rating = false;
        rateProblem = null;
    }

    private void KeepReading() => deleting = null;

    private void StartCapture()
    {
        capturing = true;
        problem = null;
        fresh = new ReadingDraft
        {
            ReadOn = DateTime.Now.ToString("yyyy-MM-dd"),
            Vehicle = vehicles?.Count == 1 ? vehicles[0].Id.ToString() : string.Empty,
        };
    }

    private void StartRate()
    {
        rating = true;
        rateProblem = null;

        // Der 1. Januar als Vorschlag: Der Satz wird je Kalenderjahr vereinbart. Ein Vorschlag
        // ist kein Zwang — das Feld lässt sich überschreiben.
        rate = new RateDraft { ValidFrom = $"{DateTime.Now.Year}-01-01" };
    }

    private Task SaveReadingAsync() => RunAsync(async () =>
    {
        busy = true;
        problem = null;

        try
        {
            if (!DateOnly.TryParse(fresh.ReadOn, out var tag))
            {
                problem = "Das Ablesedatum fehlt.";
                return;
            }

            if (Parse(fresh.Meter) is not { } stand)
            {
                problem = "Der Zählerstand fehlt.";
                return;
            }

            await Api.CreateChargingReadingAsync(new CreateChargingReadingRequest
            {
                EmploymentId = data?.EmploymentId,
                VehicleId = int.TryParse(fresh.Vehicle, out var wagen) ? wagen : null,
                ReadOn = tag,
                MeterKwh = stand,
                DocumentId = int.TryParse(fresh.Document, out var beleg) ? beleg : null,
                Note = fresh.Note,
            });

            capturing = false;
            await LoadAsync();
            Toasts.Show("Ablesung erfasst.", ToastKind.Saved);
        }
        finally
        {
            busy = false;
        }
    });

    private Task SaveRateAsync() => RunAsync(async () =>
    {
        busy = true;
        rateProblem = null;

        try
        {
            if (!DateOnly.TryParse(rate.ValidFrom, out var ab))
            {
                rateProblem = "Das Datum „gültig ab“ fehlt.";
                return;
            }

            if (Parse(rate.Euro) is not { } satz)
            {
                rateProblem = "Der Satz fehlt.";
                return;
            }

            await Api.CreateChargingRateAsync(new CreateChargingRateRequest
            {
                EmploymentId = data?.EmploymentId,
                ValidFrom = ab,
                EuroPerKwh = satz,
                Note = rate.Note,
            });

            rating = false;
            await LoadAsync();
            Toasts.Show("Satz eingetragen.", ToastKind.Saved);
        }
        finally
        {
            busy = false;
        }
    });

    private Task DeleteAsync(int id) => RunAsync(async () =>
