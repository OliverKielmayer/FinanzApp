    });

    // ── Formate ────────────────────────────────────────────────────────────────────────────

    /// <summary>Kilowattstunden mit so vielen Nachkommastellen, wie wirklich dastehen.</summary>
    private static string Kwh(decimal wert)
        => GermanFormat.Quantity(wert) + " kWh";

    /// <summary>Ein Satz je kWh — vier Nachkommastellen, wenn er sie trägt.</summary>
    private static string Satz(decimal wert)
        => GermanFormat.Price(wert) + "/kWh";

    /// <summary>Zahl wie getippt: deutsch mit Komma, notfalls mit Punkt.</summary>
    /// <remarks>
    /// Dieselbe Lesart wie in der Lohnmaske. Ein Zählerstand wird aus einem Display
    /// abgeschrieben, und wer „1.234,567“ tippt, meint nicht 1234567.
    /// </remarks>
    private static decimal? Parse(string text)
    {
        var sauber = text.Trim().Replace("kWh", string.Empty).Replace("€", string.Empty)
            .Replace(" ", string.Empty);

        if (sauber.Length == 0)
        {
            return null;
        }

        if (sauber.Contains(','))
        {
            sauber = sauber.Replace(".", string.Empty).Replace(',', '.');
        }

        return decimal.TryParse(
            sauber, System.Globalization.NumberStyles.Number,
            System.Globalization.CultureInfo.InvariantCulture, out var wert)
            ? wert
            : null;
    }
