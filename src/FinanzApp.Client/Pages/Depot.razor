@page "/depot"
@attribute [Authorize]
@inherits AppPage

<PageTitle>Depot — FinanzApp</PageTitle>

<AsyncView Loading="Loading" Error="@Error" Stale="HasLoadedOnce" Retry="ReloadAsync">
    @if (data is { } portfolio)
    {
        <section class="hero">
            <span class="label-muted">
                Depotwert · @portfolio.DepotName
                @if (portfolio.DepotId is { } depotId)
                {
                    <EditLink Type="depot" Id="depotId" />
                }
            </span>
            <span class="hero-value medium num">@State.Euro(portfolio.TotalValue)</span>
            <div class="hero-deltas">
                <span class="hero-delta-primary num">
                    @State.Euro(portfolio.Gain, withPlusSign: true) G/V
                </span>
                <span class="hero-delta-secondary num">
                    @GermanFormat.Percent(portfolio.GainPercent, 1, withPlusSign: true) ·
                    TTWROR @GermanFormat.Percent(portfolio.TwrorPercent, 1) p. a.
                </span>
            </div>
        </section>


        <section class="section">
            <div class="section-head">
                <span class="label-strong">Depotentwicklung</span>
                @* Der Kursstand bleibt sichtbar: die Kurse kommen aus einem austauschbaren
                   Anbieter und können veralten. *@
                @* Ein Kurs ohne belegbare Herkunft darf nicht aussehen wie einer vom Ticker.
                   Stammt er aus der letzten Ausführung, steht das dabei. *@
                <span class="meta num">Kurs @PriceNote(portfolio)</span>
            </div>
            <Sparkline Values="portfolio.History" Height="84" Top="12" Bottom="70"
                       Label="Depotentwicklung der letzten Monate" />
        </section>

        @* Drei Reiter statt einer langen Seite — v5-Handoff, Abschnitt 11. *@
        <div class="holdings-filter">
            @foreach (var (reiter, beschriftung) in Tabs)
            {
                var wahl = reiter;
                <button type="button" class="chip @(tab == reiter ? "active" : null)"
                        @onclick="() => PickAsync(wahl)">@beschriftung</button>
            }
        </div>

        @if (tab == DepotTab.Positions)
        {
        <div class="section" style="padding-bottom:4px">
            <span class="label-strong">Positionen</span>
            @if (portfolio.PricesFromTrades)
            {
                @* Nicht gepflegt, sondern gerechnet — das gehört dazu, sonst sucht jemand die
                   Zeile zum Bearbeiten. *@
                <span class="meta">aus den Ausführungen abgeleitet</span>
            }
        </div>

        @if (portfolio.Positions.Count == 0)
        {
            <EmptyState Title="Keine Position im Depot"
                        Text="Positionen entstehen aus den ausgeführten Orders. Die Orderdatei
                              des Brokers einlesen — dann stehen Stück, Einstand und Wert hier."
                        ActionLabel="Zu den Transaktionen" />
        }

        @if (band is { } zustand)
        {
            <QuoteBand Data="zustand" Busy="fetching" OnRefresh="RefreshQuotesAsync" />
        }

        @foreach (var position in portfolio.Positions)
        {
            var isin = position.Isin;
            var offen = open == isin;

            <div class="position-row @(offen ? "open" : null)">
                <button type="button" class="position-head" @onclick="() => ToggleAsync(position)">
                    <div class="position-line">
                        <span class="position-name">@position.Name</span>
                        <span class="position-value num">@State.Euro(position.Value)</span>
                    </div>
                    <div class="position-meta">
                        <span class="num">
                            @GermanFormat.Quantity(position.Quantity) St. ·
                            @State.Euro(position.Price) · @position.Isin
                        </span>
                        <span class="position-trend">
                            @* Die Sparkline zeigt die gespeicherte Reihe, nicht den Gewinn:
                               beides nebeneinander sagt, ob der Gewinn gerade entsteht oder
                               vergeht. *@
                            @if (Spark(isin) is { } linie)
                            {
                                <svg class="position-spark" viewBox="0 0 80 22" preserveAspectRatio="none"
                                     role="img" aria-label="Kursverlauf" focusable="false">
                                    <polyline fill="none" stroke-width="1.5" points="@linie.Points"
                                              stroke="@(linie.Rising ? "var(--color-accent)" : "var(--color-neutral-600)")"></polyline>
                                </svg>
                            }
                            <span class="position-gain num @(position.GainPercent < 0 ? "negative" : null)">
                                @GermanFormat.Percent(position.GainPercent, 1, withPlusSign: true)
                            </span>
                        </span>
                    </div>
                </button>

                @if (offen && series is { } verlauf && verlauf.Isin == isin)
                {
                    <QuoteChart Data="verlauf" Busy="fetching" OnPickRange="PickRangeAsync" />
                }
            </div>
        }

        <AddRow Route="/neu/depot" Label="Depot anlegen" />
        }
        else if (tab == DepotTab.Trades)
        {
            <DepotTradesTab DepotId="portfolio.DepotId ?? 0" OnImported="ReloadAsync" />
        }
        else
        {
            <DepotStatementsTab DepotId="portfolio.DepotId ?? 0" />
        }

        <div class="spacer"></div>
    }
    else if (!Loading && Error is null)
    {
        @* Kein Depot im Haushalt ist kein Fehler. Bis hierher meldete die Seite „Keine
           Verbindung zum Server“: der Endpunkt antwortet mit 404, und der Client machte
           daraus eine Aussage über das Netz. *@
        <div class="import-nothing">
            <span class="label-strong">Kein Depot erfasst</span>
            <span class="create-help">
                Mit einem Depot zeigt dieser Bereich Wert, Gewinn und Verlust je Position und
                die Entwicklung über die Zeit.
            </span>
        </div>

        <AddRow Route="/neu/depot" Label="Depot anlegen" />

        <div class="spacer"></div>
    }
</AsyncView>

@code {
    private enum DepotTab
    {
        Positions,
        Trades,
        Statements,
    }

    private static readonly (DepotTab Tab, string Label)[] Tabs =
    [
        (DepotTab.Positions, "Positionen"),
        (DepotTab.Trades, "Transaktionen"),
        (DepotTab.Statements, "Aufstellungen"),
    ];

    private PortfolioDto? data;
    private DepotTab tab = DepotTab.Positions;

    private QuoteBandDto? band;
    private QuoteSeriesDto? series;

    /// <summary>Welche Position aufgeklappt ist, über ihre ISIN.</summary>
    private string? open;

    private QuoteRange range = QuoteRange.Year;
    private bool fetching;

    protected override async Task LoadAsync()
    {
        data = await Api.GetPortfolioAsync();

        // Der Kursstand wird gelesen, nicht abgerufen: ein Abruf bei jedem Seitenaufruf wäre
        // bei einer inoffiziellen Quelle der schnellste Weg zur Sperre — Abschnitt 16.1.
        band = data is null ? null : await Api.GetQuoteBandAsync();
    }

    /// <summary>
    /// Ein Abruf — der eine Weg neben dem Zeitplan.
    /// </summary>
    /// <remarks>
    /// Danach wird die Seite neu geholt: die Bewertung hängt am jüngsten gespeicherten Kurs,
    /// und der ist jetzt ein anderer. Kopf, Zeile und Band lesen dieselbe Antwort.
    /// </remarks>
    private Task RefreshQuotesAsync() => RunAsync(async () =>
    {
        fetching = true;
        try
        {
            var ergebnis = await Api.RefreshQuotesAsync();
            Toasts.Show(ergebnis.Message);

            await LoadAsync();
            await LoadSeriesAsync();
        }
        finally
        {
            fetching = false;
        }
    });

    private Task ToggleAsync(PositionDto position)
    {
        if (open == position.Isin)
        {
            open = null;
            series = null;
            return Task.CompletedTask;
        }

        open = position.Isin;
        return LoadSeriesAsync();
    }

    private Task PickRangeAsync(QuoteRange gewaehlt)
    {
        range = gewaehlt;
        return LoadSeriesAsync();
    }

    /// <summary>Holt den Verlauf der aufgeklappten Position samt ihrem Einstand je Stück.</summary>
    /// <remarks>
    /// Der Einstand geht mit, weil die Einstandslinie zur Aussage des Charts gehört — und weil
    /// nur der Server weiß, was ein Stück gekostet hat.
    /// </remarks>
    private Task LoadSeriesAsync() => RunAsync(async () =>
    {
        if (open is not { Length: > 0 } isin || data is null)
        {
            series = null;
            return;
        }

        var position = data.Positions.FirstOrDefault(p => p.Isin == isin);
        var einstand = position is { Quantity: > 0m } p ? p.CostBasis / p.Quantity : (decimal?)null;

        series = await Api.GetQuoteSeriesAsync(isin, range, einstand);
    });

    /// <summary>Die Sparkline der Zeile — aus derselben Reihe wie der Chart darunter.</summary>
    /// <remarks>
    /// Sie entsteht nur für die aufgeklappte Position: die Reihen aller Papiere im Voraus zu
    /// holen hieße, für jede Zeile eine Anfrage zu stellen, die niemand angesehen hat.
    /// </remarks>
    private (string Points, bool Rising)? Spark(string? isin)
    {
        if (series is not { } reihe || reihe.Isin != isin || reihe.Points.Count < 2)
        {
            return null;
        }

        var tief = reihe.Low;
        var spanne = reihe.High - tief;
        var letzte = reihe.Points.Count - 1;

        var punkte = string.Join(' ', reihe.Points.Select((p, i) =>
        {
            var anteil = spanne == 0m ? 0.5m : (p.Close - tief) / spanne;
            var y = 22m - 3m - anteil * (22m - 6m);

            return (i * 80m / letzte).ToString("0.0", Invariant) + "," + y.ToString("0.0", Invariant);
        }));

        return (punkte, reihe.Points[^1].Close >= reihe.Points[0].Close);
    }

    private static readonly System.Globalization.CultureInfo Invariant =
        System.Globalization.CultureInfo.InvariantCulture;

    /// <summary>
    /// Woher der Kurs stammt.
    /// </summary>
    /// <remarks>
    /// <b>Ein Stand, überall derselbe</b> — Abschnitt 16.3. Kopfzeile, Kursband und
    /// Positionszeilen nennen denselben Tag; vorher stand „Stand 14.08.“ aus der
    /// Transaktionsableitung neben „heute 17:35“ auf demselben Schirm.
    /// </remarks>
    private static string PriceNote(PortfolioDto portfolio)
    {
        var stand = GermanFormat.Date(DateOnly.FromDateTime(portfolio.PricesAsOf));

        if (!portfolio.PricesFromTrades)
        {
            return stand;
        }

        return portfolio.Positions.Count == 1
            ? stand
            : $"{stand} · ältester der Position";
    }

    private Task PickAsync(DepotTab gewaehlt)
    {
        tab = gewaehlt;
        return Task.CompletedTask;
    }
}
