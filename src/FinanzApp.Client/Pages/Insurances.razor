@page "/versicherungen"
@attribute [Authorize]
@inherits AppPage

<PageTitle>Versicherungen — FinanzApp</PageTitle>

<div class="filter-chips">
    @foreach (var option in Filters)
    {
        <button type="button" class="chip @(filter == option.Key ? "active" : null)"
                @onclick="() => filter = option.Key">@option.Label @CountFor(option.Key)</button>
    }
</div>

<AsyncView Loading="Loading" Error="@Error" Retry="ReloadAsync">
    @if (Visible.Count == 0)
    {
        <div class="empty-area">
            <span class="empty-area-text">@EmptyText</span>
        </div>
    }

    @foreach (var insurance in Visible)
    {
        <button type="button" class="tap contract-row @(insurance.NoticeIsDue ? "deadline" : null)"
                @onclick="@(() => Navigation.NavigateTo($"/versicherungen/{insurance.Id}"))">
            <span class="stack">
                <span class="contract-name">@insurance.Name</span>
                <span class="meta">@Describe(insurance)</span>
            </span>
            <span class="contract-amount num">@State.Euro0(insurance.Premium)</span>
        </button>
    }

    <div class="spacer"></div>
</AsyncView>

@code {
    private enum Filter
    {
        All,
        Notice,
        Premium,
    }

    private static readonly (Filter Key, string Label)[] Filters =
    [
        (Filter.All, "Alle"),
        (Filter.Notice, "Frist"),
        (Filter.Premium, "Beitrag"),
    ];

    private IReadOnlyList<InsuranceListItemDto> insurances = [];
    private Filter filter = Filter.All;

    protected override async Task LoadAsync() => insurances = await Api.GetInsurancesAsync();

    private IReadOnlyList<InsuranceListItemDto> Visible => filter switch
    {
        Filter.Notice => [.. insurances.Where(i => i.NoticeIsDue)],
        Filter.Premium => [.. insurances.OrderByDescending(i => i.Premium)],
        _ => insurances,
    };

    private int CountFor(Filter key) => key switch
    {
        Filter.Notice => insurances.Count(i => i.NoticeIsDue),
        _ => insurances.Count,
    };

    private string EmptyText => filter == Filter.Notice
        ? "Keine Kündigungsfrist läuft gerade."
        : "Noch kein Versicherungsvertrag hinterlegt.";

    private static string Describe(InsuranceListItemDto insurance)
    {
        var parts = new List<string> { insurance.Insurer, Interval(insurance) };

        if (insurance.NoticeIsDue && insurance.DaysUntilNotice is { } days)
        {
            parts.Add(days == 0
                ? "Kündigung heute letzter Tag"
                : $"Kündigung bis {GermanFormat.Date(insurance.NoticeDeadline!.Value)} — {days} Tage");
        }
        else if (insurance.EndsOn is { } ends)
        {
            parts.Add("bis " + GermanFormat.Date(ends));
        }

        return string.Join(" · ", parts);
    }

    private static string Interval(InsuranceListItemDto insurance) => insurance.PremiumInterval switch
    {
        PremiumInterval.Monthly => GermanFormat.EuroRounded(insurance.Premium) + "/Monat",
        PremiumInterval.Quarterly => GermanFormat.EuroRounded(insurance.Premium) + "/Quartal",
        PremiumInterval.HalfYearly => GermanFormat.EuroRounded(insurance.Premium) + "/Halbjahr",
        _ => GermanFormat.EuroRounded(insurance.Premium) + "/Jahr",
    };
}
