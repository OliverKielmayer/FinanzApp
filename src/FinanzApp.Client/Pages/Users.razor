@page "/benutzer"
@attribute [Authorize]
@inherits AppPage
@inject FinanzAppAuthStateProvider Auth
@inject DeviceProfileStore Profiles

<PageTitle>Benutzer &amp; Anmeldung — FinanzApp</PageTitle>

<AsyncView Loading="Loading" Error="@Error" Stale="HasLoadedOnce" Retry="ReloadAsync">
    @if (data is { } household)
    {
        <div class="household-head">
            <span class="label-muted">Haushalt</span>
            <span class="household-name">@household.HouseholdName</span>
            <span class="household-sub">
                @household.Members.Count @(household.Members.Count == 1 ? "Benutzer" : "Benutzer") ·
                gemeinsame Konten, getrennte Anmeldung
            </span>
        </div>

        @foreach (var member in household.Members)
        {
            <div class="member-row">
                <div class="stack">
                    <span class="member-name">@member.Name</span>
                    <span class="member-mail">@member.Email</span>
                    <span class="meta">zuletzt aktiv: @LastSeen(member.LastSeenAt)</span>
                    <span class="meta">@Sees(member)</span>
                </div>
                <div class="member-side">
                    <span class="tag @RoleTag(member.Role)">@RoleLabel(member.Role)</span>
                    @if (canManage)
                    {
                        <button type="button" class="member-rights"
                                @onclick="@(() => Toasts.Show("Rechteverwaltung folgt"))">Rechte</button>
                    }
                </div>
            </div>
        }

        @if (household.Invitation is { } invitation)
        {
            <div class="invite">
                <span class="label-strong">Einladen</span>
                <div class="invite-line">
                    <span class="invite-code">@invitation.Code</span>
                    <button type="button" class="invite-link" disabled="@busy"
                            @onclick="NewInviteAsync">Neuer Code</button>
                </div>
                <span class="meta">
                    Gültig bis @GermanFormat.Date(DateOnly.FromDateTime(invitation.ExpiresAt)) ·
                    einmalige Verwendung
                </span>
            </div>
        }
        else if (canManage)
        {
            <div class="invite">
                <span class="label-strong">Einladen</span>
                <div class="invite-line">
                    <span class="meta">Kein gültiger Code.</span>
                    <button type="button" class="invite-link" disabled="@busy"
                            @onclick="NewInviteAsync">Code erzeugen</button>
                </div>
            </div>
        }

        <div class="session">
            <span class="label-strong">Diese Sitzung</span>
            <span class="session-line">
                Angemeldet als @household.Session.UserName ·
                seit @household.Session.SignedInAt.ToString("HH:mm") · dieses Gerät
            </span>
            <div class="session-actions">
                <button type="button" class="btn btn-secondary" disabled="@busy"
                        @onclick="SwitchUserAsync">Benutzer wechseln</button>
                <button type="button" class="btn btn-primary" disabled="@busy"
                        @onclick="LogoutAsync">Abmelden</button>
            </div>
        </div>

        @*
            Nur eigene Konten. Fremde stehen nicht hier — ihre Freigabe verwaltet der
            Eigentümer, und ein Schalter, der nichts bewirkt, wäre schlimmer als keiner.
        *@
        <div class="session">
            <span class="label-strong">Kontofreigaben</span>

            @if (mine.Count == 0)
            {
                <span class="session-line">
                    @foreign @(foreign == 1 ? "Konto ist" : "Konten sind") für dich freigegeben —
                    die Freigabe verwaltet jeweils der Eigentümer.
                </span>
            }
            else
            {
                <span class="session-line">@shared von @mine.Count eigenen geteilt</span>

                @foreach (var account in mine)
                {
                    var konto = account;

                    <div class="share-row">
                        <div class="stack">
                            <span class="member-name">@konto.Name</span>
                            <span class="meta">@Reach(konto)</span>
                        </div>

                        <AuthorizeView Roles="Owner,Member" Context="share">
                            <div class="chipcloud">
                                <button type="button"
                                        class="chip @(konto.Sharing == AccountSharing.Household ? "active" : null)"
                                        disabled="@busy"
                                        @onclick="() => ShareAsync(konto, AccountSharing.Household, [])">
                                    Haushalt
                                </button>
                                <button type="button"
                                        class="chip @(IsPrivate(konto) ? "active" : null)"
                                        disabled="@busy"
                                        @onclick="() => ShareAsync(konto, AccountSharing.Private, [])">
                                    Nur ich
                                </button>

                                @* Die Chips kommen aus der Mitgliederliste — ohne den
                                   Angemeldeten: er selbst ist „Nur ich“. *@
                                @foreach (var other in Others(household))
                                {
                                    var wer = other;
                                    <button type="button"
                                            class="chip @(SharedWith(konto, wer.Id) ? "active" : null)"
                                            disabled="@busy"
                                            @onclick="() => ToggleShareAsync(konto, wer.Id)">
                                        @wer.Name
                                    </button>
                                }
                            </div>
                        </AuthorizeView>
                    </div>
                }
            }
        </div>

        @* Das eigene Passwort ändern. Nicht der Vergessen-Weg — hier zählt, dass jemand das
           bisherige kennt. *@
        <div class="session">
            <span class="label-strong">Passwort ändern</span>

            @if (!changing)
            {
                <span class="session-line">
                    Ein neues Passwort beendet alle anderen offenen Sitzungen. Diese hier bleibt.
                </span>
                <div class="session-actions">
                    <button type="button" class="btn btn-secondary"
                            @onclick="@(() => changing = true)">Passwort ändern</button>
                </div>
            }
            else
            {
                <div class="field">
                    <label for="pw-old">Bisheriges Passwort</label>
                    <input id="pw-old" class="input" type="password" autocomplete="current-password"
                           value="@currentPassword"
                           @oninput="e => currentPassword = e.Value?.ToString() ?? string.Empty" />
                </div>

                <div class="field">
                    <label for="pw-new">Neues Passwort</label>
                    <input id="pw-new" class="input" type="password" autocomplete="new-password"
                           placeholder="@($"mindestens {PasswordPolicy.MinimumLength} Zeichen")"
                           value="@newPassword" @oninput="OnNewPasswordInput" />
                </div>

                <div class="strength">
                    <div class="strength-bars" role="img" aria-label="@($"Passwortstärke: {strengthText}")">
                        @for (var level = 1; level <= 4; level++)
                        {
                            <div class="strength-bar @BarClass(level)"></div>
                        }
                    </div>
                    <span class="strength-text">@strengthText</span>
                </div>

                @if (problem is { Length: > 0 })
                {
                    <span class="create-problem">@problem</span>
                }

                <div class="session-actions">
                    <button type="button" class="btn btn-primary"
                            disabled="@(busy || !CanSubmit)" @onclick="ChangePasswordAsync">
                        Passwort speichern
                    </button>
                    <button type="button" class="btn btn-secondary" disabled="@busy"
                            @onclick="CancelChange">Abbrechen</button>
                </div>
            }
        </div>

        <div class="spacer"></div>
    }
</AsyncView>

@code {
    private HouseholdOverviewDto? data;
    private IReadOnlyList<AccountDto> accounts = [];

    /// <summary>Die eigenen Konten — nur sie lassen sich hier umstellen.</summary>
    private List<AccountDto> mine = [];

    /// <summary>Wie viele fremde Konten für mich freigegeben sind.</summary>
    private int foreign;

    /// <summary>Wie viele eigene ich geteilt habe.</summary>
    private int shared;
    private bool canManage;
    private bool busy;

    private bool changing;
    private string currentPassword = string.Empty;
    private string newPassword = string.Empty;
    private string? problem;
    private PasswordStrength strength = PasswordStrength.None;
    private string strengthText = PasswordPolicy.Describe(PasswordStrength.None);

    private bool CanSubmit =>
        currentPassword.Length > 0 && PasswordPolicy.IsAcceptable(newPassword);

    private void OnNewPasswordInput(ChangeEventArgs e)
    {
        newPassword = e.Value?.ToString() ?? string.Empty;
        strength = PasswordPolicy.Evaluate(newPassword);
        strengthText = PasswordPolicy.Describe(strength);
        problem = null;
    }

    /// <summary>Gefüllte Balken bis zur erreichten Stufe; ab „Gut“ in Akzent.</summary>
    private string? BarClass(int level)
    {
        if (level > (int)strength)
        {
            return null;
        }

        return strength >= PasswordPolicy.Required ? "filled enough" : "filled";
    }

    private void CancelChange()
    {
        changing = false;
        currentPassword = string.Empty;
        newPassword = string.Empty;
        problem = null;
        strength = PasswordStrength.None;
        strengthText = PasswordPolicy.Describe(PasswordStrength.None);
    }

    private async Task ChangePasswordAsync()
    {
        busy = true;
        problem = null;

        try
        {
            await Api.ChangePasswordAsync(currentPassword, newPassword);

            CancelChange();
            Toasts.Show("Passwort geändert · andere Sitzungen beendet");
        }
        catch (ApiException ex)
        {
            // Der Grund kommt vom Server und steht am Feld — nicht als flüchtiger Toast.
            problem = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    protected override async Task LoadAsync()
    {
        var konten = Api.GetAccountsAsync();

        data = await Api.GetHouseholdAsync();
        accounts = await konten;
        canManage = Auth.User?.CanManageUsers == true;

        Recount();
    }

    private void Recount()
    {
        mine = [.. accounts.Where(a => a.IsMine)];
        foreign = accounts.Count(a => !a.IsMine);
        shared = mine.Count(a => a.Sharing != AccountSharing.Private
                                 && !(a.Sharing == AccountSharing.Named && a.SharedWith.Count == 0));
    }

    /// <summary>
    /// Die übrigen Mitglieder — ohne den Angemeldeten.
    /// </summary>
    /// <remarks>
    /// Er selbst ist „Nur ich“; ein Chip mit dem eigenen Namen wäre entweder wirkungslos oder
    /// eine zweite Schreibweise für dieselbe Sache.
    /// </remarks>
    private IEnumerable<HouseholdMemberDto> Others(HouseholdOverviewDto household)
        => household.Members.Where(m => m.Id != Auth.User?.Id);

    private static bool IsPrivate(AccountDto account)
        => account.Sharing == AccountSharing.Private
           || (account.Sharing == AccountSharing.Named && account.SharedWith.Count == 0);

    private static bool SharedWith(AccountDto account, int userId)
        => account.Sharing == AccountSharing.Named
           && account.SharedWith.Any(s => s.UserId == userId);

    /// <summary>Wen das Konto erreicht — in Klartext, nicht als Rohwert.</summary>
    private string Reach(AccountDto account)
    {
        if (account.Sharing == AccountSharing.Household)
        {
            var alle = data?.Members.Count ?? 0;
            return alle == 1 ? "nur du" : $"alle {alle} Benutzer";
        }

        if (IsPrivate(account))
        {
            return "nur " + (Auth.User?.Name ?? "du");
        }

        // Der Eigentümer sieht sein Konto immer mit — er gehört in die Aufzählung.
        var namen = new List<string> { Auth.User?.Name ?? "du" };
        namen.AddRange(account.SharedWith.Select(x => x.Name));

        return string.Join(" + ", namen);
    }

    /// <summary>
    /// Wie viele Konten ein Mitglied sieht.
    /// </summary>
    /// <remarks>
    /// Der Plural richtet sich nach der Gesamtzahl, nicht nach der gesehenen: „sieht 1 von 3
    /// Konten“, nicht „1 von 3 Konto“.
    /// </remarks>
    private static string Sees(HouseholdMemberDto member)
    {
        var text = $"sieht {member.VisibleAccountCount} von {member.TotalAccountCount} "
                   + (member.TotalAccountCount == 1 ? "Konto" : "Konten");

        return member.Role == HouseholdRole.ReadOnly ? text + " · nur lesend" : text;
    }

    private Task ShareAsync(AccountDto account, AccountSharing sharing, IReadOnlyList<int> userIds)
        => ApplyAsync(account, sharing, userIds);

    /// <summary>Einen Namen zu- oder abschalten. Bleibt keiner übrig, ist das Konto privat.</summary>
    private Task ToggleShareAsync(AccountDto account, int userId)
    {
        var namen = account.Sharing == AccountSharing.Named
            ? account.SharedWith.Select(s => s.UserId).ToList()
            : [];

        if (!namen.Remove(userId))
        {
            namen.Add(userId);
        }

        return ApplyAsync(
            account,
            namen.Count == 0 ? AccountSharing.Private : AccountSharing.Named,
            namen);
    }

    private Task ApplyAsync(AccountDto account, AccountSharing sharing, IReadOnlyList<int> userIds)
        => RunAsync(async () =>
        {
            busy = true;
            try
            {
                var geaendert = await Api.SetAccountSharingAsync(account.Id, sharing, userIds);

                // Nur die eine Zeile ersetzen: die Liste neu zu laden würde die Ansicht
                // zurücksetzen, obwohl sich genau ein Konto geändert hat.
                accounts = [.. accounts.Select(a => a.Id == geaendert.Id ? geaendert : a)];
                Recount();

                Toasts.Show($"{geaendert.Name}: {Reach(geaendert)}");
            }
            finally
            {
                busy = false;
            }
        });

    private Task NewInviteAsync() => RunAsync(async () =>
    {
        busy = true;
        try
        {
            var invitation = await Api.CreateInvitationAsync();
            data = data! with { Invitation = invitation };
            Toasts.Show("Neuer Einladungscode erzeugt");
        }
        finally
        {
            busy = false;
        }
    });

    /// <summary>Meldet ab, lässt die Profilliste des Geräts aber stehen.</summary>
    private Task SwitchUserAsync() => EndSessionAsync(forgetProfile: false, "Benutzer wechseln");

    /// <summary>Meldet ab und vergisst das Profil auf diesem Gerät.</summary>
    private Task LogoutAsync() => EndSessionAsync(forgetProfile: true, "Abgemeldet");

    private async Task EndSessionAsync(bool forgetProfile, string message)
    {
        busy = true;
        try
        {
            var email = Auth.User?.Email;
            await Api.LogoutAsync();

            if (forgetProfile && email is not null)
            {
                await Profiles.ForgetAsync(email);
            }

            Auth.SetUser(null);
            Toasts.Show(message);
            Navigation.NavigateTo(AuthScreens.Login, replace: true);
        }
        catch (ApiException ex)
        {
            Toasts.Show(ex.Message);
        }
        finally
        {
            busy = false;
        }
    }

    private static string LastSeen(DateTime? value)
    {
        if (value is not { } seen)
        {
            return "noch nie";
        }

        var today = DateOnly.FromDateTime(DateTime.Now);
        var day = DateOnly.FromDateTime(seen);

        return day == today ? $"heute, {seen:HH:mm}"
            : day == today.AddDays(-1) ? $"gestern, {seen:HH:mm}"
            : GermanFormat.Date(day);
    }

    private static string RoleLabel(HouseholdRole role) => role switch
    {
        HouseholdRole.Owner => "Inhaber",
        HouseholdRole.Member => "Mitglied",
        _ => "Lesezugriff",
    };

    private static string RoleTag(HouseholdRole role) => role switch
    {
        HouseholdRole.Owner => "tag-accent",
        HouseholdRole.Member => "tag-neutral",
        _ => "tag-outline",
    };
}
