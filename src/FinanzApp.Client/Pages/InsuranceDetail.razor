@page "/versicherungen/{Id:int}"
@attribute [Authorize]
@inherits AppPage

<PageTitle>Versicherung — FinanzApp</PageTitle>

<AsyncView Loading="Loading" Error="@Error" Retry="ReloadAsync">
    @if (data is { } insurance)
    {
        <section class="hero">
            <span class="label-muted">@insurance.Name</span>
            <span class="hero-value medium">@insurance.Insurer</span>
            <span class="loan-sub num">
                @(insurance.PolicyNumber is { Length: > 0 } number ? "Nr. " + number + " · " : string.Empty)
                @State.Euro0(insurance.Premium) @IntervalLabel(insurance.PremiumInterval) ·
                @State.Euro(insurance.MonthlyPremium) je Monat
            </span>
        </section>

        @* Die Frist wird nicht gepflegt, sondern gerechnet: Vertragsende minus Kündigungsfrist. *@
        <div class="section" style="padding-bottom:4px">
            <span class="label-strong">Fristen</span>
        </div>

        @if (insurance.NoticeDeadline is { } deadline)
        {
            @if (insurance.NoticeIsDue)
            {
                <div class="notice">
                    <span class="notice-title">Kündigung bis @GermanFormat.Date(deadline)</span>
                    <span class="notice-text">
                        noch @insurance.DaysUntilNotice Tage ·
                        @insurance.NoticePeriodMonths Monate vor Ablauf
                    </span>
                </div>
            }
            else
            {
                <div class="detail-block">
                    <span class="detail-label">Kündigung möglich bis</span>
                    <span class="detail-value num">
                        @GermanFormat.Date(deadline) · @insurance.NoticePeriodMonths Monate vor Ablauf
                    </span>
                </div>
            }
        }
        else
        {
            <div class="detail-block">
                <span class="detail-label">Kündigung</span>
                <span class="detail-value">Kein Vertragsende hinterlegt — daraus lässt sich keine Frist ableiten.</span>
            </div>
        }

        <div class="detail-block">
            <span class="detail-label">Laufzeit · Konto</span>
            <span class="detail-value num">
                @(insurance.StartsOn is { } from ? "seit " + GermanFormat.Date(from) : "Beginn offen")
                @(insurance.EndsOn is { } to ? " · bis " + GermanFormat.Date(to) : string.Empty)
                @(insurance.AccountName is { Length: > 0 } account ? " · " + account : string.Empty)
            </span>
        </div>

        <div class="list-head">
            <span class="label-strong">Dokumente</span>
            <span class="list-count num">@insurance.Documents.Count</span>
        </div>

        @if (insurance.Documents.Count == 0)
        {
            <div class="empty-area">
                <span class="empty-area-text">Kein Dokument hinterlegt.</span>
            </div>
        }

        @foreach (var document in insurance.Documents)
        {
            <button type="button" class="tap doc-row @(document.FileExists ? null : "missing")"
                    @onclick="@(() => Navigation.NavigateTo($"/dokumente/{document.Id}"))">
                <span class="stack">
                    <span class="doc-name">@document.Title</span>
                    <span class="doc-meta">
                        @(document.FileExists
                            ? $"{document.TypeName} · {(document.DocumentDate is { } d ? GermanFormat.Date(d) : "ohne Datum")}"
                            : "Datei nicht gefunden")
                    </span>
                </span>
            </button>
        }

        <div class="list-head">
            <span class="label-strong">Zahlungen</span>
            <span class="list-count num">@insurance.Payments.Count</span>
        </div>

        @if (insurance.Payments.Count == 0)
        {
            <div class="empty-area">
                <span class="empty-area-text">Noch keine Buchung gefunden, die zu diesem Vertrag passt.</span>
            </div>
        }

        @foreach (var payment in insurance.Payments)
        {
            <div class="row">
                <div class="stack">
                    <span class="balance-label plain">@payment.Payee</span>
                    <span class="meta num">@GermanFormat.Date(payment.BookingDate) · @payment.AccountName</span>
                </div>
                <span class="balance-value num">@State.Euro(payment.Amount)</span>
            </div>
        }

        <div class="spacer"></div>
    }
</AsyncView>

@code {
    [Parameter] public int Id { get; set; }

    private InsuranceDetailDto? data;

    protected override async Task LoadAsync() => data = await Api.GetInsuranceAsync(Id);

    private static string IntervalLabel(PremiumInterval interval) => interval switch
    {
        PremiumInterval.Monthly => "monatlich",
        PremiumInterval.Quarterly => "vierteljährlich",
        PremiumInterval.HalfYearly => "halbjährlich",
        _ => "jährlich",
    };
}
