@page "/mehr"
@attribute [Authorize]
@inherits AppPage
@inject FinanzAppAuthStateProvider Auth

<PageTitle>Alle Bereiche — FinanzApp</PageTitle>

@*
    „Mehr“ ist mit der Erweiterung die Bereichsliste: jede Zeile trägt einen Untertitel und
    rechts eine Kennzahl. Konten, Budgets und Depot stehen hier, seit die Tab-Bar Vorgänge und
    Dokumente aufgenommen hat — die Screens selbst sind unverändert.
*@
<AsyncView Loading="Loading" Error="@Error" Retry="ReloadAsync">
    @if (data is { } overview)
    {
        @foreach (var area in Rows(overview))
        {
            <button type="button" class="tap more-row" @onclick="() => Open(area)">
                <span class="stack">
                    <span class="more-label">@area.Label</span>
                    <span class="meta">@area.Subtitle</span>
                </span>
                <span class="more-value num">@area.Value</span>
            </button>
        }

        <div class="spacer"></div>
    }
</AsyncView>

@code {
    private sealed record AreaRow(string Label, string Subtitle, string Value, string? Route, string? Toast = null);

    private MoreOverviewDto? data;

    protected override async Task LoadAsync() => data = await Api.GetMoreOverviewAsync();

    private IEnumerable<AreaRow> Rows(MoreOverviewDto overview)
    {
        var areas = overview.Areas;

        yield return new AreaRow(
            "Konten & Buchungen",
            "Girokonten, Tagesgeld, Import",
            string.Empty,
            "/konten");

        yield return new AreaRow("Budgets", "Monat · Quartal · Jahr", string.Empty, "/budgets");

        yield return new AreaRow("Depot", "Wertpapiere und Kurse", string.Empty, "/depot");

        yield return new AreaRow(
            "Darlehen",
            $"{overview.Loan.Lender} · Rate {GermanFormat.EuroRounded(overview.Loan.Installment)}",
            State.Euro0(-overview.Loan.RemainingDebt),
            "/darlehen");

        yield return new AreaRow(
            "Datenimport",
            $"{overview.Import.Formats} · {overview.Import.ProfileCount} Profile",
            "CAMT",
            "/import");

        yield return new AreaRow(
            "Vorsorge & Kapital",
            $"Kapital-LV, Riester, Bausparen · Stand {GermanFormat.Date(overview.Pension.ValuationDate)}",
            State.Euro0(overview.Pension.TotalValue),
            "/vorsorge");

        yield return new AreaRow(
            "Absicherung",
            "Verträge, Beiträge, Fristen — ohne Vermögenswert",
            $"{areas.ProtectionCount} Verträge",
            "/absicherung");

        yield return new AreaRow(
            "Gesundheit / PKV",
            "Arztrechnungen und Erstattungen",
            areas.OpenMedicalBillCount == 0 ? "erledigt" : $"{areas.OpenMedicalBillCount} offen",
            "/gesundheit");

        yield return new AreaRow(
            "Wohnen & Immobilien",
            $"{areas.PropertyCount} Objekt · {areas.ContractCount} Verträge",
            string.Empty,
            "/wohnen");

        yield return new AreaRow(
            "Auswertungen",
            "Liquidität, Kategorien, Sparpotential",
            string.Empty,
            "/liquiditaet");

        yield return new AreaRow(
            "Kategorien",
            $"{overview.CategoryCount} Kategorien · Ausgaben und Einnahmen",
            string.Empty,
            "/kategorien");

        yield return new AreaRow(
            "Kategorieregeln",
            $"{overview.RuleCount} Regeln · gelernt beim Import",
            string.Empty,
            "/kategorieregeln");

        // Nicht gestaltet — laut Handoff vor dem Bau anzufragen. Die Zeile führt deshalb nicht
        // ins Leere, sondern sagt, woran es liegt.
        yield return new AreaRow(
            "Arbeit & Beruf",
            "Arbeitgeber, Verträge, Lohnabrechnungen",
            "geplant",
            null,
            "Arbeit & Beruf ist noch nicht gestaltet");

        yield return new AreaRow(
            "Benutzer & Anmeldung",
            $"{Auth.User?.HouseholdName} · {overview.HouseholdMemberCount} Benutzer",
            Auth.User?.Name ?? string.Empty,
            "/benutzer");

        yield return new AreaRow(
            "Administration",
            "Dokumenttypen, Kategorien, Regeln",
            "geplant",
            null,
            "Administration ist noch nicht gestaltet");

        yield return new AreaRow(
            "Sicherheit",
            $"{(overview.Security.TwoFactorEnabled ? "2FA aktiv" : "2FA noch nicht aktiv")} · "
                + $"Backup {GermanFormat.DateTime(overview.Security.LastBackup)}",
            overview.Security.TwoFactorEnabled ? "OK" : "Prüfen",
            null,
            overview.Security.TwoFactorEnabled ? "Alle Backups gültig" : "2FA folgt in einer späteren Runde");

        yield return new AreaRow(
            "Dokumente",
            areas.MissingFileCount == 0
                ? "Ablage aller Bereiche"
                : $"Ablage aller Bereiche · {areas.MissingFileCount} ohne Datei",
            $"{areas.DocumentCount}",
            "/dokumente");
    }

    private void Open(AreaRow area)
    {
        if (area.Route is { } route)
        {
            Navigation.NavigateTo(route);
            return;
        }

        Toasts.Show(area.Toast ?? "Folgt");
    }
}
