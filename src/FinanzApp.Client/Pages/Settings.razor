@page "/einstellungen"
@attribute [Authorize]
@inherits AppPage

@*
    Einstellungen — v5-Handoff, Abschnitt 5.

    Stammdaten, die man dreimal im Jahr braucht und die vorher dauerhaft in der Navigation
    standen. Sieben Zeilen mit Untertitel und rechter Kennzahl; die Einzelscreens bleiben, wie
    sie sind — sie haben nur keinen Platz mehr in der ersten Ebene.
*@

<PageTitle>Einstellungen — FinanzApp</PageTitle>

<AsyncView Loading="Loading" Error="@Error" Stale="HasLoadedOnce" Retry="ReloadAsync">
    @if (data is { } overview)
    {
        @foreach (var zeile in Rows(overview))
        {
            @if (zeile.Route is { } ziel)
            {
                <a class="setting-row" href="@ziel">
                    <span class="stack">
                        <span class="setting-name">@zeile.Label</span>
                        <span class="meta">@zeile.Subtitle</span>
                    </span>
                    <span class="setting-value num">@zeile.Value</span>
                </a>
            }
            else
            {
                @* Ohne Ziel keine Verknüpfung: ein Link, der nirgendwohin führt, ist ein
                   Versprechen, das der nächste Klick bricht. *@
                <div class="setting-row plain">
                    <span class="stack">
                        <span class="setting-name">@zeile.Label</span>
                        <span class="meta">@zeile.Subtitle</span>
                    </span>
                    <span class="setting-value num">@zeile.Value</span>
                </div>
            }
        }

        <div class="spacer"></div>
    }
</AsyncView>

@code {
    private sealed record SettingRow(string Label, string Subtitle, string Value, string? Route);

    private MoreOverviewDto? data;
    private QuoteBandDto? band;

    protected override async Task LoadAsync()
    {
        data = await Api.GetMoreOverviewAsync();

        // Gelesen, nicht abgerufen: der Zeitplan und der Knopf im Depot sind die beiden Wege
        // zu einem Abruf, und ein dritter über den Seitenaufbau wäre einer zu viel.
        band = await Api.GetQuoteBandAsync();
    }

    private IEnumerable<SettingRow> Rows(MoreOverviewDto overview)
    {
        yield return new SettingRow(
            "Kategorien",
            "Ausgaben und Einnahmen · bestimmen Budgets und Auswertungen",
            $"{overview.CategoryCount}",
            "/kategorien");

        yield return new SettingRow(
            "Kategorieregeln",
            "greifen beim Import, bevor gefragt wird",
            $"{overview.RuleCount} {(overview.RuleCount == 1 ? "Regel" : "Regeln")}",
            "/kategorieregeln");

        yield return new SettingRow(
            "Benutzer & Freigaben",
            "Haushalt, Rollen, Kontofreigaben",
            $"{overview.HouseholdMemberCount} "
            + (overview.HouseholdMemberCount == 1 ? "Benutzer" : "Benutzer"),
            "/benutzer");

        yield return new SettingRow(
            "Importprofile",
            "erkannte Formate beim Einlesen",
            overview.Import.Formats,
            "/import");

        yield return new SettingRow(
            "Dokumentablage",
            "relative Pfade unterhalb des Dokumentordners",
            $"{overview.Areas.DocumentCount}",
            "/dokumente");

        yield return new SettingRow(
            "Dokumenttypen",
            "bestimmen Ablagepfad und Beleganalyse",
            $"{overview.DocumentTypeCount}",
            "/dokumenttypen");

        // Die Zeile führt ins Depot: dort steht das Band mit dem Zustand, und dort ist auch
        // der Knopf. Eine Einstellungsseite, die den Abruf selbst anstößt, hätte zwei Orte für
        // dieselbe Handlung.
        yield return new SettingRow(
            "Kursquelle",
            QuoteLine(),
            QuoteState(),
            "/depot");

        yield return new SettingRow(
            "Sicherheit & Sicherung",
            SecurityLine(overview.Security),
            overview.Security.TwoFactorEnabled ? "2FA aktiv" : "2FA aus",
            null);
    }

    /// <summary>Was zur Kursquelle unter der Zeile steht.</summary>
    /// <remarks>
    /// Der Satz nennt, was die eigentliche Zusage ist: der Verlauf gehört der Anwendung. Ohne
    /// ihn läse sich die Zeile wie eine Abhängigkeit von einem fremden Dienst.
    /// </remarks>
    private string QuoteLine()
    {
        if (band is not { } zustand)
        {
            return "Kursverlauf wird gespeichert";
        }

        var stand = zustand.FetchedAt is { } zeit
            ? "zuletzt " + GermanFormat.DateTime(zeit)
            : "noch nie abgerufen";

        return $"{zustand.Source} · {stand} · Verlauf wird gespeichert";
    }

    private string QuoteState() => band?.State switch
    {
        FinanzApp.Shared.Contracts.QuoteState.Fresh => "aktuell",
        FinanzApp.Shared.Contracts.QuoteState.Stale => "veraltet",
        FinanzApp.Shared.Contracts.QuoteState.Failed => "Fehler",
        FinanzApp.Shared.Contracts.QuoteState.Never => "nie",
        _ => "—",
    };

    private static string SecurityLine(SecuritySummaryDto security)
    {
        var faktor = security.TwoFactorEnabled
            ? "Zwei-Faktor-Anmeldung aktiv"
            : "Zwei-Faktor-Anmeldung noch nicht aktiv";

        return security.LastBackup == default
            ? faktor
            : $"{faktor} · letzte Sicherung {GermanFormat.DateTime(security.LastBackup)}";
    }
}
