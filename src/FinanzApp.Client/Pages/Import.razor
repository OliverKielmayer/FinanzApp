@page "/import"
@attribute [Authorize]
@inherits AppPage
@inject ImportDraft Draft

@*
    Der Import ist ein Flow, keine feste Zusammenfassung: leer → liest → prüfen → übernommen.
    Ab Tablet zweispaltig — links, was in der Datei steht, rechts die Prüfung.

    Die eine Regel, die alles zusammenhält: Zähler und Aktionsschalter lesen **dieselbe**
    Auswahl. Ein zugeschaltetes Duplikat erhöht „Übernehmen“ mit, sonst widerspräche der Kopf
    dem Knopf.
*@

<PageTitle>Kontoauszug einlesen — FinanzApp</PageTitle>

<AsyncView Loading="Loading" Error="@Error" Retry="ReloadAsync">
    @if (data is { } preview)
    {
        @if (stage == Stage.Empty)
        {
            <AuthorizeView Roles="Owner,Member" Context="write">
                <Authorized>
                    <div class="import-panel blueprint dropzone @(dragging ? "over" : null)"
                         @ondragenter="() => dragging = true"
                         @ondragleave="() => dragging = false"
                         @ondrop="() => dragging = false">
                        <i class="corner tl" aria-hidden="true"></i>
                        <i class="corner tr" aria-hidden="true"></i>
                        <i class="corner bl" aria-hidden="true"></i>
                        <i class="corner br" aria-hidden="true"></i>

                        @* Liegt unsichtbar über der ganzen Fläche: derselbe Weg nimmt den Klick
                           und die fallengelassene Datei. *@
                        <InputFile class="dropzone-input"
                                   accept=".xml,.camt,.zip,text/xml,application/xml,application/zip"
                                   OnChange="OnFileSelected" aria-label="Kontoauszug auswählen" />

                        <span class="kicker">Kontoauszug einlesen</span>
                        <span class="create-help">
                            camt.052 oder camt.053 hierher ziehen oder anklicken — einzeln oder
                            als ZIP mit den Tagesauszügen darin.
                        </span>

                        @if (problem is { Length: > 0 })
                        {
                            <span class="create-problem">@problem</span>
                        }

                        <div class="doc-actions">
                            <button type="button" class="btn btn-secondary" @onclick="ReadExampleAsync">
                                Beispielauszug einlesen
                            </button>
                        </div>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="import-panel blueprint">
                        <i class="corner tl" aria-hidden="true"></i>
                        <i class="corner tr" aria-hidden="true"></i>
                        <i class="corner bl" aria-hidden="true"></i>
                        <i class="corner br" aria-hidden="true"></i>

                        <span class="kicker">Kontoauszug einlesen</span>
                        <span class="create-help">Zum Einlesen fehlen die Rechte.</span>
                    </div>
                </NotAuthorized>
            </AuthorizeView>

            @if (preview.LastImport is { } last)
            {
                <div class="list-head">
                    <span class="label-strong">Zuletzt importiert</span>
                </div>
                <div class="detail-block">
                    <span class="detail-label">@last.FileName</span>
                    <span class="detail-value num">
                        @GermanFormat.Date(last.ImportedOn) · @last.AccountName · @last.RecordCount Sätze
                    </span>
                </div>
            }
        }
        else if (stage == Stage.Reading)
        {
            @* Kein Spinner, sondern die Kette — man sieht, wo es steht. *@
            <div class="import-panel blueprint">
                <i class="corner tl" aria-hidden="true"></i>
                <i class="corner tr" aria-hidden="true"></i>
                <i class="corner bl" aria-hidden="true"></i>
                <i class="corner br" aria-hidden="true"></i>

                <span class="kicker">Liest @fileName</span>

                <div class="chain">
                    @foreach (var (label, done) in ReadSteps)
                    {
                        <div class="chain-step @(done ? "done" : null) @(!done ? "current" : null)">
                            <span class="chain-mark" aria-hidden="true">@(done ? "✓" : "◻")</span>
                            <span class="chain-title">@label</span>
                        </div>
                    }
                </div>

                <div class="doc-actions">
                    <button type="button" class="btn btn-secondary" @onclick="Cancel">Abbrechen</button>
                </div>
            </div>
        }
        else
        {
            <div class="scan-split">
                @* Links: was in der Datei steht. *@
                <div class="scan-source">
                    <div class="detail-block">
                        @* Bei einem Archiv steht der Archivname da, und die Sätze stammen aus
                           mehreren Dateien. Ohne die Zahl bliebe offen, ob wirklich alle
                           gelesen wurden. *@
                        <span class="detail-label">Datei · Format</span>
                        <span class="detail-value num">
                            @preview.FileName@(preview.SourceFileCount > 1
                                ? $" · {preview.SourceFileCount} Auszüge"
                                : null) · @preview.Format
                        </span>
                    </div>

                    <div class="detail-block">
                        <span class="detail-label">Zeitraum</span>
                        <span class="detail-value num">
                            @(preview.From is { } from && preview.To is { } to
                                ? $"{GermanFormat.Date(from)} – {GermanFormat.Date(to)}"
                                : "—")
                        </span>
                    </div>

                    <div class="detail-block">
                        <span class="detail-label">Auszugssaldo</span>
                        <span class="detail-value num">
                            @(preview.StatementBalance is { } balance
                                ? State.Euro(balance, withPlusSign: true)
                                : "—")
                        </span>
                    </div>

                    <div class="detail-block">
                        <span class="detail-label">Trennzeichen · Profil</span>
                        <span class="detail-value num">
                            @(preview.Separator ?? "entfällt") · @preview.ProfileName
                        </span>
                    </div>
                </div>

                @* Rechts: die Prüfung. *@
                <div class="scan-fields">
                    @*
                        Die Leiste bleibt oben stehen. Bei dreihundert Sätzen läge der
                        Importieren-Knopf sonst unerreichbar weit unten, und man scrollte
                        blind an der Auswahl vorbei, die man gerade trifft.
                    *@
                    <div class="import-bar">
                        <div class="import-bar-text">
                            <span class="kicker">
                                @Draft.Selected.Count von @preview.RecordCount
                                @(preview.RecordCount == 1 ? "Satz" : "Sätzen") gewählt
                            </span>
                            <span class="import-bar-status @(StatusIsWarning ? "warn" : null)">
                                @StatusText
                            </span>
                        </div>

                        <AuthorizeView Roles="Owner,Member" Context="bar">
                            <div class="import-bar-actions">
                                <button type="button" class="btn btn-primary"
                                        disabled="@(busy || Draft.Selected.Count == 0)" @onclick="CommitAsync">
                                    @(Draft.Selected.Count == 0
                                        ? "Nichts ausgewählt"
                                        : $"{Draft.Selected.Count} {(Draft.Selected.Count == 1 ? "Buchung" : "Buchungen")} importieren")
                                </button>
                                <button type="button" class="btn btn-ghost" disabled="@busy"
                                        @onclick="Cancel">Verwerfen</button>
                            </div>
                        </AuthorizeView>
                    </div>

                    <div class="picker">
                        <span class="label-strong">Zielkonto</span>
                        <div class="chipcloud">
                            @foreach (var account in preview.Accounts)
                            {
                                var id = account.Id;
                                <button type="button" class="chip @(Draft.AccountId == id ? "active" : null)"
                                        @onclick="() => Draft.AccountId = id">
                                    @account.Name
                                    @if (account.Id == preview.SuggestedAccountId)
                                    {
                                        <span class="chip-hint">erkannt</span>
                                    }
                                </button>
                            }
                        </div>
                    </div>

                    @if (NothingNew)
                    {
                        @*
                            Der häufigste Wiederholungsfall. Leere Blöcke zu zeigen wäre die
                            schlechtere Auskunft — hier steht, warum nichts dasteht.
                        *@
                        <div class="import-nothing">
                            <span class="label-strong">Nichts Neues in dieser Datei</span>
                            <span class="create-help">
                                @preview.RecordCount @(preview.RecordCount == 1 ? "Satz" : "Sätze")
                                erkannt, keiner neu.
                            </span>
                            <div class="doc-actions">
                                <button type="button" class="btn btn-secondary" @onclick="Cancel">
                                    Andere Datei wählen
                                </button>
                            </div>
                            <span class="create-help">
                                Einzelne Sätze lassen sich unter „Alle Zeilen“ trotzdem zuschalten.
                            </span>
                        </div>
                    }

                    @* Die drei Zähler rechnen gegen dieselbe Auswahl wie der Schalter. *@
                    <section class="tx-totals">
                        <div class="tx-total">
                            <span class="label-muted">Übernehmen</span>
                            <span class="tx-total-value num">@Draft.Selected.Count</span>
                        </div>
                        <div class="tx-total">
                            <span class="label-muted">Duplikat</span>
                            <span class="tx-total-value num">@preview.DuplicateCount</span>
                        </div>
                        <div class="tx-total">
                            <span class="label-muted">Vorhanden</span>
                            <span class="tx-total-value num">@preview.ExistingCount</span>
                        </div>
                    </section>

                    <div class="tx-totals-note">@preview.DuplicateCriterion</div>

                    @if (preview.ErrorCount > 0)
                    {
                        <div class="notice">
                            <span class="notice-title">
                                @preview.ErrorCount @(preview.ErrorCount == 1 ? "Satz" : "Sätze") nicht übernehmbar
                            </span>
                            <span class="notice-text">
                                Sie stehen unter „Alle Zeilen“ mit dem Grund und lassen sich nicht
                                zuschalten — übersprungen wird nichts stillschweigend.
                            </span>
                        </div>
                    }

                    <div class="segmented bordered">
                        <button type="button" class="segmented-opt @(Draft.Grouped ? "active" : null)"
                                @onclick="() => Draft.Grouped = true">Gruppen</button>
                        <button type="button" class="segmented-opt @(Draft.Grouped ? null : "active")"
                                @onclick="() => Draft.Grouped = false">Alle Zeilen</button>
                    </div>

                    @if (Draft.Grouped)
                    {
                        var offen = OpenGroups;

                        @if (offen.Count > 0)
                        {
                            <div class="list-head">
                                <span class="label-strong">
                                    @offen.Count @(offen.Count == 1 ? "Empfänger" : "Empfänger") zuordnen
                                </span>
                            </div>

                            @foreach (var group in offen)
                            {
                                var key = group.Key;
                                var aufgeklappt = Draft.OpenGroup == key;

                                <div class="import-group @(aufgeklappt ? "open" : null)">
                                    <button type="button" class="import-group-head"
                                            @onclick="() => ToggleGroup(key)">
                                        <span class="import-group-mark" aria-hidden="true">+</span>
                                        <span class="stack">
                                            <span class="import-row-payee">@group.Payee</span>
                                            <span class="meta num">@DescribeGroup(group)</span>
                                        </span>
                                        <span class="import-row-amount num">
                                            @State.Euro(group.Sum, withPlusSign: true)
                                        </span>
                                    </button>

                                    @if (aufgeklappt)
                                    {
                                        <div class="import-group-body">
                                            <div class="chipcloud">
                                                @foreach (var category in ChipsFor(group))
                                                {
                                                    var chosen = category;
                                                    <button type="button" class="chip"
                                                            @onclick="() => Assign(group, chosen)">
                                                        @category.Name
                                                    </button>
                                                }

                                                @* Gestrichelt, damit er nicht wie eine Auswahl
                                                   aussieht: er legt etwas an, statt zu wählen. *@
                                                <button type="button" class="chip chip-new"
                                                        @onclick="() => StartNewCategory(group)">
                                                    + Neue Kategorie
                                                </button>
                                            </div>

                                            @if (Draft.CreatingFor == group.Key)
                                            {
                                                @* Direkt hier, nicht auf einem anderen Screen: ein
                                                   Wechsel und Rücksprung köstete alle bisherigen
                                                   Zuordnungen, und das ist Arbeitsverlust. *@
                                                <div class="field">
                                                    <label for="neue-kat">
                                                        @(group.Sum >= 0
                                                            ? "Neue Einnahmekategorie"
                                                            : "Neue Ausgabenkategorie")
                                                    </label>
                                                    <input id="neue-kat" class="input" value="@Draft.FreshCategory"
                                                           placeholder="z. B. Abos"
                                                           @oninput="e => Draft.FreshCategory = e.Value?.ToString() ?? string.Empty" />
                                                </div>

                                                @if (createProblem is { Length: > 0 })
                                                {
                                                    <span class="create-problem">@createProblem</span>
                                                }

                                                <div class="doc-actions">
                                                    <button type="button" class="btn btn-primary"
                                                            disabled="@(busy || Draft.FreshCategory.Trim().Length == 0)"
                                                            @onclick="() => CreateAndAssignAsync(group)">
                                                        Anlegen &amp; zuordnen
                                                    </button>
                                                    <button type="button" class="btn btn-secondary"
                                                            @onclick="CancelNewCategory">Abbrechen</button>
                                                </div>
                                            }

                                            <label class="sheet-rule">
                                                <input type="checkbox" checked="@Draft.Remember"
                                                       @onchange="e => Draft.Remember = e.Value is true" />
                                                <span class="sheet-rule-text">
                                                    Regel merken: „@Categorization.RulePatternFor(group.Payee)“
                                                    → künftig automatisch
                                                </span>
                                            </label>

                                            @* Die Vorschau fällt auf das nächste vorhandene Feld
                                               zurück; ohne jedes Feld erscheint die Zeile gar nicht. *@
                                            @foreach (var row in group.Rows)
                                            {
                                                var satz = row;
                                                @if (Preview(satz) is { } vorschau)
                                                {
                                                    <button type="button" class="import-detail"
                                                            @onclick="() => detail = satz">
                                                        <span class="meta num">@vorschau</span>
                                                        <span class="import-detail-more">Details</span>
                                                    </button>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            @* Zwei Auswege, damit niemand dreihundert Zeilen einzeln beantworten muss. *@
                            <AuthorizeView Roles="Owner,Member" Context="bulk">
                                <div class="doc-actions">
                                    <button type="button" class="btn btn-secondary"
                                            @onclick="AssignRestAsMiscellaneous">
                                        Alle @offen.Count als „Sonstiges“
                                    </button>
                                    <button type="button" class="btn btn-secondary" @onclick="DeferRest">
                                        Später zuordnen
                                    </button>
                                </div>
                            </AuthorizeView>
                        }

                        var zugeordnet = AssignedGroups;

                        @if (zugeordnet.Count > 0)
                        {
                            <div class="list-head">
                                <span class="label-strong">Automatisch zugeordnet</span>
                                <span class="label-muted num">
                                    @zugeordnet.Sum(g => g.Rows.Count) von @Draft.Selected.Count Sätzen
                                </span>
                            </div>

                            @foreach (var group in zugeordnet)
                            {
                                <div class="import-row">
                                    <span class="tag">@group.CategoryName</span>
                                    <span class="stack">
                                        <span class="import-row-payee num">@(group.Rows.Count)×</span>
                                        <span class="meta">@group.Payees</span>
                                    </span>
                                    <span class="import-row-amount num">
                                        @State.Euro(group.Sum, withPlusSign: true)
                                    </span>
                                </div>
                            }

                            <div class="tx-totals-note">
                                @RuleCount @(RuleCount == 1 ? "Regel greift" : "Regeln greifen") ·
                                @LearnedCount davon in diesem Import gelernt ·
                                <a href="/kategorieregeln">Regeln ansehen</a>
                            </div>
                        }
                    }
                    else
                    {
                        @foreach (var row in preview.Rows)
                        {
                            <div class="import-row @StateClass(row) @(Draft.Selected.Contains(row.Index) ? "picked" : null)">
                                <label class="tx-check import-check">
                                    <input type="checkbox" checked="@Draft.Selected.Contains(row.Index)"
                                           disabled="@(row.State == ImportRowState.Error)"
                                           @onchange="e => Toggle(row, e)"
                                           aria-label="@($"{row.Payee} übernehmen")" />
                                </label>

                                <span class="stack">
                                    <span class="import-row-payee">@row.Payee</span>
                                    <span class="meta num">@Describe(row)</span>
                                </span>

                                <span class="import-row-amount num">
                                    @(row.Amount is { } amount ? State.Euro(amount, withPlusSign: true) : "—")
                                </span>

                                @if (row.Details is not null)
                                {
                                    var satz = row;
                                    <button type="button" class="import-detail-link"
                                            @onclick="() => detail = satz">Details</button>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        }

        <div class="spacer"></div>
    }
</AsyncView>

@if (detail is { } offen)
{
    <StatementPanel Payee="@offen.Payee"
                    BookingDate="@offen.BookingDate"
                    Amount="@offen.Amount"
                    Details="@offen.Details"
                    Reference="@offen.Reference"
                    AccountName="@(data?.Accounts.FirstOrDefault(a => a.Id == Draft.AccountId)?.Name)"
                    ForImport="true"
                    Keep="@KeepFor(offen)"
                    KeepChanged="wahl => SetKeep(offen, wahl)"
                    OnApplyToAll="ApplyKeepToAll"
                    OnClose="@(() => detail = null)" />
}

@code {
    private enum Stage
    {
        Empty,
        Reading,
        Check,
    }

    /// <summary>20 MB — dieselbe Grenze, die der Server zieht.</summary>
    private const long MaxBytes = 20L * 1024 * 1024;

    /// <summary>
    /// Ein Empfänger mit allen seinen gewählten Sätzen.
    /// </summary>
    /// <remarks>
    /// Gefragt wird je Empfänger, nicht je Buchung. Niemand kategorisiert dreihundert Zeilen
    /// einzeln, und dieselbe Antwort dreißigmal zu geben ist keine Sorgfalt, sondern Arbeit
    /// ohne Ertrag.
    /// </remarks>
    private sealed record PayeeGroup(
        string Key, string Payee, IReadOnlyList<ImportRowDto> Rows, decimal Sum,
        DateOnly? From, DateOnly? To);

    /// <summary>Eine Kategorie mit dem, was ihr automatisch zugefallen ist.</summary>
    private sealed record AssignedGroup(
        string CategoryName, IReadOnlyList<ImportRowDto> Rows, string Payees, decimal Sum);

    private IReadOnlyList<CategoryDto> categories = [];
    private ImportRowDto? detail;

    /// <summary>Warum das Anlegen einer Kategorie nicht geklappt hat.</summary>
    private string? createProblem;

    /// <summary>Die gewählten Sätze, aus denen wirklich eine Buchung wird.</summary>
    private IEnumerable<ImportRowDto> Importable
        => data?.Rows.Where(r => Draft.Selected.Contains(r.Index) && r.State != ImportRowState.Error)
           ?? [];

    /// <summary>Was noch keine Kategorie hat — weder aus einer Regel noch aus einer Wahl.</summary>
    private List<PayeeGroup> OpenGroups =>
    [
        .. Importable
            .Where(r => Resolve(r) is null && !Draft.Deferred.Contains(Categorization.Normalize(r.Payee)))
            .GroupBy(r => Categorization.Normalize(r.Payee), StringComparer.Ordinal)
            .Select(g => Build(g.Key, [.. g]))
            .OrderByDescending(g => g.Rows.Count)
            .ThenBy(g => g.Payee, StringComparer.CurrentCulture),
    ];

    private List<AssignedGroup> AssignedGroups =>
    [
        .. Importable
            .Select(r => (Row: r, Category: Resolve(r)))
            .Where(x => x.Category is not null)
            .GroupBy(x => x.Category!, StringComparer.Ordinal)
            .Select(g => new AssignedGroup(
                g.Key,
                [.. g.Select(x => x.Row)],
                string.Join(" · ", g.Select(x => x.Row.Payee).Distinct(StringComparer.CurrentCulture).Take(4)),
                g.Sum(x => x.Row.Amount ?? 0m)))
            .OrderByDescending(g => g.Rows.Count),
    ];

    /// <summary>
    /// Wie viele Regeln auf diesen Auszug wirken — die bestehenden und die gerade gemerkten.
    /// </summary>
    /// <remarks>
    /// Die neu gemerkten zählen mit, sonst stünde da „0 Regeln greifen · 1 davon in diesem Import
    /// gelernt“. Ein „davon“ von null geht nicht auf, und die gerade gelernte Regel ordnet ihre
    /// Gruppe ja tatsächlich zu.
    /// </remarks>
    private int RuleCount
        => Importable.Select(r => r.RuleId).Where(id => id is not null).Distinct().Count()
           + LearnedCount;

    /// <summary>Wie viele davon erst hier gemerkt werden sollen.</summary>
    private int LearnedCount => Draft.Choices.Values.Count(c => c.RememberRule);

    /// <summary>Der Fall „alles schon gebucht“ — kein leerer Bildschirm, sondern eine Auskunft.</summary>
    private bool NothingNew => data is { RecordCount: > 0, NewCount: 0 };

    /// <summary>Sätze, aus denen eine Buchung ohne Kategorie würde.</summary>
    private int Uncategorised => Importable.Count(r => Resolve(r) is null);

    private bool StatusIsWarning => Draft.Selected.Count == 0 || Uncategorised > 0;

    /// <summary>
    /// Die Statuszeile.
    /// </summary>
    /// <remarks>
    /// Sie darf nie Vollständigkeit behaupten, wenn etwas offen bleibt. „Später zuordnen“ nimmt
    /// die Empfänger aus der Fragenliste, aber ihre Buchungen gehen trotzdem ohne Kategorie
    /// hinein — „Alle gewählten Sätze haben eine Kategorie“ wäre dann schlicht falsch. Deshalb
    /// gibt es neben den drei Fassungen des Handoffs eine vierte für genau diesen Fall.
    /// </remarks>
    private string StatusText
    {
        get
        {
            if (Draft.Selected.Count == 0)
            {
                return "Nichts zu übernehmen";
            }

            var offen = OpenGroups.Count;
            if (offen > 0)
            {
                return $"{offen} Empfänger ohne Kategorie";
            }

            var ohne = Uncategorised;

            return ohne == 0
                ? "Alle gewählten Sätze haben eine Kategorie"
                : $"{ohne} {(ohne == 1 ? "Satz" : "Sätze")} gehen ohne Kategorie hinein";
        }
    }

    /// <summary>Die Kategorie eines Satzes: erst die Wahl im Import, dann die Regel.</summary>
    private string? Resolve(ImportRowDto row)
    {
        var key = Categorization.Normalize(row.Payee);

        if (Draft.Choices.TryGetValue(key, out var choice))
        {
            return categories.FirstOrDefault(c => c.Id == choice.CategoryId)?.Name;
        }

        return Draft.Deferred.Contains(key) ? null : row.CategoryName;
    }

    private static PayeeGroup Build(string key, IReadOnlyList<ImportRowDto> rows)
    {
        var dates = rows.Where(r => r.BookingDate is not null).Select(r => r.BookingDate!.Value).ToList();

        return new PayeeGroup(
            key,
            rows[0].Payee,
            rows,
            rows.Sum(r => r.Amount ?? 0m),
            dates.Count == 0 ? null : dates.Min(),
            dates.Count == 0 ? null : dates.Max());
    }

    /// <summary>
    /// Anzahl, Zeitraum und, wenn er für die ganze Gruppe gilt, der Buchungstext der Bank.
    /// </summary>
    /// <remarks>
    /// <para>Bei einer einzigen Buchung steht ein Datum da, keine Spanne — „22.08. – 22.08.“ wäre
    /// eine Zeitangabe, die sich selbst widerspricht.</para>
    /// <para>Der Buchungstext („Dauerauftrag“, „SB-Auszahlung“, „Lohn/Gehalt/Rente“) sagt, um
    /// welche Art Umsatz es geht. Er steht nur da, wenn er für <em>alle</em> Sätze der Gruppe
    /// gilt — sonst wäre er keine Eigenschaft der Gruppe, sondern eine Behauptung über sie.</para>
    /// </remarks>
    private static string DescribeGroup(PayeeGroup group)
    {
        var teile = new List<string> { $"{group.Rows.Count}×" };

        if (group.From is { } from)
        {
            teile.Add(group.To is { } to && to != from
                ? $"{GermanFormat.Date(from)} – {GermanFormat.Date(to)}"
                : GermanFormat.Date(from));
        }

        var texte = group.Rows.Select(r => r.Details?.BookingText).Distinct().ToList();
        if (texte is [{ Length: > 0 } gemeinsam])
        {
            teile.Add(gemeinsam);
        }

        return string.Join(" · ", teile);
    }

    /// <summary>
    /// Die Chipliste folgt dem Vorzeichen der Gruppe.
    /// </summary>
    /// <remarks>
    /// Ein Gehaltseingang darf nicht nur als „Sonstiges“ ablegbar sein — sonst wird eine falsche
    /// Regel gelernt, und die greift dann bei jedem weiteren Import.
    /// </remarks>
    private IEnumerable<CategoryDto> ChipsFor(PayeeGroup group)
        => categories.Where(c => c.Direction == (group.Sum >= 0
            ? CategoryDirection.Income
            : CategoryDirection.Expense));

    private void ToggleGroup(string key)
    {
        Draft.OpenGroup = Draft.OpenGroup == key ? null : key;
        CancelNewCategory();
    }

    private void StartNewCategory(PayeeGroup group)
    {
        Draft.CreatingFor = group.Key;
        Draft.FreshCategory = string.Empty;
        createProblem = null;
    }

    private void CancelNewCategory()
    {
        Draft.CreatingFor = null;
        Draft.FreshCategory = string.Empty;
        createProblem = null;
    }

    /// <summary>
    /// Anlegen, zuordnen, merken — in einem Schritt.
    /// </summary>
    /// <remarks>
    /// <para>Die Richtung folgt dem Vorzeichen der Gruppe: bei einer Gutschrift entsteht eine
    /// Einnahmekategorie. Eine Ausgabenkategorie für einen Gehaltseingang wäre von Anfang an
    /// falsch abgelegt.</para>
    /// <para>Trifft der Name eine vorhandene Kategorie, ist das kein Fehler — sie wird benutzt,
    /// und die Meldung sagt es. Die übrigen Zuordnungen bleiben unangetastet; die Vorschau wird
    /// nicht neu aufgebaut.</para>
    /// </remarks>
    private Task CreateAndAssignAsync(PayeeGroup group) => RunAsync(async () =>
    {
        busy = true;
        createProblem = null;

        try
        {
            var direction = group.Sum >= 0 ? CategoryDirection.Income : CategoryDirection.Expense;
            var ergebnis = await Api.EnsureCategoryAsync(Draft.FreshCategory.Trim(), direction);

            // Die Chipliste kennt die neue Kategorie noch nicht.
            if (ergebnis.Created)
            {
                categories = [.. categories, ergebnis.Category];
            }

            var anzahl = group.Rows.Count;
            Draft.Choices[group.Key] = new ImportCategoryChoice(group.Payee, ergebnis.Category.Id, Draft.Remember);
            Draft.Deferred.Remove(group.Key);

            CancelNewCategory();
            Draft.OpenGroup = null;

            var was = ergebnis.Created ? "angelegt" : "bestand bereits";
            Toasts.Show(Draft.Remember
                ? $"{ergebnis.Category.Name} {was} · {anzahl}× zugeordnet · Regel gemerkt"
                : $"{ergebnis.Category.Name} {was} · {anzahl}× zugeordnet");
        }
        catch (ApiException ex)
        {
            createProblem = ex.Message;
        }
        finally
        {
            busy = false;
        }
    });

    private ImportKeepFields KeepFor(ImportRowDto row)
        => Draft.KeepOverrides.TryGetValue(row.Index, out var eigene) ? eigene : Draft.Keep;

    private void SetKeep(ImportRowDto row, ImportKeepFields wahl) => Draft.KeepOverrides[row.Index] = wahl;

    /// <summary>Überträgt die Wahl eines Satzes auf den ganzen Auszug.</summary>
    private void ApplyKeepToAll(ImportKeepFields wahl)
    {
        Draft.Keep = wahl;
        Draft.KeepOverrides.Clear();

        Toasts.Show("Gilt jetzt für alle Sätze");
    }

    /// <summary>
    /// Die Vorschau eines Satzes in der aufgeklappten Gruppe.
    /// </summary>
    /// <remarks>
    /// Sie fällt auf das nächste vorhandene Feld zurück: Verwendungszweck, sonst die IBAN der
    /// Gegenseite, sonst „nur Importreferenz“. Ohne jedes Feld gibt es nichts zu zeigen, und die
    /// Zeile erscheint gar nicht — eine leere Zeile wäre ein Versprechen ohne Inhalt.
    /// </remarks>
    private static string? Preview(ImportRowDto row)
    {
        var kern = row.Details?.Purpose
                   ?? row.Details?.CounterpartyIban
                   ?? (row.State == ImportRowState.Error ? null : "nur Importreferenz");

        if (kern is null)
        {
            return null;
        }

        var teile = new List<string>();
        if (row.BookingDate is { } tag)
        {
            teile.Add(GermanFormat.Date(tag));
        }

        teile.Add(kern.Length <= 60 ? kern : kern[..59].TrimEnd() + "…");

        return string.Join(" · ", teile);
    }

    /// <summary>Eine Chip-Wahl gilt für alle Sätze des Empfängers.</summary>
    private void Assign(PayeeGroup group, CategoryDto category)
    {
        Draft.Choices[group.Key] = new ImportCategoryChoice(group.Payee, category.Id, Draft.Remember);
        Draft.Deferred.Remove(group.Key);
        Draft.OpenGroup = null;

        Toasts.Show(Draft.Remember
            ? $"{group.Rows.Count}× {category.Name} · Regel gemerkt"
            : $"{group.Rows.Count}× {category.Name}");
    }

    /// <summary>Der schnelle Ausweg — ohne Regel, denn „Sonstiges“ lernt man nicht.</summary>
    private void AssignRestAsMiscellaneous()
    {
        var betroffen = OpenGroups;

        foreach (var group in betroffen)
        {
            var direction = group.Sum >= 0 ? CategoryDirection.Income : CategoryDirection.Expense;
            var misc = categories.FirstOrDefault(
                c => c.Direction == direction && c.Name == "Sonstiges");

            if (misc is not null)
            {
                Draft.Choices[group.Key] = new ImportCategoryChoice(group.Payee, misc.Id, RememberRule: false);
            }
        }

        Draft.OpenGroup = null;
        Toasts.Show($"{betroffen.Count} als „Sonstiges“ übernommen");
    }

    /// <summary>
    /// Die Empfänger fallen aus der Fragenliste; ihre Buchungen landen unkategorisiert im
    /// Triage-Banner der Buchungsliste. Verschwiegen wird nichts.
    /// </summary>
    private void DeferRest()
    {
        var betroffen = OpenGroups;

        foreach (var group in betroffen)
        {
            Draft.Deferred.Add(group.Key);
        }

        Draft.OpenGroup = null;
        Toasts.Show($"{betroffen.Count} später zuordnen");
    }

    /// <summary>
    /// Die Vorschau, die die Seite gerade zeigt.
    /// </summary>
    /// <remarks>
    /// Auf der Prüfstufe ist das die des Entwurfs, auf der leeren die vom Server geholte, die nur
    /// Konten und den letzten Import kennt. Beides ist eine Vorschau — aber nur die erste ist
    /// begonnene Arbeit, und darum liegt nur sie im <see cref="ImportDraft"/>.
    /// </remarks>
    private ImportPreviewDto? data;

    private Stage stage = Stage.Empty;
    private string fileName = string.Empty;
    private string? problem;
    private bool dragging;
    private int readStep;
    private bool busy;
    private CancellationTokenSource? reading;

    /// <summary>
    /// Die Kette benennt die Reihenfolge und erfindet keinen Fortschritt.
    /// </summary>
    /// <remarks>
    /// Schritt 1 ist getan, sobald die Datei im Speicher liegt; die übrigen drei geschehen in
    /// einem Zug auf dem Server und werden auch zusammen abgehakt. Sie einzeln durchlaufen zu
    /// lassen hieße, eine Zwischenzeit vorzuspielen, die es nicht gibt.
    /// </remarks>
    private (string Label, bool Done)[] ReadSteps =>
    [
        ("Datei gelesen", readStep > 0),
        ("Format erkannt", readStep > 1),
        ("Konto zugeordnet", readStep > 1),
        ("Duplikate geprüft", readStep > 1),
    ];

    /// <summary>
    /// Setzt die Seite auf den Stand, den sie beim Verlassen hatte.
    /// </summary>
    /// <remarks>
    /// Ein begonnener Import geht der leeren Stufe vor: seine Vorschau ist dieselbe, die der
    /// Server noch vorhält, und die Zuordnungen darauf sind die Arbeit, die nicht verloren gehen
    /// soll. Ist er abgelaufen, steht das da — stillschweigend zurückzusetzen sähe aus, als hätte
    /// die Anwendung ihn schlicht vergessen.
    /// </remarks>
    protected override async Task LoadAsync()
    {
        // Die Chips im Empfänger-Akkordeon brauchen die Kategorien; ohne sie stünde die Gruppe
        // offen da, ohne dass sich etwas wählen ließe.
        var laden = Api.GetCategoriesAsync();

        if (Draft.Expired)
        {
            Draft.Clear();
            problem = "Der begonnene Import ist abgelaufen. Bitte die Datei noch einmal einlesen.";
        }

        if (Draft.Preview is { } begonnen)
        {
            data = begonnen;
            stage = Stage.Check;
        }
        else
        {
            data = await Api.GetImportPreviewAsync();
            stage = Stage.Empty;
        }

        categories = await laden;

        var verwaist = Draft.DropChoicesOutside(categories.Select(c => c.Id));
        if (verwaist > 0)
        {
            Toasts.Show($"{verwaist} {(verwaist == 1 ? "Empfänger ist" : "Empfänger sind")} "
                        + "wieder offen — die gewählte Kategorie gibt es nicht mehr");
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        dragging = false;
        problem = null;

        var file = e.File;
        if (file.Size > MaxBytes)
        {
            problem = "Die Datei ist größer als 20 MB.";
            return;
        }

        fileName = file.Name;

        // Erst in den Speicher, dann die Stufe wechseln. Mit dem Wechsel verschwindet das
        // Dateifeld aus dem DOM, und IBrowserFile hängt daran — danach ließe sich der Strom
        // nicht mehr öffnen, und das Lesen bliebe wortlos in der Kette stehen.
        byte[] content;
        try
        {
            using var buffer = new MemoryStream();
            await using (var source = file.OpenReadStream(MaxBytes))
            {
                await source.CopyToAsync(buffer);
            }

            content = buffer.ToArray();
        }
        catch (IOException ex)
        {
            problem = $"Die Datei ließ sich nicht lesen: {ex.Message}";
            return;
        }

        await ReadAsync(token => Api.ReadStatementAsync(new MemoryStream(content), file.Name, token));
    }

    /// <summary>Der eingebaute Beispielauszug — zum Ausprobieren ohne eigene Datei.</summary>
    private async Task ReadExampleAsync()
    {
        problem = null;
        fileName = "Beispielauszug";
        await ReadAsync(Api.GetImportPreviewAsync);
    }

    private async Task ReadAsync(Func<CancellationToken, Task<ImportPreviewDto>> read)
    {
        stage = Stage.Reading;
        readStep = 0;

        reading?.Cancel();
        reading = new CancellationTokenSource();
        var token = reading.Token;

        try
        {
            readStep = 1;
            StateHasChanged();

            var gelesen = await read(token);
            readStep = 2;

            // Der Entwurf fängt von vorn an: Zuordnungen gehören zu der Datei, für die sie
            // getroffen wurden, und Vorauswahl wie Zielkonto stehen in der frischen Vorschau.
            Draft.Start(gelesen);

            data = gelesen;
            fileName = gelesen.FileName;
            detail = null;
            CancelNewCategory();

            stage = Stage.Check;
        }
        catch (OperationCanceledException)
        {
            stage = Stage.Empty;
        }
        catch (ApiException ex)
        {
            // Der Grund bleibt am Panel stehen. Ein Toast wäre weg, bevor jemand die nächste
            // Datei aussucht — und genau dabei soll er helfen.
            problem = ex.Message;
            stage = Stage.Empty;
        }
    }

    /// <summary>
    /// Verwerfen — und zwar ganz: sonst stünde der Entwurf beim nächsten Besuch wieder da.
    /// </summary>
    private void Cancel()
    {
        reading?.Cancel();
        Draft.Clear();
        CancelNewCategory();

        detail = null;
        problem = null;
        stage = Stage.Empty;
    }

    private void Toggle(ImportRowDto row, ChangeEventArgs e)
    {
        if (row.State == ImportRowState.Error)
        {
            return;
        }

        if (e.Value is true)
        {
            Draft.Selected.Add(row.Index);
        }
        else
        {
            Draft.Selected.Remove(row.Index);
        }
    }

    private Task CommitAsync() => RunAsync(async () =>
    {
        busy = true;
        try
        {
            var result = await Api.CommitImportAsync(
                Draft.Preview!.Id, Draft.AccountId, [.. Draft.Selected], [.. Draft.Choices.Values],
                Draft.Keep, [.. Draft.KeepOverrides.Select(x => new ImportKeepOverride(x.Key, x.Value))]);

            // Was ohne Kategorie blieb, gehört in die Meldung: diese Zahl ist die Brücke zum
            // Triage-Banner der Buchungsliste. Verschwiegen taucht sie dort unerklärt auf.
            var teile = new List<string>
            {
                $"{result.ImportedCount} {(result.ImportedCount == 1 ? "Buchung" : "Buchungen")} importiert",
            };

            if (result.ForcedDuplicates > 0)
            {
                teile.Add($"{result.ForcedDuplicates} trotz Treffer");
            }

            if (result.WithoutCategory > 0)
            {
                teile.Add($"{result.WithoutCategory} ohne Kategorie");
            }

            // Die Vorschau ist auf dem Server verbraucht. Bliebe der Entwurf stehen, böte die
            // Seite beim nächsten Besuch denselben Auszug noch einmal an — und liefe ins Leere.
            Draft.Clear();

            Toasts.Show(string.Join(" · ", teile));
            Navigation.NavigateTo("/konten");
        }
        finally
        {
            busy = false;
        }
    });

    private static string StateClass(ImportRowDto row) => row.State switch
    {
        ImportRowState.Existing => "known",
        ImportRowState.Duplicate => "known",
        ImportRowState.Error => "broken",
        _ => string.Empty,
    };

    private static string Describe(ImportRowDto row)
    {
        var parts = new List<string>();

        if (row.BookingDate is { } date)
        {
            parts.Add(GermanFormat.Date(date));
        }

        parts.Add(row.State switch
        {
            ImportRowState.Existing => "bereits vorhanden",
            ImportRowState.Duplicate => "mögliches Duplikat",
            ImportRowState.Error => row.Problem ?? "nicht lesbar",
            _ => "neu",
        });

        if (row.CategoryName is { Length: > 0 } category)
        {
            parts.Add(category);
        }

        return string.Join(" · ", parts);
    }
}
