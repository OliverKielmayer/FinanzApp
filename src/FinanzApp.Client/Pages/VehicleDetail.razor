@page "/fahrzeuge/{Id:int}"
@attribute [Authorize]
@inherits AppPage

<PageTitle>@(data?.Name ?? "Fahrzeug") — FinanzApp</PageTitle>

<AsyncView Loading="Loading" Error="@Error" Stale="HasLoadedOnce" Retry="ReloadAsync">
    @if (data is { } vehicle)
    {
        <section class="hero">
            <span class="label-muted">Kosten 12 Monate</span>
            <span class="hero-value medium num">@State.Euro0(vehicle.CostsLastTwelveMonths)</span>
            <span class="loan-sub">
                @vehicle.Name · @vehicle.Plate@(vehicle.CostParts.Count > 0 ? " · " + string.Join(", ", vehicle.CostParts) : null)
            </span>
        </section>

        <div class="detail-block">
            <span class="detail-label">Fahrzeug</span>
            <span class="detail-value num">@Describe(vehicle)</span>
        </div>

        @*
            Die 1-%-Regelung, in ihren Bestandteilen. Nur die Endsumme zu zeigen hieße, eine
            Zahl zu nennen, die niemand nachrechnen kann — und sie ist beim Dienstwagen der
            mit Abstand größte Posten der Kostenzeile oben.
        *@
        @if (vehicle.Benefit is { } vorteil)
        {
            <div class="value-parts">
                <span class="label-muted">So entsteht der geldwerte Vorteil</span>

                <div class="value-part">
                    <span class="stack">
                        <span>Private Nutzung</span>
                        <span class="meta num">1 % von @State.Euro0(vorteil.Basis) je Monat</span>
                    </span>
                    <span class="num">@State.Euro(vorteil.UsePerMonth)</span>
                </div>

                @if (vorteil.CommuteKilometres is { } km)
                {
                    <div class="value-part">
                        <span class="stack">
                            <span>Weg zur Arbeit</span>
                            <span class="meta num">
                                0,03 % je Kilometer · @GermanFormat.Quantity(km) km einfach@(vorteil.EmployerName is { Length: > 0 } arbeitgeber
                                    ? " · " + arbeitgeber
                                    : null)
                            </span>
                        </span>
                        <span class="num">@State.Euro(vorteil.CommutePerMonth)</span>
                    </div>
                }

                <div class="value-part total">
                    <span class="label-strong">Je Monat</span>
                    <span class="num">@State.Euro(vorteil.PerMonth)</span>
                </div>

                <span class="meta num">@Basis(vorteil)</span>

                <span class="meta">
                    Im Jahr @State.Euro(vorteil.PerYear) — so steht er in den Kosten oben. Der
                    Betrag wird nicht überwiesen, er erhöht das zu versteuernde Einkommen. Was
                    davon im Netto fehlt, hängt vom persönlichen Steuersatz ab und steht
                    deshalb hier nicht als Zahl.
                </span>

                @* Ohne Entfernung entsteht der Zuschlag gar nicht. Das zu verschweigen hieße,
                   eine unvollständige Rechnung als vollständige auszugeben. *@
                @if (vorteil.CommuteKilometres is null)
                {
                    <span class="meta">
                        Ohne erfasste Entfernung fehlt der Zuschlag für Fahrten zwischen Wohnung
                        und Arbeitsstätte. Er entsteht, sobald am verknüpften Arbeitsverhältnis
                        eine Entfernung steht.
                    </span>
                }
            </div>
        }

        <div class="list-head">
            <span class="label-strong">Versicherung</span>
        </div>

        @if (vehicle.Policy is { } policy)
        {
            @* Verwiesen, nicht kopiert: der Vertrag steht weiter unter Absicherung. *@
            <button type="button" class="tap contract-row @(policy.NoticeIsDue ? "deadline" : null)"
                    @onclick="@(() => Navigation.NavigateTo($"/police/{policy.PolicyId}"))">
                <span class="stack">
                    <span class="contract-name">@policy.Name</span>
                    <span class="meta">
                        @policy.Provider@(policy.NoticeDeadline is { } deadline
                            ? " · Wechselfrist " + GermanFormat.Date(deadline)
                            : null)
                    </span>
                </span>
                <span class="contract-amount num">@State.Euro0(policy.AnnualPremium)</span>
            </button>
        }
        else
        {
            <div class="empty-area">
                <span class="empty-area-text">
                    Keine Versicherung verknüpft. Sie wird unter Absicherung geführt und hier nur
                    verwiesen — angelegt wird sie dort.
                </span>
                <AuthorizeView Roles="Owner,Member">
                    <button type="button" class="btn btn-secondary"
                            @onclick="@(() => Navigation.NavigateTo("/neu/protection"))">Versicherung anlegen</button>
                </AuthorizeView>
            </div>
        }

        <div class="list-head">
            <span class="label-strong">Dokumente</span>
            <span class="list-count num">@vehicle.Documents.Count</span>
        </div>

        @if (vehicle.Documents.Count == 0)
        {
            <div class="empty-area">
                <span class="empty-area-text">Kein Dokument hinterlegt.</span>
            </div>
        }

        @foreach (var document in vehicle.Documents)
        {
            <button type="button" class="tap doc-row @(document.FileExists ? null : "missing")"
                    @onclick="@(() => Navigation.NavigateTo($"/dokumente/{document.Id}"))">
                <span class="stack">
                    <span class="doc-name">@document.FileName</span>
                    <span class="doc-meta">@(document.FileExists ? document.TypeName : "Datei nicht gefunden")</span>
                </span>
            </button>
        }

        <div class="spacer"></div>
    }
</AsyncView>

@code {
    [Parameter] public int Id { get; set; }

    private VehicleDetailDto? data;

    protected override async Task LoadAsync() => data = await Api.GetVehicleAsync(Id);

    /// <summary>
    /// Die Bemessungsgrundlage im Klartext — der Satz, den sonst niemand nachvollziehen kann.
    /// </summary>
    /// <remarks>
    /// Der Minderungssatz steht nur da, wo er greift. „zu 100 % angesetzt“ an einem Verbrenner
    /// wäre eine Angabe über etwas, das gar nicht entschieden wurde.
    /// </remarks>
    private string Basis(CompanyCarBenefitDto vorteil)
    {
        var satz = vorteil.TaxableSharePercent;
        var gemindert = satz < 100m
            ? $", davon {GermanFormat.Percent(satz, 0)} als {(satz == 25m ? "Elektro" : "Hybrid")}"
            : string.Empty;

        return $"Bruttolistenpreis {State.Euro0(vorteil.GrossListPrice)}, "
               + $"abgerundet auf volle hundert Euro{gemindert} — Bemessung "
               + $"{State.Euro0(vorteil.Basis)}.";
    }

    private static string Describe(VehicleDetailDto vehicle)
    {
        var parts = new List<string> { vehicle.Plate };

        if (vehicle.Usage is { Length: > 0 } usage)
        {
            parts.Add(usage);
        }

        if (vehicle.FirstRegistration is { } first)
        {
            parts.Add("Erstzulassung " + GermanFormat.Date(first));
        }

        if (vehicle.Mileage is { } mileage)
        {
            parts.Add($"{mileage:N0} km");
        }

        return string.Join(" · ", parts);
    }
}
