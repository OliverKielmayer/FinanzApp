@page "/scaneingang"
@attribute [Authorize]
@inherits AppPage

@*
    Posteingang statt Einzelbeleg: gescannt wird stapelweise, eingeordnet wird später. Ein Beleg
    bleibt hier stehen, bis Typ und Objekt bestätigt sind — sonst verschwände er in der Ablage,
    ohne dass jemand entschieden hätte, wozu er gehört.

    Hier landet auch, was der Ordnerdienst hereingereicht hat. Zugeordnet hat er, so weit es
    ohne Rückfrage ging; übernommen hat er nichts. Was ihm gelungen ist, steht als „erkannt“
    da und kostet einen Tipp; was nicht, trägt der Benutzer über „Zuordnen“ nach.
*@

<PageTitle>Scaneingang — FinanzApp</PageTitle>

<AsyncView Loading="Loading" Error="@Error" Stale="HasLoadedOnce" Retry="ReloadAsync">
    @if (data is { } inbox)
    {
        <section class="hero">
            <span class="label-muted">Wartet auf Zuordnung</span>
            <span class="hero-value medium num">@inbox.WaitingCount</span>
            <span class="hero-delta">
                @(inbox.WaitingCount == 1 ? "Beleg" : "Belege") · Typ und Objekt fehlen noch
            </span>
        </section>

        @if (inbox.Items.Count == 0)
        {
            <div class="empty-area">
                <span class="empty-area-title">Der Eingang ist leer</span>
                <span class="empty-area-text">
                    Alles Eingescannte ist eingeordnet. Neue Belege landen hier, bis Typ und
                    Objekt feststehen.
                </span>
                <AuthorizeView Roles="Owner,Member">
                    <button type="button" class="btn btn-primary"
                            @onclick="@(() => Navigation.NavigateTo("/scannen"))">Beleg einlesen</button>
                </AuthorizeView>
            </div>
        }

        @foreach (var item in inbox.Items)
        {
            <button type="button" class="tap doc-row @(item.Recognised ? null : "missing")"
                    @onclick="@(() => Navigation.NavigateTo($"/dokumente/{item.DocumentId}"))">
                <span class="stack">
                    <span class="doc-name">@item.FileName</span>
                    <span class="doc-meta">@Describe(item)</span>
                </span>
                <span class="tag @(item.Recognised ? "tag-neutral" : "tag-accent")">
                    @(item.Recognised ? "erkannt" : "prüfen")
                </span>
            </button>

            @*
                Der Verdacht steht über den Schaltern und nicht in der Zeile: er ist eine
                Bemerkung zum Beleg, keine Eigenschaft von ihm. Byteweise gleiche Dateien kommen
                gar nicht erst herein — was hier steht, ist der unsichere Fall, und der braucht
                einen Blick auf beide Belege. Der Verweis führt deshalb zum vorhandenen.
            *@
            @if (item.DuplicateOfDocumentId is { } vorhanden)
            {
                <div class="doc-duplicate">
                    Derselbe Beleg liegt möglicherweise schon in der Ablage:
                    <a href="/dokumente/@vorhanden">@(item.DuplicateOfTitle ?? "vorhandener Beleg")</a>.
                    Beide hätten denselben Ablagenamen bekommen — gleiche Art, gleicher Stichtag,
                    gleiche Zuordnung. Es kann auch eine berichtigte Fassung sein.
                </div>
            }

            @*
                Die Zeile führt zum Beleg, die Schalter darunter räumen ihn weg. Zwei Aktionen an
                einer Zeile brauchen zwei Flächen — ein Tipp, der je nach Stelle etwas anderes
                tut, trifft irgendwann das Falsche.
            *@
            <AuthorizeView Roles="Owner,Member">
                <div class="doc-actions">
                    <button type="button" class="btn btn-secondary" disabled="@busy"
                            @onclick="@(() => assigning = item)">Zuordnen</button>

                    @*
                        Der vierte Schritt des Belegwegs, nachgeholt. Was der Ordnerdienst
                        einliefert, ist abgelegt und zugeordnet — die Werte stehen aber erst im
                        Objekt, wenn jemand sie gesehen und bestätigt hat. Ohne diesen Schalter
                        gäbe es dafür keinen Weg außer: dieselbe Datei ein zweites Mal einlesen.
                    *@
                    @*
                        Zwei Namen, ein Weg: liegt ein Leseabdruck vor, führt der Schalter zum
                        Prüfschritt; fehlt er, liest die Nachschau die Datei mit den Regeln von
                        heute und erkennt die Art dabei neu. „Werte lesen“ heißt deshalb nicht
                        „noch einmal“ — der Beleg kann vorher gelegen haben, ohne je gelesen
                        worden zu sein, und eine neue Leseregel macht ihn erst jetzt lesbar.
                    *@
                    @if (item.ValuesHref is { Length: > 0 } pruefen)
                    {
                        <button type="button" class="btn btn-secondary" disabled="@busy"
                                @onclick="@(() => Navigation.NavigateTo(pruefen))">
                            @(item.ValuesLabel ?? "Werte lesen")
                        </button>
                    }

                    @if (item.Recognised)
                    {
                        @* Erkannt heißt: Typ und Objekt stehen schon. Dann fehlt nur das Ja. *@
                        <button type="button" class="btn btn-ghost" disabled="@busy"
                                @onclick="@(() => AskFileAsync(item))">Wegräumen</button>
                    }
                </div>
            </AuthorizeView>

            @*
                „Wegräumen“ nimmt keine Werte — es räumt die Zeile weg. Stehen gelesene Werte
                offen, sagt der Eingang das, bevor der Beleg verschwindet: genau so sind dreizehn
                Statusreporte eines Vertrags durchgerutscht, und am Vertrag stand hinterher eine
                Null. Der bessere Weg steht daneben, nicht dahinter.
            *@
            @if (wegraeumen == item.Id)
            {
                <AuthorizeView Roles="Owner,Member">
                    <div class="notice">
                        <span class="notice-title">
                            @item.UnconfirmedValues gelesene
                            @(item.UnconfirmedValues == 1 ? "Angabe" : "Angaben") sind noch nicht
                            übernommen
                        </span>
                        <span class="notice-text">
                            Weggeräumt verschwindet der Beleg aus dem Eingang, und seine Werte
                            bleiben, wo sie sind: in keinem Objekt.
                        </span>

                        <div class="doc-actions">
                            @if (item.ValuesHref is { Length: > 0 } jetzt)
                            {
                                <button type="button" class="btn btn-primary" disabled="@busy"
                                        @onclick="@(() => Navigation.NavigateTo(jetzt))">
                                    Werte übernehmen
                                </button>
                            }

                            <button type="button" class="btn btn-secondary" disabled="@busy"
                                    @onclick="@(() => FileAsync(item))">
                                Trotzdem wegräumen
                            </button>
                            <button type="button" class="btn btn-ghost" disabled="@busy"
                                    @onclick="@(() => wegraeumen = null)">Zurück</button>
                        </div>
                    </div>
                </AuthorizeView>
            }
        }

        <div class="spacer"></div>
    }
</AsyncView>

@if (assigning is { } offen)
{
    <ScanAssignSheet Item="offen" Types="types"
                     OnAssigned="AfterAssignAsync"
                     OnClose="@(() => assigning = null)" />
}

@code {
    private ScanInboxDto? data;

    /// <summary>Die Typenliste des Haushalts — für das Zuordnen-Sheet.</summary>
    private IReadOnlyList<DocumentTypeDto> types = [];

    /// <summary>Der Eintrag, für den gerade nachgefragt wird — <c>null</c> im Normalfall.</summary>
    private int? wegraeumen;

    private ScanInboxItemDto? assigning;
    private bool busy;

    /// <summary>
    /// Eingang und Typenliste zusammen. Die Liste im Sheet nachzuladen hieße, sie bei jedem
    /// Öffnen erneut zu holen — sie ändert sich seltener als der Eingang.
    /// </summary>
    protected override async Task LoadAsync()
    {
        data = await Api.GetScanInboxAsync();
        types = await Api.GetAssignableDocumentTypesAsync();
    }

    private async Task AfterAssignAsync()
    {
        assigning = null;
        await ReloadAsync();
    }

    /// <summary>
    /// Räumt einen erkannten Beleg weg.
    /// </summary>
    /// <remarks>
    /// Der Server prüft trotzdem, ob Typ und Objekt wirklich stehen. „Erkannt“ ist die Zusage der
    /// Einlieferung, nicht der Beweis — dazwischen kann jemand den Vertrag gelöscht haben.
    /// </remarks>
    /// <summary>
    /// Wegräumen — mit Rückfrage, wo Werte offen sind.
    /// </summary>
    /// <remarks>
    /// Ohne offene Werte ist Wegräumen harmlos: der Beleg ist eingeordnet, mehr war nie zu
    /// holen. Eine Rückfrage bei jedem Mal wäre dann nur ein Klick mehr — und eine Rückfrage,
    /// die immer kommt, liest irgendwann niemand mehr.
    /// </remarks>
    private Task AskFileAsync(ScanInboxItemDto item)
    {
        if (item.UnconfirmedValues == 0)
        {
            return FileAsync(item);
        }

        wegraeumen = item.Id;
        return Task.CompletedTask;
    }

    private Task FileAsync(ScanInboxItemDto item) => RunAsync(async () =>
    {
        wegraeumen = null;
        busy = true;

        try
        {
            await Api.FileScanInboxAsync(item.Id);
            Toasts.Show($"{item.FileName} ist eingeordnet.");
            await ReloadAsync();
        }
        finally
        {
            busy = false;
        }
    });

    private static string Describe(ScanInboxItemDto item)
    {
        var parts = new List<string>();

        if (item.Sender is { Length: > 0 } sender)
        {
            parts.Add(sender);
        }

        if (item.PageCount is { } pages)
        {
            parts.Add($"{pages} {(pages == 1 ? "Seite" : "Seiten")}");
        }

        parts.Add("eingegangen " + GermanFormat.Date(item.ArrivedOn));
        return string.Join(" · ", parts);
    }
}
