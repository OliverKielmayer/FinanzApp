@page "/scaneingang/{Id:int}"
@attribute [Authorize]
@inherits AppPage

@*
    Der Prüfplatz: ein Beleg, groß, und daneben die Entscheidung.

    Vorher waren Ansehen und Zuordnen zwei Orte. Wer wissen wollte, was auf einem Zettel steht,
    tippte die Zeile an und stand im Dokumentbereich — wo sich nichts zuordnen lässt. Also
    zurück, „Zuordnen“, und nun entscheiden, ohne den Beleg vor Augen zu haben. Bei sechs
    Belegen am Stück ist das sechsmal derselbe Umweg, und beim sechsten rät man.

    Hier steht beides nebeneinander, und „Zuordnen und weiter“ führt zum nächsten Wartenden.
    Der Stapel ist die Einheit, nicht der einzelne Zettel.
*@

<PageTitle>Beleg prüfen — FinanzApp</PageTitle>

<AsyncView Loading="Loading" Error="@Error" Stale="HasLoadedOnce" Retry="ReloadAsync">
    @if (Aktueller is { } beleg)
    {
        <section class="hero">
            <span class="label-muted">Beleg @Platz von @Gesamt</span>
            <span class="sheet-payee">@beleg.FileName</span>
            <span class="meta">
                @if (beleg.PageCount is { } seiten)
                {
                    <text>@seiten @(seiten == 1 ? "Seite" : "Seiten") · </text>
                }
                eingegangen @GermanFormat.Date(beleg.ArrivedOn)
            </span>
        </section>

        <div class="triage">
            @*
                Die Datei selbst, so groß wie der Platz hergibt. Das ist der ganze Zweck dieser
                Seite: Wer entscheidet, wohin ein Beleg gehört, muss ihn lesen können.
            *@
            <div class="triage-paper">
                @switch (DocumentPreview.For(null, beleg.FileName))
                {
                    case DocumentPreviewKind.Frame:
                        <iframe class="triage-frame" src="@DocumentPreview.FileUrl(beleg.DocumentId)"
                                title="@($"Vorschau von {beleg.FileName}")"></iframe>
                        break;

                    case DocumentPreviewKind.Image:
                        <img class="triage-image" src="@DocumentPreview.FileUrl(beleg.DocumentId)"
                             alt="@($"Vorschau von {beleg.FileName}")" />
                        break;

                    default:
                        <div class="doc-preview">
                            Diese Dateiart lässt sich hier nicht anzeigen. Zuordnen geht trotzdem —
                            und öffnen auch.
                        </div>
                        break;
                }

                <a class="section-link" href="@DocumentPreview.FileUrl(beleg.DocumentId)"
                   target="_blank" rel="noopener">In eigenem Fenster öffnen</a>
            </div>

            <div class="triage-form">
                @*
                    Ansehen darf jeder, der den Haushalt sehen darf; zuordnen nur, wer schreiben
                    darf. Die Rolle „ReadOnly“ ist für das Steuerbüro gedacht — es soll einen
                    Beleg aufschlagen können, ohne ihn einsortieren zu dürfen. Stünde die ganze
                    Seite unter Schreibrecht, wäre ihm der Beleg nicht mehr zugänglich, seit die
                    Zeile im Eingang hierher führt.
                *@
                <AuthorizeView Roles="Owner,Member" Context="zuordnen">
                    <NotAuthorized>
                        <div class="triage-hint">
                            Dieser Beleg lässt sich ansehen, aber nicht einordnen: Dafür fehlt
                            das Schreibrecht im Haushalt. Er bleibt im Eingang stehen.
                        </div>
                    </NotAuthorized>
                    <Authorized>
                @*
                    Was der Text vermuten lässt. Der Vorschlag steht nicht nur da — er ist im
                    Typ schon gesetzt, sonst wäre er eine Auskunft zum Abtippen. Geändert wird
                    er mit einem Tipp, und bestätigt wird ohnehin von Hand.
                *@
                @if (beleg.SuggestedType is { Length: > 0 } geraten)
                {
                    @* Ohne Artikel: „eine Gebührenbescheid“ stand hier, und ebenso „eine
                       Kontoauszug“ und „eine Steuerbescheid“. Das Geschlecht steckt im Namen,
                       den der Haushalt selbst vergibt — raten lässt es sich nicht, und ein
                       falscher Artikel lässt den ganzen Satz nach Maschine klingen. *@
                    <div class="triage-hint">
                        Dem Text nach: <strong>@geraten</strong>, Ablage unter @beleg.SuggestedArea.
                        @if (!beleg.SuggestedTypeExists)
                        {
                            <text>
                                Diesen Dokumenttyp gibt es im Haushalt noch nicht —
                                <a href="/dokumenttypen">jetzt anlegen</a>.
                            </text>
                        }
                    </div>
                }

                <div class="picker">
                    <span class="label-strong">Typ</span>
                    @if (types.Count == 0)
                    {
                        <span class="meta">
                            Es gibt noch keinen Dokumenttyp.
                            <a href="/dokumenttypen">Hier lässt sich einer anlegen.</a>
                        </span>
                    }
                    else
                    {
                        <div class="chipcloud">
                            @foreach (var type in types)
                            {
                                <button type="button" class="chip @(typeId == type.Id ? "active" : null)"
                                        @onclick="() => typeId = type.Id">@type.Name</button>
                            }
                        </div>
                    }
                </div>

                <div class="picker">
                    <span class="label-strong">Objekt</span>

                    @if (anlegen)
                    {
                        @*
                            Die fehlende Tür.

                            Eine Arztrechnung gehört an einen Erstattungsvorgang — Betrag,
                            Eigenanteil, was die Kasse noch schuldet. Den gibt es beim ersten
                            Beleg naturgemäß noch nicht, und bisher führte der einzige Weg
                            dahin über „Beleg scannen“ unter Gesundheit: denselben Zettel ein
                            zweites Mal einlesen, obwohl er hier schon abgelegt und gelesen
                            daliegt. Wer das einmal gemacht hat, hängt die Rechnung beim
                            nächsten Mal an den Krankenversicherungsvertrag, weil das schneller
                            geht — und dann steht sie am Vertrag statt an ihrer Erstattung.

                            Also wird der Vorgang hier angelegt, mit dem Beleg vor Augen.
                        *@
                        @*
                            Gelesen und nicht geraten — und jedes Feld sagt, woraus.

                            Ein Betrag mit seiner Quellzeile ist in einer Sekunde geprüft; einer
                            ohne ist eine Behauptung, die niemand mehr nachsieht. Bei einer
                            Erstattung wandert er in eine Forderung gegen die Kasse, also steht
                            die Zeile dabei.
                        *@
                        @if (liest)
                        {
                            <span class="meta">Der Beleg wird gelesen …</span>
                        }
                        else if (gelesen is { HasContent: true })
                        {
                            <div class="triage-hint">
                                Aus dem Beleg gelesen. Unter jedem Feld steht die Zeile, aus der
                                der Wert stammt — bitte einmal dagegenhalten.
                            </div>
                        }
                        else if (gelesen is not null)
                        {
                            <div class="triage-hint">
                                Aus diesem Beleg war nichts zu lesen — keine der üblichen
                                Beschriftungen steht darauf. Die Werte bitte eintragen.
                            </div>
                        }

                        <div class="auth-form">
                            <div class="field">
                                <label for="neu-provider">Rechnungssteller</label>
                                <input id="neu-provider" class="input" placeholder="z. B. Dr. Meyer, Zahnarzt"
                                       value="@provider"
                                       @oninput="e => provider = e.Value?.ToString() ?? string.Empty" />
                                @if (gelesen?.ProviderSource is { Length: > 0 } q1)
                                {
                                    <span class="read-from">gelesen aus: @q1</span>
                                }
                            </div>
                            <div class="field">
                                <label for="neu-datum">Rechnungsdatum</label>
                                <input id="neu-datum" class="input" type="date"
                                       value="@billDate.ToString("yyyy-MM-dd")" @onchange="OnBillDateChanged" />
                                @if (gelesen?.BillDateSource is { Length: > 0 } q2)
                                {
                                    <span class="read-from">gelesen aus: @q2</span>
                                }
                                else
                                {
                                    <span class="read-from">nicht gelesen — Eingangsdatum des Belegs</span>
                                }
                            </div>
                            <div class="field">
                                <label for="neu-nummer">Rechnungsnummer</label>
                                <input id="neu-nummer" class="input" placeholder="z. B. R-2026-114"
                                       value="@billNumber"
                                       @oninput="e => billNumber = e.Value?.ToString() ?? string.Empty" />
                                @if (gelesen?.BillNumberSource is { Length: > 0 } q3)
                                {
                                    <span class="read-from">gelesen aus: @q3</span>
                                }
                            </div>
                            <div class="field">
                                <label for="neu-brutto">Betrag (€)</label>
                                @*
                                    Unveränderliche Kultur und nicht die deutsche: Ein
                                    Zahlenfeld im Browser kennt nur den Punkt. Mit einem
                                    Komma stand das Feld leer da — während im Hintergrund der
                                    gelesene Betrag lag, die erwartete Erstattung damit rechnete und der
                                    Schalter frei war. Ein Betrag, den man nicht sieht und
                                    trotzdem anlegt, ist schlimmer als gar keiner.
                                *@
                                <input id="neu-brutto" class="input" type="number" step="0.01" min="0"
                                       value="@Zahl(gross)" @oninput="OnGrossInput" />
                                @if (gelesen?.GrossAmountSource is { Length: > 0 } q4)
                                {
                                    <span class="read-from">gelesen aus: @q4</span>
                                }
                            </div>
                            @*
                                Zahnbehandlung ist keine Nebensächlichkeit, sondern eine
                                Rechengröße: Sie fällt aus dem Jahresdeckel heraus. Deshalb ein
                                Schalter und keine stille Annahme — gelesen wird er aus dem
                                Text, entschieden wird er hier.
                            *@
                            <div class="field">
                                <label class="switch-row" for="neu-zahn">
                                    <input id="neu-zahn" type="checkbox" checked="@zahn"
                                           @onchange="OnDentalChanged" />
                                    <span>Zahnbehandlung</span>
                                </label>
                                @if (gelesen?.IsDentalSource is { Length: > 0 } q5)
                                {
                                    <span class="read-from">gelesen aus: @q5</span>
                                }
                            </div>

                            <div class="field">
                                <label for="neu-eigen">Eigenanteil (€)</label>
                                <input id="neu-eigen" class="input" type="number" step="0.01" min="0"
                                       value="@Zahl(ownShare)" @oninput="OnOwnShareInput" />
                                @*
                                    Nicht vom Beleg, sondern aus dem Vertrag — und die Rechnung
                                    dahinter steht dabei. Ein Eigenanteil, der von selbst
                                    dasteht, muss sagen, woher er kommt; sonst übernimmt man
                                    ihn ungeprüft in eine Forderung gegen die Kasse.
                                *@
                                <span class="read-from">@EigenanteilGrund</span>
                            </div>
                        </div>

                        <div class="detail-block">
                            <span class="detail-label">Erwartete Erstattung</span>
                            <span class="detail-value num">@State.Euro(Erwartet)</span>
                        </div>

                        <span class="meta">
                            Der Eigenanteil zählt als Ausgabe, nicht als offene Forderung. Offen
                            bleibt nur die erwartete Erstattung.
                        </span>

                        <div class="actions">
                            <button type="button" class="btn btn-primary" disabled="@(!KannAnlegen)"
                                    @onclick="CreateBillAndAssignAsync">
                                Anlegen und zuordnen
                            </button>
                            <button type="button" class="btn btn-ghost" disabled="@busy"
                                    @onclick="@(() => anlegen = false)">Zurück zur Suche</button>
                        </div>
                    }
                    else if (objektForm is { } formular)
                    {
                        @*
                            Ein Objekt anlegen, mit dem Beleg daneben.

                            Die Felder sind dieselben wie unter „Neu“ — derselbe Baustein, dieselbe
                            Liste vom Server. Was hier fehlte, wäre dort auch Pflicht; zwei
                            Formulare für dasselbe Objekt liefen auseinander, und das fiele erst
                            auf, wenn eines unvollständig anlegt.
                        *@
                        <span class="meta">@formular.Title</span>

                        <CreateFields Fields="formular.Fields" Values="objektWerte"
                                      @bind-Problem="objektProblem" @bind-ProblemKey="objektProblemKey" />

                        @if (objektProblem is { Length: > 0 } && objektProblemKey is null)
                        {
                            <div class="notice">
                                <span class="notice-title">Noch nicht angelegt</span>
                                <span class="notice-text">@objektProblem</span>
                            </div>
                        }

                        <div class="doc-actions">
                            <button type="button" class="btn btn-primary" disabled="@busy"
                                    @onclick="CreateObjectAsync">@formular.SubmitLabel</button>
                            <button type="button" class="btn btn-ghost" disabled="@busy"
                                    @onclick="CancelObject">Zurück zur Suche</button>
                        </div>
                    }
                    else if (picked is { } gewaehlt)
                    {
                        @* Das Gewählte steht statt der Suche da: es ist die Antwort auf die Frage,
                           und die Suchtreffer darunter wären nur noch Ablenkung. *@
                        <button type="button" class="tap more-row open" @onclick="Reset">
                            <span class="stack">
                                <span class="more-label">@gewaehlt.Label</span>
                                <span class="meta">@gewaehlt.TargetLabel · @gewaehlt.Subtitle</span>
                            </span>
                            <span class="tag tag-neutral">ändern</span>
                        </button>
                    }
                    else
                    {
                        <div class="searchbar">
                            <input class="input" type="search" placeholder="Vertrag, Immobilie, Fahrzeug …"
                                   aria-label="Objekt suchen" value="@term" @oninput="OnSearchInput" />
                        </div>

                        @if (searching)
                        {
                            <span class="meta">Wird gesucht …</span>
                        }
                        else if (term.Trim().Length > 0 && hits.Count == 0)
                        {
                            <span class="meta">
                                Kein Objekt passt zu „@term“. Der Beleg lässt sich trotzdem
                                ablegen — er steht dann unter „ohne Objekt“ und kann später
                                angehängt werden.
                            </span>
                        }

                        @foreach (var hit in hits)
                        {
                            <button type="button" class="tap more-row" @onclick="() => picked = hit">
                                <span class="stack">
                                    <span class="more-label">@hit.Label</span>
                                    <span class="meta">@hit.TargetLabel · @hit.Subtitle</span>
                                </span>
                            </button>
                        }

                        @*
                            Steht der Beleg unter Gesundheit, fehlt sein Objekt fast immer — ein
                            Erstattungsvorgang entsteht erst mit der ersten Rechnung. Der Schalter
                            steht deshalb hier und nicht hinter einer Fehlersuche.
                        *@
                        @if (IstGesundheit)
                        {
                            <button type="button" class="btn btn-secondary" disabled="@busy"
                                    @onclick="BeginBill">Neue Arztrechnung anlegen</button>
                        }

                        @*
                            Und für alles andere, das es noch nicht gibt.

                            Ein Notarschreiben zum Hauskauf kommt an, bevor das Haus angelegt ist;
                            die erste Rechnung eines Versorgers, bevor der Vertrag erfasst ist. Wer
                            dafür den Prüfplatz verlassen muss, kommt mit dem Beleg im Kopf zurück
                            — oder gar nicht.
                        *@
                        <span class="create-help">Gibt es das Objekt noch nicht, hier anlegen:</span>

                        <div class="chipcloud">
                            @foreach (var weg in Anlegewege)
                            {
                                <button type="button" class="chip" disabled="@busy"
                                        @onclick="() => BeginObjectAsync(weg.Type)">@weg.Label</button>
                            }
                        </div>
                    }
                </div>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>

        @*
            Der Hauptschalter sagt, was als Nächstes kommt — und was überhaupt geschieht.
            „Zuordnen“ mit Objekt, „Ablegen“ ohne; „und weiter“ bei einem Stapel, „und fertig“
            beim letzten. Wer liest, was er drückt, soll nicht überrascht werden: ein Beleg,
            der nur abgelegt wird, soll nicht als zugeordnet angekündigt sein.
        *@
        <div class="triage-foot">
            <AuthorizeView Roles="Owner,Member" Context="schalter">
                <button type="button" class="btn btn-primary" disabled="@(!CanAssign)"
                        @onclick="AssignAsync">
                    @(picked is null ? "Ablegen" : "Zuordnen")@(NaechsterId is null ? " und fertig" : " und weiter")
                </button>

                @* Was ohne Objekt geschieht, steht am Schalter und nicht in einer Meldung
                   hinterher. Vorher entscheiden ist billiger als nachher suchen. *@
                @if (picked is null && typeId is not null)
                {
                    <span class="triage-hint">
                        Noch kein Objekt gewählt — der Beleg wird abgelegt und bleibt unter
                        „ohne Objekt“ auffindbar.
                    </span>
                }

                @if (beleg.ValuesHref is { Length: > 0 } pruefen)
                {
                    <button type="button" class="btn btn-ghost" disabled="@busy"
                            @onclick="@(() => Navigation.NavigateTo(pruefen))">
                        @(beleg.ValuesLabel ?? "Werte lesen")
                    </button>
                }
            </AuthorizeView>

            @* Blättern und zurück sind kein Schreiben — die stehen jedem offen. *@
            @if (NaechsterId is { } weiter)
            {
                <button type="button" class="btn btn-secondary" disabled="@busy"
                        @onclick="@(() => Navigation.NavigateTo($"/scaneingang/{weiter}"))">
                    Überspringen
                </button>
            }

            <button type="button" class="btn btn-ghost" disabled="@busy"
                    @onclick="@(() => Navigation.NavigateTo("/scaneingang"))">
                Zum Eingang
            </button>
        </div>

        <div class="spacer"></div>
    }
    else if (HasLoadedOnce)
    {
        @*
            Der Beleg ist weg — zugeordnet, weggeräumt oder gelöscht, womöglich in einem anderen
            Fenster. Eine leere Seite ließe raten; dieser Satz sagt, was passiert ist.
        *@
        <div class="empty-area">
            <span class="empty-area-title">Dieser Beleg wartet nicht mehr</span>
            <span class="empty-area-text">
                Er ist zugeordnet oder weggeräumt worden. Im Eingang steht, was noch offen ist.
            </span>
            <button type="button" class="btn btn-primary"
                    @onclick="@(() => Navigation.NavigateTo("/scaneingang"))">Zum Eingang</button>
        </div>
    }
</AsyncView>

@code {
    [Parameter] public int Id { get; set; }

    private ScanInboxDto? data;
    private IReadOnlyList<DocumentTypeDto> types = [];

    private int? typeId;
    private ObjectHitDto? picked;
    private IReadOnlyList<ObjectHitDto> hits = [];
    private string term = string.Empty;
    private bool searching;
    private bool busy;

    // ── Ein Objekt anlegen, ohne den Prüfplatz zu verlassen ────────────────────────────────

    /// <summary>
    /// Was sich von hier aus anlegen lässt.
    /// </summary>
    /// <remarks>
    /// <para>Nicht alle Anlegewege: Ein Budget ist eine Vorgabe und kein Gegenstand, an dem ein
    /// Beleg hinge. Hier stehen die, zu denen Post ins Haus kommt.</para>
    /// <para>Der offene Posten steht vorn, weil er der häufigste ist: Was mit der Post kommt und
    /// Geld kostet, ist meistens eine Rechnung. Er ist auch der einzige Weg hier, der nicht ein
    /// Objekt beschreibt, sondern eine Verpflichtung — und der einzige, der von selbst wieder
    /// verschwindet, sobald die Zahlung dasteht.</para>
    /// </remarks>
    private static readonly (CreateObjectType Type, string Label)[] Anlegewege =
    [
        (CreateObjectType.Invoice, "Offener Posten"),
        (CreateObjectType.Property, "Immobilie"),
        (CreateObjectType.Contract, "Vertrag"),
        (CreateObjectType.Vehicle, "Fahrzeug"),
        (CreateObjectType.Purchase, "Anschaffung"),
        (CreateObjectType.Protection, "Versicherung"),
        (CreateObjectType.Pension, "Vorsorge"),
        (CreateObjectType.Account, "Konto"),
        (CreateObjectType.Loan, "Darlehen"),
    ];

    private CreateFormDto? objektForm;
    private readonly Dictionary<string, string?> objektWerte = [];
    private string? objektProblem;
    private string? objektProblemKey;

    /// <summary>Für welchen Beleg der Vorschlag schon eingesetzt wurde.</summary>
    /// <remarks>
    /// Ohne diese Marke setzte jedes Neuzeichnen den Typ zurück auf den Vorschlag — und eine
    /// Auswahl, die sich von selbst rückgängig macht, ist schlimmer als keine Vorbelegung.
    /// </remarks>
    private int? vorbelegtFuer;

    private CancellationTokenSource? debounce;

    // ── Eine Arztrechnung, die es noch nicht gibt ──────────────────────────────────────────

    private bool anlegen;
    private bool liest;

    /// <summary>Was aus dem Beleg gelesen wurde — mit den Zeilen, aus denen es stammt.</summary>
    private ExtractedBillDto? gelesen;

    private string provider = string.Empty;
    private string billNumber = string.Empty;
    private DateOnly billDate;
    private decimal gross;
    private decimal ownShare;

    /// <summary>Ob der Beleg eine Zahnbehandlung ist — gelesen, aber umschaltbar.</summary>
    private bool zahn;

    /// <summary>Die Selbstbeteiligungsregel des Vertrags, so weit gepflegt.</summary>
    private OwnShareRuleDto? regel;

    /// <summary>
    /// Ob jemand den Eigenanteil von Hand gesetzt hat.
    /// </summary>
    /// <remarks>
    /// Dann wird er nicht mehr überschrieben, wenn sich der Betrag ändert — ein Wert, der sich
    /// unter den Fingern zurücksetzt, ist schlimmer als keiner. Das Umschalten von
    /// „Zahnbehandlung“ hebt die Marke wieder auf: Dort ändert sich die Regel selbst, nicht
    /// nur ihre Eingangsgröße.
    /// </remarks>
    private bool eigenanteilVonHand;

    /// <summary>Die Begründung unter dem Eigenanteil.</summary>
    private string EigenanteilGrund { get; set; } = "steht nicht auf der Rechnung";

    /// <summary>Was nach dem Eigenanteil offen bleibt — dieselbe Rechnung wie am Vorgang.</summary>
    private decimal Erwartet => Math.Max(0m, gross - ownShare);

    /// <summary>
    /// Ob der gewählte Typ in den Gesundheitsbereich gehört.
    /// </summary>
    /// <remarks>
    /// Am Typ und nicht am Namen: „Arztrechnung“ kann im Haushalt anders heißen, der Bereich
    /// steht am Typ fest. Ohne gewählten Typ ist die Frage offen, und dann steht der Schalter
    /// auch nicht da.
    /// </remarks>
    private bool IstGesundheit
        => types.FirstOrDefault(t => t.Id == typeId)?.Area == DocumentArea.Health;

    private bool KannAnlegen
        => !busy && typeId is not null && provider.Trim().Length > 0
           && gross > 0m && ownShare >= 0m && ownShare <= gross;

    private ScanInboxItemDto? Aktueller
        => data?.Items.FirstOrDefault(i => i.Id == Id);

    private int Platz
        => data is null ? 0 : data.Items.ToList().FindIndex(i => i.Id == Id) + 1;

    private int Gesamt => data?.Items.Count ?? 0;

    /// <summary>
    /// Der nächste wartende Beleg — der danach, sonst der davor, sonst keiner.
    /// </summary>
    /// <remarks>
    /// Beim letzten Beleg eines Stapels zurück an den Anfang zu springen hieße, von vorn
    /// anzufangen. Dann lieber zurück in den Eingang: dort steht, was übrig ist.
    /// </remarks>
    private int? NaechsterId
    {
        get
        {
            if (data is null)
            {
                return null;
            }

            var liste = data.Items;
            var hier = liste.ToList().FindIndex(i => i.Id == Id);

            return hier >= 0 && hier + 1 < liste.Count ? liste[hier + 1].Id : null;
        }
    }

    /// <summary>
    /// Was der Hauptschalter verlangt: eine Art. Mehr nicht.
    /// </summary>
    /// <remarks>
    /// Früher auch ein Objekt. Das klang nach Sorgfalt und war eine Sackgasse: Ein
    /// Notarschreiben zum Hauskauf kommt an, bevor das Haus angelegt ist, und ein Lieferschein
    /// bekommt nie ein Objekt. Beide blieben für immer im Eingang liegen — und wer das zweimal
    /// erlebt hat, hängt den nächsten Beleg an irgendetwas, damit er verschwindet. Das ist
    /// schlechter als gar keine Verknüpfung, weil es wie eine aussieht.
    /// </remarks>
    private bool CanAssign => !busy && typeId is not null;

    protected override async Task LoadAsync()
    {
        data = await Api.GetScanInboxAsync();
        types = await Api.GetAssignableDocumentTypesAsync();

        Vorbelegen();
    }

    /// <summary>
    /// Setzt den vorgeschlagenen Typ ein, wenn es ihn gibt.
    /// </summary>
    /// <remarks>
    /// Das Ziel ist, dass der Benutzer möglichst wenig entscheiden muss. Ein Vorschlag, der
    /// danebensteht und abgetippt werden will, erreicht das nicht — er muss im Feld stehen.
    /// Bestätigt wird er trotzdem von Hand: Ohne Objekt geht ohnehin nichts weiter.
    /// </remarks>
    private void Vorbelegen()
    {
        if (vorbelegtFuer == Id || Aktueller is not { } beleg)
        {
            return;
        }

        vorbelegtFuer = Id;
        typeId = null;
        Reset();

        if (beleg.SuggestedType is not { Length: > 0 } geraten || !beleg.SuggestedTypeExists)
        {
            return;
        }

        typeId = types
            .FirstOrDefault(t => string.Equals(t.Name, geraten, StringComparison.OrdinalIgnoreCase))
            ?.Id;
    }

    private void Reset()
    {
        picked = null;
        term = string.Empty;
        hits = [];
        anlegen = false;
        gelesen = null;
        CancelObject();
    }

    /// <summary>
    /// Holt das Anlegeformular für einen Objekttyp und zeigt es an Ort und Stelle.
    /// </summary>
    /// <remarks>
    /// Die Feldliste kommt vom Server, wie auf der Anlegeseite auch. Sie hier nachzubauen hieße,
    /// sie zweimal zu pflegen — und die zweite Fassung vergäße beim nächsten neuen Feld etwas.
    /// </remarks>
    private Task BeginObjectAsync(CreateObjectType typ) => RunAsync(async () =>
    {
        busy = true;
        try
        {
            objektWerte.Clear();
            objektProblem = null;
            objektProblemKey = null;

            // Mit dem Beleg daneben: Händler, Kaufdatum und Preis stehen auf dem Blatt, und der
            // gelesene Text liegt am Dokument. Was der Server davon zuordnen kann, kommt als
            // Vorgabewert zurück — und was er nicht lesen konnte, bleibt leer.
            objektForm = await Api.GetCreateFormAsync(typ, Aktueller?.DocumentId);

            foreach (var feld in objektForm.Fields.Where(f => f.DefaultValue is { Length: > 0 }))
            {
                objektWerte[feld.Key] = feld.DefaultValue;
            }
        }
        catch (ApiException ex)
        {
            objektForm = null;
            Toasts.Show(ex.Message, ToastKind.Problem);
        }
        finally
        {
            busy = false;
        }
    });

    private void CancelObject()
    {
        objektForm = null;
        objektWerte.Clear();
        objektProblem = null;
        objektProblemKey = null;
    }

    /// <summary>
    /// Legt das Objekt an und wählt es gleich aus.
    /// </summary>
    /// <remarks>
    /// <para>Angelegt und ausgewählt, aber <em>nicht</em> abgelegt: Der Beleg wandert erst, wenn
    /// jemand den Hauptschalter drückt. Wer gerade ein Objekt angelegt hat, soll noch einmal
    /// sehen, woran der Beleg landen wird — das Anlegen ist der aufwendigere Schritt, und genau
    /// danach rutscht ein Griff am ehesten daneben.</para>
    /// <para>Art und Name des neuen Objekts kommen aus der Antwort und nicht aus dem Objekttyp
    /// und den eingetippten Feldern: Zwei Annahmen über etwas, das der Server gerade selbst
    /// geschrieben hat, wären zwei Gelegenheiten, daneben zu liegen.</para>
    /// </remarks>
    private Task CreateObjectAsync() => RunAsync(async () =>
    {
        if (objektForm is not { } formular)
        {
            return;
        }

        busy = true;
        try
        {
            var ergebnis = await Api.CreateObjectAsync(formular.Type, objektWerte);

            if (!ergebnis.Ok)
            {
                objektProblem = ergebnis.Message ?? "Das hat nicht geklappt.";
                objektProblemKey = ergebnis.FieldKey;
                return;
            }

            if (ergebnis is not { LinkTarget: { } art, Id: { } kennung })
            {
                // Angelegt ist es trotzdem — es lässt sich nur nichts daran hängen. Das zu
                // verschweigen hieße, den Beleg stillschweigend ohne Objekt abzulegen.
                CancelObject();
                Toasts.Show("Angelegt — daran lässt sich aber nichts hängen.", ToastKind.Saved);
                return;
            }

            picked = new ObjectHitDto
            {
                TargetType = art,
                TargetId = kennung,
                Label = ergebnis.Label ?? formular.Title,
                Subtitle = "gerade angelegt",
                TargetLabel = Anlegewege.FirstOrDefault(w => w.Type == formular.Type).Label ?? "Objekt",
            };

            CancelObject();
            term = string.Empty;
            hits = [];
            Toasts.Show($"{picked.Label} angelegt.", ToastKind.Saved);
        }
        catch (ApiException ex)
        {
            objektProblem = ex.Message;
            objektProblemKey = null;
        }
        finally
        {
            busy = false;
        }
    });

    /// <summary>
    /// Öffnet das Formular für einen neuen Erstattungsvorgang.
    /// </summary>
    /// <remarks>
    /// Das Rechnungsdatum startet auf dem Eingangsdatum des Belegs und nicht auf heute: Post
    /// liegt selten lange. Es ist trotzdem geraten — deshalb steht es als Feld da, und der
    /// Beleg daneben sagt, was wirklich drauf steht. Rechnungssteller und Betrag bleiben leer;
    /// sie zu raten hieße, eine Zahl zu erfinden, die anschließend niemand mehr prüft.
    /// </remarks>
    private async Task BeginBill()
    {
        if (Aktueller is not { } beleg)
        {
            return;
        }

        anlegen = true;
        liest = true;
        gelesen = null;
        regel = null;

        provider = string.Empty;
        billNumber = string.Empty;
        billDate = beleg.ArrivedOn;
        gross = 0m;
        ownShare = 0m;
        zahn = false;
        eigenanteilVonHand = false;
        EigenanteilGrund = "steht nicht auf der Rechnung";

        try
        {
            var antwort = await Api.ExtractBillFromDocumentAsync(beleg.DocumentId);
            gelesen = antwort.Bill;
            regel = antwort.OwnShare;

            // Nur übernehmen, was gelesen wurde. Ein nicht gefundenes Feld bleibt auf seiner
            // Vorgabe stehen und fragt — eine Null im Betragsfeld sähe aus wie ein Ergebnis.
            provider = antwort.Bill.Provider ?? string.Empty;
            billNumber = antwort.Bill.BillNumber ?? string.Empty;
            billDate = antwort.Bill.BillDate ?? beleg.ArrivedOn;
            gross = antwort.Bill.GrossAmount ?? 0m;
            zahn = antwort.Bill.IsDental;

            Eigenanteil();
        }
        catch (ApiException ex)
        {
            // Das Lesen ist eine Erleichterung und keine Bedingung. Scheitert es, bleibt die
            // Maske leer und der Vorgang lässt sich trotzdem anlegen.
            gelesen = null;
            regel = null;
            Toasts.Show(ex.Message, ToastKind.Problem);
        }
        finally
        {
            liest = false;
        }
    }

    /// <summary>
    /// Schlägt den Eigenanteil aus der Vertragsregel vor.
    /// </summary>
    /// <remarks>
    /// Gerechnet wird mit derselben Funktion wie auf dem Server — die Regel steht im
    /// gemeinsamen Teil, damit sie nicht an zwei Orten auseinanderläuft. Was von Hand gesetzt
    /// wurde, bleibt stehen; die Begründung sagt dann, was die Regel ergeben hätte.
    /// </remarks>
    private void Eigenanteil()
    {
        var rat = OwnShareRule.For(gross, zahn, regel);
        EigenanteilGrund = rat.Reason;

        if (eigenanteilVonHand || rat.Amount is not { } vorschlag)
        {
            return;
        }

        ownShare = vorschlag;
    }

    private void OnGrossInput(ChangeEventArgs e)
    {
        gross = Parse(e.Value);
        Eigenanteil();
    }

    private void OnOwnShareInput(ChangeEventArgs e)
    {
        ownShare = Parse(e.Value);
        eigenanteilVonHand = true;
    }

    /// <summary>
    /// „Zahnbehandlung“ umgeschaltet.
    /// </summary>
    /// <remarks>
    /// Hier ändert sich die Regel selbst und nicht nur ihre Eingangsgröße — deshalb gilt auch
    /// ein von Hand gesetzter Eigenanteil nicht mehr. Wer ihn trotzdem will, trägt ihn danach
    /// wieder ein.
    /// </remarks>
    private void OnDentalChanged(ChangeEventArgs e)
    {
        zahn = e.Value is true;
        eigenanteilVonHand = false;
        Eigenanteil();
    }

    private void OnBillDateChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var parsed))
        {
            billDate = parsed;
        }
    }

    /// <summary>
    /// Ein Betrag, wie ein Zahlenfeld im Browser ihn versteht: mit Punkt.
    /// </summary>
    private static string Zahl(decimal wert)
        => wert.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private static decimal Parse(object? value)
        => decimal.TryParse(
            value?.ToString(),
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture,
            out var parsed)
            ? parsed
            : 0m;

    /// <summary>
    /// Legt den Erstattungsvorgang an und ordnet den Beleg daran zu.
    /// </summary>
    /// <remarks>
    /// <para><b>Zwei Aufrufe und kein <c>DocumentId</c> beim Anlegen.</b> Der Anlege-Aufruf
    /// kann den Beleg selbst verknüpfen — dann hinge er am Vorgang, stünde aber weiter ohne Typ
    /// im Eingang. Das Zuordnen macht beides und mehr: Es setzt den Typ, legt die Datei in den
    /// richtigen Ordner um und benennt sie nach ihrem Inhalt. Beides zusammen ergäbe zwei
    /// Verknüpfungen auf dasselbe Ziel.</para>
    /// <para>Scheitert das Zuordnen, steht der Vorgang trotzdem — angelegt ist angelegt. Der
    /// Beleg bleibt dann im Eingang, und das Objekt findet sich jetzt über die Suche.</para>
    /// </remarks>
    private async Task CreateBillAndAssignAsync()
    {
        if (Aktueller is not { } beleg || typeId is not { } type)
        {
            return;
        }

        var weiter = NaechsterId;
        busy = true;

        try
        {
            var vorgang = await Api.CreateMedicalBillAsync(new CreateMedicalBillRequest
            {
                Provider = provider.Trim(),
                BillDate = billDate,
                BillNumber = string.IsNullOrWhiteSpace(billNumber) ? null : billNumber.Trim(),
                GrossAmount = gross,
                OwnShare = ownShare,
                ExpectedReimbursement = Erwartet,
                IsDental = zahn,
            });

            await Api.AssignScanInboxAsync(
                beleg.Id,
                new AssignScanInboxRequest
                {
                    DocumentTypeId = type,
                    TargetType = LinkTargetType.MedicalBill,
                    TargetId = vorgang.Id,
                });

            Toasts.Show($"{beleg.FileName} liegt jetzt bei {vorgang.Provider}.", ToastKind.Saved);

            Navigation.NavigateTo(weiter is { } naechster
                ? $"/scaneingang/{naechster}"
                : "/scaneingang");
        }
        catch (ApiException ex)
        {
            Toasts.Show(ex.Message, ToastKind.Problem);
        }
        finally
        {
            busy = false;
        }
    }

    /// <summary>
    /// Sucht nach 250 ms Ruhe. Dieselbe Wartezeit wie in der Dokumentsuche — jeder Anschlag
    /// wäre eine Anfrage, und die letzte überholte die vorletzte.
    /// </summary>
    private async Task OnSearchInput(ChangeEventArgs e)
    {
        term = e.Value?.ToString() ?? string.Empty;

        debounce?.Cancel();
        debounce?.Dispose();
        debounce = new CancellationTokenSource();

        var laufend = debounce.Token;

        // Ein einzelnes Zeichen trifft halb Haushalt. Die Suche beginnt ab zwei.
        if (term.Trim().Length < 2)
        {
            hits = [];
            searching = false;
            return;
        }

        searching = true;

        try
        {
            await Task.Delay(250, laufend);

            // Die Anfrage selbst läuft ohne Abbruchmarke: ein abgebrochener Aufruf käme als
            // „Der Server hat nicht rechtzeitig geantwortet“ zurück, und das stimmte nicht —
            // es hat nur jemand weitergetippt. Verworfen wird deshalb das Ergebnis, nicht die
            // Anfrage.
            var result = await Api.SearchDocumentsAsync(term.Trim());

            if (laufend.IsCancellationRequested)
            {
                return;
            }

            hits = result.Objects;
            searching = false;
            StateHasChanged();
        }
        catch (OperationCanceledException)
        {
            // Ein neuer Tastenanschlag hat diese Anfrage überholt. „Wird gesucht …“ bleibt
            // stehen, weil die nächste Anfrage schon läuft.
        }
        catch (ApiException ex)
        {
            searching = false;
            Toasts.Show(ex.Message, ToastKind.Problem);
        }
    }

    /// <summary>
    /// Legt ab — mit Objekt, wenn eines gewählt ist — und geht weiter.
    /// </summary>
    /// <remarks>
    /// <para>Das Ziel steht vor dem Aufruf fest. Danach ist der Beleg aus dem Eingang
    /// verschwunden, und „der nächste“ wäre aus einer Liste zu holen, in der er nicht mehr
    /// steht.</para>
    /// <para>Die Meldung nennt beim Namen, was geschehen ist. „Liegt jetzt bei X“ für einen
    /// zugeordneten Beleg, „abgelegt, noch ohne Objekt“ für den anderen — eine Meldung, die
    /// beides gleich nennt, verschweigt genau den Unterschied, auf den es ankommt.</para>
    /// </remarks>
    private async Task AssignAsync()
    {
        if (Aktueller is not { } beleg || typeId is not { } type)
        {
            return;
        }

        var weiter = NaechsterId;
        busy = true;

        try
        {
            await Api.AssignScanInboxAsync(
                beleg.Id,
                new AssignScanInboxRequest
                {
                    DocumentTypeId = type,
                    TargetType = picked?.TargetType,
                    TargetId = picked?.TargetId,
                });

            Toasts.Show(picked is { } ziel
                ? $"{beleg.FileName} liegt jetzt bei {ziel.Label}."
                : $"{beleg.FileName} ist abgelegt — noch ohne Objekt.", ToastKind.Saved);

            Navigation.NavigateTo(weiter is { } naechster
                ? $"/scaneingang/{naechster}"
                : "/scaneingang");
        }
        catch (ApiException ex)
        {
            Toasts.Show(ex.Message, ToastKind.Problem);
        }
        finally
        {
            busy = false;
        }
    }

    /// <summary>
    /// Die laufende Suche abbrechen. Ohne das liefe nach dem Weiterspringen noch eine Anfrage
    /// und schriebe ihr Ergebnis in eine Komponente, die es nicht mehr gibt.
    /// </summary>
    public override void Dispose()
    {
        debounce?.Cancel();
        debounce?.Dispose();

        base.Dispose();
    }
}
