@page "/scaneingang/{Id:int}"
@attribute [Authorize]
@inherits AppPage

@*
    Der Prüfplatz: ein Beleg, groß, und daneben die Entscheidung.

    Vorher waren Ansehen und Zuordnen zwei Orte. Wer wissen wollte, was auf einem Zettel steht,
    tippte die Zeile an und stand im Dokumentbereich — wo sich nichts zuordnen lässt. Also
    zurück, „Zuordnen“, und nun entscheiden, ohne den Beleg vor Augen zu haben. Bei sechs
    Belegen am Stück ist das sechsmal derselbe Umweg, und beim sechsten rät man.

    Hier steht beides nebeneinander, und „Zuordnen und weiter“ führt zum nächsten Wartenden.
    Der Stapel ist die Einheit, nicht der einzelne Zettel.
*@

<PageTitle>Beleg prüfen — FinanzApp</PageTitle>

<AsyncView Loading="Loading" Error="@Error" Stale="HasLoadedOnce" Retry="ReloadAsync">
    @if (Aktueller is { } beleg)
    {
        <section class="hero">
            <span class="label-muted">Beleg @Platz von @Gesamt</span>
            <span class="sheet-payee">@beleg.FileName</span>
            <span class="meta">
                @if (beleg.PageCount is { } seiten)
                {
                    <text>@seiten @(seiten == 1 ? "Seite" : "Seiten") · </text>
                }
                eingegangen @GermanFormat.Date(beleg.ArrivedOn)
            </span>
        </section>

        <div class="triage">
            @*
                Die Datei selbst, so groß wie der Platz hergibt. Das ist der ganze Zweck dieser
                Seite: Wer entscheidet, wohin ein Beleg gehört, muss ihn lesen können.
            *@
            <div class="triage-paper">
                @switch (DocumentPreview.For(null, beleg.FileName))
                {
                    case DocumentPreviewKind.Frame:
                        <iframe class="triage-frame" src="@DocumentPreview.FileUrl(beleg.DocumentId)"
                                title="@($"Vorschau von {beleg.FileName}")"></iframe>
                        break;

                    case DocumentPreviewKind.Image:
                        <img class="triage-image" src="@DocumentPreview.FileUrl(beleg.DocumentId)"
                             alt="@($"Vorschau von {beleg.FileName}")" />
                        break;

                    default:
                        <div class="doc-preview">
                            Diese Dateiart lässt sich hier nicht anzeigen. Zuordnen geht trotzdem —
                            und öffnen auch.
                        </div>
                        break;
                }

                <a class="section-link" href="@DocumentPreview.FileUrl(beleg.DocumentId)"
                   target="_blank" rel="noopener">In eigenem Fenster öffnen</a>
            </div>

            <div class="triage-form">
                @*
                    Ansehen darf jeder, der den Haushalt sehen darf; zuordnen nur, wer schreiben
                    darf. Die Rolle „ReadOnly“ ist für das Steuerbüro gedacht — es soll einen
                    Beleg aufschlagen können, ohne ihn einsortieren zu dürfen. Stünde die ganze
                    Seite unter Schreibrecht, wäre ihm der Beleg nicht mehr zugänglich, seit die
                    Zeile im Eingang hierher führt.
                *@
                <AuthorizeView Roles="Owner,Member" Context="zuordnen">
                    <NotAuthorized>
                        <div class="triage-hint">
                            Dieser Beleg lässt sich ansehen, aber nicht einordnen: Dafür fehlt
                            das Schreibrecht im Haushalt. Er bleibt im Eingang stehen.
                        </div>
                    </NotAuthorized>
                    <Authorized>
                @*
                    Was der Text vermuten lässt. Der Vorschlag steht nicht nur da — er ist im
                    Typ schon gesetzt, sonst wäre er eine Auskunft zum Abtippen. Geändert wird
                    er mit einem Tipp, und bestätigt wird ohnehin von Hand.
                *@
                @if (beleg.SuggestedType is { Length: > 0 } geraten)
                {
                    <div class="triage-hint">
                        Dem Text nach eine <strong>@geraten</strong>, Ablage unter @beleg.SuggestedArea.
                        @if (!beleg.SuggestedTypeExists)
                        {
                            <text>
                                Diesen Dokumenttyp gibt es im Haushalt noch nicht —
                                <a href="/dokumenttypen">jetzt anlegen</a>.
                            </text>
                        }
                    </div>
                }

                <div class="picker">
                    <span class="label-strong">Typ</span>
                    @if (types.Count == 0)
                    {
                        <span class="meta">
                            Es gibt noch keinen Dokumenttyp.
                            <a href="/dokumenttypen">Hier lässt sich einer anlegen.</a>
                        </span>
                    }
                    else
                    {
                        <div class="chipcloud">
                            @foreach (var type in types)
                            {
                                <button type="button" class="chip @(typeId == type.Id ? "active" : null)"
                                        @onclick="() => typeId = type.Id">@type.Name</button>
                            }
                        </div>
                    }
                </div>

                <div class="picker">
                    <span class="label-strong">Objekt</span>

                    @if (anlegen)
                    {
                        @*
                            Die fehlende Tür.

                            Eine Arztrechnung gehört an einen Erstattungsvorgang — Betrag,
                            Eigenanteil, was die Kasse noch schuldet. Den gibt es beim ersten
                            Beleg naturgemäß noch nicht, und bisher führte der einzige Weg
                            dahin über „Beleg scannen“ unter Gesundheit: denselben Zettel ein
                            zweites Mal einlesen, obwohl er hier schon abgelegt und gelesen
                            daliegt. Wer das einmal gemacht hat, hängt die Rechnung beim
                            nächsten Mal an den Krankenversicherungsvertrag, weil das schneller
                            geht — und dann steht sie am Vertrag statt an ihrer Erstattung.

                            Also wird der Vorgang hier angelegt, mit dem Beleg vor Augen.
                        *@
                        <div class="auth-form">
                            <div class="field">
                                <label for="neu-provider">Rechnungssteller</label>
                                <input id="neu-provider" class="input" placeholder="z. B. Dr. Meyer, Zahnarzt"
                                       value="@provider"
                                       @oninput="e => provider = e.Value?.ToString() ?? string.Empty" />
                            </div>
                            <div class="field">
                                <label for="neu-datum">Rechnungsdatum</label>
                                <input id="neu-datum" class="input" type="date"
                                       value="@billDate.ToString("yyyy-MM-dd")" @onchange="OnBillDateChanged" />
                            </div>
                            <div class="field">
                                <label for="neu-nummer">Rechnungsnummer</label>
                                <input id="neu-nummer" class="input" placeholder="z. B. R-2026-114"
                                       value="@billNumber"
                                       @oninput="e => billNumber = e.Value?.ToString() ?? string.Empty" />
                            </div>
                            <div class="field">
                                <label for="neu-brutto">Betrag (€)</label>
                                <input id="neu-brutto" class="input" type="number" step="0.01" min="0"
                                       value="@gross" @oninput="e => gross = Parse(e.Value)" />
                            </div>
                            <div class="field">
                                <label for="neu-eigen">Eigenanteil (€)</label>
                                <input id="neu-eigen" class="input" type="number" step="0.01" min="0"
                                       value="@ownShare" @oninput="e => ownShare = Parse(e.Value)" />
                            </div>
                        </div>

                        <div class="detail-block">
                            <span class="detail-label">Erwartete Erstattung</span>
                            <span class="detail-value num">@State.Euro(Erwartet)</span>
                        </div>

                        <span class="meta">
                            Der Eigenanteil zählt als Ausgabe, nicht als offene Forderung. Offen
                            bleibt nur die erwartete Erstattung.
                        </span>

                        <div class="actions">
                            <button type="button" class="btn btn-primary" disabled="@(!KannAnlegen)"
                                    @onclick="CreateBillAndAssignAsync">
                                Anlegen und zuordnen
                            </button>
                            <button type="button" class="btn btn-ghost" disabled="@busy"
                                    @onclick="@(() => anlegen = false)">Zurück zur Suche</button>
                        </div>
                    }
                    else if (picked is { } gewaehlt)
                    {
                        @* Das Gewählte steht statt der Suche da: es ist die Antwort auf die Frage,
                           und die Suchtreffer darunter wären nur noch Ablenkung. *@
                        <button type="button" class="tap more-row open" @onclick="Reset">
                            <span class="stack">
                                <span class="more-label">@gewaehlt.Label</span>
                                <span class="meta">@gewaehlt.TargetLabel · @gewaehlt.Subtitle</span>
                            </span>
                            <span class="tag tag-neutral">ändern</span>
                        </button>
                    }
                    else
                    {
                        <div class="searchbar">
                            <input class="input" type="search" placeholder="Vertrag, Immobilie, Fahrzeug …"
                                   aria-label="Objekt suchen" value="@term" @oninput="OnSearchInput" />
                        </div>

                        @if (searching)
                        {
                            <span class="meta">Wird gesucht …</span>
                        }
                        else if (term.Trim().Length > 0 && hits.Count == 0)
                        {
                            <span class="meta">
                                Kein Objekt passt zu „@term“. Gibt es das Objekt noch nicht, muss es
                                zuerst angelegt werden — der Beleg bleibt bis dahin im Eingang.
                            </span>
                        }

                        @foreach (var hit in hits)
                        {
                            <button type="button" class="tap more-row" @onclick="() => picked = hit">
                                <span class="stack">
                                    <span class="more-label">@hit.Label</span>
                                    <span class="meta">@hit.TargetLabel · @hit.Subtitle</span>
                                </span>
                            </button>
                        }

                        @*
                            Steht der Beleg unter Gesundheit, fehlt sein Objekt fast immer — ein
                            Erstattungsvorgang entsteht erst mit der ersten Rechnung. Der Schalter
                            steht deshalb hier und nicht hinter einer Fehlersuche.
                        *@
                        @if (IstGesundheit)
                        {
                            <button type="button" class="btn btn-secondary" disabled="@busy"
                                    @onclick="BeginBill">Neue Arztrechnung anlegen</button>
                        }
                    }
                </div>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>

        @*
            Der Hauptschalter sagt, was als Nächstes kommt. „Zuordnen und weiter“ bei einem
            Stapel, „Zuordnen und fertig“ beim letzten — wer liest, was er drückt, soll nicht
            überrascht werden.
        *@
        <div class="triage-foot">
            <AuthorizeView Roles="Owner,Member" Context="schalter">
                <button type="button" class="btn btn-primary" disabled="@(!CanAssign)"
                        @onclick="AssignAsync">
                    @(NaechsterId is null ? "Zuordnen und fertig" : "Zuordnen und weiter")
                </button>

                @if (beleg.ValuesHref is { Length: > 0 } pruefen)
                {
                    <button type="button" class="btn btn-ghost" disabled="@busy"
                            @onclick="@(() => Navigation.NavigateTo(pruefen))">
                        @(beleg.ValuesLabel ?? "Werte lesen")
                    </button>
                }
            </AuthorizeView>

            @* Blättern und zurück sind kein Schreiben — die stehen jedem offen. *@
            @if (NaechsterId is { } weiter)
            {
                <button type="button" class="btn btn-secondary" disabled="@busy"
                        @onclick="@(() => Navigation.NavigateTo($"/scaneingang/{weiter}"))">
                    Überspringen
                </button>
            }

            <button type="button" class="btn btn-ghost" disabled="@busy"
                    @onclick="@(() => Navigation.NavigateTo("/scaneingang"))">
                Zum Eingang
            </button>
        </div>

        <div class="spacer"></div>
    }
    else if (HasLoadedOnce)
    {
        @*
            Der Beleg ist weg — zugeordnet, weggeräumt oder gelöscht, womöglich in einem anderen
            Fenster. Eine leere Seite ließe raten; dieser Satz sagt, was passiert ist.
        *@
        <div class="empty-area">
            <span class="empty-area-title">Dieser Beleg wartet nicht mehr</span>
            <span class="empty-area-text">
                Er ist zugeordnet oder weggeräumt worden. Im Eingang steht, was noch offen ist.
            </span>
            <button type="button" class="btn btn-primary"
                    @onclick="@(() => Navigation.NavigateTo("/scaneingang"))">Zum Eingang</button>
        </div>
    }
</AsyncView>

@code {
    [Parameter] public int Id { get; set; }

    private ScanInboxDto? data;
    private IReadOnlyList<DocumentTypeDto> types = [];

    private int? typeId;
    private ObjectHitDto? picked;
    private IReadOnlyList<ObjectHitDto> hits = [];
    private string term = string.Empty;
    private bool searching;
    private bool busy;

    /// <summary>Für welchen Beleg der Vorschlag schon eingesetzt wurde.</summary>
    /// <remarks>
    /// Ohne diese Marke setzte jedes Neuzeichnen den Typ zurück auf den Vorschlag — und eine
    /// Auswahl, die sich von selbst rückgängig macht, ist schlimmer als keine Vorbelegung.
    /// </remarks>
    private int? vorbelegtFuer;

    private CancellationTokenSource? debounce;

    // ── Eine Arztrechnung, die es noch nicht gibt ──────────────────────────────────────────

    private bool anlegen;
    private string provider = string.Empty;
    private string billNumber = string.Empty;
    private DateOnly billDate;
    private decimal gross;
    private decimal ownShare;

    /// <summary>Was nach dem Eigenanteil offen bleibt — dieselbe Rechnung wie am Vorgang.</summary>
    private decimal Erwartet => Math.Max(0m, gross - ownShare);

    /// <summary>
    /// Ob der gewählte Typ in den Gesundheitsbereich gehört.
    /// </summary>
    /// <remarks>
    /// Am Typ und nicht am Namen: „Arztrechnung“ kann im Haushalt anders heißen, der Bereich
    /// steht am Typ fest. Ohne gewählten Typ ist die Frage offen, und dann steht der Schalter
    /// auch nicht da.
    /// </remarks>
    private bool IstGesundheit
        => types.FirstOrDefault(t => t.Id == typeId)?.Area == DocumentArea.Health;

    private bool KannAnlegen
        => !busy && typeId is not null && provider.Trim().Length > 0
           && gross > 0m && ownShare >= 0m && ownShare <= gross;

    private ScanInboxItemDto? Aktueller
        => data?.Items.FirstOrDefault(i => i.Id == Id);

    private int Platz
        => data is null ? 0 : data.Items.ToList().FindIndex(i => i.Id == Id) + 1;

    private int Gesamt => data?.Items.Count ?? 0;

    /// <summary>
    /// Der nächste wartende Beleg — der danach, sonst der davor, sonst keiner.
    /// </summary>
    /// <remarks>
    /// Beim letzten Beleg eines Stapels zurück an den Anfang zu springen hieße, von vorn
    /// anzufangen. Dann lieber zurück in den Eingang: dort steht, was übrig ist.
    /// </remarks>
    private int? NaechsterId
    {
        get
        {
            if (data is null)
            {
                return null;
            }

            var liste = data.Items;
            var hier = liste.ToList().FindIndex(i => i.Id == Id);

            return hier >= 0 && hier + 1 < liste.Count ? liste[hier + 1].Id : null;
        }
    }

    private bool CanAssign => !busy && typeId is not null && picked is not null;

    protected override async Task LoadAsync()
    {
        data = await Api.GetScanInboxAsync();
        types = await Api.GetAssignableDocumentTypesAsync();

        Vorbelegen();
    }

    /// <summary>
    /// Setzt den vorgeschlagenen Typ ein, wenn es ihn gibt.
    /// </summary>
    /// <remarks>
    /// Das Ziel ist, dass der Benutzer möglichst wenig entscheiden muss. Ein Vorschlag, der
    /// danebensteht und abgetippt werden will, erreicht das nicht — er muss im Feld stehen.
    /// Bestätigt wird er trotzdem von Hand: Ohne Objekt geht ohnehin nichts weiter.
    /// </remarks>
    private void Vorbelegen()
    {
        if (vorbelegtFuer == Id || Aktueller is not { } beleg)
        {
            return;
        }

        vorbelegtFuer = Id;
        typeId = null;
        Reset();

        if (beleg.SuggestedType is not { Length: > 0 } geraten || !beleg.SuggestedTypeExists)
        {
            return;
        }

        typeId = types
            .FirstOrDefault(t => string.Equals(t.Name, geraten, StringComparison.OrdinalIgnoreCase))
            ?.Id;
    }

    private void Reset()
    {
        picked = null;
        term = string.Empty;
        hits = [];
        anlegen = false;
    }

    /// <summary>
    /// Öffnet das Formular für einen neuen Erstattungsvorgang.
    /// </summary>
    /// <remarks>
    /// Das Rechnungsdatum startet auf dem Eingangsdatum des Belegs und nicht auf heute: Post
    /// liegt selten lange. Es ist trotzdem geraten — deshalb steht es als Feld da, und der
    /// Beleg daneben sagt, was wirklich drauf steht. Rechnungssteller und Betrag bleiben leer;
    /// sie zu raten hieße, eine Zahl zu erfinden, die anschließend niemand mehr prüft.
    /// </remarks>
    private void BeginBill()
    {
        if (Aktueller is not { } beleg)
        {
            return;
        }

        anlegen = true;
        provider = string.Empty;
        billNumber = string.Empty;
        billDate = beleg.ArrivedOn;
        gross = 0m;
        ownShare = 0m;
    }

    private void OnBillDateChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var parsed))
        {
            billDate = parsed;
        }
    }

    private static decimal Parse(object? value)
        => decimal.TryParse(
            value?.ToString(),
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture,
            out var parsed)
            ? parsed
            : 0m;

    /// <summary>
    /// Legt den Erstattungsvorgang an und ordnet den Beleg daran zu.
    /// </summary>
    /// <remarks>
    /// <para><b>Zwei Aufrufe und kein <c>DocumentId</c> beim Anlegen.</b> Der Anlege-Aufruf
    /// kann den Beleg selbst verknüpfen — dann hinge er am Vorgang, stünde aber weiter ohne Typ
    /// im Eingang. Das Zuordnen macht beides und mehr: Es setzt den Typ, legt die Datei in den
    /// richtigen Ordner um und benennt sie nach ihrem Inhalt. Beides zusammen ergäbe zwei
    /// Verknüpfungen auf dasselbe Ziel.</para>
    /// <para>Scheitert das Zuordnen, steht der Vorgang trotzdem — angelegt ist angelegt. Der
    /// Beleg bleibt dann im Eingang, und das Objekt findet sich jetzt über die Suche.</para>
    /// </remarks>
    private async Task CreateBillAndAssignAsync()
    {
        if (Aktueller is not { } beleg || typeId is not { } type)
        {
            return;
        }

        var weiter = NaechsterId;
        busy = true;

        try
        {
            var vorgang = await Api.CreateMedicalBillAsync(new CreateMedicalBillRequest
            {
                Provider = provider.Trim(),
                BillDate = billDate,
                BillNumber = string.IsNullOrWhiteSpace(billNumber) ? null : billNumber.Trim(),
                GrossAmount = gross,
                OwnShare = ownShare,
                ExpectedReimbursement = Erwartet,
            });

            await Api.AssignScanInboxAsync(
                beleg.Id,
                new AssignScanInboxRequest
                {
                    DocumentTypeId = type,
                    TargetType = LinkTargetType.MedicalBill,
                    TargetId = vorgang.Id,
                });

            Toasts.Show($"{beleg.FileName} liegt jetzt bei {vorgang.Provider}.");

            Navigation.NavigateTo(weiter is { } naechster
                ? $"/scaneingang/{naechster}"
                : "/scaneingang");
        }
        catch (ApiException ex)
        {
            Toasts.Show(ex.Message);
        }
        finally
        {
            busy = false;
        }
    }

    /// <summary>
    /// Sucht nach 250 ms Ruhe. Dieselbe Wartezeit wie in der Dokumentsuche — jeder Anschlag
    /// wäre eine Anfrage, und die letzte überholte die vorletzte.
    /// </summary>
    private async Task OnSearchInput(ChangeEventArgs e)
    {
        term = e.Value?.ToString() ?? string.Empty;

        debounce?.Cancel();
        debounce?.Dispose();
        debounce = new CancellationTokenSource();

        var laufend = debounce.Token;

        // Ein einzelnes Zeichen trifft halb Haushalt. Die Suche beginnt ab zwei.
        if (term.Trim().Length < 2)
        {
            hits = [];
            searching = false;
            return;
        }

        searching = true;

        try
        {
            await Task.Delay(250, laufend);

            // Die Anfrage selbst läuft ohne Abbruchmarke: ein abgebrochener Aufruf käme als
            // „Der Server hat nicht rechtzeitig geantwortet“ zurück, und das stimmte nicht —
            // es hat nur jemand weitergetippt. Verworfen wird deshalb das Ergebnis, nicht die
            // Anfrage.
            var result = await Api.SearchDocumentsAsync(term.Trim());

            if (laufend.IsCancellationRequested)
            {
                return;
            }

            hits = result.Objects;
            searching = false;
            StateHasChanged();
        }
        catch (OperationCanceledException)
        {
            // Ein neuer Tastenanschlag hat diese Anfrage überholt. „Wird gesucht …“ bleibt
            // stehen, weil die nächste Anfrage schon läuft.
        }
        catch (ApiException ex)
        {
            searching = false;
            Toasts.Show(ex.Message);
        }
    }

    /// <summary>
    /// Ordnet zu und geht weiter.
    /// </summary>
    /// <remarks>
    /// Das Ziel steht vor dem Aufruf fest. Danach ist der Beleg aus dem Eingang verschwunden,
    /// und „der nächste“ wäre aus einer Liste zu holen, in der er nicht mehr steht.
    /// </remarks>
    private async Task AssignAsync()
    {
        if (Aktueller is not { } beleg || typeId is not { } type || picked is not { } ziel)
        {
            return;
        }

        var weiter = NaechsterId;
        busy = true;

        try
        {
            await Api.AssignScanInboxAsync(
                beleg.Id,
                new AssignScanInboxRequest
                {
                    DocumentTypeId = type,
                    TargetType = ziel.TargetType,
                    TargetId = ziel.TargetId,
                });

            Toasts.Show($"{beleg.FileName} liegt jetzt bei {ziel.Label}.");

            Navigation.NavigateTo(weiter is { } naechster
                ? $"/scaneingang/{naechster}"
                : "/scaneingang");
        }
        catch (ApiException ex)
        {
            Toasts.Show(ex.Message);
        }
        finally
        {
            busy = false;
        }
    }

    /// <summary>
    /// Die laufende Suche abbrechen. Ohne das liefe nach dem Weiterspringen noch eine Anfrage
    /// und schriebe ihr Ergebnis in eine Komponente, die es nicht mehr gibt.
    /// </summary>
    public override void Dispose()
    {
        debounce?.Cancel();
        debounce?.Dispose();

        base.Dispose();
    }
}
