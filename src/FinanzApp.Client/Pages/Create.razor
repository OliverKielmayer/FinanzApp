@page "/neu"
@page "/neu/{Type}"
@page "/bearbeiten/{Type}/{Id:int}"
@attribute [Authorize(Roles = "Owner,Member")]
@inherits AppPage
@inject NavigationHistory History

@*
    Ein Formularscreen für alle Objekttypen. Was er zeigt, beschreibt der Server — dieselbe
    Feldliste, gegen die er auch prüft. Deshalb kann eine Meldung das fehlende Feld bei dem
    Namen nennen, den hier steht, und ein neuer Objekttyp braucht keine neue Seite.
*@

<PageTitle>@(form?.Title ?? "Anlegen") — FinanzApp</PageTitle>

@if (string.IsNullOrWhiteSpace(Type))
{
    @* Der Sammeleintrag aus dem Erfassen-Sheet: erst fragen, was angelegt werden soll. *@
    <div class="section-head">
        <span class="label-strong">Was anlegen?</span>
    </div>

    @foreach (var (route, label, hint) in Kinds)
    {
        <button type="button" class="tap contract-row"
                @onclick="@(() => Navigation.NavigateTo(route))">
            <span class="stack">
                <span class="contract-name">@label</span>
                <span class="meta">@hint</span>
            </span>
        </button>
    }

    <div class="spacer"></div>
}
else
{
<AsyncView Loading="Loading" Error="@Error" Retry="ReloadAsync">
    @if (form is { } definition)
    {
        @if (definition.Hint is { Length: > 0 } hint)
        {
            <div class="create-hint">@hint</div>
        }

        @* Police einlesen — nur dort, wo es eine gibt. Die Werte landen nicht im Formular,
           bis jemand sie übernimmt. *@
        @if (SupportsImport)
        {
            <div class="import-panel blueprint">
                <i class="corner tl" aria-hidden="true"></i>
                <i class="corner tr" aria-hidden="true"></i>
                <i class="corner bl" aria-hidden="true"></i>
                <i class="corner br" aria-hidden="true"></i>

                <span class="kicker">Police einlesen</span>

                @if (reading)
                {
                    @* Kein Spinner, sondern die Kette — man sieht, wo es steht. *@
                    <div class="chain">
                        @foreach (var (label, done) in ReadSteps)
                        {
                            <div class="chain-step @(done ? "done" : null) @(!done ? "current" : null)">
                                <span class="chain-mark" aria-hidden="true">@(done ? "✓" : "◻")</span>
                                <span class="chain-title">@label</span>
                            </div>
                        }
                    </div>
                    <div class="doc-actions">
                        <button type="button" class="btn btn-secondary" @onclick="CancelRead">Abbrechen</button>
                    </div>
                }
                else if (analysis is { } read)
                {
                    @if (read.Fields.Count == 0)
                    {
                        <div class="notice">
                            <span class="notice-title">Nichts erkannt</span>
                            <span class="notice-text">@read.Note</span>
                        </div>
                        <span class="create-help num">@read.FileName · @read.RelativePath</span>
                        <div class="doc-actions">
                            <button type="button" class="btn btn-secondary" @onclick="DiscardRead">Verwerfen</button>
                        </div>
                    }
                    else
                    {
                        <span class="create-help num">@read.FileName</span>

                        @foreach (var field in read.Fields)
                        {
                            <div class="import-field @(field.IsUncertain ? "unsure" : null)">
                                <span class="import-field-label">@field.Label</span>
                                <span class="import-field-value num">@field.Display</span>
                                <span class="import-field-origin">
                                    @(field.SourcePage is { } page ? $"Seite {page}" : "ohne Seitenangabe")@(field.IsUncertain ? " · unsicher" : null)
                                </span>
                            </div>
                        }

                        <div class="doc-actions">
                            <button type="button" class="btn btn-primary" @onclick="ApplyRead">
                                Alle @read.Fields.Count Werte übernehmen
                            </button>
                            <button type="button" class="btn btn-secondary" @onclick="DiscardRead">Verwerfen</button>
                        </div>
                    }
                }
                else
                {
                    <span class="create-help">
                        Die Datei bleibt liegen, wo sie ist — gespeichert wird nur ihr Pfad im
                        Dokumentordner. Erkannte Werte füllen das Formular erst auf Ihr Zutun.
                    </span>
                    <div class="note-field">
                        <InputFile class="input" accept=".pdf,image/*" OnChange="OnFilePicked" />
                    </div>
                }
            </div>
        }

        <div class="create-fields">
            @foreach (var field in definition.Fields)
            {
                <div class="field create-field @(problemKey == field.Key ? "invalid" : null)">
                    <label for="@("f-" + field.Key)">
                        @field.Label@(field.Required ? null : (MarkupString)" <span class=\"create-optional\">optional</span>")
                    </label>

                    @switch (field.Kind)
                    {
                        case CreateFieldKind.Choice:
                        case CreateFieldKind.Reference:
                            @if (field.Options is { Count: 0 })
                            {
                                <span class="meta">Nichts zur Auswahl vorhanden.</span>
                            }
                            else
                            {
                                <div class="chipcloud" id="@("f-" + field.Key)">
                                    @foreach (var option in field.Options ?? [])
                                    {
                                        <button type="button"
                                                class="chip @(Get(field.Key) == option.Value ? "active" : null)"
                                                @onclick="() => Pick(field, option)">
                                            @option.Label
                                            @if (option.Hint is { Length: > 0 } optionHint)
                                            {
                                                <span class="chip-hint">@optionHint</span>
                                            }
                                        </button>
                                    }
                                </div>
                            }
                            break;

                        case CreateFieldKind.Date:
                            <input id="@("f-" + field.Key)" class="input" type="date"
                                   value="@Get(field.Key)"
                                   @oninput="e => Set(field.Key, e.Value?.ToString())" />
                            break;

                        case CreateFieldKind.Money:
                            <input id="@("f-" + field.Key)" class="input num" type="text" inputmode="decimal"
                                   placeholder="@field.Placeholder" value="@Get(field.Key)"
                                   @oninput="e => Set(field.Key, e.Value?.ToString())" />
                            break;

                        case CreateFieldKind.Number:
                            <input id="@("f-" + field.Key)" class="input num" type="number" min="0"
                                   placeholder="@field.Placeholder" value="@Get(field.Key)"
                                   @oninput="e => Set(field.Key, e.Value?.ToString())" />
                            break;

                        default:
                            <input id="@("f-" + field.Key)" class="input" type="text"
                                   placeholder="@field.Placeholder" value="@Get(field.Key)"
                                   @oninput="e => Set(field.Key, e.Value?.ToString())" />
                            break;
                    }

                    @if (problemKey == field.Key && problem is { Length: > 0 })
                    {
                        <span class="create-problem">@problem</span>
                    }
                    else if (field.Help is { Length: > 0 } help)
                    {
                        <span class="create-help">@help</span>
                    }
                </div>
            }
        </div>

        @* Eine Meldung ohne zugehöriges Feld gehört trotzdem gezeigt. *@
        @if (problem is { Length: > 0 } && problemKey is null)
        {
            <div class="notice">
                <span class="notice-title">Noch nicht angelegt</span>
                <span class="notice-text">@problem</span>
            </div>
        }

        <div class="actions entry-actions">
            <button type="button" class="btn btn-primary" disabled="@saving"
                    @onclick="SubmitAsync">@definition.SubmitLabel</button>
            <button type="button" class="btn btn-secondary" disabled="@saving"
                    @onclick="History.GoBack">Abbrechen</button>
        </div>

        @* Das Löschen steht unten und durch eine Volllinie abgesetzt — nicht neben dem Speichern.
           Zweistufig statt Systemdialog: der zweite Tipp ist die Bestätigung. *@
        @if (definition.DeleteImpact is { } impact)
        {
            <div class="delete-block">
                <span class="label-strong">@impact.Title</span>
                <span class="delete-consequence">@impact.Consequence</span>

                @if (confirmingDelete)
                {
                    <div class="doc-actions">
                        <button type="button" class="btn btn-primary delete-confirm" disabled="@saving"
                                @onclick="DeleteAsync">Löschen bestätigen</button>
                        <button type="button" class="btn btn-secondary" disabled="@saving"
                                @onclick="@(() => confirmingDelete = false)">Behalten</button>
                    </div>
                }
                else
                {
                    <div class="doc-actions">
                        <button type="button" class="btn btn-secondary" disabled="@saving"
                                @onclick="@(() => confirmingDelete = true)">@impact.ActionLabel</button>
                    </div>
                }
            </div>
        }

        <div class="spacer"></div>
    }
</AsyncView>
}

@code {
    /// <summary>
    /// Die Typen, die angelegt werden können — alle acht aus Abschnitt 6 des Handoffs.
    /// </summary>
    private static readonly (string Route, string Label, string Hint)[] Kinds =
    [
        ("/neu/account", "Konto", "Giro oder Tagesgeld, mit Startsaldo und Stichtag"),
        ("/neu/depot", "Depot", "Broker, Depotwert, Verrechnungskonto"),
        ("/neu/pension", "Vorsorgevertrag", "Kapital-LV, Riester, Bausparen — zählt zum Vermögen"),
        ("/neu/protection", "Versicherung", "Hausrat, Kfz, Haftpflicht — ohne Vermögenswert"),
        ("/neu/property", "Immobilie", "mit Kaufdatum und bestehendem Darlehen"),
        ("/neu/contract", "Vertrag", "Strom, Internet, Wartung — mit Abschlag"),
        ("/neu/vehicle", "Fahrzeug", "Kennzeichen, Erstzulassung, verknüpfte Versicherung"),
        ("/neu/budget", "Budget", "Kategorie, Betrag, Warnschwelle"),
    ];

    [Parameter] public string Type { get; set; } = string.Empty;

    /// <summary>Gesetzt, wenn ein vorhandener Datensatz bearbeitet wird.</summary>
    [Parameter] public int? Id { get; set; }

    private bool confirmingDelete;

    private CreateFormDto? form;
    private readonly Dictionary<string, string?> values = [];
    private string? problem;
    private string? problemKey;
    private bool saving;

    private DocumentAnalysisDto? analysis;
    private bool reading;
    private int readStep;
    private CancellationTokenSource? readCancel;

    /// <summary>
    /// Nur Policen werden eingelesen. Ein Konto oder ein Budget hat kein Dokument, aus dem sich
    /// etwas lesen ließe — dort wäre das Panel eine leere Verheißung.
    /// </summary>
    private bool SupportsImport =>
        Id is null && Parsed is CreateObjectType.Pension or CreateObjectType.Protection;

    /// <summary>Die sichtbare Kette beim Lesen. Sie sagt, wo es steht, statt nur zu kreiseln.</summary>
    private (string Label, bool Done)[] ReadSteps =>
    [
        ("Text erkannt", readStep > 0),
        ("Absender bestimmt", readStep > 1),
        ("Vertragsart erkannt", readStep > 2),
        ("Werte gelesen", readStep > 3),
    ];

    private CreateObjectType Parsed =>
        Enum.TryParse<CreateObjectType>(Type, ignoreCase: true, out var type) ? type : CreateObjectType.Account;

    protected override async Task LoadAsync()
    {
        if (string.IsNullOrWhiteSpace(Type))
        {
            return;
        }

        form = Id is { } id
            ? await Api.GetEditFormAsync(Parsed, id)
            : await Api.GetCreateFormAsync(Parsed);

        values.Clear();
        problem = null;
        problemKey = null;
        confirmingDelete = false;

        foreach (var field in form.Fields.Where(f => f.DefaultValue is { Length: > 0 }))
        {
            values[field.Key] = field.DefaultValue;
        }

        // Vorhandene Werte gewinnen über die Vorbelegung.
        foreach (var (key, value) in form.Values)
        {
            values[key] = value;
        }
    }

    private string? Get(string key) => values.TryGetValue(key, out var value) ? value : null;

    private void Set(string key, string? value)
    {
        values[key] = value;

        // Sobald das bemängelte Feld angefasst wird, verschwindet die Meldung — sie hat ihren
        // Zweck erfüllt und stünde sonst noch da, wenn längst etwas drinsteht.
        if (problemKey == key)
        {
            problem = null;
            problemKey = null;
        }
    }

    /// <summary>
    /// Eine Auswahl kann aus dem Formular herausführen: „Depot“ im Konto-Formular ist kein Konto.
    /// </summary>
    private void Pick(CreateFieldDto field, CreateOptionDto option)
    {
        if (option.RedirectTo is { Length: > 0 } route)
        {
            Navigation.NavigateTo(route);
            return;
        }

        Set(field.Key, option.Value);
    }

    private Task DeleteAsync() => RunAsync(async () =>
    {
        if (Id is not { } id)
        {
            return;
        }

        saving = true;
        try
        {
            var result = await Api.DeleteObjectAsync(Parsed, id);
            if (!result.Ok)
            {
                problem = result.Message;
                problemKey = null;
                confirmingDelete = false;
                return;
            }

            Toasts.Show(result.Message ?? "Gelöscht");
            Navigation.NavigateTo(result.Route ?? "/");
        }
        finally
        {
            saving = false;
        }
    });

    private async Task OnFilePicked(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
        {
            return;
        }

        readCancel?.Cancel();
        readCancel = new CancellationTokenSource();
        var token = readCancel.Token;

        reading = true;
        readStep = 0;
        analysis = null;

        try
        {
            // Die Kette läuft mit der Anfrage mit. Sie ist keine Fortschrittsanzeige der Analyse,
            // sondern sagt, welcher Schritt gerade dran wäre — mehr weiß der Client nicht.
            var call = Api.AnalysePolicyAsync(Parsed, file.OpenReadStream(25L * 1024 * 1024, token), file.Name, token);

            while (!call.IsCompleted && readStep < 3)
            {
                await Task.Delay(220, token);
                readStep++;
                StateHasChanged();
            }

            analysis = await call;
            readStep = 4;
        }
        catch (OperationCanceledException)
        {
            analysis = null;
        }
        catch (ApiException ex)
        {
            Toasts.Show(ex.Message);
            analysis = null;
        }
        finally
        {
            reading = false;
        }
    }

    private void CancelRead()
    {
        readCancel?.Cancel();
        reading = false;
        analysis = null;
    }

    private void DiscardRead()
    {
        analysis = null;
        readStep = 0;
    }

    /// <summary>
    /// Übernimmt die gelesenen Werte ins Formular — und erst hier wird die Übernahme auch
    /// vermerkt. Jedes Feld bleibt danach änderbar.
    /// </summary>
    private Task ApplyRead() => RunAsync(async () =>
    {
        if (analysis is not { } read || read.Fields.Count == 0)
        {
            return;
        }

        foreach (var field in read.Fields)
        {
            values[field.Key] = field.Value;
        }

        Toasts.Show($"{read.Fields.Count} Werte übernommen · bitte prüfen");
        analysis = null;
    });

    private Task SubmitAsync() => RunAsync(async () =>
    {
        saving = true;
        try
        {
            var result = Id is { } id
                ? await Api.UpdateObjectAsync(Parsed, id, values)
                : await Api.CreateObjectAsync(Parsed, values);

            if (!result.Ok)
            {
                problem = result.Message;
                problemKey = result.FieldKey;
                return;
            }

            Toasts.Show(Id is null
                ? $"{form!.Title.Replace(" anlegen", string.Empty)} angelegt"
                : "Änderungen gespeichert");

            Navigation.NavigateTo(result.Route ?? "/");
        }
        finally
        {
            saving = false;
        }
    });
}
