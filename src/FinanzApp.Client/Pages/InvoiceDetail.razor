@page "/rechnungen/{Id:int}"
@attribute [Authorize]
@inherits AppPage

<PageTitle>Rechnung — FinanzApp</PageTitle>

<AsyncView Loading="Loading" Error="@Error" Stale="HasLoadedOnce" Retry="ReloadAsync">
    @if (data is { } invoice)
    {
        <section class="hero">
            <span class="label-muted">@(invoice.ContractName ?? "Rechnung")</span>
            <span class="hero-value medium num">@State.Euro(invoice.Amount)</span>
            <span class="loan-sub num">
                @invoice.Subject
                @(invoice.Number is { Length: > 0 } number ? " · Nr. " + number : string.Empty)
            </span>

            @*
                Bearbeiten gehört hierher wie bei Vertrag, Fahrzeug und Immobilie. Die Maske
                gab es längst — nur führte von dieser Seite kein Weg dorthin, und wer eine
                abgetippte Rechnungsnummer berichtigen wollte, musste die Adresse kennen.
            *@
            <EditLink Type="invoice" Id="invoice.Id" />
        </section>

        @if (invoice.Status == InvoiceStatus.Open)
        {
            <div class="notice">
                <span class="notice-title">@DueLabel(invoice)</span>
                <span class="notice-text num">@GermanFormat.Date(invoice.DueOn)</span>
            </div>
        }
        else
        {
            @*
                Nicht nur „bezahlt“. Eine zugeordnete Buchung belegt die Zahlung, eine bestätigte
                Barzahlung behauptet sie — der Unterschied gehört hierher und nicht ins Gedächtnis
                dessen, der geklickt hat. Wer später prüft, warum eine Zahlung nicht im Konto
                auftaucht, findet die Antwort sonst nirgends.
            *@
            <div class="detail-block">
                <span class="detail-label">Status</span>
                <span class="detail-value">@SettlementLabel(invoice)</span>
            </div>

            @if (invoice.PaymentNote is { Length: > 0 } notiz)
            {
                <div class="detail-block">
                    <span class="detail-label">Zur Zahlung</span>
                    <span class="detail-value">@notiz</span>
                </div>
            }
        }

        <div class="detail-block">
            <span class="detail-label">Gehört zu</span>
            <span class="detail-value">
                @(invoice.Payee is { Length: > 0 } empfaenger ? empfaenger : invoice.ContractName ?? "kein Vertrag")
                @(invoice.PropertyName is { Length: > 0 } property ? " · " + property : string.Empty)
            </span>
        </div>

        <div class="detail-block">
            <span class="detail-label">Rechnungsdatum · Fälligkeit</span>
            <span class="detail-value num">
                @GermanFormat.Date(invoice.IssuedOn) · @GermanFormat.Date(invoice.DueOn)
            </span>
        </div>

        @if (invoice.Documents.Count > 0)
        {
            <div class="list-head">
                <span class="label-strong">Dokument</span>
                <span class="list-count num">@invoice.Documents.Count</span>
            </div>

            @foreach (var document in invoice.Documents)
            {
                <button type="button" class="tap doc-row @(document.FileExists ? null : "missing")"
                        @onclick="@(() => Navigation.NavigateTo($"/dokumente/{document.Id}"))">
                    <span class="stack">
                        <span class="doc-name">@document.FileName</span>
                        <span class="doc-meta">@(document.FileExists ? document.TypeName : "Datei nicht gefunden")</span>
                    </span>
                </button>
            }
        }

        <div class="list-head">
            <span class="label-strong">Zahlung</span>
        </div>

        @if (invoice.TransactionId is not null)
        {
            <div class="detail-block">
                <span class="detail-label">Zugeordnete Buchung</span>
                <span class="detail-value">vorhanden</span>
            </div>
        }
        else
        {
            <div class="empty-area">
                <span class="empty-area-text">Noch keine Buchung zugeordnet.</span>
            </div>
        }

        <AuthorizeView Roles="Owner,Member">
            @if (invoice.Status == InvoiceStatus.Open)
            {
                @if (candidates is { Count: > 0 })
                {
                    @* Dieselbe Mechanik wie beim PKV-Vorgang: vorschlagen, nicht entscheiden. *@
                    @foreach (var candidate in candidates)
                    {
                        @* Eine vergebene Buchung bleibt stehen und lässt sich nicht wählen. Sie
                           verschwinden zu lassen hieße, jemanden nach einer Abbuchung suchen zu
                           lassen, die er im Konto mit eigenen Augen gesehen hat. *@
                        var vergeben = candidate.AssignedTo is { Length: > 0 };

                        <button type="button" class="tap candidate-row @(candidate.IsBestMatch ? "best" : null)"
                                disabled="@(busy || vergeben)" @onclick="() => PayAsync(candidate.TransactionId)">
                            <span class="stack">
                                <span class="work-title num">
                                    @State.Euro(-candidate.Amount) · @GermanFormat.DateShort(candidate.BookingDate)
                                </span>
                                <span class="work-due">@candidate.AccountName · @candidate.Payee · @candidate.Reason</span>

                                @* Der Verwendungszweck. Bei zwei gleich hohen Buchungen desselben
                                   Absenders am selben Tag ist er das Einzige, was sie
                                   unterscheidet. *@
                                @if (candidate.Purpose is { Length: > 0 } zweck)
                                {
                                    <span class="candidate-purpose">@zweck</span>
                                }

                                @if (candidate.AssignedTo is { Length: > 0 } belegt)
                                {
                                    <span class="candidate-taken">Schon zugeordnet: @belegt</span>
                                }
                            </span>
                            <span class="candidate-amount num">@candidate.Score</span>
                        </button>
                    }
                }

                @*
                    Der zweite Weg, und er braucht ein Wort dazu. Bar bezahlt, verrechnet, von
                    einem Konto, das die Anwendung nicht führt — ohne diese Angabe bliebe von der
                    Zahlung nur ein Status, und in einem halben Jahr wüsste niemand mehr, warum
                    zu dieser Rechnung keine Abbuchung zu finden ist.
                *@
                <div class="detail-block">
                    <span class="detail-label">Ohne Buchung beglichen?</span>
                    <input class="input" value="@paymentNote" aria-label="Wie beglichen"
                           placeholder="z. B. bar bezahlt"
                           @oninput="e => paymentNote = e.Value?.ToString() ?? string.Empty" />
                </div>

                <div class="actions">
                    <button type="button" class="btn btn-primary" disabled="@busy" @onclick="LoadCandidatesAsync">
                        Buchung zuordnen
                    </button>
                    <button type="button" class="btn btn-secondary" disabled="@busy"
                            @onclick="@(() => PayAsync(null))">Als bezahlt markieren</button>
                    <button type="button" class="btn btn-secondary" disabled="@busy"
                            @onclick="StartTransferAsync">Überweisen</button>
                </div>
            }

            @*
                Die Überweisung. Sie steht bewusst <b>unter</b> den übrigen Schaltflächen und
                öffnet eine eigene Maske: Hier geht Geld hinaus, und das soll nicht derselbe
                Handgriff sein wie „als bezahlt markieren“.
            *@
            @if (draft is { } entwurf)
            {
                <div class="blueprint report-payees">
                    <i class="corner tl" aria-hidden="true"></i>
                    <i class="corner br" aria-hidden="true"></i>

                    @if (entwurf.AlreadyOrdered)
                    {
                        <div class="create-problem">
                            <span>
                                Für diesen Posten ist schon ein Auftrag erteilt worden. Ein zweiter
                                ginge zusätzlich hinaus — sieh erst im Kontoauszug nach.
                            </span>
                        </div>
                    }

                    <div class="field">
                        <label for="ue-konto">Von Konto</label>
                        <select id="ue-konto" class="input" value="@fresh.AccountId"
                                @onchange="e => fresh.AccountId = e.Value?.ToString() ?? string.Empty">
                            <option value="">— wählen —</option>
                            @foreach (var konto in accounts ?? [])
                            {
                                <option value="@konto.Id">@konto.Name</option>
                            }
                        </select>
                    </div>

                    <div class="field">
                        <label for="ue-name">Empfänger</label>
                        <input id="ue-name" class="input" value="@fresh.ReceiverName"
                               @oninput="e => fresh.ReceiverName = e.Value?.ToString() ?? string.Empty" />
                    </div>

                    <div class="field">
                        <label for="ue-iban">IBAN</label>
                        <input id="ue-iban" class="input" value="@fresh.Iban"
                               placeholder="DE.. .... .... .... .... .."
                               @oninput="e => fresh.Iban = e.Value?.ToString() ?? string.Empty" />
                        <span class="create-help">
                            Die Prüfziffer wird geprüft — sie fängt zwei vertauschte Ziffern ab. Ob
                            das Konto dem Empfänger gehört, weiß sie nicht.
                        </span>
                    </div>

                    @*
                        Vorschläge zum Antippen, nicht vorbelegt. Eine falsche Vorbelegung, die
                        niemand mehr ansieht, kostet das Geld; ein falscher Vorschlag einen Blick.
                    *@
                    @foreach (var vorschlag in entwurf.IbanSuggestions)
                    {
                        <button type="button" class="tap import-row plain"
                                @onclick="() => TakeIban(vorschlag)">
                            <span class="stack">
                                <span class="work-title num">@Gruppiert(vorschlag.Iban)</span>
                                <span class="work-due">
                                    @(vorschlag.FromHistory ? "Schon überwiesen" : "Vom Beleg")
                                    · @vorschlag.Detail
                                </span>
                            </span>
                        </button>
                    }

                    @if (entwurf.IbanSuggestions.Count == 0)
                    {
                        <span class="create-help">
                            Kein Vorschlag: An diesen Empfänger wurde noch nie überwiesen, und im
                            Beleg steht keine IBAN mit aufgehender Prüfziffer. Dann hilft nur
                            abtippen — und zweimal hinsehen.
                        </span>
                    }

                    <div class="field">
                        <label for="ue-betrag">Betrag</label>
                        <input id="ue-betrag" class="input" inputmode="decimal" value="@fresh.Amount"
                               @oninput="e => fresh.Amount = e.Value?.ToString() ?? string.Empty" />
                    </div>

                    <div class="field">
                        <label for="ue-zweck">Verwendungszweck</label>
                        <input id="ue-zweck" class="input" value="@fresh.Purpose"
                               @oninput="e => fresh.Purpose = e.Value?.ToString() ?? string.Empty" />
                    </div>

                    <div class="field">
                        <label for="ue-pin">Bank-PIN</label>
                        <input id="ue-pin" class="input" type="password" autocomplete="off"
                               value="@fresh.Pin"
                               @oninput="e => fresh.Pin = e.Value?.ToString() ?? string.Empty" />
                        <span class="create-help">
                            Sie geht an die Bank und wird nirgends gespeichert. Freigegeben wird
                            danach in der App deiner Bank — hier wird keine TAN eingetippt.
                        </span>
                    </div>

                    @if (problem is { Length: > 0 } fehler)
                    {
                        <div class="create-problem"><span>@fehler</span></div>
                    }

                    <div class="actions">
                        <button type="button" class="btn btn-danger" disabled="@busy"
                                @onclick="SubmitTransferAsync">Auftrag erteilen</button>
                        <button type="button" class="btn btn-secondary"
                                @onclick="CancelTransfer">Abbrechen</button>
                    </div>
                </div>
            }
        </AuthorizeView>

        <span class="entry-summary" style="display:block">
            Kette: Dokument → Rechnung → Vertrag → Immobilie → Buchung.
        </span>

        <div class="spacer"></div>
    }
</AsyncView>

@code {
    [Parameter] public int Id { get; set; }

    private InvoiceDetailDto? data;
    private IReadOnlyList<PaymentCandidateDto>? candidates;
    private bool busy;

    /// <summary>Der Entwurf der Überweisung, solange die Maske offen ist.</summary>
    private TransferDraftDto? draft;
    private IReadOnlyList<AccountDto>? accounts;
    private string? problem;

    private readonly Formular fresh = new();

    /// <summary>Was in der Maske steht — alles als Text, bis es geprüft ist.</summary>
    private sealed class Formular
    {
        public string AccountId { get; set; } = string.Empty;
        public string ReceiverName { get; set; } = string.Empty;
        public string Iban { get; set; } = string.Empty;
        public string Amount { get; set; } = string.Empty;
        public string Purpose { get; set; } = string.Empty;

        /// <summary>Nur für diesen einen Auftrag. Sie verlässt die Maske nicht nach oben.</summary>
        public string Pin { get; set; } = string.Empty;
    }

    private Task StartTransferAsync() => RunAsync(async () =>
    {
        busy = true;

        try
        {
            accounts ??= await Api.GetAccountsAsync();
            var entwurf = await Api.GetTransferDraftAsync(Id);

            fresh.AccountId = entwurf.AccountId?.ToString() ?? string.Empty;
            fresh.ReceiverName = entwurf.ReceiverName;
            fresh.Amount = GermanFormat.Decimal2(entwurf.Amount);
            fresh.Purpose = entwurf.Purpose;
            fresh.Iban = string.Empty;
            fresh.Pin = string.Empty;

            problem = null;
            draft = entwurf;
        }
        finally
        {
            busy = false;
        }
    });

    /// <summary>Ein Vorschlag wird übernommen — durch Antippen, nicht von selbst.</summary>
    private void TakeIban(IbanSuggestionDto vorschlag)
    {
        fresh.Iban = vorschlag.Iban;
        problem = null;
    }

    /// <summary>
    /// Die IBAN in Vierergruppen.
    /// </summary>
    /// <remarks>
    /// So steht sie auf jedem Papier, und so prüft man sie nach: zweiundzwanzig Zeichen am
    /// Stück liest niemand gegen eine Rechnung.
    /// </remarks>
    private static string Gruppiert(string iban)
        => string.Join(" ", Enumerable
            .Range(0, (iban.Length + 3) / 4)
            .Select(i => iban.Substring(i * 4, Math.Min(4, iban.Length - (i * 4)))));

    private void CancelTransfer()
    {
        draft = null;
        problem = null;
        fresh.Pin = string.Empty;
    }

    /// <summary>
    /// Erteilt den Auftrag.
    /// </summary>
    /// <remarks>
    /// Die PIN wird nach dem Versuch geleert — ob er gelang oder nicht. Sie soll nicht in einer
    /// offenen Maske stehen bleiben, während jemand anderes auf den Bildschirm sieht.
    /// </remarks>
    private Task SubmitTransferAsync() => RunAsync(async () =>
    {
        problem = null;

        if (!int.TryParse(fresh.AccountId, out var konto))
        {
            problem = "Wähle das Konto, von dem überwiesen wird.";
            return;
        }

        if (!decimal.TryParse(fresh.Amount, System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.GetCultureInfo("de-DE"), out var betrag)
            && !decimal.TryParse(fresh.Amount, System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.InvariantCulture, out betrag))
        {
            problem = "Der Betrag ist keine Zahl.";
            return;
        }

        busy = true;

        try
        {
            var auftrag = await Api.SubmitTransferAsync(new TransferRequest
            {
                AccountId = konto,
                Pin = fresh.Pin,
                ReceiverName = fresh.ReceiverName,
                ReceiverIban = fresh.Iban,
                Amount = betrag,
                Purpose = fresh.Purpose,
                InvoiceId = Id,
            });

            draft = null;

            Toasts.Show(
                auftrag.State == TransferState.Accepted
                    ? "Die Bank hat den Auftrag angenommen."
                    : "Die Bank hat den Auftrag abgelehnt: " + auftrag.BankMessage,
                auftrag.State == TransferState.Accepted ? ToastKind.Saved : ToastKind.Problem);
        }
        finally
        {
            fresh.Pin = string.Empty;
            busy = false;
        }
    });

    /// <summary>Was zur Zahlung zu sagen ist, wenn keine Buchung dahintersteht.</summary>
    private string paymentNote = string.Empty;

    protected override async Task LoadAsync()
    {
        data = await Api.GetInvoiceAsync(Id);
        candidates = null;
    }

    private static string DueLabel(InvoiceDetailDto invoice) => invoice.DaysUntilDue switch
    {
        < 0 => $"Überfällig seit {-invoice.DaysUntilDue} Tagen",
        0 => "Heute fällig",
        1 => "Fällig morgen",
        var days => $"Fällig in {days} Tagen",
    };

    /// <summary>
    /// Wie der Posten erledigt wurde — und woran man das erkennt.
    /// </summary>
    /// <remarks>
    /// „Bezahlt“ allein wäre zu wenig. Eine Buchung ist ein Beleg; eine bestätigte Barzahlung
    /// ist eine Aussage. Nur eines davon lässt sich nachprüfen, und wer in einem halben Jahr
    /// fragt, warum zu dieser Rechnung keine Abbuchung im Konto steht, bekommt hier die Antwort.
    /// </remarks>
    private static string SettlementLabel(InvoiceDetailDto invoice)
    {
        if (invoice.Status == InvoiceStatus.Cancelled)
        {
            return "storniert";
        }

        var wann = invoice.PaidOn is { } tag ? " am " + GermanFormat.Date(tag) : string.Empty;

        return invoice.IsProven
            ? $"bezahlt{wann} · durch Buchung belegt"
            : $"bezahlt{wann} · selbst bestätigt, keine Buchung zugeordnet";
    }

    private async Task LoadCandidatesAsync()
    {
        busy = true;
        try
        {
            candidates = await Api.GetInvoicePaymentCandidatesAsync(Id);
            if (candidates.Count == 0)
            {
                Toasts.Show("Keine passende Buchung gefunden");
            }
        }
        catch (ApiException ex)
        {
            Toasts.Show(ex.Message, ToastKind.Problem);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task PayAsync(int? transactionId)
    {
        busy = true;
        try
        {
            // Die Notiz nur beim Weg ohne Buchung. Bei einer zugeordneten Buchung
            // stünde sie neben einem Beleg und sagte nichts dazu.
            data = await Api.PayInvoiceAsync(
                Id, transactionId, transactionId is null ? paymentNote : null);
            candidates = null;
            Toasts.Show(transactionId is null ? "Als bezahlt markiert" : "Buchung zugeordnet", ToastKind.Saved);
        }
        catch (ApiException ex)
        {
            Toasts.Show(ex.Message, ToastKind.Problem);
        }
        finally
        {
            busy = false;
        }
    }
}
