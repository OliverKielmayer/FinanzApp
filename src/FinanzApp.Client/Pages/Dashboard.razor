@page "/"
@attribute [Authorize]
@inherits AppPage

<PageTitle>Vermögen — FinanzApp</PageTitle>

<AsyncView Loading="Loading" Error="@Error" Retry="ReloadAsync">
    @if (data is { } dashboard)
    {
        @*
            Neu über dem bisherigen Inhalt: was diesen Monat übrig bleibt, und was offen ist.
            Das Nettovermögen rückt eine Sektion nach unten, sonst bleibt alles wie es war.
        *@
        @if (liquidity is { } cash)
        {
            <button type="button" class="tap hero" @onclick="@(() => Navigation.NavigateTo("/liquiditaet"))">
                <span class="label-muted">Bleibt übrig · @GermanFormat.MonthName(cash.Month)</span>
                <span class="hero-value num">@State.Euro(cash.Remaining, withPlusSign: true)</span>
                <span class="hero-deltas">
                    <span class="hero-delta-secondary num">
                        Einnahmen @State.Euro0(cash.Income) · Ausgaben @State.Euro0(cash.Expenses)
                    </span>
                    <span class="hero-delta-primary num">
                        Sparquote @GermanFormat.Percent(cash.SavingsRatePercent)
                    </span>
                </span>
            </button>
        }

        @if (work is { OpenCount: > 0 } summary)
        {
            <div class="triage-wrap">
                <button type="button" class="triage" @onclick="@(() => Navigation.NavigateTo("/vorgaenge"))">
                    <span class="stack">
                        <span class="triage-title">
                            @summary.OpenCount @(summary.OpenCount == 1 ? "offener Vorgang" : "offene Vorgänge")
                        </span>
                        <span class="triage-sub num">@DescribeWork(summary)</span>
                    </span>
                    <span class="triage-arrow" aria-hidden="true">→</span>
                </button>
            </div>
        }

        <section class="section">
            <span class="label-muted">Nettovermögen</span>
            <span class="hero-value num">@State.Euro(dashboard.NetWorth.Net)</span>
            <div class="hero-deltas">
                <span class="hero-delta-primary num">
                    @State.Euro(dashboard.NetWorth.DeltaPreviousMonth, withPlusSign: true) zum Vormonat
                </span>
                <span class="hero-delta-secondary num">
                    @GermanFormat.Percent(dashboard.NetWorth.DeltaYearPercent, 1, withPlusSign: true) im Jahr
                </span>
            </div>
        </section>

        @* Chart und Bilanz stehen ab Tablet nebeneinander (Handoff v4, Abschnitt 2).
           Dafür müssen sie Geschwister sein — die Kacheln rücken darunter. *@
        <div class="chart-balance">
            <section class="section">
                <div class="section-head">
                    <span class="label-strong">Vermögensentwicklung</span>
                    <span class="meta">@MonthSpanLabel(dashboard.History)</span>
                </div>
                <Sparkline Values="dashboard.History" Height="96" Top="10" Bottom="88" ShowMidline="true"
                           Label="Vermögensentwicklung der letzten Monate" />
                <div class="chart-axis">
                    @foreach (var label in AxisLabels(dashboard.History))
                    {
                        <span>@label</span>
                    }
                </div>
            </section>

            <section class="balance">
                <div class="balance-row">
                    <span class="balance-label">Bruttovermögen</span>
                    <span class="balance-value num">@State.Euro(dashboard.NetWorth.Gross)</span>
                </div>

                <button type="button" class="tap balance-row" @onclick="OpenLoan">
                    <span class="stack">
                        <span class="balance-label plain">@dashboard.Liability.Label</span>
                        <span class="meta">@dashboard.Liability.Subtitle</span>
                    </span>
                    <span class="balance-value debt num">@State.Euro(-dashboard.Liability.Amount)</span>
                </button>

                <div class="balance-row total">
                    <span class="balance-label">Nettovermögen</span>
                    <span class="balance-value num">@State.Euro(dashboard.NetWorth.Net)</span>
                </div>
            </section>
        </div>

        <div class="asset-grid">
            @foreach (var asset in dashboard.Assets)
            {
                <button type="button" class="tap asset-tile" @onclick="() => Navigation.NavigateTo(asset.Route)">
                    <span class="asset-tile-label">@asset.Label</span>
                    <span class="asset-tile-value num">@State.Euro(asset.Value)</span>
                    <span class="meta">@asset.Subtitle</span>
                    <ProgressBar Ratio="asset.ShareOfGross" Height="4"
                                 Label="@($"Anteil {asset.Label} am Bruttovermögen")" />
                </button>
            }
        </div>

        <section class="kpi">
            <div class="kpi-cell">
                <span class="label-muted">Einnahmen</span>
                <span class="kpi-value num">@State.Euro0(dashboard.Month.Income)</span>
            </div>
            <div class="kpi-cell">
                <span class="label-muted">Ausgaben</span>
                <span class="kpi-value num">@State.Euro0(dashboard.Month.Expenses)</span>
            </div>
            <div class="kpi-cell">
                <span class="label-muted">Sparquote</span>
                <span class="kpi-value accent num">@GermanFormat.Percent(dashboard.Month.SavingsRatePercent)</span>
            </div>
        </section>

        <section class="section">
            <div class="section-head">
                <span class="label-strong">Budgets @GermanFormat.MonthName(dashboard.Month.Month)</span>
                <button type="button" class="section-link" @onclick="@(() => Navigation.NavigateTo("/budgets"))">
                    Alle ansehen
                </button>
            </div>

            @foreach (var budget in dashboard.TopBudgets)
            {
                <div class="budget-mini">
                    <div class="budget-mini-line">
                        <span>@budget.Name</span>
                        <span class="num @(budget.IsOverspent ? "budget-row-figures over" : null)">
                            @State.Euro0(budget.Spent) / @State.Euro0(budget.Planned)
                        </span>
                    </div>
                    <ProgressBar Ratio="budget.Ratio" Height="6"
                                 Variant="@(budget.IsOverspent ? "over" : "neutral")"
                                 Label="@($"Auslastung Budget {budget.Name}")" />
                </div>
            }
        </section>

        <div class="actions">
            <button type="button" class="btn btn-primary"
                    @onclick="@(() => Navigation.NavigateTo("/erfassen"))">Buchung erfassen</button>
            <button type="button" class="btn btn-secondary"
                    @onclick="@(() => Navigation.NavigateTo("/import"))">Import</button>
        </div>

        <div class="spacer"></div>
    }
</AsyncView>

@code {
    private DashboardDto? data;
    private LiquidityDto? liquidity;
    private OpenWorkSummaryDto? work;

    protected override async Task LoadAsync()
    {
        data = await Api.GetDashboardAsync();
        liquidity = await Api.GetLiquidityAsync();
        work = await Api.GetWorkSummaryAsync();
    }

    /// <summary>Die Untertitelzeile des Banners nennt, was die Vorgänge ausmacht.</summary>
    private string DescribeWork(OpenWorkSummaryDto summary)
    {
        var parts = new List<string>();

        if (summary.ExpectedReimbursement > 0)
        {
            parts.Add("Erstattung " + State.Euro0(summary.ExpectedReimbursement));
        }

        if (summary.DueInvoiceCount > 0)
        {
            parts.Add(summary.DueInvoiceCount == 1
                ? "1 Rechnung fällig"
                : $"{summary.DueInvoiceCount} Rechnungen fällig");
        }

        if (summary.OverdueCount > 0)
        {
            parts.Add(summary.OverdueCount == 1 ? "1 überfällig" : $"{summary.OverdueCount} überfällig");
        }

        return parts.Count == 0 ? "Jetzt ansehen" : string.Join(" · ", parts);
    }

    private void OpenLoan()
    {
        var loanId = data?.Liability.LoanId ?? 0;
        Navigation.NavigateTo(loanId > 0 ? $"/darlehen?id={loanId}" : "/darlehen");
    }

    /// <summary>„12 Monate“ — die Länge der Reihe, nicht fest verdrahtet.</summary>
    private static string MonthSpanLabel(IReadOnlyList<TimeSeriesPointDto> history)
        => history.Count switch
        {
            0 or 1 => "laufender Monat",
            _ => history.Count + " Monate",
        };

    /// <summary>Erster, mittlerer und letzter Monat der Reihe.</summary>
    private static IEnumerable<string> AxisLabels(IReadOnlyList<TimeSeriesPointDto> history)
    {
        if (history.Count == 0)
        {
            yield break;
        }

        yield return GermanFormat.MonthAxis(history[0].Month);

        if (history.Count > 2)
        {
            yield return GermanFormat.MonthAxis(history[(history.Count - 1) / 2].Month);
        }

        if (history.Count > 1)
        {
            yield return GermanFormat.MonthAxis(history[^1].Month);
        }
    }
}
