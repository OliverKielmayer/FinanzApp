@inherits AppPage

@*
    Die Dokumentseite als Baustein. Auf dem Telefon füllt sie den Screen, ab Tablet steht sie
    als Vorschauspalte neben der Liste — dieselbe Komponente, nur ein anderer Platz.
*@
<AsyncView Loading="Loading" Error="@Error" Stale="HasLoadedOnce" Retry="ReloadAsync">
    @if (data is { } document)
    {
        <section class="hero">
            <span class="label-muted">@(document.TypeName ?? "Dokument")</span>
            <span class="sheet-payee">@document.Title</span>
            <span class="meta">@document.FileName</span>
        </section>

        @if (document.FileExists)
        {
            <div class="doc-preview">Vorschau — die Datei öffnet in einem neuen Fenster.</div>
            <div class="doc-actions">
                <a class="btn btn-primary" href="@($"/api/documents/{document.Id}/file")"
                   target="_blank" rel="noopener">Datei öffnen</a>
            </div>
        }
        else
        {
            @*
                Datei fehlt: der Eintrag bleibt vollständig sichtbar und verknüpft. Ausblenden
                wäre der schlechteste Ausweg — dann wüsste niemand mehr, dass es ihn gab.
            *@
            <div class="notice">
                <span class="notice-title">Datei nicht gefunden</span>
                <span class="notice-text num">@document.RelativePath</span>
            </div>

            <AuthorizeView Roles="Owner,Member">
                <div class="doc-actions">
                    @if (fixing)
                    {
                        <div class="field">
                            <label for="doc-path">Neuer Pfad im Dokumentordner</label>
                            <input id="doc-path" class="input" placeholder="Bereich/Ordner/Datei.pdf"
                                   value="@newPath" @oninput="e => newPath = e.Value?.ToString() ?? string.Empty" />
                        </div>
                        <button type="button" class="btn btn-primary" disabled="@busy"
                                @onclick="SavePathAsync">Pfad speichern</button>
                        <button type="button" class="btn btn-secondary"
                                @onclick="@(() => fixing = false)">Abbrechen</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary" @onclick="StartFix">Pfad korrigieren</button>
                        <button type="button" class="btn btn-secondary"
                                @onclick="@(() => Toasts.Show("Ordnersuche folgt"))">Im Ordner suchen</button>
                        <button type="button" class="btn btn-secondary"
                                @onclick="@(() => Toasts.Show("Eintrag bleibt bestehen"))">
                            Eintrag behalten, Datei später
                        </button>
                    }
                </div>
            </AuthorizeView>
        }

        <div class="detail-block">
            <span class="detail-label">Pfad</span>
            <span class="detail-value num">@document.RelativePath</span>
        </div>

        <div class="detail-block">
            <span class="detail-label">Typ · Dokumentdatum · Gültigkeit</span>
            <span class="detail-value">@DescribeMeta(document)</span>
        </div>

        @if (document.Tags.Count > 0)
        {
            <div class="picker">
                <span class="label-strong">Schlagworte</span>
                <div class="chipcloud">
                    @foreach (var tag in document.Tags)
                    {
                        <span class="chip">@tag</span>
                    }
                </div>
            </div>
        }

        <div class="list-head">
            <span class="label-strong">Verknüpft mit</span>
            <span class="list-count num">@document.Links.Count</span>
        </div>

        @if (document.Links.Count == 0)
        {
            <div class="empty-area">
                <span class="empty-area-text">
                    Noch mit nichts verknüpft. Verknüpft wird sonst am Objekt — die Versicherung
                    hängt ihr Dokument an.
                </span>
            </div>
        }

        @foreach (var link in document.Links)
        {
            <button type="button" class="tap more-row" @onclick="() => OpenLink(link)">
                <span class="stack">
                    <span class="more-label">@link.Label</span>
                    <span class="meta">@link.TargetLabel</span>
                </span>
            </button>
        }

        @* Gelöscht wird nur der Eintrag — die Datei bleibt liegen. Das steht auch so da,
           damit niemand einen Dateiverlust befürchtet, den es nicht gibt. *@
        <AuthorizeView Roles="Owner,Member">
            <div class="delete-block">
                <span class="label-strong">Dokument löschen</span>
                <span class="delete-consequence">
                    Nur der Eintrag verschwindet — die Datei bleibt im Dokumentordner liegen.
                    @(document.Links.Count == 0
                        ? "Es hängt keine Verknüpfung daran."
                        : $"{document.Links.Count} Verknüpfung{(document.Links.Count == 1 ? "" : "en")} entfällt.")
                </span>

                @if (confirmingDelete)
                {
                    <div class="doc-actions">
                        <button type="button" class="btn btn-primary delete-confirm" disabled="@busy"
                                @onclick="DeleteAsync">Löschen bestätigen</button>
                        <button type="button" class="btn btn-secondary" disabled="@busy"
                                @onclick="@(() => confirmingDelete = false)">Behalten</button>
                    </div>
                }
                else
                {
                    <div class="doc-actions">
                        <button type="button" class="btn btn-secondary" disabled="@busy"
                                @onclick="@(() => confirmingDelete = true)">Dokument löschen</button>
                    </div>
                }
            </div>
        </AuthorizeView>

        <div class="spacer"></div>
    }
</AsyncView>

@code {
    [Parameter] public int Id { get; set; }

    /// <summary>Wird nach dem Löschen ausgelöst, damit die Liste nachrücken kann.</summary>
    [Parameter] public EventCallback<int> OnDeleted { get; set; }

    private DocumentDetailDto? data;
    private bool fixing;
    private bool confirmingDelete;
    private bool busy;
    private string newPath = string.Empty;

    private int loadedId;

    protected override async Task LoadAsync()
    {
        loadedId = Id;
        fixing = false;
        confirmingDelete = false;
        data = await Api.GetDocumentAsync(Id);
    }

    /// <summary>
    /// Ab Tablet bleibt die Komponente stehen und bekommt nur eine andere Id — dann muss sie
    /// selbst nachladen, sonst zeigte die Vorschau weiter das vorige Dokument.
    /// </summary>
    /// <remarks>
    /// Der Haken der Basis, nicht <c>OnParametersSetAsync</c>: dort liegt das erste Laden, und
    /// eine Überschreibung ohne Basisaufruf ließ die Spalte auf „Wird geladen …“ stehen.
    /// </remarks>
    protected override async Task OnParametersChangedAsync()
    {
        if (data is not null && loadedId != Id)
        {
            await ReloadAsync();
        }
    }

    private async Task DeleteAsync()
    {
        busy = true;
        try
        {
            await Api.DeleteDocumentAsync(Id);
            Toasts.Show("Dokumenteintrag gelöscht · Datei bleibt liegen");
            await OnDeleted.InvokeAsync(Id);
        }
        catch (ApiException ex)
        {
            Toasts.Show(ex.Message);
        }
        finally
        {
            busy = false;
            confirmingDelete = false;
        }
    }

    private void StartFix()
    {
        newPath = data?.RelativePath ?? string.Empty;
        fixing = true;
    }

    private async Task SavePathAsync()
    {
        busy = true;
        try
        {
            data = await Api.FixDocumentPathAsync(Id, newPath);
            fixing = false;
            Toasts.Show("Pfad gespeichert");
        }
        catch (ApiException ex)
        {
            Toasts.Show(ex.Message);
        }
        finally
        {
            busy = false;
        }
    }

    private static string DescribeMeta(DocumentDetailDto document)
    {
        var parts = new List<string>();
        if (document.TypeName is { Length: > 0 } type)
        {
            parts.Add(type);
        }

        if (document.DocumentDate is { } date)
        {
            parts.Add(GermanFormat.Date(date));
        }

        if (document.ValidFrom is { } from)
        {
            parts.Add("ab " + GermanFormat.Date(from));
        }

        if (document.ValidUntil is { } until)
        {
            parts.Add("bis " + GermanFormat.Date(until));
        }

        return parts.Count == 0 ? "—" : string.Join(" · ", parts);
    }

    private void OpenLink(DocumentLinkDto link)
    {
        var route = link.TargetType switch
        {
            LinkTargetType.Policy => $"/police/{link.TargetId}",
            LinkTargetType.Contract => $"/vertraege/{link.TargetId}",
            LinkTargetType.Property => $"/wohnen/{link.TargetId}",
            LinkTargetType.Invoice => $"/rechnungen/{link.TargetId}",
            LinkTargetType.MedicalBill => $"/gesundheit/{link.TargetId}",
            LinkTargetType.Loan => $"/darlehen?id={link.TargetId}",
            LinkTargetType.Transaction or LinkTargetType.Account => "/konten",
            _ => null,
        };

        if (route is null)
        {
            Toasts.Show("Zu diesem Objekt gibt es keinen eigenen Screen.");
            return;
        }

        Navigation.NavigateTo(route);
    }
}
