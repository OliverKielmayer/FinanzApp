@inherits AppPage

@*
    Die Dokumentseite als Baustein. Auf dem Telefon füllt sie den Screen, ab Tablet steht sie
    als Vorschauspalte neben der Liste — dieselbe Komponente, nur ein anderer Platz.
*@
<AsyncView Loading="Loading" Error="@Error" Stale="HasLoadedOnce" Retry="ReloadAsync">
    @if (data is { } document)
    {
        <section class="hero">
            <span class="label-muted">@(document.TypeName ?? "Dokument")</span>
            <span class="sheet-payee">@document.Title</span>
            <span class="meta">@document.FileName</span>
        </section>

        @if (document.FileExists)
        {
            @*
                Die Datei selbst, nicht ein Satz über sie. Ein PDF steht im Rahmen, ein Bild als
                Bild; was der Browser nicht darstellt, sagt das statt eine leere Fläche zu zeigen.
            *@
            @switch (DocumentPreview.For(document.Extension, document.FileName))
            {
                case DocumentPreviewKind.Frame:
                    <iframe class="doc-frame" src="@DocumentPreview.FileUrl(document.Id)"
                            title="@($"Vorschau von {document.FileName}")"></iframe>
                    break;

                case DocumentPreviewKind.Image:
                    <img class="doc-image" src="@DocumentPreview.FileUrl(document.Id)"
                         alt="@($"Vorschau von {document.FileName}")" />
                    break;

                default:
                    <div class="doc-preview">
                        Diese Dateiart lässt sich hier nicht anzeigen@(document.Extension is { Length: > 0 } endung
                            ? " (" + endung + ")"
                            : null). Öffnen und Herunterladen gehen trotzdem.
                    </div>
                    break;
            }

            <div class="doc-actions">
                <a class="btn btn-primary" href="@DocumentPreview.FileUrl(document.Id)"
                   target="_blank" rel="noopener">In neuem Fenster öffnen</a>
                <a class="btn btn-secondary" href="@DocumentPreview.DownloadUrl(document.Id)">
                    Herunterladen
                </a>
            </div>
        }
        else
        {
            @*
                Datei fehlt: der Eintrag bleibt vollständig sichtbar und verknüpft. Ausblenden
                wäre der schlechteste Ausweg — dann wüsste niemand mehr, dass es ihn gab.
            *@
            <div class="notice">
                <span class="notice-title">Datei nicht gefunden</span>
                <span class="notice-text num">@document.RelativePath</span>
            </div>

            <AuthorizeView Roles="Owner,Member">
                <div class="doc-actions">
                    @if (fixing)
                    {
                        <div class="field">
                            <label for="doc-path">Neuer Pfad im Dokumentordner</label>
                            <input id="doc-path" class="input" placeholder="Bereich/Ordner/Datei.pdf"
                                   value="@newPath" @oninput="e => newPath = e.Value?.ToString() ?? string.Empty" />
                        </div>
                        <button type="button" class="btn btn-primary" disabled="@busy"
                                @onclick="SavePathAsync">Pfad speichern</button>
                        <button type="button" class="btn btn-secondary"
                                @onclick="@(() => fixing = false)">Abbrechen</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary" @onclick="StartFix">Pfad korrigieren</button>
                        <button type="button" class="btn btn-secondary"
                                @onclick="@(() => Toasts.Show("Ordnersuche folgt"))">Im Ordner suchen</button>
                        <button type="button" class="btn btn-secondary"
                                @onclick="@(() => Toasts.Show("Eintrag bleibt bestehen"))">
                            Eintrag behalten, Datei später
                        </button>
                    }
                </div>
            </AuthorizeView>
        }

        @*
            Was dieses Schreiben verlangt.

            Es stand bisher nur im Vorgang. Wer von dort hierher kam — und der Vorgang führt
            genau hierher —, sah das Papier und nicht mehr den Satz, um den es ging.

            Der Satz steht wörtlich da und nicht zusammengefasst: Er ist die Fundstelle, an der
            sich in zwei Sekunden prüfen lässt, ob richtig gelesen wurde.
        *@
        @if (document.ActionLine is { Length: > 0 } forderung)
        {
            <div class="notice">
                <span class="notice-title">
                    @(document.ActionDueDate is { } frist
                        ? $"Verlangt etwas — spätestens {GermanFormat.Date(frist)}"
                        : "Verlangt etwas")
                </span>
                <span class="notice-text">„@forderung“</span>

                @if (document.ActionFromModel)
                {
                    <span class="meta">Vom Sprachmodell gefunden</span>
                }

                @*
                    Der Weg zum offenen Posten. Ein Vorgang aus einem Schreiben kennt keinen
                    Betrag — die Zahl steht in seiner Zeile als Text, und keine Buchung findet
                    ihn. Ein offener Posten kennt ihn, und die Zahlungssuche kommt an ihn heran.

                    Das Formular steht vorbefüllt da, geschrieben wird nichts, bis jemand
                    „Posten anlegen“ drückt.
                *@
                <AuthorizeView Roles="Owner,Member" Context="posten">
                    <div class="doc-actions">
                        <a class="btn btn-primary" href="@($"/neu/invoice?beleg={document.Id}")">
                            Als offenen Posten erfassen
                        </a>
                    </div>
                </AuthorizeView>
            </div>
        }

        @*
            Gelesene Werte, die nie jemand übernommen hat. Von außen sah so ein Beleg aus wie
            ein übernommener: eingelesen, abgelegt, mit dem Vertrag verknüpft — und im Vertrag
            stand trotzdem nichts. Wer im Scaneingang „Wegräumen“ drückt, erzeugt genau das.

            Der Weg zurück fehlte ebenfalls: der Prüfschritt ist erreichbar, aber keine Fläche
            führte dorthin. Beides steht jetzt hier.
        *@
        @if (document.UnconfirmedValues > 0)
        {
            <div class="notice">
                <span class="notice-title">
                    @document.UnconfirmedValues gelesene
                    @(document.UnconfirmedValues == 1 ? "Angabe" : "Angaben") noch nicht übernommen
                </span>
                <span class="notice-text">
                    Der Beleg ist abgelegt, seine Werte stehen aber in keinem Objekt. Der
                    Prüfschritt zeigt sie und trägt sie ein.
                </span>

                @if (document.ValuesHref is { Length: > 0 } pruefen)
                {
                    <AuthorizeView Roles="Owner,Member">
                        <div class="doc-actions">
                            <a class="btn btn-primary" href="@pruefen">Werte übernehmen</a>
                        </div>
                    </AuthorizeView>
                }
            </div>
        }

        <div class="detail-block">
            <span class="detail-label">Pfad</span>
            <span class="detail-value num">@document.RelativePath</span>
        </div>

        <div class="detail-block">
            <span class="detail-label">Typ · Dokumentdatum · Gültigkeit</span>
            <span class="detail-value">@DescribeMeta(document)</span>
        </div>

        @*
            Nachträglich ändern.

            Art, Titel und Datum standen bisher fest, sobald ein Beleg abgelegt war: Der
            Endpunkt dafür gab es, aufgerufen hat ihn keine Seite. Wer sich vergriffen hatte,
            musste den Eintrag löschen und die Datei neu einlesen — das legt sie ein zweites
            Mal ab. Eine Zuordnung, die sich nicht korrigieren lässt, wird beim Zuordnen
            vorsichtig gemacht, und vorsichtig heißt hier: gar nicht.

            Der Bereich steht nicht als eigenes Feld da. Er hängt an der Art, und zwei Felder,
            die dasselbe sagen können, sagen irgendwann Verschiedenes.
        *@
        <AuthorizeView Roles="Owner,Member" Context="pflege">
            @if (editing)
            {
                <div class="picker">
                    <span class="label-strong">Art</span>
                    <div class="chipcloud">
                        @foreach (var art in types)
                        {
                            <button type="button" class="chip @(typeId == art.Id ? "active" : null)"
                                    @onclick="() => typeId = art.Id">@art.Name</button>
                        }
                    </div>

                    @if (SelectedType is { } gewaehlt)
                    {
                        <span class="create-help">Bereich: @AreaLabel(gewaehlt.Area)</span>
                    }

                    <div class="field">
                        <label for="doc-title">Titel</label>
                        <input id="doc-title" class="input" type="text" @bind="draftTitle" />
                    </div>

                    <div class="field">
                        <label for="doc-date">Dokumentdatum</label>
                        <input id="doc-date" class="input" type="date" @bind="draftDate" />
                    </div>

                    <div class="doc-actions">
                        <button type="button" class="btn btn-primary" disabled="@busy"
                                @onclick="SaveAsync">Übernehmen</button>
                        <button type="button" class="btn btn-secondary" disabled="@busy"
                                @onclick="@(() => editing = false)">Abbrechen</button>
                    </div>
                </div>
            }
            else
            {
                <div class="doc-actions">
                    <button type="button" class="btn btn-secondary" disabled="@busy"
                            @onclick="StartEdit">Angaben ändern</button>
                </div>
            }
        </AuthorizeView>

        @*
            Die Freigabe. Zwei Stufen genügen: Ein Konto kennt zusätzlich „namentlich“ und
            „Gemeinschaft“, aber beides beantwortet Fragen, die ein Dokument nicht stellt.
        *@
        <AuthorizeView Roles="Owner,Member" Context="freigabe">
            <div class="picker">
                <span class="label-strong">Sichtbar für</span>
                <div class="chipcloud">
                    <button type="button" disabled="@busy"
                            class="chip @(document.Sharing == DocumentSharing.Household ? "active" : null)"
                            @onclick="() => ShareAsync(DocumentSharing.Household)">den Haushalt</button>
                    <button type="button" disabled="@busy"
                            class="chip @(document.Sharing == DocumentSharing.Private ? "active" : null)"
                            @onclick="() => ShareAsync(DocumentSharing.Private)">nur mich</button>
                </div>
                @if (document.Sharing == DocumentSharing.Private)
                {
                    <span class="create-help">
                        Niemand sonst im Haushalt sieht dieses Dokument — auch nicht in der Suche
                        oder in einer Auswertung.
                    </span>
                }
            </div>
        </AuthorizeView>

        @if (document.Tags.Count > 0)
        {
            <div class="picker">
                <span class="label-strong">Schlagworte</span>
                <div class="chipcloud">
                    @foreach (var tag in document.Tags)
                    {
                        <span class="chip">@tag</span>
                    }
                </div>
            </div>
        }

        <div class="list-head">
            <span class="label-strong">Verknüpft mit</span>
            <span class="list-count num">@document.Links.Count</span>
        </div>

        @if (document.Links.Count == 0)
        {
            <div class="empty-area">
                <span class="empty-area-text">
                    Noch mit nichts verknüpft. Manche Post hängt an nichts und wird es nie —
                    ein Lieferschein etwa. Gibt es das Objekt, lässt es sich hier anhängen.
                </span>
            </div>
        }

        @foreach (var link in document.Links)
        {
            <div class="more-row link-row">
                <button type="button" class="tap stack" @onclick="() => OpenLink(link)">
                    <span class="more-label">@link.Label</span>
                    <span class="meta">@link.TargetLabel</span>
                </button>

                @* Nur die Verknüpfung geht, nicht das Dokument. Das steht am Knopf, damit
                   niemand hier einen Löschknopf vermutet. *@
                <AuthorizeView Roles="Owner,Member" Context="loesen">
                    <button type="button" class="btn btn-ghost" disabled="@busy"
                            title="Verknüpfung lösen — das Dokument bleibt"
                            @onclick="() => UnlinkAsync(link)">Lösen</button>
                </AuthorizeView>
            </div>
        }

        @*
            Anhängen von hier aus. Bisher ging das nur am Objekt — wer vom Dokument kam,
            musste wissen, wo das Gegenstück wohnt. Beim Beleg, der ohne Objekt abgelegt
            wurde, ist das genau der Weg, den er braucht.
        *@
        <AuthorizeView Roles="Owner,Member" Context="anhaengen">
            <div class="picker">
                <span class="label-strong">Objekt anhängen</span>

                <div class="searchbar">
                    <input class="input" type="search" placeholder="Vertrag, Immobilie, Fahrzeug …"
                           aria-label="Objekt suchen" value="@term" @oninput="OnSearchInput" />
                </div>

                @if (searching)
                {
                    <span class="meta">Wird gesucht …</span>
                }
                else if (term.Trim().Length > 1 && hits.Count == 0)
                {
                    <span class="meta">Kein Objekt passt zu „@term“.</span>
                }

                @foreach (var hit in hits)
                {
                    <button type="button" class="tap more-row" disabled="@busy"
                            @onclick="() => LinkAsync(hit)">
                        <span class="stack">
                            <span class="more-label">@hit.Label</span>
                            <span class="meta">@hit.TargetLabel · @hit.Subtitle</span>
                        </span>
                    </button>
                }
            </div>
        </AuthorizeView>

        @* Gelöscht wird nur der Eintrag — die Datei bleibt liegen. Das steht auch so da,
           damit niemand einen Dateiverlust befürchtet, den es nicht gibt. *@
        <AuthorizeView Roles="Owner,Member">
            <div class="delete-block">
                <span class="label-strong">Dokument löschen</span>
                <span class="delete-consequence">
                    Nur der Eintrag verschwindet — die Datei bleibt im Dokumentordner liegen.
                    @(document.Links.Count == 0
                        ? "Es hängt keine Verknüpfung daran."
                        : $"{document.Links.Count} Verknüpfung{(document.Links.Count == 1 ? "" : "en")} entfällt.")
                </span>

                @if (confirmingDelete)
                {
                    <div class="doc-actions">
                        <button type="button" class="btn btn-primary delete-confirm" disabled="@busy"
                                @onclick="DeleteAsync">Löschen bestätigen</button>
                        <button type="button" class="btn btn-secondary" disabled="@busy"
                                @onclick="@(() => confirmingDelete = false)">Behalten</button>
                    </div>
                }
                else
                {
                    <div class="doc-actions">
                        <button type="button" class="btn btn-secondary" disabled="@busy"
                                @onclick="@(() => confirmingDelete = true)">Dokument löschen</button>
                    </div>
                }
            </div>
        </AuthorizeView>

        <div class="spacer"></div>
    }
</AsyncView>

@code {
    [Parameter] public int Id { get; set; }

    /// <summary>Wird nach dem Löschen ausgelöst, damit die Liste nachrücken kann.</summary>
    [Parameter] public EventCallback<int> OnDeleted { get; set; }

    private DocumentDetailDto? data;
    private bool fixing;
    private bool confirmingDelete;
    private bool busy;
    private string newPath = string.Empty;

    private int loadedId;

    // ── Angaben ändern ─────────────────────────────────────────────────────────────────────

    private IReadOnlyList<DocumentTypeDto> types = [];
    private bool editing;
    private int? typeId;
    private string draftTitle = string.Empty;
    private DateOnly? draftDate;

    private DocumentTypeDto? SelectedType => types.FirstOrDefault(t => t.Id == typeId);

    // ── Objekt anhängen ────────────────────────────────────────────────────────────────────

    private IReadOnlyList<ObjectHitDto> hits = [];
    private string term = string.Empty;
    private bool searching;
    private CancellationTokenSource? debounce;

    private static string AreaLabel(DocumentArea area) => DocumentAreaNames.Label(area);

    protected override async Task LoadAsync()
    {
        loadedId = Id;
        fixing = false;
        confirmingDelete = false;
        editing = false;
        term = string.Empty;
        hits = [];
        data = await Api.GetDocumentAsync(Id);

        // Einmal für die Lebensdauer der Komponente: Ab Tablet bleibt sie stehen und bekommt
        // beim Blättern nur eine andere Id. Die Artenliste jedes Mal neu zu holen wäre eine
        // Anfrage ohne neue Auskunft.
        if (types.Count == 0)
        {
            types = await Api.GetAssignableDocumentTypesAsync();
        }
    }

    private void StartEdit()
    {
        if (data is not { } dokument)
        {
            return;
        }

        typeId = dokument.DocumentTypeId;
        draftTitle = dokument.Title;
        draftDate = dokument.DocumentDate;
        editing = true;
    }

    /// <summary>
    /// Schreibt Art, Titel und Datum zurück.
    /// </summary>
    /// <remarks>
    /// <para>Die nicht gezeigten Felder werden mitgeschickt, wie sie sind. Der Endpunkt setzt
    /// den ganzen Eintrag: Was fehlt, wird geleert — und dann hätte eine Titelkorrektur
    /// klammheimlich Gültigkeit und Schlagworte gelöscht.</para>
    /// <para>Der Bereich kommt aus der Art. Ohne Art bleibt er, wie er war: Ihn dann auf
    /// „Sonstiges“ zu stellen wäre eine Aussage, die niemand getroffen hat.</para>
    /// </remarks>
    private Task SaveAsync() => RunAsync(async () =>
    {
        if (data is not { } dokument || string.IsNullOrWhiteSpace(draftTitle))
        {
            return;
        }

        busy = true;
        try
        {
            await Api.UpdateDocumentAsync(Id, new UpdateDocumentRequest
            {
                Title = draftTitle.Trim(),
                DocumentTypeId = typeId,
                Area = SelectedType?.Area ?? dokument.Area,
                Description = dokument.Description,
                DocumentDate = draftDate,
                ValidFrom = dokument.ValidFrom,
                ValidUntil = dokument.ValidUntil,
                Tags = dokument.Tags,
            });

            data = await Api.GetDocumentAsync(Id);
            editing = false;
            Toasts.Show("Angaben übernommen", ToastKind.Saved);
        }
        finally
        {
            busy = false;
        }
    });

    /// <summary>Hängt das Dokument an ein Objekt und lädt die Zeile neu.</summary>
    private Task LinkAsync(ObjectHitDto treffer) => RunAsync(async () =>
    {
        busy = true;
        try
        {
            await Api.LinkDocumentAsync(Id, treffer.TargetType, treffer.TargetId);
            data = await Api.GetDocumentAsync(Id);
            term = string.Empty;
            hits = [];
            Toasts.Show($"Hängt jetzt an {treffer.Label}.", ToastKind.Saved);
        }
        catch (ApiException ex)
        {
            Toasts.Show(ex.Message, ToastKind.Problem);
        }
        finally
        {
            busy = false;
        }
    });

    /// <summary>
    /// Löst eine Verknüpfung. Die Datei bleibt, wo sie ist.
    /// </summary>
    /// <remarks>
    /// Sie zurück nach <c>Unbekannt</c> zu schieben wäre die gründlichere Geste und die
    /// schlechtere: Wer eine Verknüpfung löst, korrigiert meist eine Zuordnung und setzt
    /// gleich die nächste. Die Datei zweimal zu verschieben verwirrt jeden, der nebenher den
    /// Dateimanager offen hat.
    /// </remarks>
    private Task UnlinkAsync(DocumentLinkDto verknuepfung) => RunAsync(async () =>
    {
        busy = true;
        try
        {
            await Api.UnlinkDocumentAsync(verknuepfung.Id);
            data = await Api.GetDocumentAsync(Id);
            Toasts.Show($"Verknüpfung zu {verknuepfung.Label} gelöst · Datei bleibt liegen", ToastKind.Saved);
        }
        catch (ApiException ex)
        {
            Toasts.Show(ex.Message, ToastKind.Problem);
        }
        finally
        {
            busy = false;
        }
    });

    /// <summary>
    /// Sucht nach 250 ms Ruhe — dieselbe Wartezeit wie am Prüfplatz und in der Dokumentsuche.
    /// </summary>
    /// <remarks>
    /// Jeder Anschlag eine Anfrage wäre nicht nur Last, sondern falsche Ergebnisse: die letzte
    /// überholte die vorletzte.
    /// </remarks>
    private async Task OnSearchInput(ChangeEventArgs e)
    {
        term = e.Value?.ToString() ?? string.Empty;

        debounce?.Cancel();
        debounce?.Dispose();
        debounce = new CancellationTokenSource();

        var laufend = debounce.Token;

        // Ein einzelnes Zeichen trifft halb Haushalt. Die Suche beginnt ab zwei.
        if (term.Trim().Length < 2)
        {
            hits = [];
            searching = false;
            return;
        }

        searching = true;

        try
        {
            await Task.Delay(250, laufend);

            // Die Anfrage selbst läuft ohne Abbruchmarke: ein abgebrochener Aufruf käme als
            // „Der Server hat nicht rechtzeitig geantwortet“ zurück, und das stimmte nicht —
            // es hat nur jemand weitergetippt. Verworfen wird das Ergebnis, nicht die Anfrage.
            var ergebnis = await Api.SearchDocumentsAsync(term.Trim());

            if (laufend.IsCancellationRequested)
            {
                return;
            }

            // Was schon hängt, steht nicht noch einmal zur Auswahl.
            var schon = data?.Links ?? [];
            hits =
            [
                .. ergebnis.Objects.Where(o =>
                    !schon.Any(l => l.TargetType == o.TargetType && l.TargetId == o.TargetId)),
            ];

            searching = false;
            StateHasChanged();
        }
        catch (OperationCanceledException)
        {
            // Ein neuer Tastenanschlag hat diese Anfrage überholt. „Wird gesucht …“ bleibt
            // stehen, weil die nächste Anfrage schon läuft.
        }
        catch (ApiException ex)
        {
            searching = false;
            Toasts.Show(ex.Message, ToastKind.Problem);
        }
    }

    public override void Dispose()
    {
        debounce?.Cancel();
        debounce?.Dispose();
        base.Dispose();
    }

    /// <summary>
    /// Stellt die Freigabe um und lädt neu.
    /// </summary>
    /// <remarks>
    /// Neu geladen, nicht am Ort geändert: Wer ein Dokument auf „nur ich“ stellt, wird dabei
    /// sein Eigentümer — das entscheidet der Server, und die Anzeige soll sagen, was dort steht.
    /// </remarks>
    private Task ShareAsync(DocumentSharing freigabe) => RunAsync(async () =>
    {
        if (data is null || data.Sharing == freigabe)
        {
            return;
        }

        busy = true;
        try
        {
            await Api.SetDocumentSharingAsync(Id, freigabe);
            data = await Api.GetDocumentAsync(Id);
            Toasts.Show(freigabe == DocumentSharing.Private
                ? "Sichtbar nur für Sie"
                : "Sichtbar für den Haushalt", ToastKind.Saved);
        }
        finally
        {
            busy = false;
        }
    });

    /// <summary>
    /// Ab Tablet bleibt die Komponente stehen und bekommt nur eine andere Id — dann muss sie
    /// selbst nachladen, sonst zeigte die Vorschau weiter das vorige Dokument.
    /// </summary>
    /// <remarks>
    /// Der Haken der Basis, nicht <c>OnParametersSetAsync</c>: dort liegt das erste Laden, und
    /// eine Überschreibung ohne Basisaufruf ließ die Spalte auf „Wird geladen …“ stehen.
    /// </remarks>
    protected override async Task OnParametersChangedAsync()
    {
        if (data is not null && loadedId != Id)
        {
            await ReloadAsync();
        }
    }

    private async Task DeleteAsync()
    {
        busy = true;
        try
        {
            await Api.DeleteDocumentAsync(Id);
            Toasts.Show("Dokumenteintrag gelöscht · Datei bleibt liegen", ToastKind.Saved);
            await OnDeleted.InvokeAsync(Id);
        }
        catch (ApiException ex)
        {
            Toasts.Show(ex.Message, ToastKind.Problem);
        }
        finally
        {
            busy = false;
            confirmingDelete = false;
        }
    }

    private void StartFix()
    {
        newPath = data?.RelativePath ?? string.Empty;
        fixing = true;
    }

    private async Task SavePathAsync()
    {
        busy = true;
        try
        {
            data = await Api.FixDocumentPathAsync(Id, newPath);
            fixing = false;
            Toasts.Show("Pfad gespeichert", ToastKind.Saved);
        }
        catch (ApiException ex)
        {
            Toasts.Show(ex.Message, ToastKind.Problem);
        }
        finally
        {
            busy = false;
        }
    }

    private static string DescribeMeta(DocumentDetailDto document)
    {
        var parts = new List<string>();
        if (document.TypeName is { Length: > 0 } type)
        {
            parts.Add(type);
        }

        if (document.DocumentDate is { } date)
        {
            parts.Add(GermanFormat.Date(date));
        }

        if (document.ValidFrom is { } from)
        {
            parts.Add("ab " + GermanFormat.Date(from));
        }

        if (document.ValidUntil is { } until)
        {
            parts.Add("bis " + GermanFormat.Date(until));
        }

        return parts.Count == 0 ? "—" : string.Join(" · ", parts);
    }

    private void OpenLink(DocumentLinkDto link)
    {
        var route = link.TargetType switch
        {
            LinkTargetType.Policy => $"/police/{link.TargetId}",
            LinkTargetType.Contract => $"/vertraege/{link.TargetId}",
            LinkTargetType.Property => $"/wohnen/{link.TargetId}",
            LinkTargetType.Invoice => $"/rechnungen/{link.TargetId}",
            LinkTargetType.MedicalBill => $"/gesundheit/{link.TargetId}",
            LinkTargetType.Loan => $"/darlehen?id={link.TargetId}",
            LinkTargetType.Transaction or LinkTargetType.Account => "/konten",
            _ => null,
        };

        if (route is null)
        {
            Toasts.Show("Zu diesem Objekt gibt es keinen eigenen Screen.");
            return;
        }

        Navigation.NavigateTo(route);
    }
}
