@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    Ein Beleg, mit der Kamera aufgenommen — am Telefon mit der rückwärtigen, am Rechner mit
    der Webcam.

    Am Telefon genügte bisher `capture="environment"` am Dateifeld; das öffnet die Kamera-App
    des Geräts, und die kann alles besser, als eine Seite es könnte. Am Rechner tut dasselbe
    Attribut nichts, dort öffnet sich der Dateiwähler. Für eine Webcam gibt es nur diesen Weg.
*@
<div class="cam">
    @if (fehler is { Length: > 0 } grund)
    {
        @* Nie eine leere Fläche: der Grund steht da, und der Dateiwähler bleibt der Ausweg. *@
        <div class="empty-area">
            <span class="empty-area-title">Die Kamera steht nicht zur Verfügung</span>
            <span class="empty-area-text">@grund</span>
            <div class="empty-area-actions">
                <button type="button" class="btn btn-secondary" @onclick="RetryAsync">
                    Noch einmal versuchen
                </button>
                <button type="button" class="btn btn-ghost" @onclick="CloseAsync">Zurück</button>
            </div>
        </div>
    }
    else
    {
        @*
            Das Bild bleibt im Baum, auch wenn eine Aufnahme darüberliegt: nähme man es heraus,
            wäre der Strom beim „Neu aufnehmen“ weg und müsste samt Freigabefrage neu starten.
        *@
        <div class="cam-stage @(shot is null ? null : "taken")">
            <video @ref="video" class="cam-video" playsinline muted autoplay
                   aria-label="Kameravorschau"></video>

            @if (shot is { Length: > 0 } aufnahme)
            {
                <img class="cam-shot" src="data:image/jpeg;base64,@aufnahme" alt="Aufgenommener Beleg" />
            }
        </div>

        @if (shot is null)
        {
            @if (cameras.Count > 1)
            {
                @*
                    Mehrere Kameras sind am Rechner die Regel, sobald ein Telefon als Webcam
                    hängt oder ein Bildschirm eine eingebaute hat. Die erste ist dann selten die
                    gemeinte.
                *@
                <label class="cam-pick">
                    <span class="label-muted">Kamera</span>
                    <select class="input" value="@active" @onchange="SwitchAsync"
                            aria-label="Kamera wählen">
                        @foreach (var kamera in cameras)
                        {
                            <option value="@kamera.Id">@kamera.Name</option>
                        }
                    </select>
                </label>
            }

            <div class="cam-actions">
                <button type="button" class="btn btn-primary" disabled="@(!running || busy)"
                        @onclick="CaptureAsync">Aufnehmen</button>
                <button type="button" class="btn btn-ghost" @onclick="CloseAsync">Abbrechen</button>
            </div>

            @if (size is { } masse)
            {
                @*
                    Die Auflösung steht da, weil sie über das Ergebnis entscheidet: aus 640×480
                    liest keine Erkennung eine Vertragsnummer, und das merkt man sonst erst an
                    der leeren Maske.
                *@
                <span class="cam-note meta">
                    @masse.Breite × @masse.Hoehe Bildpunkte@(masse.Breite < 1280 ? " — für kleine Schrift wenig" : string.Empty)
                </span>
            }
        }
        else
        {
            <div class="cam-actions">
                <button type="button" class="btn btn-primary" disabled="@busy" @onclick="UseAsync">
                    Verwenden
                </button>
                <button type="button" class="btn btn-secondary" disabled="@busy" @onclick="Retake">
                    Neu aufnehmen
                </button>
                <button type="button" class="btn btn-ghost" @onclick="CloseAsync">Abbrechen</button>
            </div>

            <span class="cam-note meta">
                Lesbar? Was hier unscharf ist, ist es auch für die Erkennung.
            </span>
        }
    }
</div>

@code {
    /// <summary>Die Aufnahme als JPEG — der Aufrufer gibt ihr einen Namen und lädt sie hoch.</summary>
    [Parameter] public EventCallback<byte[]> OnCaptured { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private ElementReference video;

    private string? fehler;
    private string? shot;
    private string? active;
    private bool running;
    private bool busy;
    private bool started;

    private IReadOnlyList<Camera> cameras = [];
    private Size? size;

    /// <summary>Eine gefundene Kamera. Ihr Name steht erst nach der ersten Freigabe fest.</summary>
    private sealed record Camera(string Id, string Name);

    private sealed record Size(int Breite, int Hoehe);

    private sealed record StartResult(
        bool Ok, string? Grund, List<Camera>? Kameras, string? Aktiv, int Breite, int Hoehe);

    /// <summary>
    /// Gestartet wird nach dem ersten Rendern, nicht davor.
    /// </summary>
    /// <remarks>
    /// Vorher gibt es das Bildelement noch nicht, und <c>ElementReference</c> zeigt ins Leere.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !started)
        {
            started = true;
            await StartAsync(null);
        }
    }

    private async Task StartAsync(string? deviceId)
    {
        try
        {
            var antwort = await JS.InvokeAsync<StartResult>("finanzapp.kamera.start", video, deviceId);

            if (!antwort.Ok)
            {
                fehler = antwort.Grund ?? "Die Kamera ließ sich nicht öffnen.";
                running = false;
            }
            else
            {
                fehler = null;
                running = true;
                cameras = antwort.Kameras ?? [];
                active = antwort.Aktiv is { Length: > 0 } gewaehlt ? gewaehlt : deviceId;
                size = new Size(antwort.Breite, antwort.Hoehe);
            }
        }
        catch (JSException ex)
        {
            fehler = Short(ex);
            running = false;
        }

        StateHasChanged();
    }

    /// <summary>
    /// Aus einer Ausnahme der Skriptbrücke wird ein Satz, kein Stapelauszug.
    /// </summary>
    /// <remarks>
    /// <para>Die Meldung einer <c>JSException</c> trägt die ganze Aufrufkette durch
    /// <c>blazor.webassembly.js</c> mit. Auf dem Schirm ist das kein Hinweis, sondern eine Wand,
    /// und sie sagt niemandem, was zu tun wäre.</para>
    /// <para>Eine fehlende Funktion hat dabei fast immer dieselbe Ursache: die Seite läuft mit
    /// einem älteren Skript aus dem Zwischenspeicher. Das ist eine Auskunft, mit der sich etwas
    /// anfangen lässt — der Name der Funktion nicht.</para>
    /// </remarks>
    private static string Short(JSException ex)
    {
        if (ex.Message.Contains("Could not find", StringComparison.Ordinal))
        {
            return "Die Seite läuft mit einem älteren Stand ihres Skripts. Einmal neu laden "
                   + "(Strg+F5), dann steht die Kamera bereit.";
        }

        var erste = ex.Message.Split('\n')[0].Trim();
        return erste.Length > 180 ? erste[..180] + " …" : erste;
    }

    private async Task RetryAsync()
    {
        fehler = null;
        await StartAsync(active);
    }

    private async Task SwitchAsync(ChangeEventArgs e)
    {
        if (e.Value?.ToString() is { Length: > 0 } id && id != active)
        {
            active = id;
            await StartAsync(id);
        }
    }

    private async Task CaptureAsync()
    {
        busy = true;
        try
        {
            shot = await JS.InvokeAsync<string?>("finanzapp.kamera.aufnehmen", video);

            if (shot is null)
            {
                fehler = "Die Kamera hat noch kein Bild geliefert. Einen Augenblick warten und "
                         + "noch einmal auslösen.";
            }
        }
        catch (JSException ex)
        {
            fehler = Short(ex);
        }
        finally
        {
            busy = false;
        }
    }

    /// <summary>Zurück zur Vorschau — der Strom lief weiter, es gibt nichts neu zu starten.</summary>
    private void Retake() => shot = null;

    private async Task UseAsync()
    {
        if (shot is not { Length: > 0 } aufnahme)
        {
            return;
        }

        busy = true;

        // Erst die Kamera aus, dann hochladen: die Analyse dauert, und solange soll keine
        // Leuchte brennen und kein Bild weiterlaufen, das niemand mehr ansieht.
        await StopAsync();
        await OnCaptured.InvokeAsync(Convert.FromBase64String(aufnahme));
    }

    private async Task CloseAsync()
    {
        await StopAsync();
        await OnClose.InvokeAsync();
    }

    private async Task StopAsync()
    {
        running = false;

        try
        {
            await JS.InvokeVoidAsync("finanzapp.kamera.stop");
        }
        catch (JSException)
        {
            // Beim Verlassen der Seite ist die Brücke manchmal schon zu. Dann hat der Browser
            // den Strom ohnehin beendet.
        }
    }

    public async ValueTask DisposeAsync() => await StopAsync();
}
