@using System.Globalization

@*
    Fixkosten & vertragliche Bindung — Abschnitt 10b.

    Die Bezugsgröße steht im Balkentext. Ein Prozentsatz ohne genannte Basis war im Prototyp
    der Grund, warum zwei Berichte nebeneinander verschiedene Anteile zeigten, ohne dass
    jemand sehen konnte, worauf sie sich beziehen.
*@

<div class="report-split">
    <div class="report-hero">
        <span class="kicker">Fix pro Monat</span>
        <span class="hero-value medium num">@State.Euro(Data.MonthlyFixed)</span>
        <span class="meta">@GermanFormat.Percent(Data.FixedSharePercent, 0) der Monatsbasis</span>
    </div>

    <div class="report-hero">
        <span class="kicker">Frei disponibel</span>
        <span class="hero-value medium num">@State.Euro(Data.MonthlyFree)</span>
        <span class="meta">Monatsbasis minus gebunden</span>
    </div>
</div>

<div class="report-bar-wrap">
    @* Der Balken deckelt bei hundert Prozent. Ein über den Rand laufender Balken wäre eine
       Zeichnung, die etwas anderes behauptet als die Anmerkung darunter. *@
    <div class="report-bar" role="img" aria-label="@BarNote">
        <div class="report-bar-fix" style="width:@Width"></div>
    </div>
    <span class="meta">@BarNote</span>
</div>

@if (Data.Rows.Count == 0)
{
    <div class="import-nothing">
        <span class="label-strong">Keine gebundenen Kosten erfasst</span>
        <span class="create-help">
            Darlehen, Verträge und Policen speisen diesen Bericht — bislang steht keines davon
            im Bestand.
        </span>
    </div>
}

@*
    Zwei Gliederungen derselben Liste, weil es zwei Fragen an sie gibt. Nach Kostenart:
    wofür geht das Geld — was könnte weg? Nach Konto: von wo geht es ab — welches Konto
    muss jeden Monat gedeckt sein? Zwanzig Einzelzeilen beantworten keine von beiden.

    Die Anteile beziehen sich jeweils auf die gebundenen Kosten und ergeben zusammen hundert
    Prozent. Gegen die Monatsbasis gerechnet täten sie es nicht.
*@
@if (Data.Rows.Count > 0)
{
    <div class="report-setting">
        <span class="label-muted">Gliederung</span>
        <div class="segmented bordered">
            <button type="button" class="segmented-opt @(nachKonto ? null : "active")"
                    @onclick="() => nachKonto = false">nach Kostenart</button>
            <button type="button" class="segmented-opt @(nachKonto ? "active" : null)"
                    @onclick="() => nachKonto = true">nach Konto</button>
        </div>
    </div>
}

@foreach (var gruppe in Gliederung)
{
    <div class="report-fix-group">
        <span class="stack">
            <span class="label-strong">@gruppe.Name</span>
            <span class="meta num">
                @gruppe.Rows.Count @(gruppe.Rows.Count == 1 ? "Posten" : "Posten") ·
                @GermanFormat.Percent(gruppe.SharePercent, 0) der Fixkosten
            </span>
        </span>
        <span class="report-row-amount num">@State.Euro(gruppe.MonthlyAmount)</span>
    </div>

    @foreach (var zeile in gruppe.Rows)
    {
        <div class="report-fix-row sub">
            <span class="stack">
                <span class="report-row-name">@zeile.Name</span>
                <span class="meta @(zeile.NoticeDue ? "due" : null)">@Zeilenhinweis(zeile)</span>
            </span>
            <span class="report-row-amount num">@State.Euro(zeile.MonthlyAmount)</span>
        </div>
    }
}

@if (nachKonto && Data.Accounts.Any(k => k.AccountId is null))
{
    @* Was unter „Ohne Konto“ steht, ist keine Auskunft über ein Konto, sondern die
       Stelle, an der die Auskunft fehlt. Der Satz sagt, wo man sie einträgt. *@
    <div class="tx-totals-note">
        „Ohne Konto“ heißt: Am Posten steht nicht, wovon er abgeht — nicht, dass er von
        keinem Konto abginge. Eintragen lässt es sich am Vertrag, an der Police und am
        Darlehen.
    </div>
}

@if (Data.WithoutAmountCount > 0)
{
    @* Sie fehlen in der Summe oben. Verschwiegen wäre „Fix pro Monat“ zu klein, ohne dass
       jemand sagen könnte warum. *@
    <div class="tx-totals-note">
        Nicht enthalten: @Data.WithoutAmountCount
        @(Data.WithoutAmountCount == 1 ? "Vertrag weist" : "Verträge weisen")
        keinen Beitrag aus · <a href="/vorsorge">nachtragen</a>
    </div>
}

<div class="tx-totals-note">@Data.Note</div>

@code {
    [Parameter, EditorRequired]
    public FixedCostsDto Data { get; set; } = default!;

    [Inject] private AppState State { get; set; } = default!;

    /// <summary>Ob nach Konto statt nach Kostenart gegliedert wird.</summary>
    /// <remarks>
    /// Die Kostenart bleibt die Vorgabe: Sie beantwortet die Frage, mit der man eine
    /// Fixkostenliste aufschlägt — was könnte weg. Das Konto beantwortet die zweite, und wer
    /// sie hat, findet sie einen Klick weit entfernt.
    /// </remarks>
    private bool nachKonto;

    /// <summary>Ein Abschnitt der Liste — eine Kostenart oder ein Konto.</summary>
    /// <remarks>
    /// Beide Gliederungen haben dieselbe Form, also zeigt sie dieselbe Schleife. Zwei fast
    /// gleiche Schleifen nebeneinander wären zwei Stellen, an denen die Darstellung
    /// auseinanderlaufen kann.
    /// </remarks>
    private sealed record Abschnitt(
        string Name,
        decimal MonthlyAmount,
        decimal SharePercent,
        IReadOnlyList<FixedCostRowDto> Rows);

    private IEnumerable<Abschnitt> Gliederung
        => nachKonto
            ? Data.Accounts.Select(k =>
                new Abschnitt(k.Name, k.MonthlyAmount, k.SharePercent, k.Rows))
            : Data.Groups.Select(g =>
                new Abschnitt(g.Name, g.MonthlyAmount, g.SharePercent, g.Rows));

    /// <summary>
    /// Die Zeile nennt immer die <em>andere</em> Dimension.
    /// </summary>
    /// <remarks>
    /// Unter einer Kontogruppe die Kostenart, unter einer Kostenart das Konto. Die Gruppe, in
    /// der eine Zeile steht, noch einmal in der Zeile zu wiederholen, verbräuchte den Platz
    /// für die Angabe, die man an dieser Stelle gerade nicht sieht.
    /// </remarks>
    private string Zeilenhinweis(FixedCostRowDto zeile)
    {
        if (nachKonto)
        {
            // Nur voranstellen, was nicht schon dasteht. Die Kostenart wird aus dem Bereich
            // abgeleitet, wo keine gepflegt ist — und der Bereich ist der erste Teil der
            // Anmerkung. Ohne diese Prüfung stand am Stromvertrag „Wohnen · Wohnen · …“, und
            // das sah aus, als zählte die Anwendung dasselbe zweimal.
            return zeile.Note.StartsWith(zeile.Group + " ", StringComparison.CurrentCultureIgnoreCase)
                   || zeile.Note.Equals(zeile.Group, StringComparison.CurrentCultureIgnoreCase)
                ? zeile.Note
                : $"{zeile.Group} · {zeile.Note}";
        }

        return zeile.AccountName is { } konto ? $"{konto} · {zeile.Note}" : zeile.Note;
    }

    /// <summary>
    /// „Fix 45 % · frei 55 % · Basis 2.975,40 € pro Monat, gerechnet aus August 2026“.
    /// </summary>
    /// <remarks>
    /// Der Satz entsteht hier und nicht auf dem Server: er nennt einen Betrag, und ein dort
    /// fertig formatierter käme an „Beträge verbergen“ vorbei.
    /// </remarks>
    private string BarNote
    {
        get
        {
            var fix = GermanFormat.Percent(Data.FixedSharePercent, 0);
            var frei = GermanFormat.Percent(Math.Max(0m, 100m - Data.FixedSharePercent), 0);

            return $"Fix {fix} · frei {frei} · Basis "
                   + $"{State.Euro(Data.Range.MonthlyExpenseBase)} pro Monat, gerechnet aus "
                   + Data.Range.PeriodLabel;
        }
    }

    private string Width
        => Math.Clamp(Data.FixedSharePercent, 0m, 100m)
               .ToString("0.#", CultureInfo.InvariantCulture) + "%";
}
