@implements IDisposable
@inject NavigationManager Navigation
@inject ToastService Toasts

@*
    Die Mitte der Tab-Leiste ist eine Aktion, kein Screen: ein Sheet über allem, damit der Weg von
    „Papier in der Hand“ zu „erfasst“ immer gleich lang ist. Der bestehende 3-Schritt-Screen für
    Buchungen bleibt vollständig erhalten und wird von hier aus geöffnet.
*@
<button type="button" class="backdrop" aria-label="Schließen" @onclick="OnClose"></button>

<div @ref="sheet" class="sheet capture-sheet" role="dialog" aria-modal="true" aria-label="Was erfassen?"
     tabindex="-1" @onkeydown="OnKeyDown">
    <div class="sheet-head">
        <div class="stack">
            <span class="kicker">Erfassen</span>
            <span class="sheet-payee">Was erfassen?</span>
        </div>
        <button type="button" class="header-action" @onclick="OnClose">Schließen</button>
    </div>

    <div class="sheet-body">
        @*
            Eine Tür für Papier, nicht fünf.

            Vorher stand hier je ein Eingang für Statusreport, Arztrechnung, Rechnung,
            Kontoauszug und „Beleg“ — und jeder führte in einen eigenen Leser. Der Benutzer
            musste einordnen, bevor die Maschine hingesehen hatte, und wer sich vergriff, bekam
            die falschen Leseregeln. Dabei erkennt derselbe Trichter, durch den der überwachte
            Ordner jede Datei schickt, die Art selbst.
        *@
        <div class="capture-list">
            <button type="button" class="btn btn-primary capture-item" @onclick="@(() => Go("/einlesen"))">
                Beleg einlesen
            </button>
            <button type="button" class="btn btn-secondary capture-item" @onclick="@(() => Go("/erfassen"))">
                Buchung erfassen
            </button>
            <button type="button" class="btn btn-secondary capture-item" @onclick="@(() => Go("/scaneingang"))">
                Scaneingang öffnen@(WaitingLabel)
            </button>
            <button type="button" class="btn btn-secondary capture-item" @onclick="@(() => Go("/neu"))">
                Objekt oder Vertrag anlegen
            </button>
            <button type="button" class="btn btn-secondary capture-item" @onclick="@(() => Go("/vorgaenge?neu=1"))">
                Aufgabe / Frist
            </button>
        </div>

        <span class="capture-note">
            Der Beleg landet im Dokumentordner; die Anwendung merkt sich nur den Pfad. Wer einen
            Scanner hat, legt die Datei gleich in den überwachten Ordner — dann braucht es auch
            diesen Weg nicht.
        </span>

        @*
            Die alten Türen bleiben erreichbar, aber nicht als erste Entscheidung. Wer weiß, dass
            er einen Kontoauszug in der Hand hält, soll ihn direkt importieren dürfen.
        *@
        <details class="capture-more">
            <summary>Wenn Sie es genau wissen</summary>
            <div class="capture-list">
                <button type="button" class="btn btn-ghost capture-item" @onclick="@(() => Go("/import"))">
                    Kontoauszug importieren
                </button>
                <button type="button" class="btn btn-ghost capture-item" @onclick="@(() => Go("/scannen"))">
                    Statusreport / Quartalsaufstellung
                </button>
                <button type="button" class="btn btn-ghost capture-item"
                        @onclick="@(() => Go("/gesundheit/scannen?art=arztrechnung"))">
                    Arztrechnung / PKV
                </button>
                <button type="button" class="btn btn-ghost capture-item" @onclick="@(() => Go("/dokumente?neu=1"))">
                    Dokument verknüpfen
                </button>
            </div>
        </details>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>
    /// Wie viele Belege auf Zuordnung warten.
    /// </summary>
    /// <remarks>
    /// Die Zahl gehört in die Zeile: sie ist der Grund, das Sheet überhaupt zu öffnen. Ohne sie
    /// wäre „Scaneingang öffnen“ eine Einladung ins Ungewisse.
    /// </remarks>
    [Parameter] public int? Waiting { get; set; }

    private string? WaitingLabel
        => Waiting is > 0
            ? $" · {Waiting} {(Waiting == 1 ? "Beleg wartet" : "Belege warten")}"
            : null;

    private ElementReference sheet;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await sheet.FocusAsync();
        }
    }

    private Task OnKeyDown(KeyboardEventArgs e)
        => e.Key == "Escape" ? OnClose.InvokeAsync() : Task.CompletedTask;

    private async Task Go(string route)
    {
        await OnClose.InvokeAsync();
        Navigation.NavigateTo(route);
    }

    public void Dispose()
    {
        // Nichts zu lösen — der Platzhalter hält die Symmetrie zu den übrigen Sheets.
    }
}
