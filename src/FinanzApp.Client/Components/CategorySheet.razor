@*
    Bottom-Sheet zum Zuordnen einer Kategorie. Ein Tipp auf einen Chip ordnet sofort zu und
    lässt das Sheet offen — beim Aufräumen mehrerer Buchungen ist das der schnellere Weg.
    Die Regel auf dem Empfänger-Präfix entsteht erst mit „Fertig“.
*@
<button type="button" class="backdrop" aria-label="Schließen" @onclick="OnClose"></button>

<div @ref="sheet" class="sheet" role="dialog" aria-modal="true" aria-label="@(IsBatch ? "Stapelvergabe" : "Kategorie zuordnen")"
     tabindex="-1" @onkeydown="OnKeyDown">
    <div class="sheet-head">
        @if (IsBatch)
        {
            @* Der Kopf sagt vorab, was die Stapelvergabe nicht anfassen wird. Das nachträglich
               zu melden wäre zu spät — dann hätte man schon geklickt. *@
            <div class="stack">
                <span class="kicker">Stapelvergabe</span>
                <span class="sheet-payee">
                    @BatchCount @(BatchCount == 1 ? "Buchung" : "Buchungen")
                </span>
                <span class="meta">Umbuchungen bleiben unverändert</span>
            </div>
            <span class="sheet-amount num">@State.Euro(BatchAmount, withPlusSign: true)</span>
        }
        else
        {
            <div class="stack">
                <span class="kicker">Kategorie zuordnen</span>
                <span class="sheet-payee">@Transaction!.Payee</span>
                <span class="meta">@GermanFormat.Date(Transaction.BookingDate) · @Transaction.AccountName</span>
            </div>
            <span class="sheet-amount num">@State.Euro(Transaction.Amount, withPlusSign: true)</span>
        }
    </div>

    <div class="sheet-body">
        @* Lesezugriff sieht die Buchung, ordnet aber nichts zu. *@
        <AuthorizeView Roles="Owner,Member">
            <Authorized>
                <div class="chipcloud">
                    @foreach (var category in Categories)
                    {
                        <button type="button"
                                class="chip @(!IsBatch && Transaction!.CategoryId == category.Id ? "active" : null)"
                                @onclick="() => OnPickCategory.InvokeAsync(category)">@category.Name</button>
                    }

                    <button type="button"
                            class="chip @(!IsBatch && Transaction!.Kind == TransactionKind.Transfer ? "active" : null)"
                            @onclick="OnPickTransfer">Umbuchung</button>
                </div>

                @* Eine Regel hängt am Empfänger — bei vielen Buchungen gibt es den nicht. *@
                @if (!IsBatch)
                {
                    <div class="sheet-rule">
                        <span class="sheet-rule-text">Regel für „@rulePattern“ merken</span>
                        <label class="radio">
                            <input type="checkbox" checked="@rememberRule" @onchange="ToggleRule" />
                            <span class="dot"></span>
                        </label>
                    </div>
                }
            </Authorized>
            <NotAuthorized>
                <span class="auth-note">
                    Dieser Zugang darf Buchungen ansehen, aber nicht kategorisieren.
                </span>
            </NotAuthorized>
        </AuthorizeView>

        @* Nach dem Import bleiben die Auszugsfelder erreichbar — dieselbe Ansicht wie dort,
           nur ohne die Schalter: am gespeicherten Datensatz gibt es nichts mehr zu wählen. *@
        @if (!IsBatch && Transaction!.HasStatementData)
        {
            <div class="sheet-rule">
                <span class="sheet-rule-text">Auszugsdaten</span>
                <button type="button" class="btn btn-ghost" @onclick="@(() => showStatement = true)">
                    Ansehen
                </button>
            </div>
        }
    </div>

    <div class="sheet-foot">
        <AuthorizeView Roles="Owner,Member">
            <Authorized>
                <button type="button" class="btn btn-primary" @onclick="Confirm">Fertig</button>

                @* Zweistufig: der zweite Tipp löscht. Kein Systemdialog — der reißt aus dem
                   Zusammenhang, in dem die Buchung gerade steht. *@
                @if (!IsBatch && OnDelete.HasDelegate)
                {
                    @if (confirmingDelete)
                    {
                        <button type="button" class="btn btn-primary delete-confirm"
                                @onclick="OnDelete">Wirklich löschen?</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-secondary"
                                @onclick="@(() => confirmingDelete = true)">Löschen</button>
                    }

                    <button type="button" class="btn btn-ghost" @onclick="OnSplit">Splitten</button>
                }
            </Authorized>
            <NotAuthorized>
                <button type="button" class="btn btn-primary" @onclick="OnClose">Schließen</button>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@if (showStatement && Transaction is { } gebucht)
{
    <StatementPanel Payee="@gebucht.Payee"
                    BookingDate="@gebucht.BookingDate"
                    Amount="@gebucht.Amount"
                    Details="@gebucht.Details"
                    Reference="@gebucht.ImportReference"
                    AccountName="@gebucht.AccountName"
                    OnClose="@(() => showStatement = false)" />
}

@code {
    [Inject] private AppState State { get; set; } = default!;

    private bool showStatement;

    /// <summary>Die einzelne Buchung. <c>null</c>, wenn das Sheet für eine Stapelvergabe offen ist.</summary>
    [Parameter] public TransactionDto? Transaction { get; set; }

    /// <summary>Wie viele Buchungen die Stapelvergabe umfasst. 0 heißt: Einzelbuchung.</summary>
    [Parameter] public int BatchCount { get; set; }

    /// <summary>Summe der gewählten Buchungen — die Kopfzahl der Stapelvergabe.</summary>
    [Parameter] public decimal BatchAmount { get; set; }

    private bool IsBatch => BatchCount > 0;

    [Parameter, EditorRequired] public IReadOnlyList<CategoryDto> Categories { get; set; } = [];

    [Parameter] public EventCallback<CategoryDto> OnPickCategory { get; set; }

    [Parameter] public EventCallback OnPickTransfer { get; set; }

    /// <summary>Wird mit „Fertig“ ausgelöst; der Wert sagt, ob eine Regel angelegt werden soll.</summary>
    [Parameter] public EventCallback<bool> OnConfirm { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    [Parameter] public EventCallback OnSplit { get; set; }

    /// <summary>Löscht die Buchung. Ohne Empfänger erscheint der Schalter gar nicht.</summary>
    [Parameter] public EventCallback OnDelete { get; set; }

    private bool confirmingDelete;

    private bool rememberRule = true;
    private string rulePattern = string.Empty;
    private ElementReference sheet;

    protected override void OnParametersSet()
    {
        confirmingDelete = false;
        rulePattern = Transaction is null
            ? string.Empty
            : Categorization.RulePatternFor(Transaction.Payee);
    }

    /// <summary>Beim Öffnen wandert der Fokus in das Sheet — sonst bliebe er auf der Zeile
    /// dahinter, und die Tastatur führte an der Auswahl vorbei.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await sheet.FocusAsync();
        }
    }

    private Task OnKeyDown(KeyboardEventArgs e)
        => e.Key == "Escape" ? OnClose.InvokeAsync() : Task.CompletedTask;

    private void ToggleRule(ChangeEventArgs e) => rememberRule = e.Value is true;

    private Task Confirm() => OnConfirm.InvokeAsync(rememberRule);
}
